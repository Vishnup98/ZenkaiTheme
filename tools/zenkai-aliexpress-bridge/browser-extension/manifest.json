{
  "manifest_version": 3,
  "name": "Zenkai AliExpress Checkout",
  "description": "Prepares reviewed Zenkai fulfillment checkouts in the existing signed-in AliExpress browser and stops before order submission.",
  "version": "1.0.19",
  "key": "",
  "permissions": [
    "alarms",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:4317/*",
    "http://localhost:4317/*",
    "https://*.aliexpress.com/*",
    "https://*.aliexpress.us/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:4317/*",
        "http://localhost:4317/*"
      ],
      "js": ["dashboard-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Zenkai AliExpress Checkout",
    "default_popup": "popup.html"
  }
}
