/*
 * ------------------------------------------------------------
 * ISOLATED QA TEMPLATE
 *
 * This template is intentionally not assigned to a product. It lets us
 * validate the Summoning Glow reviews section through Shopify's alternate
 * template view without changing the live product template.
 * ------------------------------------------------------------
 */
{
  "sections": {
    "main": {
      "type": "product-template",
      "settings": {
        "product_image_size": "large",
        "product_image_type": "slider",
        "product_zoom_enable": true,
        "enable_video_looping": true,
        "product_video_style": "muted",
        "enable_payment_button": true,
        "quantity_enable": false,
        "mobile_sticky_atc_enable": true,
        "show_dynamic_checkout_secondary": false,
        "social_enable": false
      }
    },
    "reviews": {
      "type": "summoning-glow-reviews",
      "settings": {
        "heading": "Loved by collectors",
        "subheading": "Real setups, close-up details, and first impressions from customers."
      }
    }
  },
  "order": [
    "main",
    "reviews"
  ]
}
