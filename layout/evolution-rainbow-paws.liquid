<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#30263b">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ product.title | escape }} | {{ shop.name | escape }}</title>
    <meta name="description" content="All eight Evolution Companions plushes in one complete collection. Meet every colorful companion, see real customer photos, and bring the whole set home.">
    {% render 'evolution-campaign-app-exclusions' %}
    {{ content_for_header }}
    {{ 'little-impostors-display-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'little-impostors-body-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    <style>
      @font-face{font-family:'Rainbow Display';src:url('{{ 'little-impostors-display-latin.woff2' | asset_url }}') format('woff2');font-style:normal;font-weight:400 800;font-display:swap}
      @font-face{font-family:'Rainbow Sans';src:url('{{ 'little-impostors-body-latin.woff2' | asset_url }}') format('woff2');font-style:normal;font-weight:400 800;font-display:swap}
    </style>
    {{ 'evolution-rainbow-paws.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'evolution-campaign.js' | asset_url }}" defer></script>
  </head>
  <body class="fg-body">
    <a href="#MainContent" class="fg-skip">Skip to the collection</a>
    <header class="ec-header fg-header">
      <a class="fg-brand" href="{{ routes.root_url }}" aria-label="Zenkai Clothing home"><img src="{{ 'zenkai_logo_1f3d003f-4bea-4a78-af5e-cde5e350c279.png' | file_url }}?width=144" width="72" height="54" alt="Zenkai Clothing"></a>
      <span class="fg-header-note"><i aria-hidden="true"></i> Free U.S. shipping <i aria-hidden="true"></i></span>
      <a class="fg-cart" href="{{ routes.cart_url }}" aria-label="View cart{% if cart.item_count > 0 %}, {{ cart.item_count }} items{% endif %}"><svg aria-hidden="true" focusable="false" viewBox="0 0 32 32" width="27" height="27" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 4h4l4 18h15l3-13H8"/><circle cx="13" cy="27" r="1.5"/><circle cx="24" cy="27" r="1.5"/></svg>{% if cart.item_count > 0 %}<span class="fg-cart-count" aria-hidden="true">{{ cart.item_count }}</span>{% endif %}</a>
    </header>
    <main id="MainContent">{{ content_for_layout }}</main>
    <footer class="fg-footer">
      <div class="fg-shell fg-footer-inner">
        <div><strong>ZENKAI</strong><span>Every color has a place here.</span></div>
        <nav aria-label="Customer support"><a href="/policies/shipping-policy">Shipping</a><a href="/policies/refund-policy">Refunds &amp; order care</a><a href="mailto:{{ shop.email }}">Contact us</a><a href="{{ shop.privacy_policy.url }}">Privacy</a></nav>
        <small>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }} <span aria-hidden="true">·</span> Secure checkout with Shopify</small>
      </div>
    </footer>
  </body>
</html>
