    {%- if zenkai_summoning_glow_landing_context -%}
      <script>
        (function() {
          var query = window.location.search || '';
          var isPaidLandingPage = /(?:^|[?&])lp=(?:reveal|desk)(?:&|$)/i.test(query);

          if (!isPaidLandingPage) return;

          var hasReleasedPaidLandingPage = false;

          function releasePaidLandingPage() {
            if (hasReleasedPaidLandingPage) return;

            var pageContainer = document.getElementById('PageContainer');
            if (!pageContainer) return;

            hasReleasedPaidLandingPage = true;

            var splashScreen = document.querySelector('.splash-screen');
            var transitionBody = document.querySelector('.transition-body');

            if (splashScreen) {
              splashScreen.style.setProperty('display', 'none', 'important');
              splashScreen.hidden = true;
              splashScreen.setAttribute('aria-hidden', 'true');
            }

            pageContainer.style.setProperty('display', 'block', 'important');
            pageContainer.style.setProperty('visibility', 'visible', 'important');

            if (transitionBody) {
              transitionBody.style.setProperty('opacity', '1', 'important');
              transitionBody.style.setProperty('visibility', 'visible', 'important');
            }

            document.body.className = document.body.className
              .replace(/(?:^|\s)unloading(?:\s|$)/g, ' ')
              .replace(/\s+/g, ' ');

            if (document.body.className.indexOf('loaded') === -1) {
              document.body.className += ' loaded';
            }
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', releasePaidLandingPage);
          } else {
            releasePaidLandingPage();
          }

          window.addEventListener('pageshow', releasePaidLandingPage);
          window.setTimeout(releasePaidLandingPage, 2500);
        })();
      </script>
      <noscript>
        <style>
          .splash-screen { display: none !important; }
          .page-container { display: block !important; visibility: visible !important; }
          .transition-body { opacity: 1 !important; visibility: visible !important; }
        </style>
      </noscript>
    {%- endif -%}

