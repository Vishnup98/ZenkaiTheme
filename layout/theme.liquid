  {%- if settings.favicon -%}
    <link rel="shortcut icon" href="{{ settings.favicon | img_url: '32x32' }}" type="image/png" />
  {%- endif -%}

  {% include 'seo-title' %}
  <title>{{ seo_title }}</title>

  {%- if page_description -%}
  <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {% include 'social-meta-tags' %}

  {{ content_for_header }}

  <script>
    var theme = {
      stylesheet: "{{ 'theme.scss.css' | asset_url }}",
      template: {{ template | json }},
      strings: {
        addToCart: {{ 'products.product.add_to_cart' | t | json }},
        soldOut: {{ 'products.product.sold_out' | t | json }},
        unavailable: {{ 'products.product.unavailable' | t | json }},
        regularPrice: {{ 'products.general.regular_price' | t | json }},
        salePrice: {{ 'products.general.sale_price' | t | json }},
        stockLabel: {{ 'products.product.stock_label' | t: count: '[count]' | json }},
        willNotShipUntil: {{ 'products.product.will_not_ship_until' | t: date: '[date]' | json }},
        willBeInStockAfter: {{ 'products.product.will_be_in_stock_after' | t: date: '[date]' | json }},
        waitingForStock: {{ 'products.product.waiting_for_stock' | t | json }},
        cartItems: {{ 'cart.general.item_count' | t: count: '[count]' | json }},
        cartConfirmDelete: {{ 'cart.general.delete_confirm' | t | json }},
        cartTermsConfirmation: {{ 'cart.general.terms_confirm' | t | json }}
      },
      settings: {
        dynamicVariantsEnable: true,
        cartType: {{ settings.cart_type | json }},
        moneyFormat: {{ shop.money_format | json }},
        quickView: {{ settings.quick_shop_enable }},
        hoverProductGrid: {{ settings.product_hover_image }},
        themeName: 'Streamline',
        themeVersion: "3.0.3"
      }
    };

    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
  </script>

  {% include 'critical-css' %}
  {% include 'load-css' %}

  <script src="{{ 'vendor-v2.js' | asset_url | split: '?' | first }}" defer="defer"></script>
  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  {%- if request.page_type contains 'customers/' -%}
    <script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer="defer"></script>
  {%- endif -%}
 </head>

<body class="template-{{ template | replace: '.', ' ' | truncatewords: 1, '' | handle }}{% if settings.cart_type == 'sticky' and cart.item_count > 0 and template != 'cart' %} body--sticky-cart-open{% endif %}{% if cart.item_count > 0 %} cart-has-items{% endif %}" data-transitions="{{ settings.animate_page_transitions }}" ontouchstart="return true;">
  <div id="OverscrollLoader" class="overscroll-loader" aria-hidden="true">
    <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon--full-color icon-loader--full-color"><path class="icon-loader__close" d="M19 17.61l27.12 27.13m0-27.12L19 44.74"/><path class="icon-loader__path" d="M40 90a40 40 0 1 1 20 0"/></svg>
  </div>

  <div class="root">

    {% if settings.animate_page_transitions %}
      <script>window.setTimeout(function() { document.body.className += " loaded"; }, 25);</script>
    {% endif %}

    {%- assign loader_size = settings.desktop_loader_width | append: 'x' -%}
    {%- assign loader_size_mobile = settings.mobile_loader_width | append: 'x' -%}

    <div class="splash-screen">
      {% if settings.logo_loader_image != blank %}
        <div class="splash-screen__loader">
          <img
            class="loader-logo__img"
            src="{{ settings.logo_loader_image | img_url: loader_size }}"
            srcset="{{ settings.logo_loader_image | img_url: loader_size }} 1x, {{ settings.logo_loader_image | img_url: loader_size, scale: 2 }} 2x"
            aria-hidden="true">
        </div>
      {% else %}
        <span class="loader-text">{{ 'general.accessibility.loading' | t }}</span>
      {% endif %}
    </div>

    <a class="in-page-link visually-hidden skip-link" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    <div id="PageContainer" class="page-container">
      <div class="transition-body">
        {% section 'header' %}

        <main class="main-content" id="MainContent">
          {{ content_for_layout }}
        </main>

        {% section 'social' %}
        {% section 'footer' %}
      </div>
    </div>

    {% section 'newsletter-popup' %}

    {% include 'video-modal' %}
    {% if settings.animate_page_transition_style == 'page-logo' %}
      <div class="loader-logo">
        {% if settings.logo_loader_image != blank %}
          <div class="splash-screen__loader">
            <img
              class="loader-logo__img"
              src="{{ settings.logo_loader_image | img_url: loader_size }}"
              srcset="{{ settings.logo_loader_image | img_url: loader_size }} 1x, {{ settings.logo_loader_image | img_url: loader_size, scale: 2 }} 2x"
              aria-hidden="true">
          </div>
        {% else %}
          <span class="loader-text">{{ 'general.accessibility.loading' | t }}</span>
        {% endif %}
      </div>
    {% endif %}
  </div>
  <div id="ProductScreens"></div>
  {% include 'photoswipe-template' %}
  {% if settings.cart_type == 'drawer' %}
    {% include 'cart-drawer' %}
  {% endif %}

  <script>
    (function() {
      var cartCopyPattern = /Add\s+(\d+)\s+more\s+items?\s+and\s+save\s+\$(\d+)/gi;
      var ignoredTags = /^(SCRIPT|STYLE|NOSCRIPT|TEXTAREA)$/;
      var observedRoots = typeof WeakSet !== 'undefined' ? new WeakSet() : null;
      var appColors = {
        mint: '#63d6bf',
        mintHover: '#4fc5ae',
        mintSoft: '#eaf7f3',
        mintWash: '#f3fbf8',
        ink: '#102522',
        dark: '#16312d',
        darkHover: '#12302b',
        text: '#202225',
        muted: '#6b6f85',
        success: '#2b8f7f',
        border: 'rgba(89, 183, 167, 0.2)'
      };

      function normalizeCartCopy(value) {
        return value.replace(cartCopyPattern, function(match, count, save) {
          return 'Add ' + count + ' more to save $' + save;
        });
      }

      function fixTextNode(node) {
        if (!node || !node.nodeValue || node.nodeValue.toLowerCase().indexOf('more item') === -1) return;
        node.nodeValue = normalizeCartCopy(node.nodeValue);
      }

      function setImportantStyle(el, name, value) {
        if (!el || !el.style) return;
        try {
          el.style.setProperty(name, value, 'important');
        } catch (e) {
          el.style.setProperty(name, value);
        }
      }

      function applyUpCartColors() {
        var popup = document.getElementById('UpcartPopup');
        if (!popup) return;

        var vars = {
          '--upcart-internal-global-button-background-color': appColors.mint,
          '--upcart-internal-global-button-text-color': appColors.ink,
          '--upcart-internal-global-button-text-hover-color': appColors.ink,
          '--upcart-internal-header-background-color': appColors.dark,
          '--upcart-internal-header-close-button-icon-color': '#ffffff',
          '--upcart-internal-header-close-button-icon-color-hover': '#ffffff',
          '--upcart-internal-announcements-bg-color': appColors.mintSoft,
          '--upcart-internal-announcements-border-color': appColors.border,
          '--upcart-internal-design-accent-color': appColors.mintSoft,
          '--upcart-internal-design-savings-text-color': appColors.success,
          '--upcart-internal-component-progress-bar-background-color': '#d9eee9',
          '--upcart-internal-component-progress-bar-foreground-color': appColors.mint,
          '--upcart-internal-component-progress-bar-icon-color-complete': appColors.ink
        };

        Object.keys(vars).forEach(function(name) {
          setImportantStyle(popup, name, vars[name]);
        });
      }

      function applyCandyRackFrameColors(frame) {
        if (!frame || frame.__zenkaiCandyRackBound === 'blocked') return;

        function apply() {
          var doc;
          try {
            doc = frame.contentDocument || (frame.contentWindow && frame.contentWindow.document);
          } catch (e) {
            frame.__zenkaiCandyRackBound = 'blocked';
            return;
          }
          if (!doc || !doc.documentElement) return;

          var vars = {
            '--add-button-background-color-1': appColors.mint,
            '--add-button-background-color-2': appColors.mintHover,
            '--add-button-background-color-3': '#bff0e6',
            '--add-button-background-color-5': appColors.mintWash,
            '--add-button-text-color': appColors.ink,
            '--add-button-border-color-1': appColors.mint,
            '--add-button-border-color-2': appColors.mintHover,
            '--add-button-border-color-3': '#bff0e6',
            '--continue-to-button-background-color-1': appColors.dark,
            '--continue-to-button-background-color-2': appColors.darkHover,
            '--continue-to-button-background-color-3': '#b8d4cd',
            '--continue-to-button-background-color-5': appColors.mintSoft,
            '--continue-to-button-text-color': '#ffffff',
            '--continue-to-button-border-color-1': appColors.dark,
            '--continue-to-button-border-color-2': appColors.darkHover,
            '--continue-to-button-border-color-3': '#b8d4cd',
            '--reject-button-background-color-1': appColors.text,
            '--reject-button-background-color-2': appColors.muted,
            '--reject-button-background-color-3': '#d7dbe3',
            '--reject-button-text-color': '#ffffff',
            '--primary-color-1': appColors.mint,
            '--primary-color-2': appColors.mintHover,
            '--primary-color-3': '#bff0e6',
            '--primary-color-5': appColors.mintWash,
            '--readable-primary-color': appColors.ink
          };

          Object.keys(vars).forEach(function(name) {
            setImportantStyle(doc.documentElement, name, vars[name]);
          });

          if (!doc.getElementById('zenkai-candyrack-colors')) {
            var style = doc.createElement('style');
            style.id = 'zenkai-candyrack-colors';
            style.textContent = [
              ':root {',
              '  --add-button-background-color-1: ' + appColors.mint + ' !important;',
              '  --add-button-background-color-2: ' + appColors.mintHover + ' !important;',
              '  --add-button-text-color: ' + appColors.ink + ' !important;',
              '  --add-button-border-color-1: ' + appColors.mint + ' !important;',
              '  --add-button-border-color-2: ' + appColors.mintHover + ' !important;',
              '  --continue-to-button-background-color-1: ' + appColors.dark + ' !important;',
              '  --continue-to-button-background-color-2: ' + appColors.darkHover + ' !important;',
              '  --continue-to-button-text-color: #ffffff !important;',
              '  --continue-to-button-border-color-1: ' + appColors.dark + ' !important;',
              '  --continue-to-button-border-color-2: ' + appColors.darkHover + ' !important;',
              '}',
              '.bg-addButtonBackgroundColor-1, .hover\\:bg-addButtonBackgroundColor-2:hover, .Button-Add { background-color: ' + appColors.mint + ' !important; }',
              '.border-addButtonBorderColor-1, .hover\\:border-addButtonBorderColor-2:hover { border-color: ' + appColors.mint + ' !important; }',
              '.text-readableAddButtonTextColor { color: ' + appColors.ink + ' !important; }',
              '.bg-continueToButtonBackgroundColor-1, .hover\\:bg-continueToButtonBackgroundColor-2:hover { background-color: ' + appColors.dark + ' !important; }',
              '.border-continueToButtonBorderColor-1, .hover\\:border-continueToButtonBorderColor-2:hover { border-color: ' + appColors.dark + ' !important; }',
              '.text-readableContinueToButtonTextColor { color: #ffffff !important; }',
              'button { letter-spacing: 0.02em; }'
            ].join('\n');
            (doc.head || doc.documentElement).appendChild(style);
          }
        }

        apply();
        if (!frame.__zenkaiCandyRackBound) {
          frame.__zenkaiCandyRackBound = 'bound';
          frame.addEventListener('load', function() {
            apply();
            window.setTimeout(apply, 150);
            window.setTimeout(apply, 500);
          });
        }
      }

      function applyCandyRackColors(root) {
        var frames = [];
        if (root && root.nodeType === 1 && root.matches && root.matches('#candyrack-frame')) {
          frames.push(root);
        }
        if (root && root.querySelectorAll) {
          root.querySelectorAll('#candyrack-frame').forEach(function(frame) {
            frames.push(frame);
          });
        }
        frames.forEach(applyCandyRackFrameColors);
      }

      function applyThirdPartyStyles(root) {
        applyUpCartColors();
        applyCandyRackColors(root || document);
      }

      function observeRoot(root) {
        if (!root || !root.querySelectorAll) return;
        if (observedRoots && observedRoots.has(root)) return;
        if (observedRoots) observedRoots.add(root);

        var observer = new MutationObserver(function(mutations) {
          mutations.forEach(function(mutation) {
            if (mutation.type === 'characterData') {
              fixTextNode(mutation.target);
              return;
            }
            mutation.addedNodes.forEach(scan);
          });
          applyThirdPartyStyles(root);
        });
        observer.observe(root, { childList: true, characterData: true, subtree: true });
      }

      function scan(root) {
        if (!root) return;
        if (root.nodeType === 3) {
          fixTextNode(root);
          return;
        }
        if (root.nodeType !== 1 && root.nodeType !== 9 && root.nodeType !== 11) return;

        var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
          acceptNode: function(node) {
            var parent = node.parentElement;
            if (!parent || ignoredTags.test(parent.tagName)) return NodeFilter.FILTER_REJECT;
            return node.nodeValue.indexOf('more item') >= 0 ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_SKIP;
          }
        });
        var textNode;
        while ((textNode = walker.nextNode())) {
          fixTextNode(textNode);
        }

        if (root.querySelectorAll) {
          applyThirdPartyStyles(root);
          root.querySelectorAll('*').forEach(function(el) {
            if (el.shadowRoot) {
              observeRoot(el.shadowRoot);
              scan(el.shadowRoot);
            }
          });
        }
      }

      function startCartCopyObserver() {
        scan(document.body);
        observeRoot(document.body);
        [250, 500, 1000, 2000, 4000].forEach(function(delay) {
          window.setTimeout(function() {
            scan(document.body);
            applyThirdPartyStyles(document);
          }, delay);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', startCartCopyObserver);
      } else {
        startCartCopyObserver();
      }
    })();
  </script>

  {{ 'pinch-zoom-fix.js' | asset_url | script_tag }}

</body>
</html>
