    {%- if zenkai_collectible_focus_context -%}
      <script>
        (function() {
          var selectors = [
            '.klaviyo-form',
            '[class*="klaviyo-form"]',
            '[class*="kl-private-reset-css"]',
            '[data-testid*="klaviyo" i]',
            'iframe[title*="klaviyo" i]',
            '[id*="smartsize" i]',
            '[class*="smartsize" i]',
            '[data-smartsize]',
            '[aria-label*="size guide" i]',
            '#aftersell-pdp-upsell',
            '#candyrack-frame',
            'iframe[src*="candyrack" i]'
          ];

          function suppressCollectibleDistractions(root) {
            var scope = root && root.querySelectorAll ? root : document;
            selectors.forEach(function(selector) {
              if (scope.matches && scope.matches(selector)) {
                scope.hidden = true;
                scope.setAttribute('aria-hidden', 'true');
              }
              scope.querySelectorAll(selector).forEach(function(node) {
                node.hidden = true;
                node.setAttribute('aria-hidden', 'true');
              });
            });

            if (scope.matches && scope.matches('button, a') && (scope.textContent || '').trim().toLowerCase() === 'view size guide') {
              scope.hidden = true;
              scope.setAttribute('aria-hidden', 'true');
            }
            scope.querySelectorAll('button, a').forEach(function(node) {
              if ((node.textContent || '').trim().toLowerCase() === 'view size guide') {
                node.hidden = true;
                node.setAttribute('aria-hidden', 'true');
              }
            });
          }

          suppressCollectibleDistractions(document);
          if ('MutationObserver' in window) {
            new MutationObserver(function(mutations) {
              mutations.forEach(function(mutation) {
                mutation.addedNodes.forEach(function(node) {
                  if (node.nodeType === 1) suppressCollectibleDistractions(node);
                });
              });
            }).observe(document.body, { childList: true, subtree: true });
          }
        })();
      </script>
    {%- endif -%}

