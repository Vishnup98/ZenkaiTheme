  <script>
    (function() {
      var cartCopyPattern = /Add\s+(\d+)\s+more\s+items?\s+and\s+save\s+\$(\d+)/gi;
      var ignoredTags = /^(SCRIPT|STYLE|NOSCRIPT|TEXTAREA)$/;
      var observedRoots = typeof WeakSet !== 'undefined' ? new WeakSet() : null;
      var suppressGenericUpsells = {{ zenkai_collectible_focus_context | json }};
      var appColors = {
        mint: '#63d6bf',
        mintHover: '#4fc5ae',
        mintSoft: '#eaf7f3',
        mintWash: '#f3fbf8',
        ink: '#102522',
        dark: '#16312d',
        darkHover: '#12302b',
        text: '#202225',
        muted: '#6b6f85',
        success: '#2b8f7f',
        border: 'rgba(89, 183, 167, 0.2)'
      };

      function normalizeCartCopy(value) {
        return value.replace(cartCopyPattern, function(match, count, save) {
          return 'Add ' + count + ' more to save $' + save;
        });
      }

      function fixTextNode(node) {
        if (!node || !node.nodeValue || node.nodeValue.toLowerCase().indexOf('more item') === -1) return;
        node.nodeValue = normalizeCartCopy(node.nodeValue);
      }

      function setImportantStyle(el, name, value) {
        if (!el || !el.style) return;
        try {
          el.style.setProperty(name, value, 'important');
        } catch (e) {
          el.style.setProperty(name, value);
        }
      }

      function forEachMatch(root, selector, callback) {
        if (!root) return;
        if (root.nodeType === 1 && root.matches && root.matches(selector)) callback(root);
        if (root.querySelectorAll) {
          root.querySelectorAll(selector).forEach(callback);
        }
      }

      function applyUpCartColors(root) {
        root = root || document;

        var vars = {
          '--upcart-internal-global-button-background-color': appColors.mint,
          '--upcart-internal-global-button-text-color': appColors.ink,
          '--upcart-internal-global-button-text-hover-color': appColors.ink,
          '--upcart-internal-header-background-color': appColors.dark,
          '--upcart-internal-header-close-button-icon-color': '#ffffff',
          '--upcart-internal-header-close-button-icon-color-hover': '#ffffff',
          '--upcart-internal-announcements-bg-color': appColors.mintSoft,
          '--upcart-internal-announcements-border-color': appColors.border,
          '--upcart-internal-design-accent-color': appColors.mintSoft,
          '--upcart-internal-design-savings-text-color': appColors.success,
          '--upcart-internal-component-progress-bar-background-color': '#d9eee9',
          '--upcart-internal-component-progress-bar-foreground-color': appColors.mint,
          '--upcart-internal-component-progress-bar-icon-color-complete': appColors.ink
        };

        forEachMatch(root, '#upCart, #UpcartPopup, #CartPopup', function(el) {
          Object.keys(vars).forEach(function(name) {
            setImportantStyle(el, name, vars[name]);
          });
        });

        if (suppressGenericUpsells) {
          forEachMatch(
            root,
            '.upcart-internal-rewards, .upcart-public-rewards',
            function(rewards) {
              setImportantStyle(rewards, 'display', 'none');
              rewards.hidden = true;
              rewards.setAttribute('aria-hidden', 'true');
            }
          );
        }

        forEachMatch(root, [
          '#upCart .upcart-checkout-button',
          '#UpcartPopup .upcart-checkout-button',
          '#CartPopup .upcart-checkout-button',
          '#upCart .upcart-internal-component__button',
          '#UpcartPopup .upcart-internal-component__button',
          '#CartPopup .upcart-internal-component__button',
          '#upCart .upcart-public-component__button',
          '#UpcartPopup .upcart-public-component__button',
          '#CartPopup .upcart-public-component__button'
        ].join(','), function(button) {
          setImportantStyle(button, 'background', appColors.mint);
          setImportantStyle(button, 'background-color', appColors.mint);
          setImportantStyle(button, 'border-color', appColors.mint);
          setImportantStyle(button, 'color', appColors.ink);
        });

        forEachMatch(root, [
          '#upCart .upcart-internal-header',
          '#UpcartPopup .upcart-internal-header',
          '#CartPopup .upcart-internal-header',
          '#upCart .upcart-public-header',
          '#UpcartPopup .upcart-public-header',
          '#CartPopup .upcart-public-header'
        ].join(','), function(header) {
          setImportantStyle(header, 'background', appColors.dark);
          setImportantStyle(header, 'background-color', appColors.dark);
        });

        forEachMatch(root, [
          '#upCart .upcart-internal-announcement',
          '#UpcartPopup .upcart-internal-announcement',
          '#CartPopup .upcart-internal-announcement',
          '#upCart .upcart-public-announcement',
          '#UpcartPopup .upcart-public-announcement',
          '#CartPopup .upcart-public-announcement'
        ].join(','), function(announcement) {
          setImportantStyle(announcement, 'background', appColors.mintSoft);
          setImportantStyle(announcement, 'background-color', appColors.mintSoft);
          setImportantStyle(announcement, 'border-color', appColors.border);
          setImportantStyle(announcement, 'color', appColors.dark);
        });

        forEachMatch(root, [
          '#upCart .upcart-internal-component-segmented-progress-bar__segment-fill',
          '#UpcartPopup .upcart-internal-component-segmented-progress-bar__segment-fill',
          '#CartPopup .upcart-internal-component-segmented-progress-bar__segment-fill',
          '#upCart .upcart-public-component-segmented-progress-bar__segment-fill',
          '#UpcartPopup .upcart-public-component-segmented-progress-bar__segment-fill',
          '#CartPopup .upcart-public-component-segmented-progress-bar__segment-fill'
        ].join(','), function(fill) {
          setImportantStyle(fill, 'background', appColors.mint);
          setImportantStyle(fill, 'background-color', appColors.mint);
        });

        forEachMatch(root, [
          '#upCart .upcart-internal-rewards__message',
          '#UpcartPopup .upcart-internal-rewards__message',
          '#CartPopup .upcart-internal-rewards__message',
          '#upCart .upcart-public-rewards__message',
          '#UpcartPopup .upcart-public-rewards__message',
          '#CartPopup .upcart-public-rewards__message'
        ].join(','), function(message) {
          setImportantStyle(message, 'color', appColors.text);
          setImportantStyle(message, 'font-weight', '700');
        });
      }

      function applyCandyRackCopy(doc) {
        if (!doc || !doc.body) return;

        var titleParent = null;
        var filter = doc.defaultView && doc.defaultView.NodeFilter ? doc.defaultView.NodeFilter : window.NodeFilter;
        var walker = doc.createTreeWalker(doc.body, filter.SHOW_TEXT, {
          acceptNode: function(node) {
            var parent = node.parentElement;
            if (!parent || ignoredTags.test(parent.tagName)) return filter.FILTER_REJECT;
            var text = node.nodeValue.replace(/\s+/g, ' ').trim();
            return /Get extras for your product|Complete your bundle/i.test(text) ? filter.FILTER_ACCEPT : filter.FILTER_SKIP;
          }
        });
        var node;
        while ((node = walker.nextNode())) {
          if (/Get extras for your product/i.test(node.nodeValue)) {
            node.nodeValue = node.nodeValue.replace(/Get extras for your product/i, 'Complete your bundle');
          }
          if (!titleParent && /Complete your bundle/i.test(node.nodeValue)) {
            titleParent = node.parentElement;
          }
        }

        if (titleParent && !doc.getElementById('zenkai-candyrack-subcopy')) {
          var subcopy = doc.createElement('p');
          subcopy.id = 'zenkai-candyrack-subcopy';
          subcopy.textContent = 'Add one more favorite and unlock your next bundle discount.';
          subcopy.style.margin = '0.2rem auto 1rem';
          subcopy.style.maxWidth = '32rem';
          subcopy.style.color = appColors.muted;
          subcopy.style.fontSize = '1.3rem';
          subcopy.style.fontWeight = '600';
          subcopy.style.lineHeight = '1.35';
          subcopy.style.textAlign = 'center';
          titleParent.insertAdjacentElement('afterend', subcopy);
        }
      }

      function applyCandyRackFrameColors(frame) {
        if (!frame || frame.__zenkaiCandyRackBound === 'blocked') return;

        function apply() {
          var doc;
          try {
            doc = frame.contentDocument || (frame.contentWindow && frame.contentWindow.document);
          } catch (e) {
            frame.__zenkaiCandyRackBound = 'blocked';
            return;
          }
          if (!doc || !doc.documentElement) return;

          var vars = {
            '--add-button-background-color-1': appColors.mint,
            '--add-button-background-color-2': appColors.mintHover,
            '--add-button-background-color-3': '#bff0e6',
            '--add-button-background-color-5': appColors.mintWash,
            '--add-button-text-color': appColors.ink,
            '--add-button-border-color-1': appColors.mint,
            '--add-button-border-color-2': appColors.mintHover,
            '--add-button-border-color-3': '#bff0e6',
            '--continue-to-button-background-color-1': appColors.dark,
            '--continue-to-button-background-color-2': appColors.darkHover,
            '--continue-to-button-background-color-3': '#b8d4cd',
            '--continue-to-button-background-color-5': appColors.mintSoft,
            '--continue-to-button-text-color': '#ffffff',
            '--continue-to-button-border-color-1': appColors.dark,
            '--continue-to-button-border-color-2': appColors.darkHover,
            '--continue-to-button-border-color-3': '#b8d4cd',
            '--reject-button-background-color-1': appColors.text,
            '--reject-button-background-color-2': appColors.muted,
            '--reject-button-background-color-3': '#d7dbe3',
            '--reject-button-text-color': '#ffffff',
            '--primary-color-1': appColors.mint,
            '--primary-color-2': appColors.mintHover,
            '--primary-color-3': '#bff0e6',
            '--primary-color-5': appColors.mintWash,
            '--readable-primary-color': appColors.ink
          };

          Object.keys(vars).forEach(function(name) {
