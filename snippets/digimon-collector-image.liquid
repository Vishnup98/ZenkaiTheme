{%- assign image_base = 'digimon-crest-' | append: name -%}
{%- assign image_small = image_base | append: '-640.webp' -%}
{%- assign image_large = image_base | append: '-1254.webp' -%}
<img src="{{ image_large | asset_url }}" srcset="{{ image_small | asset_url }} 640w, {{ image_large | asset_url }} 1254w" sizes="{{ sizes | default: '(max-width: 749px) 100vw, 50vw' }}" width="1254" height="1254" alt="{{ alt | escape }}" loading="{{ loading | default: 'lazy' }}" {% if loading == 'eager' %}fetchpriority="high"{% endif %}>
