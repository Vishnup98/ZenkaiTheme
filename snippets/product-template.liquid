<div
  id="ProductSection-{{ section_id }}"
  class="product-section"
  data-section-id="{{ section_id }}"
  data-section-type="product-template"
  data-product-category="{{ zenkai_product_category }}"
  data-product-cta-default="{{ zenkai_cta_text | escape }}"
  data-sticky-trigger-ratio="{{ zenkai_sticky_atc_trigger_ratio }}"
  {% if isModal %}data-subsection{% endif %}
  data-variant-type="{{ variant_type }}"
  {% if inventory_enable %}data-inventory="true" data-inventory-threshold="{{ inventory_threshold }}"{% endif %}
  {% if inventory_transfers_enable %}data-incoming-inventory="true"{% endif %}
  {% if product_image_type == 'stacked' %}data-images-stacked="true"{% endif %}
  data-video-style="{{ video_style }}"
  {% unless isModal %}data-enable-history-state="true"{% endunless %}
>
  <div class="page-content">
    <div class="page-width">
      <nav aria-label="breadcrumb" class="zenkai-breadcrumb{% if zenkai_hide_mobile_breadcrumbs %} zenkai-breadcrumb--mobile-hidden{% endif %}">
        <ol class="zenkai-breadcrumb__list">
          <li>
            <a href="/" class="zenkai-breadcrumb__link">Home</a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a href="/collections/all" class="zenkai-breadcrumb__link">All products</a>
          </li>
          <li aria-hidden="true">/</li>
          <li>{{ product.title | truncate: 34 }}</li>
        </ol>
      </nav>

      <div class="grid">
        <div class="grid__item {{ product_image_width }}">
          {% include 'product-images',
            section_id: section_id,
            isModal: isModal,
            video_looping: video_looping,
            video_style: video_style
          %}

          <button type="button" class="zenkai-zoom-hint" aria-label="Zoom image">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
              <line x1="11" y1="8" x2="11" y2="14"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
            Zoom
          </button>
        </div>

        <div class="grid__item {{ product_description_width }} product-single__sticky">
          <div class="product-single__meta">
            <div class="product-single__header small--text-center">
              {% if settings.vendor_enable %}
                <div class="product-single__vendor">{{ product.vendor }}</div>
              {% endif %}

              <p class="zenkai-signal-hook">{{ zenkai_signal_hook }}</p>

              {% if isModal %}
                <p class="h2 product-single__title">{{ product.title }}</p>
              {% else %}
                <h1 class="h2 product-single__title">{{ product.title }}</h1>
              {% endif %}

              {% if zenkai_social_subheadline != blank %}
                <p class="zenkai-social-subheadline">{{ zenkai_social_subheadline }}</p>
              {% endif %}

              {% if product_show_review_summary_first %}
                <div class="zenkai-hero-proof-row">
                  <div class="zenkai-review-badge zenkai-review-badge--title" data-zenkai-review-clone="title"></div>
                </div>
              {% endif %}

              <div class="zenkai-price-band">
                <div class="product-single__prices" data-price-wrapper>
                  {% if current_variant.compare_at_price > current_variant.price %}
                    <span class="product__price product__price--compare" data-product-price-compare>
                      {% if zenkai_current_variant_is_collector %}
                        {{ 11996 | money }}
                      {% else %}
                        {{ current_variant.compare_at_price | money }}
                      {% endif %}
                    </span>
                  {% endif %}

                  <span class="product__price{% if current_variant.compare_at_price > current_variant.price %} sale-price{% endif %}" data-product-price>
                    {{ current_variant.price | money }}
                  </span>

                  {% if current_variant.compare_at_price > current_variant.price %}
                    <span class="you-save">
                      {% if zenkai_current_variant_is_collector %}
                        Save $20
                      {% else %}
                        Save {{ current_variant.compare_at_price | minus: current_variant.price | money }}
                      {% endif %}
                    </span>
                  {% endif %}
                </div>
              </div>

              <div class="zenkai-paid-proof-strip" aria-label="Order confidence">
                <span class="zenkai-paid-proof-strip__item">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  2,200+ orders shipped
                </span>
                <span class="zenkai-paid-proof-strip__item">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                  Free U.S. shipping
                </span>
                {% unless zenkai_product_category == 'pin' %}
                  <span class="zenkai-paid-proof-strip__item">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 4 5v7c0 5 3.5 8.5 8 10 4.5-1.5 8-5 8-10V5l-8-3z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>
                    30-day first-item guarantee
                  </span>
                {% endunless %}
              </div>

              {% include 'product-type-switcher' %}
            </div>

            <div class="zenkai-conversion-stack">
              {% unless isModal %}
                {% include 'product-form',
                  section_id: section_id,
                  variant_type: variant_type,
                  variant_labels_enable: variant_labels_enable,
                  quantity_enable: quantity_enable,
                  enable_payment_button: enable_payment_button,
                  product_cta_text: zenkai_cta_text,
                  product_cta_note: zenkai_cta_subcopy,
                  product_cta_subcopy: zenkai_cta_subcopy,
                  show_dynamic_checkout_secondary: zenkai_secondary_checkout
                %}
              {% else %}
                <div id="ProductFormPlaceholder-{{ section_id }}" data-url="{{ product.url | within: collection }}" data-template="{{ product.template_suffix }}" class="product-form-holder">
                  {% if product.options.size > 0 %}
                    {% for i in (1..product.options.size) %}
                      <div class="placeholder-content" style="min-height: 78px; max-width: 66%;"></div>
                    {% endfor %}
                  {% endif %}
                  <div class="placeholder-content" style="min-height: 78px;"></div>
                </div>
              {% endunless %}

              <div class="zenkai-sticky-sentinel" data-sticky-sentinel aria-hidden="true"></div>

              {% if has_ugc %}
                <section class="zenkai-ugc-gallery zenkai-ugc-gallery--mobile" aria-label="{{ zenkai_ugc_heading }}">
                  <h2 class="zenkai-ugc-heading">{{ zenkai_ugc_heading }}</h2>
                  <div class="zenkai-ugc-carousel" data-ugc-carousel>
                    <div class="zenkai-ugc-track" data-ugc-track>
                      {%- for block in section.blocks -%}
                        {%- if block.type == 'ugc_photo' and block.settings.image != blank -%}
                          <div class="zenkai-ugc-card" {{ block.shopify_attributes }}>
                            <img
                              srcset="{{ block.settings.image | img_url: '300x400', crop: 'center' }} 300w,
                                     {{ block.settings.image | img_url: '450x600', crop: 'center' }} 450w,
                                     {{ block.settings.image | img_url: '600x800', crop: 'center' }} 600w"
                              sizes="72vw"
                              src="{{ block.settings.image | img_url: '450x600', crop: 'center' }}"
                              alt="{{ block.settings.caption | default: zenkai_ugc_alt | escape }}"
                              loading="lazy"
                              width="450"
                              height="600"
                            >
                            {% if block.settings.caption != blank %}
                              <div class="zenkai-ugc-card__overlay">
                                <p class="zenkai-ugc-card__caption">{{ block.settings.caption }}</p>
                              </div>
                            {% endif %}
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                    <button type="button" class="zenkai-ugc-arrow zenkai-ugc-arrow--prev" data-ugc-prev aria-label="Previous photos" hidden>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    </button>
                    <button type="button" class="zenkai-ugc-arrow zenkai-ugc-arrow--next" data-ugc-next aria-label="Next photos" hidden>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </button>
                  </div>
                </section>
              {% endif %}

              {% unless zenkai_product_category == 'pin' %}
                {% include 'bundle-callout', bundle_slot: 'mobile' %}
              {% endunless %}

              {%- for block in section.blocks -%}
                {%- case block.type -%}
                  {%- when '@app' -%}
                    <div class="zenkai-app-block" {{ block.shopify_attributes }}>
                      {% render block %}
                    </div>
                {%- endcase -%}
              {%- endfor -%}

              {% if social_enable %}
                {% include 'social-sharing',
                  share_title: product.title,
                  share_permalink: product.url,
                  share_image: product
                %}
              {% endif %}
            </div>
          </div>
        </div>
      </div>

      <div class="zenkai-pdp-below">
        {% if zenkai_product_category == 'pin' %}
          {%- assign zenkai_has_pin_story = false -%}
          {%- if zenkai_pin_collector_image_desktop != blank or zenkai_pin_collector_image_mobile != blank or zenkai_pin_quality_image_desktop != blank or zenkai_pin_quality_image_mobile != blank or zenkai_pin_lifestyle_image_desktop != blank or zenkai_pin_lifestyle_image_mobile != blank -%}
            {%- assign zenkai_has_pin_story = true -%}
          {%- endif -%}

          {% if zenkai_has_pin_story %}
            <section class="zenkai-pin-story" aria-label="Collector pack details">
              {% if zenkai_pin_collector_image_desktop != blank or zenkai_pin_collector_image_mobile != blank %}
                {%- assign zenkai_pin_collector_image = zenkai_pin_collector_image_desktop -%}
                {%- if zenkai_pin_collector_image == blank -%}
                  {%- assign zenkai_pin_collector_image = zenkai_pin_collector_image_mobile -%}
                {%- endif -%}
                <article class="zenkai-pin-story-card zenkai-pin-story-card--featured">
                  <div class="zenkai-pin-story-card__media">
                    <picture>
                      {% if zenkai_pin_collector_image_mobile != blank %}
                        <source media="(max-width: 767px)" srcset="{{ zenkai_pin_collector_image_mobile | image_url: width: 1200 }}">
                      {% endif %}
                      <img
                        src="{{ zenkai_pin_collector_image | image_url: width: 1800 }}"
                        alt="{{ zenkai_pin_collector_heading | escape }}"
                        loading="lazy"
                        width="{{ zenkai_pin_collector_image.width }}"
                        height="{{ zenkai_pin_collector_image.height }}">
                    </picture>
                  </div>
                  <div class="zenkai-pin-story-card__copy">
                    <p class="zenkai-pin-story-card__kicker">{{ zenkai_pin_collector_kicker }}</p>
                    <h2 class="zenkai-pin-story-card__heading">{{ zenkai_pin_collector_heading }}</h2>
                    <p class="zenkai-pin-story-card__body">{{ zenkai_pin_collector_body }}</p>
                  </div>
                </article>
              {% endif %}

              {% if zenkai_pin_quality_image_desktop != blank or zenkai_pin_quality_image_mobile != blank or zenkai_pin_lifestyle_image_desktop != blank or zenkai_pin_lifestyle_image_mobile != blank %}
                <div class="zenkai-pin-story__grid">
                  {% if zenkai_pin_quality_image_desktop != blank or zenkai_pin_quality_image_mobile != blank %}
                    {%- assign zenkai_pin_quality_image = zenkai_pin_quality_image_desktop -%}
                    {%- if zenkai_pin_quality_image == blank -%}
                      {%- assign zenkai_pin_quality_image = zenkai_pin_quality_image_mobile -%}
                    {%- endif -%}
                    <article class="zenkai-pin-story-card zenkai-pin-story-card--quality">
                      <div class="zenkai-pin-story-card__media">
                        <picture>
                          {% if zenkai_pin_quality_image_mobile != blank %}
                            <source media="(max-width: 767px)" srcset="{{ zenkai_pin_quality_image_mobile | image_url: width: 1000 }}">
                          {% endif %}
                          <img
                            src="{{ zenkai_pin_quality_image | image_url: width: 1200 }}"
                            alt="{{ zenkai_pin_quality_heading | escape }}"
                            loading="lazy"
                            width="{{ zenkai_pin_quality_image.width }}"
                            height="{{ zenkai_pin_quality_image.height }}">
                        </picture>
                      </div>
                      <div class="zenkai-pin-story-card__copy">
                        <p class="zenkai-pin-story-card__kicker">{{ zenkai_pin_quality_kicker }}</p>
                        <h2 class="zenkai-pin-story-card__heading">{{ zenkai_pin_quality_heading }}</h2>
                        <p class="zenkai-pin-story-card__body">{{ zenkai_pin_quality_body }}</p>
                      </div>
                    </article>
                  {% endif %}

                  {% if zenkai_pin_lifestyle_image_desktop != blank or zenkai_pin_lifestyle_image_mobile != blank %}
                    {%- assign zenkai_pin_lifestyle_image = zenkai_pin_lifestyle_image_desktop -%}
                    {%- if zenkai_pin_lifestyle_image == blank -%}
                      {%- assign zenkai_pin_lifestyle_image = zenkai_pin_lifestyle_image_mobile -%}
                    {%- endif -%}
                    <article class="zenkai-pin-story-card zenkai-pin-story-card--lifestyle">
                      <div class="zenkai-pin-story-card__media">
                        <picture>
                          {% if zenkai_pin_lifestyle_image_mobile != blank %}
                            <source media="(max-width: 767px)" srcset="{{ zenkai_pin_lifestyle_image_mobile | image_url: width: 1000 }}">
                          {% endif %}
                          <img
                            src="{{ zenkai_pin_lifestyle_image | image_url: width: 1200 }}"
                            alt="{{ zenkai_pin_lifestyle_heading | escape }}"
                            loading="lazy"
                            width="{{ zenkai_pin_lifestyle_image.width }}"
                            height="{{ zenkai_pin_lifestyle_image.height }}">
                        </picture>
                      </div>
                      <div class="zenkai-pin-story-card__copy">
                        <p class="zenkai-pin-story-card__kicker">{{ zenkai_pin_lifestyle_kicker }}</p>
                        <h2 class="zenkai-pin-story-card__heading">{{ zenkai_pin_lifestyle_heading }}</h2>
                        <p class="zenkai-pin-story-card__body">{{ zenkai_pin_lifestyle_body }}</p>
                      </div>
                    </article>
                  {% endif %}
                </div>
              {% endif %}
            </section>
          {% endif %}

          {%- assign zenkai_has_manual_reviews = false -%}
          {%- if zenkai_manual_review_quote_1 != blank or zenkai_manual_review_quote_2 != blank or zenkai_manual_review_quote_3 != blank -%}
            {%- assign zenkai_has_manual_reviews = true -%}
          {%- endif -%}

          {% if zenkai_has_manual_reviews %}
            <section class="zenkai-manual-reviews" aria-label="{{ zenkai_manual_reviews_heading | escape }}">
              <div class="zenkai-manual-reviews__header">
                <p class="zenkai-manual-reviews__kicker">Real collector notes</p>
                <h2 class="zenkai-manual-reviews__heading">{{ zenkai_manual_reviews_heading }}</h2>
              </div>
              <div class="zenkai-manual-reviews__grid">
                {% if zenkai_manual_review_quote_1 != blank %}
                  <figure class="zenkai-manual-review">
                    <blockquote class="zenkai-manual-review__quote">{{ zenkai_manual_review_quote_1 }}</blockquote>
                    <figcaption class="zenkai-manual-review__meta">
                      <span class="zenkai-manual-review__name">{{ zenkai_manual_review_name_1 | default: 'Verified buyer' }}</span>
                      {% if zenkai_manual_review_meta_1 != blank %}<span class="zenkai-manual-review__detail">{{ zenkai_manual_review_meta_1 }}</span>{% endif %}
                    </figcaption>
                  </figure>
                {% endif %}
                {% if zenkai_manual_review_quote_2 != blank %}
                  <figure class="zenkai-manual-review">
                    <blockquote class="zenkai-manual-review__quote">{{ zenkai_manual_review_quote_2 }}</blockquote>
                    <figcaption class="zenkai-manual-review__meta">
                      <span class="zenkai-manual-review__name">{{ zenkai_manual_review_name_2 | default: 'Verified buyer' }}</span>
                      {% if zenkai_manual_review_meta_2 != blank %}<span class="zenkai-manual-review__detail">{{ zenkai_manual_review_meta_2 }}</span>{% endif %}
                    </figcaption>
                  </figure>
                {% endif %}
                {% if zenkai_manual_review_quote_3 != blank %}
                  <figure class="zenkai-manual-review">
                    <blockquote class="zenkai-manual-review__quote">{{ zenkai_manual_review_quote_3 }}</blockquote>
                    <figcaption class="zenkai-manual-review__meta">
                      <span class="zenkai-manual-review__name">{{ zenkai_manual_review_name_3 | default: 'Verified buyer' }}</span>
                      {% if zenkai_manual_review_meta_3 != blank %}<span class="zenkai-manual-review__detail">{{ zenkai_manual_review_meta_3 }}</span>{% endif %}
                    </figcaption>
                  </figure>
                {% endif %}
              </div>
            </section>
          {% endif %}
        {% endif %}

        {% unless zenkai_product_category == 'pin' %}
          <aside class="zenkai-brand-quote" aria-label="Brand story">
            <p class="zenkai-brand-quote__text">Original designs. Familiar energy. Made to feel like real clothes.</p>
            <p class="zenkai-brand-quote__follow">Zenkai exists for the pieces you always wished existed: modern linework, subtle jokes, nostalgic energy, and prints that get noticed without feeling like a costume.</p>
          </aside>
        {% endunless %}

        {% if has_ugc %}
          <section class="zenkai-ugc-gallery zenkai-ugc-gallery--desktop" aria-label="{{ zenkai_ugc_heading }}">
            <h2 class="zenkai-ugc-heading">{{ zenkai_ugc_heading }}</h2>
            <div class="zenkai-ugc-carousel" data-ugc-carousel>
              <div class="zenkai-ugc-track" data-ugc-track>
                {%- for block in section.blocks -%}
                  {%- if block.type == 'ugc_photo' and block.settings.image != blank -%}
                    <div class="zenkai-ugc-card" {{ block.shopify_attributes }}>
                      <img
                        srcset="{{ block.settings.image | img_url: '300x400', crop: 'center' }} 300w,
                               {{ block.settings.image | img_url: '450x600', crop: 'center' }} 450w,
                               {{ block.settings.image | img_url: '600x800', crop: 'center' }} 600w"
                        sizes="(max-width: 767px) 72vw, 33vw"
                        src="{{ block.settings.image | img_url: '600x800', crop: 'center' }}"
                        alt="{{ block.settings.caption | default: zenkai_ugc_alt | escape }}"
                        loading="lazy"
                        width="600"
                        height="800"
                      >
                      {% if block.settings.caption != blank %}
                        <div class="zenkai-ugc-card__overlay">
                          <p class="zenkai-ugc-card__caption">{{ block.settings.caption }}</p>
                        </div>
                      {% endif %}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              <button type="button" class="zenkai-ugc-arrow zenkai-ugc-arrow--prev" data-ugc-prev aria-label="Previous photos" hidden>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
              </button>
              <button type="button" class="zenkai-ugc-arrow zenkai-ugc-arrow--next" data-ugc-next aria-label="Next photos" hidden>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </button>
            </div>
          </section>
        {% endif %}

        <div class="zenkai-additional-content">
          {% if settings.additional_content_style == 'expandable' %}
            {% include 'product-additional-content', section_id: section_id %}
          {% else %}
            {% include 'product-additional-tabs', section_id: section_id %}
          {% endif %}
        </div>
      </div>

      {% unless zenkai_product_category == 'pin' %}
        <div class="zenkai-bundle-belt">
          {% include 'bundle-callout', bundle_slot: 'desktop' %}
        </div>
      {% endunless %}

      {% if zenkai_journey_region != blank %}
        {% unless isModal %}
          {% render 'journey-badge-upsell', zenkai_journey_region: zenkai_journey_region %}
        {% endunless %}
      {% endif %}
    </div>
  </div>

  {% if zenkai_mobile_sticky_atc %}
    {% unless isModal %}
      <div class="zenkai-sticky-atc" data-sticky-atc hidden>
        <div class="zenkai-sticky-atc__meta">
          <span class="zenkai-sticky-atc__price" data-sticky-atc-price>{{ current_variant.price | money }}</span>
          <span class="zenkai-sticky-atc__variant" data-sticky-atc-variant>{{ zenkai_current_variant_label }}</span>
        </div>
        <button type="button" class="btn zenkai-sticky-atc__button" data-sticky-atc-button{% unless current_variant.available %} disabled="disabled"{% endunless %}>
          {% if current_variant.available %}
            {{ zenkai_cta_text }}
          {% else %}
            {{ 'products.product.sold_out' | t }}
          {% endif %}
        </button>
      </div>
    {% endunless %}
  {% endif %}
</div>

<script>
  /* Restyle Rokt upsell widget — lives inside #aftersell-pdp-upsell shadow DOM,
     so we pierce the shadow root and override inline custom properties there. */
  (function() {
    var vars = {
      '--pdp-widget-padding-top': '0.75rem',
      '--pdp-widget-padding-bottom': '0.75rem',
      '--pdp-widget-padding-left': '1rem',
      '--pdp-widget-padding-right': '1rem',
      '--pdp-header-font-size': '0.92rem',
      '--pdp-header-text-font-weight': '700',
      '--pdp-header-text-color': '#202225',
      '--pdp-header-alignment': 'left',
      '--pdp-product-card-border-color': 'rgba(26,27,46,0.1)',
      '--pdp-product-card-border-radius': '10px',
      '--pdp-product-card-padding': '10px',
      '--pdp-product-card-min-width': '260px',
      '--pdp-product-card-max-width': '320px',
      '--pdp-product-title-font-size': '0.82rem',
      '--pdp-product-title-text-color': '#202225',
      '--pdp-product-title-font-weight': '600',
      '--pdp-add-to-cart-button-background-color': '#63d6bf',
      '--pdp-add-to-cart-button-hover-background-color': '#4fc5ae',
      '--pdp-add-to-cart-button-text-color': '#102522',
      '--pdp-add-to-cart-button-font-size': '0.78rem',
      '--pdp-add-to-cart-button-font-weight': '800',
      '--pdp-add-to-cart-button-border-radius': '10px',
      '--pdp-product-image-width': '280px',
      '--pdp-product-image-height': '280px',
      '--pdp-product-image-border-radius': '8px',
      '--pdp-product-image-object-fit': 'cover',
      '--pdp-price-text-font-size': '0.82rem',
      '--pdp-price-text-font-weight': '700',
      '--pdp-price-text-color': '#202225',
      '--pdp-discount-text-font-size': '0.75rem',
      '--pdp-discount-text-font-weight': '700',
      '--pdp-discount-text-color': '#2d7a31',
      '--pdp-compare-at-price-text-font-size': '0.75rem',
      '--pdp-compare-at-price-text-color': '#6b6f85',
      '--pdp-variant-selection-border-radius': '8px',
      '--pdp-variant-selection-border-color': 'rgba(26,27,46,0.15)',
      '--pdp-variant-selection-font-size': '0.72rem',
      '--pdp-arrow-background-color': 'rgba(26,27,46,0.08)',
      '--pdp-arrow-hover-background-color': 'rgba(26,27,46,0.15)',
      '--pdp-arrow-icon-color': '#202225',
      '--pdp-arrow-hover-icon-color': '#202225',
      '--pdp-product-card-min-width-for-layout': '320px'
    };

    function style(shadow) {
      /* Override custom properties on .pdp-widget inside shadow DOM */
      var w = shadow.querySelector('.pdp-widget');
      if (!w) return false;
      for (var k in vars) w.style.setProperty(k, vars[k]);
      w.style.margin = '0 auto';

      /* Responsive max-width via matchMedia — keeps the inline-style mechanism
         that the widget's internal layout depends on, but adapts on breakpoint
         change. 800 on mobile (effectively unbounded), 960 on tablet, 1200 on
         desktop so ~3 cards fit inside the theme's 1300px page container. */
      var mqDesktop = window.matchMedia('(min-width: 1024px)');
      var mqTablet = window.matchMedia('(min-width: 768px)');
      var applyWidth = function() {
        if (mqDesktop.matches) w.style.maxWidth = '1200px';
        else if (mqTablet.matches) w.style.maxWidth = '960px';
        else w.style.maxWidth = '800px';
      };
      applyWidth();
      var bindMq = function(mq) {
        if (mq.addEventListener) mq.addEventListener('change', applyWidth);
        else if (mq.addListener) mq.addListener(applyWidth);
      };
      bindMq(mqDesktop);
      bindMq(mqTablet);

      /* Inject a stylesheet into the shadow root for effects + hierarchy */
      if (!shadow.querySelector('[data-zenkai-rokt]')) {
        var s = document.createElement('style');
        s.setAttribute('data-zenkai-rokt', '');
        s.textContent = [
          /* Base */
          '.pdp-widget { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; -webkit-font-smoothing: antialiased; }',
          '.pdp-widget * { box-sizing: border-box; }',

          /* Header */
          '.pdp-widget .upsell-header { font-size: 0.78rem; font-weight: 700; color: #202225; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.06em; }',

          /* Card */
          '.pdp-widget .product-card { transition: box-shadow .15s ease, transform .15s ease; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,0.06), 0 4px 16px rgba(0,0,0,0.04); }',
          '.pdp-widget .product-card:hover { box-shadow: 0 4px 12px rgba(0,0,0,.1), 0 8px 24px rgba(0,0,0,0.06); transform: translateY(-2px); }',

          /* Image */
          '.pdp-widget .product-image-wrapper { display: flex; justify-content: center; background: #eaf7f3; border-radius: 8px 8px 0 0; margin: -10px -10px 0 -10px; padding: 1rem 0.5rem; border-bottom: 1px solid rgba(26,27,46,0.06); }',
          '.pdp-widget .product-image { width: 100% !important; height: auto !important; max-height: 260px; object-fit: contain; }',

          /* Info area below image */
          '.pdp-widget .product-info-wrapper { padding-top: 0.55rem; }',

          /* Title */
          '.pdp-widget .product-title { font-size: 0.88rem; font-weight: 700; line-height: 1.25; margin-bottom: 0 !important; color: #202225; }',
          '.pdp-widget .product-title a { color: inherit; text-decoration: none; }',
          '.pdp-widget .product-info { margin-bottom: 0.1rem; }',

          /* Pricing */
          '.pdp-widget .discount-label-price-wrapper { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.15rem 0.35rem; margin-top: 0.1rem; }',
          '.pdp-widget .discount-label { font-size: 0.68rem; order: 2; }',
          '.pdp-widget .discounted-price-wrapper { display: flex; align-items: baseline; gap: 0.25rem; }',
          '.pdp-widget .price-info { font-size: 0.85rem; font-weight: 700; margin: 0; color: #202225; }',
          '.pdp-widget .compare-at-price { font-size: 0.75rem !important; font-weight: 400 !important; text-decoration: line-through; opacity: 0.45; }',

          /* Variant selector */
          '.pdp-widget .product-card-actions { margin-top: 0.35rem; }',
          '.pdp-widget .quantity-variant-wrapper { gap: 0.3rem; }',
          '.pdp-widget .select-wrap { margin-bottom: 0.3rem; position: relative; }',
          '.pdp-widget .select-wrap label { font-size: 0.58rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: #6b6f85; margin-bottom: 0.15rem; display: block; }',
          '.pdp-widget .select-dropdown { font-size: 0.78rem; font-weight: 500; color: #202225; padding: 0.45rem 2rem 0.45rem 0.65rem; border: 1px solid rgba(26,27,46,0.12); border-radius: 8px; background: #fff; width: 100%; appearance: none; -webkit-appearance: none; cursor: pointer; transition: border-color .15s ease; }',
          '.pdp-widget .select-dropdown:focus { border-color: #59b7a7; outline: none; box-shadow: 0 0 0 2px rgba(89,183,167,0.14); }',

          /* CTA button */
          '.pdp-widget .add-button { padding: 0.65rem 1rem; font-size: 0.82rem; font-weight: 800; letter-spacing: 0.01em; box-shadow: 0 6px 18px rgba(89,183,167,0.22), 0 2px 6px rgba(89,183,167,0.18); transition: background .15s ease, box-shadow .15s ease, transform .15s ease; width: 100%; }',
          '.pdp-widget .add-button:hover { box-shadow: 0 8px 22px rgba(89,183,167,0.3), 0 3px 8px rgba(89,183,167,0.2); transform: translateY(-1px); }',

          /* Carousel arrows */
          '.pdp-widget .carousel-wrapper { position: relative; }',
          '.pdp-widget .carousel-button { position: absolute; top: 35%; transform: translateY(-50%); z-index: 2; width: 32px; height: 32px; border-radius: 50%; opacity: 0.85; }',
          '.pdp-widget .carousel-button:hover { opacity: 1; }',
          '.pdp-widget .carousel-button.left { left: 6px; }',
          '.pdp-widget .carousel-button.right { right: 6px; }'
        ].join('\n');
        shadow.appendChild(s);
      }
      return true;
    }

    function hunt() {
      var host = document.getElementById('aftersell-pdp-upsell');
      if (host && host.shadowRoot) return style(host.shadowRoot);
      /* Fallback: search all shadow roots */
      var all = document.querySelectorAll('*');
      for (var i = 0; i < all.length; i++) {
        if (all[i].shadowRoot && all[i].shadowRoot.querySelector('.pdp-widget')) {
          return style(all[i].shadowRoot);
        }
      }
      return false;
    }

    if (hunt()) return;

    var attempts = 0;
    var poll = setInterval(function() {
      if (hunt() || ++attempts > 60) clearInterval(poll);
    }, 250);
  })();
</script>

<script>
  (function() {
    function initProductSection{{ section_id }}() {
      var section = document.getElementById('ProductSection-{{ section_id }}');

      if (!section) {
        return;
      }

      var ctaLabel = section.getAttribute('data-product-cta-default') || {{ zenkai_cta_text | json }};
      var productCategory = section.getAttribute('data-product-category') || '';
      var mainButton = section.querySelector('[data-add-to-cart]');
      var mainButtonText = section.querySelector('[data-add-to-cart-text]');
      var mainButtonShowsPrice = mainButton && mainButton.getAttribute('data-cta-price') === 'true';
      var stickySentinel = section.querySelector('[data-sticky-sentinel]');
      var priceSource = section.querySelector('[data-product-price]');
      var comparePriceSource = section.querySelector('[data-product-price-compare]');
      var savingsBadge = section.querySelector('.you-save');
      var selectSource = section.querySelector('[data-product-select]');
      var variantInputs = section.querySelectorAll('[data-variant-input]');
      var sticky = section.querySelector('[data-sticky-atc]');
      var stickyButton = section.querySelector('[data-sticky-atc-button]');
      var stickyPrice = section.querySelector('[data-sticky-atc-price]');
      var stickyVariant = section.querySelector('[data-sticky-atc-variant]');

      /* Clone the Judge.me review badge into the title slot. When Judge.me
         reports zero reviews, hide the proof row rather than showing an empty
         5-star widget — that mismatch between "5 stars / No reviews" actively
         damages trust ATF on a new product. */
      (function cloneReviewBadge() {
        var targets = section.querySelectorAll('[data-zenkai-review-clone]');
        if (!targets.length) return;

        function hasReviews(source) {
          var count = source.getAttribute('data-number-of-reviews');
          if (count === null) return true;
          return parseInt(count, 10) > 0;
        }

        function hideTargets() {
          targets.forEach(function(t) {
            while (t.firstChild) t.removeChild(t.firstChild);
            var wrapper = t.closest('.zenkai-hero-proof-row') || t;
            wrapper.setAttribute('hidden', 'hidden');
          });
        }

        function run() {
          var source = section.querySelector('.zenkai-app-block .jdgm-prev-badge');
          if (!source) return false;
          if (!hasReviews(source)) {
            hideTargets();
            return true;
          }
          targets.forEach(function(t) {
            while (t.firstChild) t.removeChild(t.firstChild);
            var clone = source.cloneNode(true);
            clone.style.display = '';
            t.appendChild(clone);
          });
          return true;
        }

        if (run()) return;
        var observer = new MutationObserver(function(_, obs) {
          if (run()) obs.disconnect();
        });
        observer.observe(section, { childList: true, subtree: true });
        setTimeout(function() { observer.disconnect(); }, 10000);
      })();

      function getVariantLabel() {
        if (!selectSource || !selectSource.options.length) {
          return 'Ready to order';
        }

        var option = selectSource.options[selectSource.selectedIndex];
        var label = option ? option.text : '';

        if (label.indexOf(' - ') !== -1) {
          label = label.split(' - ')[0];
        }

        if (!label || label === 'Default Title') {
          return 'Ready to order';
        }

        return label;
      }

      function isCollectorVariantLabel(label) {
        var normalized = (label || '').toLowerCase();
        return normalized.indexOf('collector') !== -1 ||
          normalized.indexOf('4 region') !== -1 ||
          normalized.indexOf('4-region') !== -1;
      }

      function syncCollectorSavings() {
        if (productCategory !== 'pin' || !isCollectorVariantLabel(getVariantLabel())) {
          return;
        }

        if (comparePriceSource) {
          comparePriceSource.textContent = '$119.96';
        }

        if (savingsBadge) {
          savingsBadge.textContent = 'Save $20';
        }
      }

      function getContextualCtaLabel() {
        if (productCategory !== 'pin') {
          return ctaLabel;
        }

        var variantLabel = getVariantLabel();
        if (!variantLabel || variantLabel === 'Ready to order') {
          return ctaLabel;
        }

        if (variantLabel.toLowerCase().indexOf('collector') !== -1) {
          return 'Add Collector Pack';
        }

        return 'Add ' + variantLabel + ' Set';
      }

      function getMainCtaLabel() {
        var label = getContextualCtaLabel();
        if (mainButtonShowsPrice && priceSource) {
          var price = priceSource.textContent.replace(/\s+/g, ' ').trim();
          if (price) label += ' - ' + price;
        }
        return label;
      }

      function syncCta() {
        if (!mainButton) {
          return;
        }

        var mainLabel = getMainCtaLabel();

        if (mainButtonText && !mainButton.disabled && mainButtonText.textContent.trim() !== mainLabel) {
          mainButtonText.textContent = mainLabel;
        }

        if (stickyButton) {
          stickyButton.disabled = mainButton.disabled;
          stickyButton.textContent = mainButton.disabled ? mainButton.textContent.replace(/\s+/g, ' ').trim() : getContextualCtaLabel();
        }
      }

      function syncMeta() {
        if (stickyPrice && priceSource) {
          stickyPrice.textContent = priceSource.textContent.replace(/\s+/g, ' ').trim();
        }

        if (stickyVariant) {
          stickyVariant.textContent = getVariantLabel();
        }
      }

      function syncAll() {
        syncCollectorSavings();
        syncCta();
        syncMeta();
      }

      function syncStickyVisibility(entry) {
        if (!sticky || !stickySentinel) {
          return;
        }

        var sentinelTop = stickySentinel.getBoundingClientRect().top;
        var isIntersecting = entry ? entry.isIntersecting : false;
        var showSticky = sentinelTop < 0 && !isIntersecting;

        sticky.hidden = !showSticky;
        sticky.classList.toggle('is-visible', showSticky);
      }

      syncAll();

      if (selectSource) {
        selectSource.addEventListener('change', function() {
          window.setTimeout(syncAll, 0);
        });
      }

      if (variantInputs.length) {
        Array.prototype.forEach.call(variantInputs, function(input) {
          input.addEventListener('change', function() {
            window.setTimeout(syncAll, 0);
          });
        });
      }

      if (mainButton && window.MutationObserver) {
        new MutationObserver(syncAll).observe(mainButton, {
          attributes: true,
          attributeFilter: ['disabled'],
          childList: true,
          characterData: true
        });
      }

      if (priceSource && window.MutationObserver) {
        new MutationObserver(syncAll).observe(priceSource, {
          childList: true,
          subtree: true,
          characterData: true
        });
      }

      if (sticky && stickySentinel) {
        if ('IntersectionObserver' in window) {
          var observer = new IntersectionObserver(function(entries) {
            syncStickyVisibility(entries[0]);
          }, {
            threshold: [0, 1]
          });

          observer.observe(stickySentinel);
          syncStickyVisibility();
          window.addEventListener('resize', function() {
            syncStickyVisibility();
          });
        } else {
          var onScroll = function() {
            syncStickyVisibility();
          };

          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll);
          syncStickyVisibility();
        }
      }

      if (stickyButton && mainButton) {
        stickyButton.addEventListener('click', function() {
          if (mainButton.disabled) {
            return;
          }

          mainButton.click();
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initProductSection{{ section_id }});
    } else {
      initProductSection{{ section_id }}();
    }
  })();
</script>

<script>
  (function() {
    var carousels = document.querySelectorAll('[data-ugc-carousel]');
    if (!carousels.length) return;

    Array.prototype.forEach.call(carousels, function(carousel) {
      var track = carousel.querySelector('[data-ugc-track]');
      var prevBtn = carousel.querySelector('[data-ugc-prev]');
      var nextBtn = carousel.querySelector('[data-ugc-next]');
      if (!track) return;

      function getScrollAmount() {
        var card = track.querySelector('.zenkai-ugc-card');
        if (!card) return 300;
        var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        return card.offsetWidth + gap;
      }

      function updateArrows() {
        if (!prevBtn || !nextBtn) return;
        prevBtn.hidden = track.scrollLeft <= 4;
        nextBtn.hidden = track.scrollLeft + track.offsetWidth >= track.scrollWidth - 4;
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function() {
          track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function() {
          track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
        });
      }

      track.addEventListener('scroll', updateArrows, { passive: true });
      window.addEventListener('resize', updateArrows);
      updateArrows();
    });
  })();
</script>

<script>
  (function() {
    if (window.innerWidth >= 768) return;

    var startX, startY;
    document.addEventListener('touchstart', function(e) {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
    }, { capture: true, passive: true });

    document.addEventListener('touchend', function(e) {
      var touch = e.changedTouches[0];
      if (Math.abs(touch.clientX - startX) > 10 || Math.abs(touch.clientY - startY) > 10) return;
      var thumbs = document.querySelectorAll('[data-product-thumb]');
      for (var i = 0; i < thumbs.length; i++) {
        var r = thumbs[i].getBoundingClientRect();
        if (touch.clientX >= r.left && touch.clientX <= r.right &&
            touch.clientY >= r.top && touch.clientY <= r.bottom) {
          e.preventDefault();
          e.stopImmediatePropagation();
          var idx = parseInt(thumbs[i].getAttribute('data-index'), 10);
          if (typeof jQuery !== 'undefined') {
            var $s = jQuery('[data-product-photos].slick-initialized');
            if ($s.length) $s.slick('slickGoTo', idx);
          }
          return;
        }
      }
    }, { capture: true, passive: false });

    setInterval(function() {
      if (typeof jQuery === 'undefined') return;
      var $slider = jQuery('[data-product-photos].slick-initialized');
      if (!$slider.length) return;
      var current = $slider.slick('slickCurrentSlide');
      var items = document.querySelectorAll('[data-product-thumb-item]');
      for (var i = 0; i < items.length; i++) {
        var isActive = parseInt(items[i].getAttribute('data-index'), 10) === current;
        items[i].classList.toggle('is-active', isActive);
      }
      var c = document.querySelector('[data-product-thumbs]');
      var a = document.querySelector('[data-product-thumb-item].is-active');
      if (c && a && c.scrollWidth > c.clientWidth) {
        c.scrollTo({ left: a.offsetLeft - (c.clientWidth / 2) + (a.offsetWidth / 2), behavior: 'smooth' });
      }
      if (c) c.style.justifyContent = (c.scrollWidth <= c.clientWidth) ? 'center' : 'flex-start';
    }, 500);

    setTimeout(function() {
      var title = document.querySelector('.product-single__title');
      if (title) {
        var size = 1.45;
        var lineH = parseFloat(getComputedStyle(title).lineHeight) || (size * 16 * 1.15);
        while (title.scrollHeight > lineH * 2 + 2 && size > 0.9) {
          size -= 0.05;
          title.style.fontSize = size + 'rem';
          lineH = parseFloat(getComputedStyle(title).lineHeight) || (size * 16 * 1.15);
        }
      }
    }, 500);
  })();
</script>
