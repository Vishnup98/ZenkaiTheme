{%- comment -%}
  Static review card used only by the Summoning Glow Essential native reviews section.

  Expected parameters:
  - review_id
  - reviewer
  - date_iso
  - date_label
  - body
  - image_name (optional theme asset filename)
  - image_width / image_height (required when image_name is present)
{%- endcomment -%}

<article
  class="sg-review-card{% if image_name != blank %} sg-review-card--with-photo{% endif %}"
  data-review-id="{{ review_id | escape }}">
  {%- if image_name != blank -%}
    {%- assign image_webp = image_name | replace: '.jpg', '.webp' -%}
    <button
      type="button"
      class="sg-review-card__photo-button"
      data-sg-review-photo
      data-full-src="{{ image_name | asset_url }}"
      data-full-alt="Customer photo shared with {{ reviewer | escape }}'s review"
      data-caption="{{ reviewer | escape }} · {{ date_label | escape }}"
      aria-haspopup="dialog"
      aria-label="View the full customer photo from {{ reviewer | escape }}'s review">
      <picture>
        <source srcset="{{ image_webp | asset_url }}" type="image/webp">
        <img
          class="sg-review-card__photo"
          src="{{ image_name | asset_url }}"
          alt="Customer photo shared with {{ reviewer | escape }}'s review"
          width="{{ image_width }}"
          height="{{ image_height }}"
          loading="lazy"
          fetchpriority="low"
          decoding="async">
      </picture>
      <span class="sg-review-card__zoom" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-4-4M11 8v6M8 11h6"></path>
          </svg>
      </span>
    </button>
  {%- endif -%}

  <div class="sg-review-card__content">
    <div class="sg-review-card__stars" aria-label="5 out of 5 stars">
      <span aria-hidden="true">★★★★★</span>
    </div>
    <p class="sg-review-card__body{% if body == 'Photo-only review.' %} sg-review-card__body--photo-only{% endif %}">{{ body | escape }}</p>
    <div class="sg-review-card__footer">
      <span class="sg-review-card__avatar" aria-hidden="true">{{ reviewer | slice: 0, 1 | upcase }}</span>
      <span class="sg-review-card__identity">
        <strong>{{ reviewer | escape }}</strong>
        <time datetime="{{ date_iso | escape }}">{{ date_label | escape }}</time>
      </span>
    </div>
  </div>
</article>
