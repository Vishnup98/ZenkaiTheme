{%- assign zk_sticker_handle = 'pixel-archive-103-piece-retro-card-sticker-pack' -%}
{%- assign zk_sticker_product = all_products[zk_sticker_handle] -%}
{%- assign zk_sticker_variant = zk_sticker_product.selected_or_first_available_variant -%}
{%- assign zk_badge_form_id = 'AddToCartForm-' | append: section_id -%}

{%- if zk_sticker_product != blank and zk_sticker_variant != blank and zk_sticker_variant.available -%}
  {%- assign zk_sticker_image = zk_sticker_product.featured_image -%}
  <div class="zk-badge-sticker" data-zk-badge-sticker-modal hidden aria-hidden="true">
    <div class="zk-badge-sticker__scrim" data-zk-badge-sticker-skip></div>
    <section
      class="zk-badge-sticker__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="zk-badge-sticker-title"
      aria-describedby="zk-badge-sticker-description">
      <button type="button" class="zk-badge-sticker__close" data-zk-badge-sticker-skip aria-label="Skip sticker add-on and continue to bag">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M18 6 6 18M6 6l12 12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path>
        </svg>
      </button>

      <div class="zk-badge-sticker__media">
        <img
          src="{{ zk_sticker_image | image_url: width: 900, height: 900, crop: 'center' }}"
          alt="{{ zk_sticker_image.alt | default: zk_sticker_product.title | escape }}"
          loading="eager"
          width="900"
          height="900">
        <span class="zk-badge-sticker__save">Save $10</span>
      </div>

      <div class="zk-badge-sticker__copy">
        <p class="zk-badge-sticker__eyebrow">Add to your bag</p>
        <h2 id="zk-badge-sticker-title">Give the badge collection a backdrop.</h2>
        <p id="zk-badge-sticker-description">Add the complete 103-piece retro card sticker archive for laptops, notebooks, cases, and luggage.</p>

        <div class="zk-badge-sticker__price" aria-label="Upsell price $19.99, normally {{ zk_sticker_variant.price | money }}">
          <s>{{ zk_sticker_variant.price | money }}</s>
          <strong>$19.99</strong>
          <span>with the badge set</span>
        </div>

        <ul class="zk-badge-sticker__details">
          <li>103 individually cut decals</li>
          <li>Retro numbered-card artwork</li>
          <li>Approximately 1.6–3.1 in each</li>
        </ul>

        <button type="button" class="zk-badge-sticker__add" data-zk-badge-sticker-add>
          <span>Add 103 Stickers — $19.99</span>
        </button>
        <button type="button" class="zk-badge-sticker__skip" data-zk-badge-sticker-skip>No thanks, continue to bag</button>
        <p class="zk-badge-sticker__note">The $10 badge-pairing discount appears automatically in your bag. Limit one discounted sticker pack per order.</p>
        <p class="zk-badge-sticker__status" data-zk-badge-sticker-status role="status" aria-live="polite"></p>
      </div>
    </section>
  </div>

  <script type="application/json" data-zk-badge-sticker-config>
    {
      "mainFormId": {{ zk_badge_form_id | json }},
      "stickerVariantId": {{ zk_sticker_variant.id | json }},
      "stickerProductTitle": {{ zk_sticker_product.title | json }}
    }
  </script>

  <style>
    .zk-badge-sticker[hidden] { display: none !important; }
    .zk-badge-sticker {
      position: fixed;
      inset: 0;
      z-index: 2147482900;
      display: grid;
      place-items: center;
      padding: 18px;
      color: #17181c;
      font-family: inherit;
    }
    .zk-badge-sticker__scrim {
      position: absolute;
      inset: 0;
      background: rgba(13, 15, 22, .62);
      backdrop-filter: blur(4px);
    }
    .zk-badge-sticker__dialog {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, .94fr) minmax(0, 1.06fr);
      width: min(100%, 860px);
      max-height: calc(100dvh - 36px);
      overflow: auto;
      background: #fff;
      border: 1px solid rgba(17, 18, 24, .12);
      border-radius: 18px;
      box-shadow: 0 30px 90px rgba(0, 0, 0, .32);
      opacity: 0;
      transform: translateY(16px) scale(.985);
      transition: opacity 180ms ease, transform 180ms ease;
    }
    .zk-badge-sticker.is-open .zk-badge-sticker__dialog {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    .zk-badge-sticker__close {
      position: absolute;
      z-index: 2;
      top: 12px;
      right: 12px;
      display: grid;
      place-items: center;
      width: 38px;
      height: 38px;
      padding: 0;
      color: #18191d;
      background: rgba(255, 255, 255, .92);
      border: 1px solid rgba(17, 18, 24, .12);
      border-radius: 999px;
      box-shadow: 0 5px 18px rgba(0, 0, 0, .12);
      cursor: pointer;
    }
    .zk-badge-sticker__media {
      position: relative;
      min-height: 100%;
      background: #eeeef0;
    }
    .zk-badge-sticker__media img {
      display: block;
      width: 100%;
      height: 100%;
      min-height: 480px;
      object-fit: cover;
    }
    .zk-badge-sticker__save {
      position: absolute;
      left: 18px;
      top: 18px;
      padding: 7px 12px;
      color: #fff;
      background: #dd204c;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
      box-shadow: 0 6px 20px rgba(145, 11, 43, .22);
    }
    .zk-badge-sticker__copy {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 52px 46px 42px;
    }
    .zk-badge-sticker__eyebrow {
      margin: 0 0 10px;
      color: #dd204c;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .12em;
      text-transform: uppercase;
    }
    .zk-badge-sticker__copy h2 {
      margin: 0;
      color: #121318;
      font-size: clamp(28px, 4vw, 42px);
      line-height: 1.02;
      letter-spacing: -.035em;
    }
    .zk-badge-sticker__copy > p:not(.zk-badge-sticker__eyebrow):not(.zk-badge-sticker__note):not(.zk-badge-sticker__status) {
      margin: 16px 0 0;
      color: #5b5e68;
      font-size: 15px;
      line-height: 1.55;
    }
    .zk-badge-sticker__price {
      display: flex;
      align-items: baseline;
      gap: 9px;
      margin-top: 18px;
    }
    .zk-badge-sticker__price s { color: #8b8e97; font-size: 16px; }
    .zk-badge-sticker__price strong { color: #dd204c; font-size: 28px; line-height: 1; }
    .zk-badge-sticker__price span { color: #656873; font-size: 12px; font-weight: 700; }
    .zk-badge-sticker__details {
      display: grid;
      gap: 7px;
      margin: 18px 0 22px;
      padding: 0;
      list-style: none;
      color: #383a42;
      font-size: 13px;
    }
    .zk-badge-sticker__details li { position: relative; padding-left: 21px; }
    .zk-badge-sticker__details li::before {
      content: '✓';
      position: absolute;
      left: 0;
      color: #15945d;
      font-weight: 900;
    }
    .zk-badge-sticker__add {
      width: 100%;
      min-height: 52px;
      padding: 13px 18px;
      color: #fff;
      background: #dd204c;
      border: 0;
      border-radius: 6px;
      font: inherit;
      font-size: 15px;
      font-weight: 800;
      cursor: pointer;
      transition: transform 120ms ease, background 120ms ease;
    }
    .zk-badge-sticker__add:hover { background: #c71840; transform: translateY(-1px); }
    .zk-badge-sticker__add:disabled { cursor: wait; opacity: .68; transform: none; }
    .zk-badge-sticker__skip {
      align-self: center;
      margin-top: 13px;
      padding: 2px;
      color: #5e6069;
      background: none;
      border: 0;
      border-bottom: 1px solid currentColor;
      font: inherit;
      font-size: 12px;
      cursor: pointer;
    }
    .zk-badge-sticker__note,
    .zk-badge-sticker__status {
      margin: 13px 0 0;
      color: #777a83;
      font-size: 11px;
      line-height: 1.45;
      text-align: center;
    }
    .zk-badge-sticker__status { min-height: 16px; color: #17181c; font-weight: 700; }
    .zk-badge-sticker__status[data-state='error'] { color: #ad1739; }
    body.zk-badge-sticker-open { overflow: hidden; }

    @media (max-width: 749px) {
      .zk-badge-sticker { align-items: end; padding: 0; }
      .zk-badge-sticker__dialog {
        grid-template-columns: 1fr;
        width: 100%;
        max-height: calc(100dvh - 8px);
        border-radius: 18px 18px 0 0;
      }
      .zk-badge-sticker__media { min-height: 0; }
      .zk-badge-sticker__media img { height: min(39vh, 330px); min-height: 230px; }
      .zk-badge-sticker__save { left: 14px; top: 14px; }
      .zk-badge-sticker__copy { padding: 24px 20px max(22px, env(safe-area-inset-bottom)); }
      .zk-badge-sticker__copy h2 { font-size: 29px; }
      .zk-badge-sticker__copy > p:not(.zk-badge-sticker__eyebrow):not(.zk-badge-sticker__note):not(.zk-badge-sticker__status) { margin-top: 10px; }
      .zk-badge-sticker__price { margin-top: 13px; }
      .zk-badge-sticker__details { margin: 14px 0 17px; }
      .zk-badge-sticker__note { margin-top: 10px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .zk-badge-sticker__dialog,
      .zk-badge-sticker__add { transition: none; }
    }
  </style>

  <script>
    (function() {
      'use strict';

      if (window.__zkBadgeStickerUpsellLoaded) return;
      window.__zkBadgeStickerUpsellLoaded = true;

      var configEl = document.querySelector('[data-zk-badge-sticker-config]');
      var modal = document.querySelector('[data-zk-badge-sticker-modal]');
      if (!configEl || !modal) return;

      var config;
      try { config = JSON.parse(configEl.textContent); } catch (error) { return; }

      var mainForm = document.getElementById(config.mainFormId);
      var addButton = modal.querySelector('[data-zk-badge-sticker-add]');
      var status = modal.querySelector('[data-zk-badge-sticker-status]');
      var state = { busy: false, previousFocus: null, activeButton: null };
      if (!mainForm || !config.stickerVariantId) return;

      function emitEvent(target, name, detail) {
        if (!target) return;
        try {
          target.dispatchEvent(new CustomEvent(name, { detail: detail }));
        } catch (error) {
          var event = document.createEvent('CustomEvent');
          event.initCustomEvent(name, true, true, detail);
          target.dispatchEvent(event);
        }
      }

      function setStatus(message, type) {
        if (!status) return;
        status.textContent = message || '';
        type ? status.setAttribute('data-state', type) : status.removeAttribute('data-state');
      }

      function setLoading(button, loading) {
        if (!button) return;
        button.disabled = loading;
        button.classList.toggle('is-loading', loading);
      }

      function cleanXHR() {
        return new Promise(function(resolve, reject) {
          if (window.__zkBadgeStickerXHRFrame && window.__zkBadgeStickerXHRFrame.contentWindow) {
            try { resolve(new window.__zkBadgeStickerXHRFrame.contentWindow.XMLHttpRequest()); return; } catch (error) {}
          }
          var frame = document.createElement('iframe');
          frame.style.cssText = 'display:none!important;width:0;height:0;border:0;position:absolute;';
          frame.setAttribute('aria-hidden', 'true');
          frame.src = 'about:blank';
          document.body.appendChild(frame);
          window.__zkBadgeStickerXHRFrame = frame;
          window.setTimeout(function() {
            try { resolve(new frame.contentWindow.XMLHttpRequest()); } catch (error) { reject(error); }
          }, 0);
        });
      }

      function request(method, url, body, contentType, useParent) {
        var xhrPromise = useParent ? Promise.resolve(new XMLHttpRequest()) : cleanXHR();
        return xhrPromise.then(function(xhr) {
          return new Promise(function(resolve, reject) {
            xhr.open(method, url, true);
            xhr.setRequestHeader('Accept', 'application/json');
            if (contentType) xhr.setRequestHeader('Content-Type', contentType);
            xhr.onreadystatechange = function() {
              if (xhr.readyState !== 4) return;
              var data = {};
              try { data = JSON.parse(xhr.responseText); } catch (error) {}
              if (xhr.status >= 200 && xhr.status < 300) resolve(data);
              else reject(new Error(data.description || data.message || 'Could not update your bag.'));
            };
            xhr.onerror = function() { reject(new Error('Could not update your bag.')); };
            xhr.send(body || null);
          });
        });
      }

      function formBody(form) {
        var source = new FormData(form);
        var params = new URLSearchParams();
        var hasQuantity = false;
        source.forEach(function(value, key) {
          if (!key || key.indexOf('data-') === 0) return;
          if (key === 'quantity') hasQuantity = true;
          params.append(key, value);
        });
        if (!hasQuantity) params.append('quantity', '1');
        return params.toString();
      }

      function addMainProduct() {
        return request('POST', '/cart/add.js', formBody(mainForm), 'application/x-www-form-urlencoded; charset=UTF-8', false);
      }

      function addSticker() {
        var body = 'id=' + encodeURIComponent(String(config.stickerVariantId)) + '&quantity=1';
        return request('POST', '/cart/add.js?upcart=1&opens_cart=never', body, 'application/x-www-form-urlencoded; charset=UTF-8', true);
      }

      function getCart() {
        return request('GET', '/cart.js', null, null, false).then(function(cart) {
          if (!cart || !Array.isArray(cart.items)) throw new Error('Could not refresh your bag.');
          return cart;
        });
      }

      function cartHasSticker(cart) {
        return Boolean(cart && cart.items && cart.items.some(function(item) {
          return String(item.variant_id) === String(config.stickerVariantId);
        }));
      }

      function announceCart(cart) {
        if (window.jQuery) window.jQuery('body').trigger('updateCart', cart);
        emitEvent(document, 'cart:updated', { cart: cart });
        emitEvent(window, 'cart:updated', { cart: cart });
        emitEvent(document, 'upcart:refresh', { cart: cart });
        emitEvent(window, 'upcart:refresh', { cart: cart });
      }

      function callWindow(name, args) {
        if (typeof window[name] !== 'function') return false;
        try { window[name].apply(window, args || []); return true; } catch (error) { return false; }
      }

      function openCart(cart) {
        if (callWindow('upcartRefreshCart')) {
          window.setTimeout(function() {
            if (callWindow('upcartOpenCart') || callWindow('upcartStickyButtonOnClick')) return;
            var delayedTrigger = document.querySelector('#upCartStickyButton, [data-upcart-open], [data-cart-drawer-open], .js-drawer-open-cart');
            if (delayedTrigger && typeof delayedTrigger.click === 'function') delayedTrigger.click();
            else window.location.href = '/cart';
          }, 500);
          return true;
        }
        if (callWindow('upcartOpenCart') || callWindow('upcartStickyButtonOnClick')) return true;

        var detail = cart && cart.items ? { cart: cart } : {};
        emitEvent(document, 'upcart:open', detail);
        emitEvent(window, 'upcart:open', detail);
        emitEvent(document, 'cart:open', detail);
        emitEvent(window, 'cart:open', detail);

        var trigger = document.querySelector('#upCartStickyButton, [data-upcart-open], [data-cart-drawer-open], .js-drawer-open-cart');
        if (trigger && typeof trigger.click === 'function') { trigger.click(); return true; }
        return false;
      }

      function closeModal() {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('zk-badge-sticker-open');
        window.setTimeout(function() { modal.hidden = true; }, 180);
      }

      function finishToCart() {
        closeModal();
        getCart().then(function(cart) {
          announceCart(cart);
          window.setTimeout(function() {
            if (!openCart(cart)) window.location.href = '/cart';
          }, 250);
        }).catch(function() {
          if (!openCart()) window.location.href = '/cart';
        });
      }

      function openModal() {
        state.previousFocus = document.activeElement;
        setStatus('', '');
        modal.hidden = false;
        modal.setAttribute('aria-hidden', 'false');
        document.body.classList.add('zk-badge-sticker-open');
        window.requestAnimationFrame(function() {
          modal.classList.add('is-open');
          addButton.focus();
        });
      }

      function showFormError(message) {
        var oldError = mainForm.querySelector('.errors');
        if (oldError) oldError.remove();
        var error = document.createElement('div');
        error.className = 'errors text-center';
        error.textContent = message;
        mainForm.insertBefore(error, mainForm.firstChild);
      }

      function startFlow(button) {
        if (state.busy) return;
        state.busy = true;
        state.activeButton = button || mainForm.querySelector('[data-add-to-cart]');
        setLoading(state.activeButton, true);

        addMainProduct()
          .then(getCart)
          .then(function(cart) {
            emitEvent(document, 'zk:gymBadgeAdded', { cart: cart });
            if (cartHasSticker(cart)) finishToCart();
            else openModal();
          })
          .catch(function(error) {
            showFormError(error && error.message ? error.message : 'Could not add the badge set.');
          })
          .then(function() {
            state.busy = false;
            setLoading(state.activeButton, false);
            state.activeButton = null;
          });
      }

      function intercept(event) {
        var form = event.type === 'submit' ? event.target : null;
        var button = event.type === 'click' && event.target.closest
          ? event.target.closest('[data-add-to-cart], .add-to-cart, button[name="add"]')
          : null;
        if (!form && button) form = button.form;
        if (form !== mainForm) return;

        event.preventDefault();
        event.stopPropagation();
        if (event.stopImmediatePropagation) event.stopImmediatePropagation();
        startFlow(button);
      }

      document.addEventListener('click', intercept, true);
      document.addEventListener('submit', intercept, true);

      modal.addEventListener('click', function(event) {
        if (event.target.closest('[data-zk-badge-sticker-add]')) {
          if (state.busy) return;
          state.busy = true;
          setLoading(addButton, true);
          setStatus('Adding the sticker pack…', '');
          addSticker()
            .then(function() { setStatus('Added — opening your bag…', ''); finishToCart(); })
            .catch(function(error) {
              setStatus(error && error.message ? error.message : 'Could not add the sticker pack.', 'error');
              setLoading(addButton, false);
            })
            .then(function() { state.busy = false; });
          return;
        }

        if (event.target.closest('[data-zk-badge-sticker-skip]')) finishToCart();
      });

      document.addEventListener('keydown', function(event) {
        if (modal.hidden || event.key !== 'Escape') return;
        finishToCart();
      });
    })();
  </script>
{%- endif -%}
