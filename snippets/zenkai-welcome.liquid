    {{ 'zenkai-welcome.css' | asset_url | stylesheet_tag }}
    <section class="zenkai-welcome" aria-label="Join the Zenkai email list" data-zenkai-welcome>
      <button class="zenkai-welcome__tab" type="button" data-welcome-open aria-label="Get $5 Off" aria-haspopup="dialog" aria-controls="zenkai-welcome-dialog" aria-expanded="false" hidden>Get $5 Off</button>
      <dialog id="zenkai-welcome-dialog" class="zenkai-welcome__dialog" aria-label="Your Zenkai welcome offer">
      <button class="zenkai-welcome__close" type="button" data-welcome-close aria-label="Close welcome offer">×</button>
      <div class="zenkai-welcome__card">
        <div class="zenkai-welcome__art" aria-hidden="true">
          <img src="{{ 'collector-home-sky-v2-640.webp' | asset_url }}" width="640" height="427" loading="lazy" alt="">
          <span class="zenkai-welcome__art-label">Small finds. Big personality.</span>
        </div>
        <div class="zenkai-welcome__content">
          <div data-welcome-signup>
            <p class="zw-form-eyebrow">THE ZENKAI LIST</p>
            <h2 class="zw-form-heading">$5 toward your<br>next favorite.</h2>
            <p class="zw-form-description zenkai-welcome__description"><strong>Your first order of $40+.</strong> Plus new plush finds, collectible drops, and subscriber offers.</p>
            <form class="zenkai-welcome__signup" data-welcome-form aria-label="Zenkai email signup">
              <label for="zenkai-welcome-email">Email address</label>
              <input id="zenkai-welcome-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="Your email address" aria-describedby="zenkai-welcome-consent" required disabled>
              <button type="submit" disabled>Get my $5 <span aria-hidden="true">→</span></button>
              <p id="zenkai-welcome-consent" class="zw-form-consent">By signing up, you agree to marketing emails from Zenkai. Unsubscribe anytime. <a href="{{ shop.privacy_policy.url }}">Privacy policy</a>.</p>
              <p class="zenkai-welcome__feedback" data-welcome-error role="alert" hidden></p>
            </form>
            <noscript><p class="zenkai-welcome__fallback">Please enable JavaScript to sign up for Zenkai emails.</p></noscript>
          </div>
          <div class="zenkai-welcome__success" data-welcome-success tabindex="-1" hidden>
            <p class="zw-form-eyebrow">YOU’RE IN GOOD COMPANY</p>
            <h2 class="zw-form-heading">Your next favorite<br>starts here.</h2>
            <p class="zw-form-description zenkai-welcome__description">Use this code for <strong>$5 off your first order of $40+</strong>. New subscribers will receive it by email, too.</p>
            <div class="zenkai-welcome__code"><strong>WELCOME5</strong><button type="button" data-welcome-copy>Copy code</button></div>
            <p data-welcome-copy-status role="status" class="zw-form-consent"></p>
            <a class="zenkai-welcome__shop" href="/discount/WELCOME5?redirect=/collections/all">Find your next favorite <span aria-hidden="true">→</span></a>
          </div>
          <details class="zenkai-welcome__terms">
            <summary>Offer details</summary>
            <p>$5 USD off your first order with $40 USD or more in merchandise, before shipping and taxes. One use per customer. Cannot combine with other product or order discounts. Eligible shipping offers still apply.</p>
          </details>
        </div>
      </div>
      </dialog>
    </section>
    <script src="{{ 'zenkai-welcome.js' | asset_url }}" defer></script>
