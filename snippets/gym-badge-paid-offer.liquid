<div class="gb-paid-landing__offer" aria-label="Collector's Pack offer">
  <div class="gb-paid-landing__price-row">
    <div>
      <span>4 Regions · 32 Badges</span>
      <strong>{{ collector_variant.price | money }}</strong>
    </div>
    <div class="gb-paid-landing__saving">
      <s>{{ separate_total | money }}</s>
      <span>Save $20</span>
    </div>
  </div>

  <ul class="gb-paid-landing__confidence" role="list">
    <li>Free U.S. shipping</li>
    <li>Ships in 1–2 business days</li>
    <li>Four fitted presentation boxes</li>
  </ul>

  <button
    type="button"
    class="gb-paid-landing__primary"
    data-gb-lp-add
    data-gb-lp-journey="{{ journey }}"
    {% unless collector_variant.available %}disabled{% endunless %}>
    {% if collector_variant.available %}
      {{ cta_text }} — {{ collector_variant.price | money }}
    {% else %}
      Collector's Pack sold out
    {% endif %}
  </button>

  <div class="gb-paid-landing__microproof" aria-label="Offer summary">
    <span><strong>32</strong> hard-enamel badges</span>
    <span><strong>4</strong> collector boxes</span>
    <span><strong>1 week</strong> typical U.S. delivery</span>
  </div>

  <a class="gb-paid-landing__secondary" href="#gb-paid-customer-proof" data-gb-lp-details>See real customer photos and exact contents</a>
  <p class="gb-paid-landing__policy">Damaged, missing, incorrect, or not as described? We’ll make it right. <a href="/pages/policy">Full collector policy</a>.</p>
</div>
