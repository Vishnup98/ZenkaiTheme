{%- assign collector_regular_navigation = true -%}
{%- if template.name == 'product' and template.suffix != blank -%}
  {%- assign collector_regular_navigation = false -%}
{%- endif -%}
{%- if collector_regular_navigation -%}
<style>
  .collector-navigation .site-nav--has-dropdown:focus-within > .site-nav__dropdown { visibility: visible; transform: translate3d(0, 0, 0); }
  .collector-navigation a:focus-visible { outline: 2px solid currentColor; outline-offset: -3px; }
</style>
<ul class="site-nav site-navigation small--hide collector-navigation" aria-label="Shop collections">
  <li class="site-nav__item site-nav__expanded-item site-nav--has-dropdown" aria-haspopup="true">
    <a href="{{ routes.collections_url }}/tees" class="site-nav__link site-nav__link--has-dropdown">Apparel</a>
    <ul class="site-nav__dropdown text-left">
      <li><a class="site-nav__dropdown-link" href="{{ routes.collections_url }}/tees">T-shirts</a></li>
      <li><a class="site-nav__dropdown-link" href="{{ routes.collections_url }}/all-hoodies">Hoodies</a></li>
      <li><a class="site-nav__dropdown-link" href="{{ routes.collections_url }}/sweatshirts">Sweatshirts</a></li>
      <li><a class="site-nav__dropdown-link" href="{{ routes.collections_url }}/all-hats">Hats</a></li>
      <li><a class="site-nav__dropdown-link" href="{{ routes.all_products_collection_url }}">Browse everything</a></li>
    </ul>
  </li>
  <li class="site-nav__item site-nav__expanded-item site-nav--has-dropdown" aria-haspopup="true">
    <a href="{{ routes.root_url }}#collector-plush" class="site-nav__link site-nav__link--has-dropdown js-no-transition">Plush sets</a>
    <ul class="site-nav__dropdown text-left">
      {% render 'collector-nav-links', collector_nav_group: 'plush', collector_nav_link_class: 'site-nav__dropdown-link site-nav__dropdown-link--second-level' %}
    </ul>
  </li>
  <li class="site-nav__item site-nav__expanded-item site-nav--has-dropdown" aria-haspopup="true">
    <a href="{{ routes.root_url }}#collector-pins" class="site-nav__link site-nav__link--has-dropdown js-no-transition">Pins &amp; badges</a>
    <ul class="site-nav__dropdown text-left">
      {% render 'collector-nav-links', collector_nav_group: 'pins', collector_nav_link_class: 'site-nav__dropdown-link site-nav__dropdown-link--second-level' %}
    </ul>
  </li>
</ul>
{%- else -%}
{% unless limit %}
  {%- assign limit = main_menu.links.size -%}
{% endunless %}
{% unless offset %}
  {%- assign offset = 0 -%}
{% endunless %}
<ul
  class="site-nav site-navigation small--hide">
  {% for link in main_menu.links limit: limit offset: offset %}
    {%- assign has_dropdown = false -%}
    {% if link.links != blank %}
      {%- assign has_dropdown = true -%}
    {% endif %}

    <li
      class="site-nav__item site-nav__expanded-item{% if has_dropdown %} site-nav--has-dropdown{% endif %}{% unless template == 'index' %}{% if link.active %} site-nav--active{% endif %}{% endunless %}"
      {% if has_dropdown %}aria-haspopup="true"{% endif %}>

      <a href="{{ link.url }}" class="site-nav__link{% if has_dropdown %} site-nav__link--has-dropdown{% endif %}">
        {{ link.title }}
      </a>
      {% if has_dropdown %}
        <ul class="site-nav__dropdown text-left">
          {% for childlink in link.links %}
            {%- assign has_sub_dropdown = false -%}
            {% if childlink.links != blank %}
              {%- assign has_sub_dropdown = true -%}
            {% endif %}

            <li class="{% if childlink.active %}site-nav--active{% endif %}{% if has_sub_dropdown %} site-nav__deep-dropdown-trigger{% endif %}">
              <a href="{{ childlink.url }}" class="site-nav__dropdown-link site-nav__dropdown-link--second-level {% if has_sub_dropdown %} site-nav__dropdown-link--has-children{% endif %}">
                {{ childlink.title | escape }}
                {% if has_sub_dropdown %}
                  <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon--wide icon-chevron-down" viewBox="0 0 28 16"><path d="M1.57 1.59l12.76 12.77L27.1 1.59" stroke-width="2" stroke="#000" fill="none" fill-rule="evenodd"/></svg>
                {% endif %}
              </a>
              {% if has_sub_dropdown %}
                <ul class="site-nav__deep-dropdown">
                  {% for grandchildlink in childlink.links %}
                    <li>
                      <a href="{{ grandchildlink.url }}" class="site-nav__dropdown-link">
                        {{ grandchildlink.title | escape }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
</ul>
{%- endif -%}
