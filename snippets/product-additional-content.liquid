{%- assign blockId = block.id -%}
{% if product %}
  {%- assign blockId = block.id | append: product.id -%}
{% endif %}

{%- assign has_custom_tabs = false -%}
{% for tag in product.tags %}
  {% if tag contains '_tab' %}
    {%- assign has_custom_tabs = true -%}
  {% endif %}
{% endfor %}

{%- assign zenkai_detail_type = product.type | downcase -%}
{%- assign zenkai_detail_title = product.title | downcase -%}
{%- assign zenkai_detail_template = product.template_suffix | downcase -%}
{%- assign zenkai_detail_eternal_wish = false -%}
{%- if product.handle == 'eternal-wish-23cm-coiled-dragon-rider-display' -%}
  {%- assign zenkai_detail_eternal_wish = true -%}
{%- endif -%}
{%- assign zenkai_detail_category = 'tee' -%}
{%- if zenkai_detail_template == 'collectible' or zenkai_detail_type contains 'collectible' or zenkai_detail_type contains 'figure' or zenkai_detail_type contains 'figurine' -%}
  {%- assign zenkai_detail_category = 'collectible' -%}
{%- elsif zenkai_detail_template == 'gympin' or zenkai_detail_type contains 'pin' or zenkai_detail_type contains 'badge' or zenkai_detail_title == 'pin' or zenkai_detail_title contains ' pin' or zenkai_detail_title contains 'pin ' or zenkai_detail_title contains 'pins' or zenkai_detail_title contains 'badge' or zenkai_detail_title contains 'brooch' -%}
  {%- assign zenkai_detail_category = 'pin' -%}
{%- elsif zenkai_detail_type contains 'cap' or zenkai_detail_type contains 'hat' or zenkai_detail_title contains 'cap' or zenkai_detail_title contains 'hat' -%}
  {%- assign zenkai_detail_category = 'cap' -%}
{%- elsif zenkai_detail_type contains 'hoodie' or zenkai_detail_type contains 'sweatshirt' or zenkai_detail_title contains 'hoodie' or zenkai_detail_title contains 'sweatshirt' -%}
  {%- assign zenkai_detail_category = 'hoodie' -%}
{%- endif -%}
{%- assign zenkai_detail_specs_label = 'Fit &amp; sizing' -%}
{%- if zenkai_detail_category == 'pin' -%}
  {%- assign zenkai_detail_specs_label = 'Pin details' -%}
{%- elsif zenkai_detail_category == 'collectible' -%}
  {%- assign zenkai_detail_specs_label = 'Display details' -%}
{%- endif -%}

<!-- Zenkai Custom Accordion -->
<style>
  .zenkai-accordion {
    margin: 0;
    border: 1px solid rgba(26, 27, 46, 0.1);
    border-radius: 18px;
    background: #fff;
    overflow: hidden;
  }

  .zenkai-accordion__item + .zenkai-accordion__item {
    border-top: 1px solid rgba(26, 27, 46, 0.08);
  }

  .zenkai-accordion__trigger {
    width: 100%;
    padding: 1rem 1.1rem;
    border: 0;
    background: none;
    color: #202225;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.35;
    text-align: left;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: color 0.2s ease;
  }

  .zenkai-accordion__trigger:hover,
  .zenkai-accordion__trigger:focus {
    background: rgba(26, 27, 46, 0.03);
  }
  .zenkai-accordion__trigger:active {
    background: rgba(26, 27, 46, 0.06);
  }
  .zenkai-accordion__trigger:focus-visible {
    outline: 2px solid #59b7a7;
    outline-offset: 2px;
  }

  .zenkai-accordion__icon {
    width: 18px;
    height: 18px;
    position: relative;
    flex: 0 0 auto;
    transition: transform 0.25s ease;
  }

  .zenkai-accordion__icon::before,
  .zenkai-accordion__icon::after {
    content: "";
    position: absolute;
    background: rgba(26, 27, 46, 0.72);
    transition: all 0.25s ease;
  }

  .zenkai-accordion__icon::before {
    top: 50%;
    left: 0;
    width: 100%;
    height: 2px;
    transform: translateY(-50%);
  }

  .zenkai-accordion__icon::after {
    top: 0;
    left: 50%;
    width: 2px;
    height: 100%;
    transform: translateX(-50%);
  }

  .zenkai-accordion__trigger.is-active .zenkai-accordion__icon {
    transform: rotate(45deg);
  }

  .zenkai-accordion__content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .zenkai-accordion__content.is-active {
    max-height: 1400px;
  }

  .zenkai-accordion__inner {
    padding: 0 1.1rem 1rem;
    color: #555872;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .zenkai-accordion__inner p {
    margin: 0 0 0.7rem;
  }

  .zenkai-accordion__inner p:last-child {
    margin-bottom: 0;
  }

  .zenkai-accordion__inner ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .zenkai-accordion__inner li {
    position: relative;
    padding-left: 1.05rem;
    margin-bottom: 0.55rem;
  }

  .zenkai-accordion__inner li:last-child {
    margin-bottom: 0;
  }

  .zenkai-accordion__inner li::before {
    content: "";
    position: absolute;
    top: 0.55rem;
    left: 0;
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 999px;
    background: #59b7a7;
  }

  .zenkai-utility-note {
    margin-top: 0.8rem;
    padding: 0.75rem 0.85rem;
    border-radius: 14px;
    background: #eaf7f3;
    color: #202225;
  }

  .zenkai-utility-note strong {
    color: #202225;
  }

  .zenkai-faq-item {
    margin-bottom: 0.9rem;
  }

  .zenkai-faq-item:last-child {
    margin-bottom: 0;
  }

  .zenkai-faq-question {
    margin-bottom: 0.35rem;
    color: #202225;
    font-weight: 700;
  }

  .zenkai-faq-answer {
    color: #6b6f85;
  }

  @media (max-width: 767px) {
    .zenkai-accordion__trigger {
      padding: 0.9rem;
    }
    .zenkai-accordion__inner {
      padding: 0 0.9rem 0.9rem;
    }
  }
</style>

<div class="zenkai-accordion">
  <div class="zenkai-accordion__item">
    <button type="button" class="zenkai-accordion__trigger is-active" aria-expanded="true" aria-controls="zenkai-size-{{ section_id }}">
      <span>{{ zenkai_detail_specs_label }}</span>
      <span class="zenkai-accordion__icon"></span>
    </button>
    <div id="zenkai-size-{{ section_id }}" class="zenkai-accordion__content is-active">
      <div class="zenkai-accordion__inner">
        {% case zenkai_detail_category %}
          {% when 'collectible' %}
            <p><strong>A layered display scene with detail from every angle.</strong></p>
            <ul>
              {% if section.settings.product_outcome_1 != blank %}<li>{{ section.settings.product_outcome_1 }}</li>{% endif %}
              {% if section.settings.product_outcome_2 != blank %}<li>{{ section.settings.product_outcome_2 }}</li>{% endif %}
              {% if section.settings.product_outcome_3 != blank %}<li>{{ section.settings.product_outcome_3 }}</li>{% endif %}
            </ul>
          {% when 'hoodie' %}
            <p><strong>True-to-size retail fit: structured through the shoulders, comfortable through the body.</strong></p>
            <ul>
              <li>Runs true to size</li>
              <li>If you're between sizes or prefer a relaxed layer, size up one</li>
              <li>Premium heavyweight fleece with a soft cotton face and cozy brushed interior</li>
            </ul>
          {% when 'pin' %}
            <p><strong>Collector-style hard enamel badges with no apparel sizing to guess.</strong></p>
            <ul>
              <li>Includes the full 8-piece gym badge set</li>
              <li>Polished hard enamel finish with secure metal clutch backings</li>
              <li>Made for backpacks, jackets, hats, cork boards, and display cases</li>
            </ul>
          {% when 'cap' %}
            <p><strong>Clean structured fit with an adjustable strap closure.</strong></p>
            <ul>
              <li>One size fits most</li>
              <li>Structured dad-cap profile with clean embroidered detail</li>
              <li>Adjust the strap for a closer or more relaxed fit</li>
            </ul>
          {% else %}
            <p><strong>True-to-size retail fit: soft from day one, comfortable through the body.</strong></p>
            <ul>
              <li>Runs true to size</li>
              <li>If you're between sizes or prefer a relaxed look, size up one</li>
              <li>100% ring-spun cotton at a midweight feel - soft from day one, holds shape after washing</li>
            </ul>
        {% endcase %}
      </div>
    </div>
  </div>

  <div class="zenkai-accordion__item">
    <button type="button" class="zenkai-accordion__trigger" aria-expanded="false" aria-controls="zenkai-shipping-{{ section_id }}">
      <span>Shipping</span>
      <span class="zenkai-accordion__icon"></span>
    </button>
    <div id="zenkai-shipping-{{ section_id }}" class="zenkai-accordion__content">
      <div class="zenkai-accordion__inner">
        {% if zenkai_detail_category == 'pin' %}
          <p><strong>Ships ready to gift.</strong></p>
        {% elsif zenkai_detail_category == 'collectible' %}
          {% if zenkai_detail_eternal_wish %}
            <p><strong>Packed for protected delivery as a layered sculpted display.</strong></p>
          {% else %}
            <p><strong>Arrives in multiple components, ready to assemble for display.</strong></p>
          {% endif %}
        {% else %}
          <p><strong>Made to order in the USA.</strong></p>
        {% endif %}
        <ul>
          {% if zenkai_detail_category == 'collectible' %}
            <li>Delivery timing is shown at checkout</li>
          {% else %}
            <li>Most orders ship within 1 to 2 business days</li>
          {% endif %}
          <li>Free U.S. shipping on every order</li>
          <li>You'll get tracking the moment it ships</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="zenkai-accordion__item">
    <button type="button" class="zenkai-accordion__trigger" aria-expanded="false" aria-controls="zenkai-description-{{ section_id }}">
      <span>Why it gets noticed</span>
      <span class="zenkai-accordion__icon"></span>
    </button>
    <div id="zenkai-description-{{ section_id }}" class="zenkai-accordion__content">
      <div class="zenkai-accordion__inner">
        {% if zenkai_detail_category == 'pin' %}
          <p><strong>For collectors who want the whole badge run, not a random single.</strong></p>
          <p>The set reads playful and display-worthy: bright enamel color, classic badge shapes, and a polished finish that works on bags, jackets, cork boards, or shelves.</p>
          <p>It is easy to gift, easy to collect, and small enough to carry the reference every day.</p>
        {% elsif zenkai_detail_category == 'collectible' %}
          {% if zenkai_detail_eternal_wish %}
            <p><strong>For the shelf that needs one unmistakable silhouette.</strong></p>
            <p>Three sweeping green coils build a layered 23 cm scene around white cloud effects, gold lightning accents, rocky peaks, and a small rider on a golden cloud.</p>
            <p>The painted textures and overlapping forms give the display a different read from the front, side, and three-quarter view.</p>
          {% else %}
            <p><strong>For the shelf that needs one unmistakable silhouette.</strong></p>
            <p>The coiled sculpt reads clearly in daylight; after dark, the concentric base and translucent effects turn the entire scene into a warm focal point.</p>
            <p>Painted texture, clear supports, and layered light give you something new to notice from every angle.</p>
          {% endif %}
        {% else %}
          <p><strong>For the ones who like the reference, not the costume.</strong></p>
          <p>Every design is an original reimagining: sometimes playful, sometimes abstract, always made to feel like something you'd actually wear.</p>
          <p>Customers call out the same things again and again: the designs get compliments, and the blanks feel good enough to keep in rotation.</p>
        {% endif %}
      </div>
    </div>
  </div>

  {% unless zenkai_detail_category == 'pin' %}
    <div class="zenkai-accordion__item">
      <button type="button" class="zenkai-accordion__trigger" aria-expanded="false" aria-controls="zenkai-brand-{{ section_id }}">
        <span>{% if zenkai_detail_category == 'collectible' %}Story behind the display{% else %}Story behind the design{% endif %}</span>
        <span class="zenkai-accordion__icon"></span>
      </button>
      <div id="zenkai-brand-{{ section_id }}" class="zenkai-accordion__content">
        <div class="zenkai-accordion__inner">
          {% if zenkai_detail_category == 'collectible' %}
            <p><strong>Familiar energy, rebuilt as a centerpiece.</strong></p>
            <p>Zenkai display pieces focus on unmistakable silhouettes, layered detail, and the kind of presence that changes the shelf around them.</p>
          {% else %}
            <p><strong>The references you grew up with, redrawn with a point of view.</strong></p>
            <p>Zenkai exists for the pieces you always wished existed: modern linework, subtle jokes, nostalgic energy, and prints that get noticed without feeling like a costume.</p>
          {% endif %}
          {% if product.description %}
            <div class="rte" style="margin-top: 0.8rem;">{{ product.description }}</div>
          {% endif %}
        </div>
      </div>
    </div>
  {% endunless %}

  <!-- Include any custom tabs from product tags -->
  {% for tag in product.tags %}
    {% if tag contains '_tab' %}
      {%- assign include_page_handle = tag | split: '_' -%}
      {%- assign include_page = pages[include_page_handle.last] -%}
      {% if include_page.title != blank %}
        <div class="zenkai-accordion__item">
          <button type="button" class="zenkai-accordion__trigger" aria-expanded="false" aria-controls="zenkai-custom-{{ include_page_handle.last }}-{{ section_id }}">
            <span>{{ include_page.title }}</span>
            <span class="zenkai-accordion__icon"></span>
          </button>
          <div id="zenkai-custom-{{ include_page_handle.last }}-{{ section_id }}" class="zenkai-accordion__content">
            <div class="zenkai-accordion__inner rte">
              {{ include_page.content }}
            </div>
          </div>
        </div>
      {% endif %}
    {% endif %}
  {% endfor %}

  <!-- Include global content pages if set in theme settings -->
  {% if settings.product_content_1 != blank %}
    <div class="zenkai-accordion__item">
      <button type="button" class="zenkai-accordion__trigger" aria-expanded="false" aria-controls="zenkai-content-1-{{ section_id }}">
        <span>{{ pages[settings.product_content_1].title }}</span>
        <span class="zenkai-accordion__icon"></span>
      </button>
      <div id="zenkai-content-1-{{ section_id }}" class="zenkai-accordion__content">
        <div class="zenkai-accordion__inner rte">
          {{ pages[settings.product_content_1].content }}
        </div>
      </div>
    </div>
  {% endif %}

  {% if settings.product_content_2 != blank %}
    <div class="zenkai-accordion__item">
      <button type="button" class="zenkai-accordion__trigger" aria-expanded="false" aria-controls="zenkai-content-2-{{ section_id }}">
        <span>{{ pages[settings.product_content_2].title }}</span>
        <span class="zenkai-accordion__icon"></span>
      </button>
      <div id="zenkai-content-2-{{ section_id }}" class="zenkai-accordion__content">
        <div class="zenkai-accordion__inner rte">
          {{ pages[settings.product_content_2].content }}
        </div>
      </div>
    </div>
  {% endif %}

  {% if settings.product_content_3 != blank %}
    <div class="zenkai-accordion__item">
      <button type="button" class="zenkai-accordion__trigger" aria-expanded="false" aria-controls="zenkai-content-3-{{ section_id }}">
        <span>{{ pages[settings.product_content_3].title }}</span>
        <span class="zenkai-accordion__icon"></span>
      </button>
      <div id="zenkai-content-3-{{ section_id }}" class="zenkai-accordion__content">
        <div class="zenkai-accordion__inner rte">
          {{ pages[settings.product_content_3].content }}
        </div>
      </div>
    </div>
  {% endif %}

  <!-- Contact Form if enabled -->
  {% if settings.product_contact %}
    {% form 'contact' %}
      <div class="zenkai-accordion__item">
        <button type="button" class="zenkai-accordion__trigger" aria-expanded="false" aria-controls="zenkai-contact-{{ section_id }}">
          <span>{{ settings.product_contact_title }}</span>
          <span class="zenkai-accordion__icon"></span>
        </button>
        <div id="zenkai-contact-{{ section_id }}" class="zenkai-accordion__content">
          <div class="zenkai-accordion__inner">
            <div class="form-vertical">
              <input type="hidden" name="contact[product]" value="Product question for: {{ shop.secure_url }}/admin/products/{{ product.id }}">

              <div class="grid grid--small">
                <div class="grid__item medium-up--one-half">
                  <label for="ContactFormName-{{ blockId }}">{{ 'contact.form.name' | t }}</label>
                  <input type="text" id="ContactFormName-{{ blockId }}" class="input-full" name="contact[name]" autocapitalize="words" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
                </div>

                <div class="grid__item medium-up--one-half">
                  <label for="ContactFormEmail-{{ blockId }}">{{ 'contact.form.email' | t }}</label>
                  <input type="email" id="ContactFormEmail-{{ blockId }}" class="input-full" name="contact[email]" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
                </div>
              </div>

              {% if settings.product_contact_show_phone %}
                <label for="ContactFormPhone-{{ blockId }}">{{ 'contact.form.phone' | t }}</label>
                <input type="tel" id="ContactFormPhone-{{ blockId }}" class="input-full" name="contact[phone]" pattern="[0-9\-]*" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}">
              {% endif %}

              <label for="ContactFormMessage-{{ blockId }}">{{ 'contact.form.message' | t }}</label>
              <textarea rows="5" id="ContactFormMessage-{{ blockId }}" class="input-full" name="contact[body]">{% if form.body %}{{ form.body }}{% endif %}</textarea>

              <button type="submit" class="btn">
                {{ 'contact.form.send' | t }}
              </button>
            </div>
          </div>
        </div>
      </div>

      {% if form.posted_successfully? %}
        <p class="note note--success">
          {{ 'contact.form.post_success' | t }}
        </p>
      {% endif %}

      {% if form.errors %}
        {{ form.errors | default_errors }}
      {% endif %}
    {% endform %}
  {% endif %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const accordionTriggers = document.querySelectorAll('.zenkai-accordion__trigger');

    function setAccordionState(trigger, isOpen) {
      if (!trigger) {
        return;
      }

      const contentId = trigger.getAttribute('aria-controls');
      const content = contentId ? document.getElementById(contentId) : trigger.nextElementSibling;

      if (!content) {
        return;
      }

      trigger.classList.toggle('is-active', isOpen);
      trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      content.classList.toggle('is-active', isOpen);
    }

    accordionTriggers.forEach(trigger => {
      setAccordionState(trigger, trigger.classList.contains('is-active') || trigger.getAttribute('aria-expanded') === 'true');
    });
    
    accordionTriggers.forEach(trigger => {
      trigger.addEventListener('click', function() {
        const isActive = this.classList.contains('is-active');
        setAccordionState(this, !isActive);
      });
    });

  });
</script>
