{%- assign image_loading = loading | default: 'lazy' -%}
{%- assign image_sizes = sizes | default: '(min-width: 900px) 50vw, 100vw' -%}
{%- if photo != blank -%}
  <img src="{{ photo | image_url: width: 1440 }}" srcset="{%- assign candidate_widths = '240,360,480,600,720,960,1200' | split: ',' -%}{%- for candidate in candidate_widths -%}{%- assign candidate_width = candidate | plus: 0 -%}{%- if candidate_width < photo.width -%}{{ photo | image_url: width: candidate_width }} {{ candidate_width }}w, {% endif %}{%- endfor -%}{{ photo | image_url: width: photo.width }} {{ photo.width }}w" sizes="{{ image_sizes }}" width="{{ photo.width }}" height="{{ photo.height }}" alt="{{ alt | escape }}" decoding="async" loading="{{ image_loading }}" {% if image_loading == 'eager' %}fetchpriority="high"{% endif %}>
{%- elsif fallback != blank -%}
  {%- assign small_asset = fallback | append: '-480.webp' -%}
  {%- assign large_asset = fallback | append: '-960.webp' -%}
  <img src="{{ large_asset | asset_url }}" srcset="{{ small_asset | asset_url }} 480w, {{ large_asset | asset_url }} 960w" sizes="{{ image_sizes }}" width="960" height="960" alt="{{ alt | escape }}" decoding="async" loading="{{ image_loading }}" {% if image_loading == 'eager' %}fetchpriority="high"{% endif %}>
{%- endif -%}
