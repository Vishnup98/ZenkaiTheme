{%- comment -%}
  Summoning Glow after-add offer

  This offer is intentionally scoped to the Summoning Glow PDP. Eternal Wish is
  kept as its own product/SKU so it can be added as a true cart line. The source
  product remains its own unlisted Shopify product and cart line.
{%- endcomment -%}

{%- if product.handle == 'summoning-glow-16cm-led-dragon-display' -%}
  {%- assign zenkai_glow_companion = all_products['eternal-wish-23cm-coiled-dragon-rider-display'] -%}
  <div class="zk-glow-upsell" data-zk-glow-upsell hidden aria-hidden="true">
    <div class="zk-glow-upsell__scrim" data-zk-glow-skip></div>
    <section
      class="zk-glow-upsell__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="zk-glow-upsell-title"
      aria-describedby="zk-glow-upsell-copy zk-glow-upsell-policy">
      <button type="button" class="zk-glow-upsell__close" data-zk-glow-skip aria-label="Skip this offer and continue to checkout">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>

      <div class="zk-glow-upsell__media" data-zk-glow-carousel>
        <div class="zk-glow-upsell__track" data-zk-glow-carousel-track>
          <div class="zk-glow-upsell__slide" data-zk-glow-carousel-slide aria-hidden="false">
            <picture>
              <source
                media="(max-width: 767px)"
                srcset="{{ 'summoning-glow-complete-set-mobile-v2.jpg' | asset_url }}">
              <img
                src="{{ 'summoning-glow-complete-set-desktop-v2.jpg' | asset_url }}"
                alt="Summoning Glow and the Eternal Wish coiled dragon and rider collectible displayed together"
                width="1536"
                height="1024"
                loading="eager"
                fetchpriority="high">
            </picture>
          </div>
          {%- for zenkai_glow_companion_image in zenkai_glow_companion.images limit: 3 -%}
            <div class="zk-glow-upsell__slide" data-zk-glow-carousel-slide aria-hidden="true">
              <img
                src="{{ zenkai_glow_companion_image | image_url: width: 1400 }}"
                srcset="{{ zenkai_glow_companion_image | image_url: width: 700 }} 700w,
                        {{ zenkai_glow_companion_image | image_url: width: 1000 }} 1000w,
                        {{ zenkai_glow_companion_image | image_url: width: 1400 }} 1400w"
                sizes="(max-width: 767px) calc(100vw - 24px), 820px"
                alt="{{ zenkai_glow_companion_image.alt | default: zenkai_glow_companion.title | escape }}"
                width="{{ zenkai_glow_companion_image.width }}"
                height="{{ zenkai_glow_companion_image.height }}"
                loading="lazy">
            </div>
          {%- endfor -%}
        </div>

        {%- if zenkai_glow_companion.images.size > 0 -%}
          <button type="button" class="zk-glow-upsell__carousel-arrow zk-glow-upsell__carousel-arrow--prev" data-zk-glow-carousel-prev aria-label="Show previous product image">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button type="button" class="zk-glow-upsell__carousel-arrow zk-glow-upsell__carousel-arrow--next" data-zk-glow-carousel-next aria-label="Show next product image">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
          <div class="zk-glow-upsell__carousel-dots" aria-label="Product images">
            <button type="button" class="is-active" data-zk-glow-carousel-dot data-slide-index="0" aria-label="Show collection image 1" aria-current="true"></button>
            {%- for zenkai_glow_companion_image in zenkai_glow_companion.images limit: 3 -%}
              <button type="button" data-zk-glow-carousel-dot data-slide-index="{{ forloop.index }}" aria-label="Show Eternal Wish image {{ forloop.index | plus: 1 }}" aria-current="false"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
        <span class="zk-glow-upsell__badge">Complete Collection offer</span>
      </div>

      <div class="zk-glow-upsell__copy">
        <p class="zk-glow-upsell__eyebrow">Complete the collectible set</p>
        <h2 id="zk-glow-upsell-title">Bring home the full summoning display.</h2>
        <p id="zk-glow-upsell-copy" class="zk-glow-upsell__intro">You have the illuminated centerpiece. Add the 23 cm coiled dragon-and-rider display and the Complete Collection discount automatically takes $50 off.</p>

        <div class="zk-glow-upsell__product-line">
          <div>
            <h3>Eternal Wish — 23cm Coiled Dragon &amp; Rider Display</h3>
            <p>Painted PVC · Three sweeping coils · Approximately 9.05 in / 23 cm</p>
          </div>
          <div class="zk-glow-upsell__price" aria-label="Regular price $99.99. Complete Collection price $49.99. Save $50.">
            <s>$99.99</s>
            <strong>$49.99</strong>
            <span>Save $50</span>
          </div>
        </div>

        <ul class="zk-glow-upsell__benefits" aria-label="Offer details">
          <li>A 23 cm layered dragon-and-rider companion</li>
          <li>Automatic Complete Collection discount</li>
          <li>Most orders arrive within one business week</li>
          <li>No subscription or recurring charge</li>
        </ul>

        <p id="zk-glow-upsell-policy" class="zk-glow-upsell__policy"><strong>Final sale:</strong> replacement or refund only if the display arrives damaged or defective.</p>

        <button type="button" class="zk-glow-upsell__add" data-zk-glow-add>
          <span>Complete the set — add for $49.99 &amp; checkout</span>
        </button>
        <button type="button" class="zk-glow-upsell__skip" data-zk-glow-skip>No thanks, checkout with Summoning Glow</button>
        <p class="zk-glow-upsell__status" data-zk-glow-status role="status" aria-live="polite"></p>
      </div>
    </section>
  </div>

  <script type="application/json" data-zk-glow-upsell-config>
    {
      "mainProductId": {{ product.id | json }},
      "upsellVariantId": 47934894473321,
      "upsellProductId": 9420423463017,
      "upsellSku": "ZK-FIG-EW23-CD"
    }
  </script>

  <style>
    .zk-glow-upsell[hidden] { display: none !important; }

    .zk-glow-upsell {
      position: fixed;
      inset: 0;
      z-index: 2147483000;
      display: grid;
      place-items: center;
      padding: 24px;
      color: #202225;
      font-family: inherit;
    }

    .zk-glow-upsell__scrim {
      position: absolute;
      inset: 0;
      background: rgba(12, 15, 18, 0.78);
      backdrop-filter: blur(6px);
    }

    .zk-glow-upsell__dialog {
      position: relative;
      display: block;
      width: min(820px, 100%);
      max-height: min(760px, calc(100vh - 48px));
      overflow-x: hidden;
      overflow-y: auto;
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 24px;
      background: #fff;
      box-shadow: 0 32px 100px rgba(0, 0, 0, 0.42);
      transform: translateY(18px) scale(0.985);
      opacity: 0;
      transition: transform 180ms ease, opacity 180ms ease;
    }

    .zk-glow-upsell.is-open .zk-glow-upsell__dialog {
      transform: translateY(0) scale(1);
      opacity: 1;
    }

    .zk-glow-upsell__close {
      position: absolute;
      top: 14px;
      right: 14px;
      z-index: 2;
      display: grid;
      width: 38px;
      height: 38px;
      place-items: center;
      padding: 0;
      border: 1px solid rgba(32, 34, 37, 0.12);
      border-radius: 50%;
      color: #202225;
      background: rgba(255, 255, 255, 0.92);
      cursor: pointer;
    }

    .zk-glow-upsell__media {
      position: relative;
      height: 300px;
      overflow: hidden;
      background: #06120f;
      touch-action: pan-y;
    }

    .zk-glow-upsell__media::after {
      position: absolute;
      inset: auto 0 0;
      z-index: 1;
      height: 42%;
      content: '';
      background: linear-gradient(to top, rgba(15, 45, 37, 0.25), transparent);
      pointer-events: none;
    }

    .zk-glow-upsell__track {
      display: flex;
      height: 100%;
      transform: translate3d(0, 0, 0);
      transition: transform 220ms ease;
      will-change: transform;
    }

    .zk-glow-upsell__slide {
      flex: 0 0 100%;
      width: 100%;
      height: 100%;
    }

    .zk-glow-upsell__slide picture,
    .zk-glow-upsell__slide img {
      display: block;
      width: 100%;
      height: 100%;
    }

    .zk-glow-upsell__slide img {
      min-height: 0;
      object-fit: contain;
      object-position: center;
    }

    .zk-glow-upsell__carousel-arrow {
      position: absolute;
      top: 50%;
      z-index: 2;
      display: grid;
      width: 38px;
      height: 38px;
      place-items: center;
      padding: 0;
      border: 1px solid rgba(255, 255, 255, 0.3);
      border-radius: 50%;
      color: #fff;
      background: rgba(15, 20, 19, 0.68);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
      cursor: pointer;
      transform: translateY(-50%);
      transition: background 140ms ease, transform 140ms ease;
    }

    .zk-glow-upsell__carousel-arrow:hover,
    .zk-glow-upsell__carousel-arrow:focus-visible {
      background: rgba(15, 20, 19, 0.9);
      transform: translateY(-50%) scale(1.04);
    }

    .zk-glow-upsell__carousel-arrow--prev { left: 14px; }
    .zk-glow-upsell__carousel-arrow--next { right: 14px; }

    .zk-glow-upsell__carousel-dots {
      position: absolute;
      right: 18px;
      bottom: 18px;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 7px 9px;
      border-radius: 999px;
      background: rgba(15, 20, 19, 0.68);
    }

    .zk-glow-upsell__carousel-dots button {
      width: 7px;
      height: 7px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.48);
      cursor: pointer;
      transition: width 140ms ease, background 140ms ease;
    }

    .zk-glow-upsell__carousel-dots button.is-active {
      width: 18px;
      border-radius: 999px;
      background: #fff;
    }

    .zk-glow-upsell__badge {
      position: absolute;
      left: 18px;
      bottom: 18px;
      z-index: 1;
      padding: 8px 12px;
      border-radius: 999px;
      color: #fff;
      background: #202225;
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      line-height: 1;
      text-transform: uppercase;
    }

    .zk-glow-upsell__copy {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 28px 38px 32px;
    }

    .zk-glow-upsell__eyebrow {
      margin: 0 0 10px;
      color: #14735d;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .zk-glow-upsell__copy h2 {
      margin: 0;
      color: #161819;
      font-size: clamp(1.85rem, 3.6vw, 2.7rem);
      line-height: 1;
      letter-spacing: -0.045em;
    }

    .zk-glow-upsell__intro {
      margin: 12px 0 17px;
      color: #5a5f61;
      font-size: 1rem;
      line-height: 1.55;
    }

    .zk-glow-upsell__product-line {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 20px;
      align-items: start;
      padding: 18px 0;
      border-top: 1px solid #dfe6e3;
      border-bottom: 1px solid #dfe6e3;
    }

    .zk-glow-upsell__product-line h3 {
      margin: 0 0 6px;
      color: #202225;
      font-size: 1rem;
      line-height: 1.25;
    }

    .zk-glow-upsell__product-line p {
      margin: 0;
      color: #6a706f;
      font-size: 0.82rem;
      line-height: 1.4;
    }

    .zk-glow-upsell__price {
      display: grid;
      justify-items: end;
      gap: 2px;
      white-space: nowrap;
    }

    .zk-glow-upsell__price s {
      color: #8b918f;
      font-size: 0.82rem;
    }

    .zk-glow-upsell__price strong {
      color: #202225;
      font-size: 1.2rem;
      line-height: 1;
    }

    .zk-glow-upsell__price span {
      color: #14735d;
      font-size: 0.7rem;
      font-weight: 900;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .zk-glow-upsell__benefits {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin: 15px 0 18px;
      padding: 0;
      color: #3c4241;
      font-size: 0.86rem;
      list-style: none;
    }

    .zk-glow-upsell__benefits li {
      position: relative;
      padding-left: 22px;
    }

    .zk-glow-upsell__benefits li::before {
      position: absolute;
      top: 0.06em;
      left: 0;
      color: #14735d;
      content: '✓';
      font-weight: 900;
    }

    .zk-glow-upsell__policy {
      margin: -4px 0 14px;
      color: #626866;
      font-size: 0.76rem;
      line-height: 1.4;
      text-align: center;
    }

    .zk-glow-upsell__policy strong {
      color: #343937;
      font-weight: 850;
    }

    .zk-glow-upsell__add {
      width: 100%;
      min-height: 54px;
      padding: 14px 20px;
      border: 0;
      border-radius: 10px;
      color: #15221e;
      background: #78d8bd;
      box-shadow: 0 8px 22px rgba(35, 139, 111, 0.2);
      font: inherit;
      font-size: 0.92rem;
      font-weight: 800;
      cursor: pointer;
      transition: transform 140ms ease, background 140ms ease;
    }

    .zk-glow-upsell__add:hover {
      background: #8ee4cb;
      transform: translateY(-1px);
    }

    .zk-glow-upsell__add:disabled {
      cursor: wait;
      opacity: 0.68;
      transform: none;
    }

    .zk-glow-upsell__skip {
      align-self: center;
      margin: 14px 0 0;
      padding: 4px;
      border: 0;
      color: #5d6462;
      background: transparent;
      font: inherit;
      font-size: 0.82rem;
      text-decoration: underline;
      text-underline-offset: 3px;
      cursor: pointer;
    }

    .zk-glow-upsell__status {
      min-height: 1.2em;
      margin: 10px 0 0;
      color: #b42318;
      font-size: 0.78rem;
      line-height: 1.35;
      text-align: center;
    }

    body.zk-glow-upsell-open { overflow: hidden; }

    @media (max-width: 767px) {
      .zk-glow-upsell {
        place-items: end center;
        padding: 12px;
      }

      .zk-glow-upsell__dialog {
        display: block;
        max-height: calc(100vh - 24px);
        overflow-y: auto;
        border-radius: 20px;
      }

      .zk-glow-upsell__media {
        height: 250px;
      }

      .zk-glow-upsell__media img {
        min-height: 0;
        object-fit: contain;
        object-position: center;
      }

      .zk-glow-upsell__badge {
        left: 12px;
        bottom: 12px;
      }

      .zk-glow-upsell__carousel-arrow {
        width: 34px;
        height: 34px;
      }

      .zk-glow-upsell__carousel-arrow--prev { left: 10px; }
      .zk-glow-upsell__carousel-arrow--next { right: 10px; }

      .zk-glow-upsell__carousel-dots {
        right: 12px;
        bottom: 12px;
      }

      .zk-glow-upsell__copy {
        padding: 22px 22px 24px;
      }

      .zk-glow-upsell__copy h2 {
        padding-right: 18px;
        font-size: clamp(1.85rem, 9vw, 2.65rem);
      }

      .zk-glow-upsell__intro {
        margin: 12px 0 16px;
        font-size: 0.91rem;
      }

      .zk-glow-upsell__product-line {
        gap: 12px;
        padding: 14px 0;
      }

      .zk-glow-upsell__benefits {
        grid-template-columns: 1fr;
        margin: 14px 0 18px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .zk-glow-upsell__dialog,
      .zk-glow-upsell__add,
      .zk-glow-upsell__track { transition: none; }
    }
  </style>

  <script>
    (function() {
      'use strict';

      if (window.__zkSummoningGlowUpsellLoaded) return;
      window.__zkSummoningGlowUpsellLoaded = true;

      var modal = document.querySelector('[data-zk-glow-upsell]');
      var configNode = document.querySelector('[data-zk-glow-upsell-config]');
      if (!modal || !configNode) return;

      var config;
      try {
        config = JSON.parse(configNode.textContent);
      } catch (error) {
        return;
      }

      var state = {
        busy: false,
        mainAdded: false,
        carouselIndex: 0,
        carouselTouchStartX: null
      };
      var dialog = modal.querySelector('.zk-glow-upsell__dialog');
      var closeButton = modal.querySelector('.zk-glow-upsell__close');
      var addButton = modal.querySelector('[data-zk-glow-add]');
      var statusNode = modal.querySelector('[data-zk-glow-status]');
      var carousel = modal.querySelector('[data-zk-glow-carousel]');
      var carouselTrack = modal.querySelector('[data-zk-glow-carousel-track]');
      var carouselSlides = Array.prototype.slice.call(modal.querySelectorAll('[data-zk-glow-carousel-slide]'));
      var carouselDots = Array.prototype.slice.call(modal.querySelectorAll('[data-zk-glow-carousel-dot]'));

      function showCarouselSlide(index) {
        if (!carouselTrack || carouselSlides.length < 2) return;
        if (index < 0) index = carouselSlides.length - 1;
        if (index >= carouselSlides.length) index = 0;
        state.carouselIndex = index;
        carouselTrack.style.transform = 'translate3d(-' + (index * 100) + '%, 0, 0)';
        carouselSlides.forEach(function(slide, slideIndex) {
          slide.setAttribute('aria-hidden', slideIndex === index ? 'false' : 'true');
        });
        carouselDots.forEach(function(dot, dotIndex) {
          var active = dotIndex === index;
          dot.classList.toggle('is-active', active);
          dot.setAttribute('aria-current', active ? 'true' : 'false');
        });
      }

      function moveCarousel(direction) {
        showCarouselSlide(state.carouselIndex + direction);
      }

      showCarouselSlide(0);

      if (carousel) {
        carousel.addEventListener('touchstart', function(event) {
          state.carouselTouchStartX = event.touches && event.touches[0]
            ? event.touches[0].clientX
            : null;
        }, { passive: true });
        carousel.addEventListener('touchend', function(event) {
          if (state.carouselTouchStartX === null) return;
          var endX = event.changedTouches && event.changedTouches[0]
            ? event.changedTouches[0].clientX
            : state.carouselTouchStartX;
          var distance = endX - state.carouselTouchStartX;
          state.carouselTouchStartX = null;
          if (Math.abs(distance) < 42) return;
          moveCarousel(distance > 0 ? -1 : 1);
        }, { passive: true });
      }

      function getCleanXHR() {
        return new Promise(function(resolve, reject) {
          if (window.__zkGlowCleanXHRFrame && window.__zkGlowCleanXHRFrame.contentWindow) {
            try {
              resolve(new window.__zkGlowCleanXHRFrame.contentWindow.XMLHttpRequest());
              return;
            } catch (error) {}
          }

          var frame = document.createElement('iframe');
          frame.style.cssText = 'display:none!important;width:0;height:0;border:0;position:absolute;';
          frame.setAttribute('aria-hidden', 'true');
          frame.src = 'about:blank';
          document.body.appendChild(frame);
          window.__zkGlowCleanXHRFrame = frame;
          window.setTimeout(function() {
            try {
              resolve(new frame.contentWindow.XMLHttpRequest());
            } catch (error) {
              reject(error);
            }
          }, 0);
        });
      }

      function request(method, url, body, contentType) {
        return getCleanXHR().then(function(xhr) {
          return new Promise(function(resolve, reject) {
            xhr.open(method, url, true);
            xhr.setRequestHeader('Accept', 'application/json');
            if (contentType) xhr.setRequestHeader('Content-Type', contentType);
            xhr.onreadystatechange = function() {
              if (xhr.readyState !== 4) return;
              var response = {};
              try { response = JSON.parse(xhr.responseText); } catch (error) {}
              if (xhr.status >= 200 && xhr.status < 300) {
                resolve(response);
              } else {
                reject(new Error(response.description || response.message || 'That item could not be added.'));
              }
            };
            xhr.onerror = function() { reject(new Error('That item could not be added.')); };
            xhr.send(body || null);
          });
        });
      }

      function formBody(form) {
        var source = new FormData(form);
        var body = new URLSearchParams();
        var hasQuantity = false;
        source.forEach(function(value, key) {
          if (!key || key.indexOf('data-') === 0) return;
          if (key === 'quantity') hasQuantity = true;
          body.append(key, value);
        });
        if (!hasQuantity) body.append('quantity', '1');
        return body.toString();
      }

      function matchesMainForm(form) {
        if (!form || !form.matches || !form.matches('form')) return false;
        var productInput = form.querySelector('[name="data-product-id"]');
        return Boolean(productInput && String(productInput.value) === String(config.mainProductId));
      }

      function quietCandyRack() {
        try { document.body.classList.remove('candyrack-popup-show', 'cr-slider-open'); } catch (error) {}
        try { if (window.CandyRack && window.CandyRack.hideSlider) window.CandyRack.hideSlider(); } catch (error) {}
        [
          '#candyrack-frame',
          '#candyrack-slider-cart',
          '.candyrack-slider-cart',
          '.CandyRack-CartSlider'
        ].forEach(function(selector) {
          try {
            document.querySelectorAll(selector).forEach(function(node) {
              node.style.setProperty('display', 'none', 'important');
              node.setAttribute('aria-hidden', 'true');
            });
          } catch (error) {}
        });
      }

      function setBusy(button, busy) {
        state.busy = busy;
        if (!button) return;
        button.disabled = busy;
        button.classList.toggle('btn--loading', busy);
        button.classList.toggle('is-loading', busy);
      }

      function setStatus(message) {
        if (statusNode) statusNode.textContent = message || '';
      }

      function openModal() {
        setStatus('');
        showCarouselSlide(0);
        modal.hidden = false;
        modal.setAttribute('aria-hidden', 'false');
        document.body.classList.add('zk-glow-upsell-open');
        window.requestAnimationFrame(function() {
          modal.classList.add('is-open');
          if (dialog) dialog.scrollTop = 0;
          if (closeButton) {
            try {
              closeButton.focus({ preventScroll: true });
            } catch (error) {
              closeButton.focus();
            }
          }
          if (dialog) dialog.scrollTop = 0;
          window.requestAnimationFrame(function() {
            if (dialog) dialog.scrollTop = 0;
          });
        });
      }

      function continueToCheckout() {
        if (state.busy) return;
        state.busy = true;
        setStatus('Opening secure checkout...');
        window.location.assign('/checkout');
      }

      function addMain(form, button) {
        if (state.busy || state.mainAdded) return;
        setBusy(button, true);
        quietCandyRack();
        request(
          'POST',
          '/cart/add.js?opens_cart=never',
          formBody(form),
          'application/x-www-form-urlencoded; charset=UTF-8'
        ).then(function() {
          state.mainAdded = true;
          openModal();
        }).catch(function(error) {
          var oldError = form.querySelector('.errors');
          if (oldError) oldError.remove();
          var errorNode = document.createElement('div');
          errorNode.className = 'errors text-center';
          errorNode.textContent = error && error.message ? error.message : 'That item could not be added.';
          form.insertBefore(errorNode, form.firstChild);
        }).then(function() {
          setBusy(button, false);
        });
      }

      function intercept(event) {
        var button = event.target && event.target.closest
          ? event.target.closest('[data-add-to-cart], .add-to-cart, button[name="add"]')
          : null;
        var form = event.type === 'submit' ? event.target : button && button.form;
        if (!matchesMainForm(form)) return;

        event.preventDefault();
        event.stopPropagation();
        if (event.stopImmediatePropagation) event.stopImmediatePropagation();
        addMain(form, button || form.querySelector('[data-add-to-cart]'));
      }

      document.addEventListener('click', intercept, true);
      document.addEventListener('submit', intercept, true);

      modal.addEventListener('click', function(event) {
        if (event.target.closest('[data-zk-glow-carousel-prev]')) {
          moveCarousel(-1);
          return;
        }

        if (event.target.closest('[data-zk-glow-carousel-next]')) {
          moveCarousel(1);
          return;
        }

        var carouselDot = event.target.closest('[data-zk-glow-carousel-dot]');
        if (carouselDot) {
          showCarouselSlide(parseInt(carouselDot.getAttribute('data-slide-index'), 10) || 0);
          return;
        }

        if (event.target.closest('[data-zk-glow-add]')) {
          if (state.busy) return;
          setBusy(addButton, true);
          setStatus('Adding Eternal Wish and opening secure checkout...');
          quietCandyRack();
          request(
            'POST',
            '/cart/add.js?upcart=1&opens_cart=never',
            'id=' + encodeURIComponent(String(config.upsellVariantId)) + '&quantity=1',
            'application/x-www-form-urlencoded; charset=UTF-8'
          ).then(function() {
            window.location.assign('/checkout');
          }).catch(function(error) {
            setStatus(error && error.message ? error.message : 'This offer is not available yet.');
            setBusy(addButton, false);
          });
          return;
        }

        if (event.target.closest('[data-zk-glow-skip]')) continueToCheckout();
      });

      document.addEventListener('keydown', function(event) {
        if (modal.hidden || state.busy) return;
        if (event.key === 'Escape') {
          continueToCheckout();
          return;
        }
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          moveCarousel(-1);
        } else if (event.key === 'ArrowRight') {
          event.preventDefault();
          moveCarousel(1);
        }
      });
    })();
  </script>
{%- endif -%}
