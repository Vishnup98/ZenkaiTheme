{%- assign zenkai_cta_text = product_cta_text | default: 'Add to Cart' -%}
{%- assign zenkai_cta_subcopy = product_cta_subcopy | default: product_cta_note | default: 'Free U.S. shipping. Printed to order.' -%}
{%- assign zenkai_secondary_checkout = true -%}
{%- assign zenkai_cta_with_price = false -%}
{%- assign zenkai_shipping_badge_text = 'Free shipping on every order' -%}
{% if zenkai_cta_text == 'Add to Cart' or zenkai_cta_text == 'Add to Bag' %}
  {%- assign zenkai_cta_with_price = true -%}
{% endif %}
{% if show_dynamic_checkout_secondary == false %}
  {%- assign zenkai_secondary_checkout = false -%}
{% endif %}

{% capture form_id %}AddToCartForm-{{ section_id }}{% endcapture %}
{% form 'product', product, id: form_id, class: 'product-single__form zenkai-product-form small--text-center' %}
  <input type="hidden" name="data-product-id" value="{{ product.id }}">
  {% if zenkai_journey_region != blank %}
    <input
      type="hidden"
      value="{{ zenkai_journey_region | escape }}"
      data-zk-journey-upsell
      data-zk-journey-region="{{ zenkai_journey_region | escape }}"
      data-zk-journey-product-title="{{ product.title | escape }}"
      data-zk-journey-product-id="{{ product.id }}">
  {% endif %}
  {% unless product.has_only_default_variant %}
    {% for option in product.options_with_values %}
      {% if variant_type == 'button' %}
        {% include 'variant-button', section_id: section_id, option_drop: option %}
      {% else %}
        {% include 'variant-dropdown', section_id: section_id %}
      {% endif %}
    {% endfor %}
  {% endunless %}

  <select name="id" id="ProductSelect-{{ section_id }}" class="product-single__variants no-js" data-product-select>
    {% for variant in product.variants %}
      {% if variant.available %}
        <option {% if variant == product.selected_or_first_available_variant %}
          selected="selected" {% endif %}
          value="{{ variant.id }}">
          {{ variant.title }} - {{ variant.price | money_with_currency }}
        </option>
      {% else %}
        <option disabled="disabled">
          {{ variant.title }} - {{ 'products.product.sold_out' | t }}
        </option>
      {% endif %}
    {% endfor %}
  </select>

  {% if quantity_enable %}
    <div class="product__quantity product__quantity--{{ variant_type }}">
      <label for="Quantity-{{ section_id }}" class="variant__label">{{ 'products.product.quantity' | t }}</label>
      <input type="number" id="Quantity-{{ section_id }}" name="quantity" value="1" min="1" max="99">
    </div>
  {% endif %}

  {%- assign enable_dynamic_buttons = false -%}
  {% if enable_payment_button and zenkai_secondary_checkout and template != 'product.preorder' %}
    {%- assign enable_dynamic_buttons = true -%}
  {% endif %}

  {% unless zenkai_product_category == 'pin' %}
    <p class="zenkai-fit-note">{{ zenkai_type_fit }}</p>
  {% endunless %}

  <div class="zenkai-product-actions" data-product-form-anchor>
    {% unless zenkai_product_category == 'pin' %}
      <div class="zenkai-trust-strip">
        <span class="zenkai-trust-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
          2,200+ orders shipped and counting
        </span>
        <span class="zenkai-trust-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
          {{ zenkai_type_trust }}
        </span>
      </div>
    {% endunless %}
    <button
      {% if product.empty? %}type="button"{% else %}type="submit"{% endif %}
      name="add"
      data-add-to-cart
      data-cta-label="{{ zenkai_cta_text | escape }}"
      data-cta-price="{% if zenkai_cta_with_price %}true{% else %}false{% endif %}"
      aria-live="polite"
      class="btn btn--full add-to-cart zenkai-primary-cta{% if enable_dynamic_buttons %} zenkai-primary-cta--with-secondary{% endif %}"
      {% unless current_variant.available %} disabled="disabled"{% endunless %}>
      <span data-add-to-cart-text>
        {% if current_variant.available %}
          {% if template == 'product.preorder' %}
            {{ 'products.product.preorder' | t }}
          {% else %}
            {{ zenkai_cta_text }}{% if zenkai_cta_with_price %} - {{ current_variant.price | money }}{% endif %}
          {% endif %}
        {% else %}
          {{ 'products.product.sold_out' | t }}
        {% endif %}
      </span>
    </button>
    {% if zenkai_product_category == 'pin' %}
      <p class="zenkai-gift-nudge"><strong>Easy gift. No size guessing.</strong> A boxed collectible for someone who still remembers every badge.</p>
    {% elsif zenkai_product_category == 'collectible' %}
      <p class="zenkai-gift-nudge"><strong>Ready for the shelf.</strong> No size guessing—just one unmistakable display piece.</p>
    {% endif %}
    {% if zenkai_ptemplate == 'summoning-glow' %}
      <p class="zenkai-arrival-note">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="1" y="3" width="15" height="13"></rect>
          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
          <circle cx="5.5" cy="18.5" r="2.5"></circle>
          <circle cx="18.5" cy="18.5" r="2.5"></circle>
        </svg>
        <span><strong>Fast tracked delivery:</strong> Most orders arrive at your door within one business week.</span>
      </p>
    {% endif %}
    {% if zenkai_primary_proof_quote != blank %}
      <div class="zenkai-proof-nudge" aria-label="Customer review">
        <span class="zenkai-proof-nudge__quote">{{ zenkai_primary_proof_quote }}</span>
        <span class="zenkai-proof-nudge__attr">{{ zenkai_primary_proof_attribution | default: 'Verified buyer' }}</span>
      </div>
    {% endif %}
  </div>

  {% if enable_dynamic_buttons %}
    <div class="zenkai-secondary-checkout">
      {{ form | payment_button }}
    </div>
  {% endif %}

  <div class="zenkai-shipping-badge">
    <svg class="zenkai-shipping-badge__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="1" y="3" width="15" height="13"></rect>
      <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
      <circle cx="5.5" cy="18.5" r="2.5"></circle>
      <circle cx="18.5" cy="18.5" r="2.5"></circle>
    </svg>
    <span class="zenkai-shipping-badge__text">{{ zenkai_shipping_badge_text }}</span>
  </div>

  {% unless zenkai_product_category == 'pin' %}
    {% if zenkai_type_benefit != blank or zenkai_type_production != blank %}
      <div class="zenkai-compact-benefits">
        {% if zenkai_type_benefit != blank %}
          <span class="zenkai-compact-benefit">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
            {{ zenkai_type_benefit }}
          </span>
        {% endif %}
        {% if zenkai_type_production != blank %}
          <span class="zenkai-compact-benefit">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
            {{ zenkai_type_production }}
          </span>
        {% endif %}
      </div>
    {% endif %}
  {% endunless %}

  {% unless product.empty? %}
    <div class="hide" aria-hidden="true" data-variant-json>
      {{ product.variants | json }}
    </div>
    {% if product.options.size > 1 %}
      <div class="hide" aria-hidden="true" data-current-variant-json>
        {{ current_variant | json }}
      </div>
    {% endif %}
  {% endunless %}

{% endform %}
