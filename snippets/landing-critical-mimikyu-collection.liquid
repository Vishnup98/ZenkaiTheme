/* Shared refinements for the complete plush collection pages. */
.ec-body { font-family:Arial,Helvetica,sans-serif; line-height:1.55; }
.ec-body .ec-page { --body-muted:#5e5863; }
.ec-body p { line-height:1.55; }
.ec-body h1 { font-size:clamp(2.25rem,3.5vw,3.25rem); line-height:1.1; letter-spacing:-.035em; }
.ec-body h2, .ec-body .ec-included h2, .ec-body .ec-reviews h2 { font-family:Arial,Helvetica,sans-serif; font-size:clamp(1.625rem,2.5vw,2.125rem); font-weight:700; line-height:1.18; letter-spacing:-.025em; }
.ec-body h3 { font-size:1.125rem; line-height:1.35; }
.ec-body .ec-eyebrow { font-size:.75rem; font-weight:600; letter-spacing:.08em; margin-bottom:10px; }
.ec-body :focus-visible { outline:2px solid #176b5b; outline-offset:3px; }
.ec-body button, .ec-body summary, .ec-body a { scroll-margin-block:5rem 7rem; }
.ec-body .ec-shell { max-width:1200px; padding-inline:28px; }
.ec-body .ec-header { position:relative; min-height:56px; height:56px; }
.ec-body .ec-hero { gap:40px; padding-block:28px 40px; }
.ec-body .ec-hero-media { align-self:center; background:transparent; }
.ec-body .ec-hero-media img { border-radius:10px; }
.ec-body .ec-hero-copy h1 { margin-bottom:14px; }
.ec-body .ec-lede { max-width:46ch; font-size:1.0625rem; line-height:1.5; color:var(--body-muted); }
.ec-body .ec-offer { margin-top:20px; padding-top:18px; }
.ec-body .ec-price { gap:12px 16px; margin-bottom:12px; }
.ec-body .ec-price > strong { font-size:2.25rem; font-weight:700; }
.ec-body .ec-price small { font-size:.8125rem; letter-spacing:0; text-transform:none; font-weight:500; }
.ec-body .ec-palette-bar { font-size:.8125rem; font-weight:500; gap:8px; margin-bottom:14px; justify-content:flex-start; }
.ec-body .ec-swatches > span { width:15px; height:15px; border-width:1px; }
.ec-body .ec-product-form { margin:0; }
.ec-body .ec-cta { min-height:52px; padding:14px 18px; font-size:1rem; font-weight:700; letter-spacing:0; border-radius:8px; }
.ec-body .ec-shipping { display:flex; flex-wrap:wrap; gap:2px 10px; justify-content:center; margin:10px 0; color:var(--body-muted); font-size:.8125rem; line-height:1.5; }
.ec-body .ec-shipping strong { color:inherit; font-weight:600; }
.ec-body .ec-offer-policy { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:0 12px; margin-top:8px; font-size:.75rem; color:var(--body-muted); }
.ec-body .ec-offer-policy a { display:inline-flex; align-items:center; min-height:44px; }
.ec-body .ec-reassurance b { font-size:.8125rem; font-weight:600; }
.ec-body .ec-reassurance small { font-size:.75rem; line-height:1.4; }
.ec-body .ec-included { display:grid; grid-template-columns:minmax(0,.7fr) minmax(0,1.3fr); align-items:center; gap:36px; padding-block:40px; }
.ec-body .ec-included-heading, .ec-body .ec-included .ec-section-heading { margin:0; }
.ec-body .ec-section-heading h2 { margin-bottom:10px; }
.ec-body .ec-section-heading p { font-size:1rem; color:var(--body-muted); max-width:46ch; }
.ec-body .ec-collection-media { width:100%; max-width:none; min-width:0; }
.ec-body .ec-gallery-stage { position:relative; }
.ec-body .ec-gallery { min-width:0; display:flex; gap:12px; overflow-x:auto; scroll-snap-type:x mandatory; overscroll-behavior-x:contain; scrollbar-width:thin; scrollbar-color:#bbb2c0 transparent; }
.ec-body .ec-portraits { max-width:none; margin:0; padding:0 0 10px; border:0; border-radius:0; background:transparent; box-shadow:none; }
.ec-body .ec-portraits::-webkit-scrollbar { display:block; height:3px; }
.ec-body .ec-portraits::-webkit-scrollbar-thumb { background:#bbb2c0; border-radius:4px; }
.ec-body .ec-portraits > figure { flex:0 0 calc((100% - 12px) / 2); padding:0; margin:0; scroll-snap-align:start; }
.ec-body .ec-portraits button, .ec-body .ec-portraits[data-ec-portrait-mode="individual"] button { display:grid; grid-template-columns:minmax(0,1fr); grid-template-rows:minmax(0,1fr); height:300px; aspect-ratio:auto; padding:0; border-radius:10px; background:#f0ede9; cursor:zoom-in; }
.ec-body .ec-portraits img { width:100%; height:100%; min-height:0; object-fit:contain; }
.ec-body .ec-gallery button:focus-visible { outline-offset:-4px; }
.ec-body .ec-gallery-controls { position:absolute; inset:0 0 10px; margin:0; max-width:none; pointer-events:none; }
.ec-body .ec-gallery-controls button { position:absolute; top:50%; transform:translateY(-50%); width:44px; min-width:44px; height:44px; padding:0; border:1px solid #d3ccd2; border-radius:50%; background:#fffdf7f5; color:#302a30; font-size:1.375rem; pointer-events:auto; box-shadow:0 2px 8px #27232b12; }
.ec-body .ec-gallery-controls [data-ec-gallery-prev] { left:8px; }
.ec-body .ec-gallery-controls [data-ec-gallery-next] { right:8px; }
.ec-body .ec-gallery-controls button:disabled { visibility:hidden; }
.ec-body .ec-gallery-controls [data-ec-gallery-position] { position:absolute; inset:0 auto auto 0; min-width:0; max-width:1px; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; }
.ec-body .ec-story { padding-block:36px; }
.ec-body .mc-story-grid { gap:40px; }
.ec-body .mc-story-grid > div > p:not(.ec-eyebrow) { margin-top:14px; }
.ec-body .mc-story-grid figure img { max-height:400px; width:100%; object-fit:contain; border-radius:10px; }
.ec-body .ec-story-intro > p:last-child { font-size:1.0625rem; line-height:1.6; }
.ec-body .ec-size { grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:48px; padding-block:40px; margin-block:0; background:transparent; border-radius:0; box-shadow:none; border:0; border-top:1px solid #27232b18; }
.ec-body .ec-size-copy > p:not(.ec-eyebrow) { max-width:43ch; }
.ec-body .ec-dimensions { margin-top:18px; padding-top:16px; border-top:1px solid #27232b20; }
.ec-body .ec-dimensions strong { display:block; font-size:1.25rem; font-weight:600; line-height:1.35; }
.ec-body .ec-dimensions span { display:block; font-size:.875rem; margin-top:3px; color:var(--body-muted); }
.ec-body .mc-size-guide { max-width:400px; margin-inline:auto; }
.ec-body .mc-size-guide img { border-radius:10px; }
.ec-body .ec-size-photos { max-width:440px; width:100%; gap:12px; }
.ec-body .ec-proof { padding-block:36px; }
.ec-body .ec-proof-lead { gap:36px; margin-bottom:24px; }
.ec-body .ec-detail-photo { box-shadow:none; }
.ec-body .ec-proof-lead .ec-detail-photo img { width:100%; max-height:360px; object-fit:contain; }
.ec-body .mc-customer-section { padding-block:36px; }
.ec-body .ec-proof > .ec-gallery, .ec-body .mc-customer-grid { padding:0 0 10px; gap:12px; }
.ec-body .ec-proof > .ec-gallery > figure, .ec-body .mc-customer-grid > figure { flex:0 0 calc((100% - 48px) / 5); min-width:0; scroll-snap-align:start; }
.ec-body .ec-proof > .ec-gallery button, .ec-body .mc-customer-grid button { width:100%; height:240px; aspect-ratio:auto; padding:0; border:0; border-radius:8px; background:#eeeae5; cursor:zoom-in; }
.ec-body .ec-proof > .ec-gallery img, .ec-body .mc-customer-grid img { width:100%; height:100%; aspect-ratio:auto; object-fit:contain; border-radius:0; }
.ec-body .ec-reviews { padding-block:36px; }
.ec-body .ec-reviews .ec-section-heading { margin-bottom:20px; }
.ec-body .ec-reviews .ec-section-heading p { color:#e3d9e6; }
.ec-body .ec-review-grid { gap:24px; }
.ec-body .ec-review-grid figure { padding:18px 0 0; border:0; border-top:1px solid #ffffff40; border-radius:0; background:transparent; }
.ec-body .ec-review-grid blockquote { font-size:1rem; font-weight:400; line-height:1.6; }
.ec-body .ec-review-grid figcaption { font-size:.75rem; margin-top:10px; }
.ec-body .ec-more-reviews { margin-top:18px; }
