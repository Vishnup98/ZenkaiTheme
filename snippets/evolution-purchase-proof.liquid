{%- comment -%}Store-wide figures supplied by the merchant; not product-specific review totals.{%- endcomment -%}
{% if placement == 'hero' %}
<div class="evo-purchase-proof evo-purchase-proof--hero" role="group" aria-label="Zenkai store ratings and order count">
  <div class="evo-proof-rating"><span class="evo-proof-stars" aria-hidden="true">★★★★★</span><strong>4.8/5</strong><span>98 Shop reviews</span></div>
  <div class="evo-proof-orders"><strong>3,000+</strong><span>orders and counting</span></div>
</div>
{% else %}
<div class="evo-purchase-proof" role="group" aria-label="Zenkai store ratings and order count">
  <p><span aria-hidden="true">★</span> <strong>4.8/5</strong> · 98 Shop reviews</p>
  <p><strong>3,000+</strong> orders and counting</p>
</div>
{% endif %}
