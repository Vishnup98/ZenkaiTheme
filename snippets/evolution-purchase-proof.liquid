{%- comment -%}Store-wide figures supplied by the merchant; not product-specific review totals.{%- endcomment -%}
{% if placement == 'hero' %}
<div class="evo-purchase-proof evo-purchase-proof--hero" role="group" aria-label="Zenkai store ratings and shipped orders">
  <div class="evo-proof-rating"><span class="evo-proof-stars" aria-hidden="true">★★★★★</span><strong>4.8/5</strong><span>95 Shop reviews</span></div>
  <div class="evo-proof-orders"><strong>2,900+</strong><span>Zenkai orders shipped<br>and counting</span></div>
</div>
{% else %}
<div class="evo-purchase-proof" role="group" aria-label="Zenkai store ratings and shipped orders">
  <p><span aria-hidden="true">★</span> <strong>4.8/5</strong> · 95 Shop reviews</p>
  <p><strong>2,900+</strong> orders shipped and counting</p>
</div>
{% endif %}
