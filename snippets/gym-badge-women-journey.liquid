      <button class="gb-women-cta gb-women-cta--final" type="button" data-gb-color-choose-collector>Get All 32 — {{ collector_variant.price | money }}</button>
      <div class="gb-women-final__trust" aria-label="Order promises">
        <span>✓ Free U.S. shipping</span>
        <span>✓ Secure checkout</span>
        <span>✓ Damaged or incorrect? We make it right.</span>
      </div>
    </div>

    <div class="gb-women-final__details">
      <details open>
        <summary>What arrives <span aria-hidden="true">+</span></summary>
        <p>Four fitted presentation boxes containing eight hard-enamel badges each—32 badges total across Kanto, Johto, Hoenn, and Sinnoh.</p>
      </details>
      <details>
        <summary>Shipping <span aria-hidden="true">+</span></summary>
