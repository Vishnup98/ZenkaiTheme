<button
  class="ls-cta{% if compact %} ls-cta--compact{% endif %}"
  type="submit"
  {% if form_id != blank %}form="{{ form_id }}"{% endif %}
  {% if main %}name="add" data-ls-main-cta{% else %}data-ls-inline-cta{% endif %}
  {% unless ready %}disabled{% endunless %}
>
  {% if ready %}
    <span>Bring the trio home</span><span aria-hidden="true">→</span>
  {% elsif launch_ready %}
    Sold out
  {% else %}
    Coming soon
  {% endif %}
</button>
