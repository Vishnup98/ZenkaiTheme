{%- assign v = product.selected_or_first_available_variant -%}
{%- assign form_id = 'EvolutionCampaignForm-' | append: section.id -%}
{%- assign photo_prefix = 'evo-campaign-' | append: section.settings.asset_id -%}
{%- assign hero_small = photo_prefix | append: '-640.webp' -%}
{%- assign hero_large = photo_prefix | append: '-1080.webp' -%}
{%- assign lineup = 'evo-campaign-customer-01.webp' -%}
{%- assign per_plush = v.price | divided_by: 8.0 -%}
{%- assign is_gift_journey = false -%}
{%- if section.settings.journey == 'whole-gift' -%}{%- assign is_gift_journey = true -%}{%- endif -%}
{%- assign purchase_label = 'Make All 8 Mine' -%}
{%- if is_gift_journey -%}{%- assign purchase_label = 'Give Them All 8' -%}{%- endif -%}
<div class="ec-page ec-palette-{{ section.settings.palette }}" data-ec-page data-journey="{{ section.settings.journey }}">
  <section class="ec-hero ec-shell" aria-labelledby="ec-title-{{ section.id }}">
    <figure class="ec-hero-media">
      <img src="{{ hero_large | asset_url }}" srcset="{{ hero_small | asset_url }} 640w, {{ hero_large | asset_url }} 1080w" sizes="(min-width: 900px) 52vw, 100vw" width="1080" height="1080" alt="{{ section.settings.hero_alt | escape }}" loading="eager" fetchpriority="high">
    </figure>
    <div class="ec-hero-copy">
      <p class="ec-eyebrow">Evolution Companions · complete collection</p>
      <h1 id="ec-title-{{ section.id }}">{% render 'evolution-hero-title', section: section %}</h1>
      <p class="ec-lede">{{ section.settings.hero_body }}</p>
      {% render 'evolution-purchase-proof', placement: 'hero' %}
      <div class="ec-offer" id="ec-offer-{{ section.id }}">
        <div class="ec-price"><strong>{{ v.price | money_without_trailing_zeros }}</strong><span>Complete 8-plush set<small>{{ per_plush | money_without_trailing_zeros }} per plush · one of every design</small></span></div>
        <div class="ec-palette-bar" role="group" aria-label="All eight costume colors are included; no color selection needed">
          <div class="ec-swatches" aria-hidden="true"><span style="--swatch:#f4a9bb"></span><span style="--swatch:#bfa5e8"></span><span style="--swatch:#b9e6f3"></span><span style="--swatch:#4ba9d7"></span><span style="--swatch:#f3792d"></span><span style="--swatch:#f3d64f"></span><span style="--swatch:#d6bf68"></span><span style="--swatch:#2f3036"></span></div>
          <span>Every color included</span>
        </div>
        {%- form 'product', product, id: form_id, class: 'ec-product-form' -%}
          <input type="hidden" name="id" value="{{ v.id }}">
          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="return_to" value="/checkout">
          <input type="hidden" name="properties[_zk_landing_view]" value="evo-{{ section.settings.journey }}">
          <button class="ec-cta" type="submit" name="add" data-ec-main-cta {% unless v.available %}disabled{% endunless %}>{% if v.available %}{{ purchase_label }} <span aria-hidden="true">—</span> {{ v.price | money }}{% else %}Sold out{% endif %}</button>
          <p class="ec-shipping"><strong>Free U.S. shipping</strong><span>Arrives in 5–7 business days</span></p>
          {{ form | payment_button }}
        {%- endform -%}
      </div>
    </div>
  </section>

  <section class="ec-included ec-shell" aria-labelledby="ec-included-{{ section.id }}">
    <div class="ec-included-heading"><div class="ec-section-heading"><h2 id="ec-included-{{ section.id }}">{% if is_gift_journey %}Meet their eight.{% else %}Meet your eight.{% endif %}</h2><p>Eight separate plushes. One of every design.</p></div></div>
    {%- assign portrait_names = 'group,espeon,jolteon,flareon,glaceon,sylveon,vaporeon,leafeon,umbreon' | split: ',' -%}
    {%- assign portrait_descriptions = 'all eight plush companions together|plush with a lavender hood and tall ears|plush with a yellow hood and white collar|plush with an orange hood and fluffy yellow collar|plush with a pale blue hood and long side flaps|plush with a pink and white hood and ribbons|plush with a bright blue hood and fin-shaped ears|plush with a pale yellow hood and green leaf details|plush with a charcoal hood and yellow ear bands' | split: '|' -%}
    <div class="ec-collection-media"><div class="ec-gallery-stage">
    <div class="ec-gallery ec-portraits" id="ec-portraits-{{ section.id }}" data-ec-gallery data-ec-portrait-mode="group" role="region" aria-roledescription="carousel" aria-label="The complete collection and each included plush" tabindex="0">
      {% for name in portrait_names %}
        {% assign full = 'evo-portrait-' | append: name | append: '-1024.webp' %}
        {% assign small = 'evo-portrait-' | append: name | append: '-480.webp' %}
        {% assign portrait_description = portrait_descriptions[forloop.index0] %}
        {% assign portrait_height = 1024 %}
        {% if name == 'group' %}{% assign portrait_height = 687 %}{% endif %}
        {% if name == 'espeon' %}{% assign portrait_height = 918 %}{% endif %}
        <figure class="ec-portrait ec-portrait--{{ name }}"><button type="button" data-ec-zoom="{{ full | asset_url }}" aria-label="Enlarge photo of {{ portrait_description }}"><img src="{{ small | asset_url }}" srcset="{{ small | asset_url }} 480w, {{ full | asset_url }} 1024w" sizes="(min-width: 900px) 320px, 78vw" width="1024" height="{{ portrait_height }}" loading="lazy" alt="Full view of {{ portrait_description }}, included in the complete set"></button></figure>
      {% endfor %}
    </div>
    <div class="ec-gallery-controls" data-ec-gallery-controls hidden><div><button type="button" data-ec-gallery-prev aria-label="Previous collection photo">←</button><span data-ec-gallery-position aria-live="polite" aria-atomic="true">1 of 9</span><button type="button" data-ec-gallery-next aria-label="Next collection photo">→</button></div></div>
    </div>
    <div class="ec-portrait-thumbs" role="group" aria-label="Collection photo thumbnails">
      {% for name in portrait_names %}
        {% assign thumbnail = 'evo-portrait-' | append: name | append: '-120.webp' %}
        <button type="button" class="ec-portrait--{{ name }}" data-ec-thumb aria-controls="ec-portraits-{{ section.id }}" aria-label="Show {{ portrait_descriptions[forloop.index0] }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"><img src="{{ thumbnail | asset_url }}" width="120" height="120" loading="lazy" alt=""></button>
      {% endfor %}
    </div></div>
  </section>

  {% unless section.settings.journey == 'everything-included' %}
  <section class="ec-story" aria-labelledby="ec-story-{{ section.id }}"><div class="ec-shell ec-story-grid ec-story-grid--simple">
    <div class="ec-story-intro"><p class="ec-eyebrow">{{ section.settings.story_eyebrow }}</p><h2 id="ec-story-{{ section.id }}">{{ section.settings.story_title }}</h2><p>{{ section.settings.story_body }}</p></div>
  </div></section>
  {% endunless %}

  <section class="ec-size ec-shell" id="ec-size-{{ section.id }}" aria-labelledby="ec-size-title-{{ section.id }}">
    <div class="ec-size-copy"><p class="ec-eyebrow">A closer look from our customers</p><h2 id="ec-size-title-{{ section.id }}">{{ section.settings.size_title }}</h2><p>{{ section.settings.size_body }}</p>
      <p class="ec-size-note">Approximately 8 × 7 × 6 inches each.</p>

    </div>
    <div class="ec-size-photos" aria-label="Customer photos showing the plushes held in a hand">
      <figure><button type="button" data-ec-zoom="{{ 'evo-campaign-handheld-purple-720.webp' | asset_url }}" aria-label="Enlarge customer photo of the purple plush held in a hand"><img src="{{ 'evo-campaign-handheld-purple-720.webp' | asset_url }}" srcset="{{ 'evo-campaign-handheld-purple-360.webp' | asset_url }} 360w, {{ 'evo-campaign-handheld-purple-720.webp' | asset_url }} 720w" sizes="(min-width: 1240px) 260px, (min-width: 900px) 23vw, 45vw" width="720" height="960" loading="lazy" alt="Customer holding the purple gem-costume plush, with the full ears, body and feet visible for scale"></button></figure>
      <figure><button type="button" data-ec-zoom="{{ 'evo-campaign-handheld-pink-720.webp' | asset_url }}" aria-label="Enlarge customer photo of the pink plush held in a hand"><img src="{{ 'evo-campaign-handheld-pink-720.webp' | asset_url }}" srcset="{{ 'evo-campaign-handheld-pink-360.webp' | asset_url }} 360w, {{ 'evo-campaign-handheld-pink-720.webp' | asset_url }} 720w" sizes="(min-width: 1240px) 260px, (min-width: 900px) 23vw, 45vw" width="720" height="960" loading="lazy" alt="Customer holding the pink ribbon-costume plush, with the full ears, ribbons and feet visible for scale"></button></figure>
    </div>
  </section>

  <section class="ec-proof ec-shell" aria-labelledby="ec-proof-{{ section.id }}">
    <div class="ec-proof-lead">
      <figure class="ec-detail-photo"><img src="{{ 'evo-portrait-detail-480.webp' | asset_url }}" srcset="{{ 'evo-portrait-detail-480.webp' | asset_url }} 480w, {{ 'evo-portrait-detail-1024.webp' | asset_url }} 1024w" sizes="(max-width: 749px) 90vw, 680px" width="1024" height="687" loading="lazy" alt="Close-up of the plush face and embroidered charcoal hood with yellow details"></figure>
      <div class="ec-proof-copy"><div class="ec-section-heading"><p class="ec-eyebrow">Customer photos, up close</p><h2 id="ec-proof-{{ section.id }}">{{ section.settings.proof_title }}</h2><p>{{ section.settings.proof_body }}</p></div>
      </div>
    </div>
    <div class="ec-gallery" data-ec-gallery id="ec-gallery-{{ section.id }}" role="region" aria-label="Customer product photos" tabindex="0">
      {%- for i in (2..6) -%}
        {%- assign proof_asset = 'evo-campaign-customer-0' | append: i | append: '.webp' -%}
        {%- case i -%}
          {%- when 2 -%}{%- assign proof_caption = 'Pink, purple & orange' -%}
          {%- when 3 -%}{%- assign proof_caption = 'Purple gem' -%}
          {%- when 4 -%}{%- assign proof_caption = 'Pink ribbons' -%}
          {%- when 5 -%}{%- assign proof_caption = 'Blue companions' -%}
          {%- when 6 -%}{%- assign proof_caption = 'Moon black' -%}
        {%- endcase -%}
        <figure><button type="button" data-ec-zoom="{{ proof_asset | asset_url }}" aria-label="Enlarge customer photo: {{ proof_caption | escape }}"><img src="{{ proof_asset | asset_url }}" width="720" height="720" loading="lazy" alt="{{ proof_caption | escape }} plush detail, photographed by a customer"></button></figure>
      {%- endfor -%}
    </div>
  </section>

  <section class="ec-reviews"><div class="ec-shell">
    <div class="ec-section-heading"><h2>From fellow collectors.</h2><p class="ec-review-source">Feedback from buyers of the individual designs.</p></div>
    <div class="ec-review-grid" role="region" aria-label="Customer review highlights"><figure><blockquote>“Super adorable! … had to grab some more for friends.”</blockquote></figure><figure><blockquote>“Wife loved them 💪🏾 Kids love them soft, perfect for gifts, couldn’t ask for better 👍”</blockquote></figure><figure><blockquote>“Shipping took longer than anticipated … Would purchase again.”</blockquote><details class="ec-review-more"><summary>Read full review</summary><blockquote>“Shipping took longer than anticipated but with the holidays it is not too surprising. For the price and quality, i am okay with the longer wait. Would purchase again.”</blockquote></details></figure></div>
    <details class="ec-more-reviews"><summary>More collector reviews</summary><div class="ec-review-grid"><figure><blockquote>“Amazing delivery product excellent condition”</blockquote></figure><figure><blockquote>“Awesome quality! i now have collected all 8 from this seller! fast shipping and highly recommend buyer here!”</blockquote></figure><figure><blockquote>“Wonderful plush! … The colors are beautiful … Highly recommend for collectors!”</blockquote><details class="ec-review-more"><summary>Read full review</summary><blockquote>“Wonderful plush! … very well made, soft, and has great finishing. The colors are beautiful and true to the character, and the material seems to be of good quality. It arrived well packaged and in perfect condition. Highly recommend for collectors!”</blockquote></details></figure></div></details>
  </div></section>

  <section class="ec-faq ec-shell" aria-labelledby="ec-faq-{{ section.id }}"><h2 id="ec-faq-{{ section.id }}">{% if is_gift_journey %}Before you give them all eight.{% else %}Before you make them yours.{% endif %}</h2>
    <details><summary>Does the price include all eight?</summary><p>Yes. {{ v.price | money }} buys eight separate plush companions, with one of every design pictured. Each plush comes in its own costume; this is not one plush with spare outfits. Gift wrapping and display props are not included.</p></details>
    <details><summary>How big is each plush?</summary><p>Approximately 8 × 7 × 6 inches each. Costume and ear shapes vary, so allow a little extra room when planning your display.</p></details>
    <details><summary>Is shipping free, and when will it arrive?</summary><p>U.S. shipping is free. Delivery typically takes 5–7 business days. Tracking is provided after dispatch. Your set may arrive separately from other products in your order. Transit can take longer around holidays; allow extra time for a fixed gifting date.</p></details>
    <details><summary>How do I care for them?</summary><p>Spot clean gently and air dry. Not suitable for children under 3 years old.</p></details>
    <details><summary>What if something is wrong with my order?</summary><p>If your order is lost in transit, damaged, defective, incorrect or materially different from its description, contact us with your order number and available photos. <a href="/pages/policy">Read the full collector policy.</a></p></details>
  </section>

  <section class="ec-final"><div class="ec-shell ec-final-grid"><img src="{{ lineup | asset_url }}" width="960" height="285" loading="lazy" alt="The eight plush companions included in the complete set"><div><p class="ec-eyebrow">{% if is_gift_journey %}Their complete collection{% else %}Your complete collection{% endif %}</p><h2>{{ section.settings.final_title }}</h2><p>{{ section.settings.final_body }}</p><button class="ec-cta" type="submit" form="{{ form_id }}" data-ec-inline-cta {% unless v.available %}disabled{% endunless %}>{% if v.available %}{{ purchase_label }} <span aria-hidden="true">—</span> {{ v.price | money }}{% else %}Sold out{% endif %}</button>{% render 'evolution-purchase-proof' %}<p class="ec-shipping"><strong>Free U.S. shipping</strong><span>Arrives in 5–7 business days</span></p></div></div></section>

  <aside class="ec-sticky" data-ec-sticky aria-label="Quick add complete set"><div><strong>{{ v.price | money }}</strong><small>all 8 plushes</small></div><button class="ec-cta" type="submit" form="{{ form_id }}" {% unless v.available %}disabled{% endunless %}>{% if v.available %}{{ purchase_label }}{% else %}Sold out{% endif %}</button></aside>
  <dialog class="ec-lightbox" data-ec-lightbox aria-label="Enlarged collection photo"><div class="ec-lightbox-toolbar"><button type="button" data-ec-zoom-toggle aria-pressed="false">Zoom in</button><span>Swipe or scroll to explore</span><button type="button" data-ec-close aria-label="Close photo" autofocus>×</button></div><div class="ec-lightbox-viewport" tabindex="0" aria-label="Product photo; scroll to explore when enlarged"><img width="960" height="960" alt="Enlarged plush collection photo"></div></dialog>
</div>
{% schema %}
{
  "name": "Evolution campaign",
  "settings": [
    {"type":"text","id":"journey","label":"Journey","default":"all-eight"},
    {"type":"text","id":"asset_id","label":"Campaign asset ID","default":"01-all-eight"},
    {"type":"text","id":"palette","label":"Palette","default":"peach"},
    {"type":"text","id":"hero_alt","label":"Hero image description","default":"All eight Evolution Companions plushes"},
    {"type":"text","id":"hero_title","label":"Headline","default":"You don’t have to pick a favorite."},
    {"type":"text","id":"hero_title_accent","label":"Highlighted phrase in headline"},
    {"type":"textarea","id":"hero_body","label":"Introduction","default":"Bring home all eight plush companions together."},
    {"type":"text","id":"story_eyebrow","label":"Story eyebrow","default":"Picture them at home"},
    {"type":"text","id":"story_title","label":"Story headline","default":"Make room for the whole set."},
    {"type":"textarea","id":"story_body","label":"Story body","default":"Keep every favorite together."},
    {"type":"text","id":"point_1_title","label":"First point title","default":"Every design is yours"},
    {"type":"textarea","id":"point_1_body","label":"First point body","default":"All eight pictured designs come in your set."},
    {"type":"text","id":"point_2_title","label":"Second point title","default":"No one missing"},
    {"type":"textarea","id":"point_2_body","label":"Second point body","default":"Line them all up and enjoy seeing the whole collection together."},
    {"type":"text","id":"point_3_title","label":"Third point title","default":"Arrange them your way"},
    {"type":"textarea","id":"point_3_body","label":"Third point body","default":"Keep the full lineup together."},
    {"type":"text","id":"size_title","label":"In-hand section headline","default":"Which one gets the spot beside you?"},
    {"type":"textarea","id":"size_body","label":"In-hand section body","default":"Put your favorite beside your pillow. Set the others where you’ll see them every day. With all eight at home, you can change your mind tomorrow."},
    {"type":"text","id":"proof_title","label":"Proof headline","default":"See the actual product photos."},
    {"type":"textarea","id":"proof_body","label":"Photo introduction","default":"Take a closer look at the little brown paws, stitched smiles and colorful hoods. Every one is part of your set."},
    {"type":"text","id":"final_title","label":"Final headline","default":"Make room for all eight."},
    {"type":"textarea","id":"final_body","label":"Final body","default":"One complete collection, ready to come home."}
  ]
}
{% endschema %}
