{%- assign v = product.selected_or_first_available_variant -%}
{%- assign form_id = 'MimikyuCollectionForm-' | append: section.id -%}
{%- assign ready = false -%}
{%- if product.id == 9438355751017 and section.settings.purchase_ready and v.available and v.price > 0 -%}{%- assign ready = true -%}{%- endif -%}
{%- assign show_placeholders = section.settings.show_placeholders -%}
{%- if request.design_mode -%}{%- assign show_placeholders = true -%}{%- endif -%}
{%- assign per_plush = v.price | divided_by: 9.0 -%}
<div class="ec-page ec-palette-cream mc-page" data-ec-page data-journey="mimikyu-collection">
  <section class="ec-hero ec-shell" aria-labelledby="mc-title-{{ section.id }}">
    <figure class="ec-hero-media">
      {% render 'mimikyu-image', photo: section.settings.hero_image, fallback: 'mimikyu-source-lineup', alt: 'The complete nine-piece Little Impostors plush collection', loading: 'eager' %}
    </figure>
    <div class="ec-hero-copy">
      <p class="ec-eyebrow">Little Impostors · complete collection</p>
      <h1 id="mc-title-{{ section.id }}">{{ section.settings.hero_title }}</h1>
      <p class="ec-lede">Nine colorful faces. One mischievous little twist. Bring home the whole Little Impostors collection, with every design included.</p>
      <div class="ec-offer">
        <div class="ec-price"><strong>{% if v.price > 0 %}{{ v.price | money }}{% else %}Coming soon{% endif %}</strong><span><small>Complete 9-plush set</small>{% if v.price > 0 %}9 plushes <i aria-hidden="true">·</i> {{ per_plush | money }} each{% else %}One of every pictured design{% endif %}</span></div>
        <div class="ec-palette-bar"><div class="ec-swatches" aria-hidden="true"><span style="--swatch:#cca26d"></span><span style="--swatch:#8ed4db"></span><span style="--swatch:#efd344"></span><span style="--swatch:#ed8c3e"></span><span style="--swatch:#bba2d7"></span><span style="--swatch:#35373c"></span><span style="--swatch:#e6e6ba"></span><span style="--swatch:#91d2e7"></span><span style="--swatch:#eda6c7"></span></div><span>All nine designs included</span></div>
        {%- form 'product', product, id: form_id, class: 'ec-product-form' -%}
          <input type="hidden" name="id" value="{{ v.id }}">
          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="return_to" value="/checkout">
          <input type="hidden" name="properties[_zk_landing_view]" value="mimikyu-collection">
          {% render 'mimikyu-cta', ready: ready, launch_ready: section.settings.purchase_ready, variant: v, main: true, show_price: true %}
          {% if ready %}{{ form | payment_button }}{% endif %}
        {%- endform -%}
        <div class="ec-reassurance" aria-label="Collection and delivery information"><span><b>Complete collection</b><small>9 separate plushes</small></span><span><b>{{ section.settings.shipping_heading }}</b><small>{{ section.settings.shipping_summary }}</small></span><span><b>Secure checkout</b><small>Powered by Shopify</small></span></div>
        <p class="ec-offer-policy">Order issue? <a href="/pages/policy">View delivery &amp; returns</a></p>
      </div>
    </div>
  </section>

  <section class="ec-included ec-shell" aria-labelledby="mc-included-{{ section.id }}">
    <div class="ec-included-heading"><div class="ec-section-heading"><p class="ec-eyebrow">Meet your nine</p><h2 id="mc-included-{{ section.id }}">Every disguise. All yours.</h2><p>Nine colorful designs, each with a scribbled little face and its own unmistakable details. You get one of every plush shown.</p></div><span class="ec-count-stamp"><strong>9</strong><span>all yours</span></span></div>
    {%- assign names = 'collection,eevee,vaporeon,jolteon,flareon,espeon,umbreon,leafeon,glaceon,sylveon' | split: ',' -%}
    {%- assign labels = 'The complete nine-plush collection|Warm tan|Aqua|Bright yellow|Orange|Lavender|Charcoal|Leaf-eared cream|Icy blue|Pink ribbon' | split: '|' -%}
    <div class="ec-gallery ec-portraits" id="mc-portraits-{{ section.id }}" data-ec-gallery data-ec-portrait-mode="group" role="region" aria-roledescription="carousel" aria-label="All nine included designs" tabindex="0">
      {% for name in names %}
        {% assign image_key = name | append: '_image' %}{% assign photo = section.settings[image_key] %}
        {% assign fallback = 'mimikyu-source-' | append: name %}{% if forloop.first %}{% assign fallback = 'mimikyu-source-lineup' %}{% endif %}
        {% assign full_asset = fallback | append: '-960.webp' %}{% assign zoom_url = full_asset | asset_url %}{% if photo != blank %}{% assign zoom_url = photo | image_url: width: 1800 %}{% endif %}
        <figure class="ec-portrait"><button type="button" data-ec-zoom="{{ zoom_url }}" aria-label="Enlarge {{ labels[forloop.index0] | escape }}">{% render 'mimikyu-image', photo: photo, fallback: fallback, alt: labels[forloop.index0], sizes: '(max-width: 749px) 88vw, 860px' %}</button></figure>
      {% endfor %}
    </div>
    <div class="ec-portrait-thumbs" aria-label="Choose a collection photo">
      {% for name in names %}
        {% assign image_key = name | append: '_image' %}{% assign photo = section.settings[image_key] %}{% assign thumb = 'mimikyu-source-' | append: name | append: '-120.webp' %}{% if forloop.first %}{% assign thumb = 'mimikyu-source-lineup-120.webp' %}{% endif %}
        <button type="button" data-ec-thumb="{{ forloop.index0 }}" aria-label="Show {{ labels[forloop.index0] | escape }}" aria-controls="mc-portraits-{{ section.id }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"><img src="{% if photo != blank %}{{ photo | image_url: width: 120 }}{% else %}{{ thumb | asset_url }}{% endif %}" width="60" height="60" alt="" loading="lazy"></button>
      {% endfor %}
    </div>
    <div class="ec-gallery-controls" data-ec-gallery-controls hidden><div><button type="button" data-ec-gallery-prev aria-label="Previous collection photo">←</button><span data-ec-gallery-position aria-live="polite">1 of 10</span><button type="button" data-ec-gallery-next aria-label="Next collection photo">→</button></div></div>
  </section>

  <section class="ec-story"><div class="ec-shell mc-story-grid">
    <div><p class="ec-eyebrow">Make room for a little mischief</p><h2>Your shelf has a new little gang.</h2><p>Line up the whole collection. Put your first favorite in the middle. Come back tomorrow and give someone else the best spot.</p><ol class="ec-points"><li><h3>Every favorite, together</h3><p>No choosing a color or leaving one behind. The full nine-piece lineup comes as one set.</p></li><li><h3>Small faces. Lots of character.</h3><p>Those wobbly smiles, pink cheeks and familiar ears make each one a little different.</p></li><li><h3>A gift with nobody missing</h3><p>Give a collector the entire gang—or keep the nine for yourself.</p></li></ol></div>
    {% if section.settings.shelf_image != blank %}<figure>{% render 'mimikyu-image', photo: section.settings.shelf_image, alt: 'All nine plushes arranged on a collector shelf in a styled scene' %}</figure>{% elsif show_placeholders %}<div class="mc-image-placeholder"><span>03</span><strong>Shelf image</strong><p>little-impostors-shelf.png</p></div>{% endif %}
  </div></section>

  {%- assign has_in_hand_photos = false -%}
  {%- if section.settings.handheld_espeon_image != blank or section.settings.handheld_sylveon_image != blank -%}{%- assign has_in_hand_photos = true -%}{%- endif -%}
  {%- assign has_size_media = has_in_hand_photos -%}
  {%- if section.settings.size_image != blank -%}{%- assign has_size_media = true -%}{%- endif -%}
  <section class="ec-size ec-shell{% unless has_size_media or show_placeholders %} mc-size-text-only{% endunless %}"><div class="ec-size-copy"><p class="ec-eyebrow">A little closer</p><h2>Little enough to keep close.</h2><p>A colorful companion for your desk, reading corner or collection shelf. Each design has its own ear shape and loose, stitched silhouette.</p><ul class="ec-size-facts"><li><strong>9</strong><span>separate plushes</span></li><li><strong>~8 in</strong><span>approximate height</span></li><li><strong>Every design</strong><span>included together</span></li></ul></div>
    {% if section.settings.size_image != blank %}<figure class="mc-size-guide">{% render 'mimikyu-image', photo: section.settings.size_image, alt: 'Little Impostors plush with a height guide showing 8 inches', sizes: '(min-width: 900px) 55vw, 92vw' %}</figure>
    {% elsif has_in_hand_photos or show_placeholders %}<div class="ec-size-photos">
      {% assign handhelds = 'handheld_espeon,handheld_sylveon' | split: ',' %}{% for name in handhelds %}{% assign image_key = name | append: '_image' %}{% assign photo = section.settings[image_key] %}
      {% if photo != blank %}<figure>{% render 'mimikyu-image', photo: photo, alt: 'A Little Impostors plush held in a hand', sizes: '(min-width: 900px) 25vw, 45vw' %}</figure>{% elsif show_placeholders %}<div class="mc-image-placeholder mc-image-placeholder--portrait"><strong>In-hand image</strong><p>Reserved for your manually supplied photo</p></div>{% endif %}{% endfor %}
    </div>{% endif %}
  </section>

  {% if section.settings.detail_image != blank or show_placeholders %}<section class="ec-proof ec-shell"><div class="ec-proof-lead"><figure class="ec-detail-photo">{% if section.settings.detail_image != blank %}{% render 'mimikyu-image', photo: section.settings.detail_image, alt: 'Close-up of the charcoal plush with its scribbled eyes, stitched zigzag mouth and yellow details' %}{% else %}<div class="mc-image-placeholder"><strong>Face and stitching detail</strong><p>little-impostors-detail.png</p></div>{% endif %}</figure><div class="ec-proof-copy"><p class="ec-eyebrow">The tiny details</p><h2>That wonderfully wonky little face.</h2><p>The scribbled eyes. The zigzag smile. The pink cheeks. Take a closer look at the little details that give the collection its character.</p></div></div></section>{% endif %}

  {%- assign customer_photos = section.blocks | where: 'type', 'customer_photo' -%}
  {%- assign testimonials = section.blocks | where: 'type', 'testimonial' -%}
  {%- assign has_photos = false -%}{%- for block in customer_photos -%}{%- if block.settings.image != blank -%}{%- assign has_photos = true -%}{%- endif -%}{%- endfor -%}
  {% if has_photos or show_placeholders %}<section class="ec-shell mc-customer-section"><div class="ec-section-heading"><p class="ec-eyebrow">At home with collectors</p><h2>Your collection, in real life.</h2></div><div class="mc-customer-grid">
    {% for block in customer_photos %}{% if block.settings.image != blank %}<figure {{ block.shopify_attributes }}>{% render 'mimikyu-image', photo: block.settings.image, alt: block.settings.caption %}</figure>{% elsif show_placeholders %}<div class="mc-image-placeholder" {{ block.shopify_attributes }}><strong>Customer photo {{ forloop.index }}</strong><p>Reserved for your real photo</p></div>{% endif %}{% endfor %}
  </div></section>{% endif %}
  {%- assign has_reviews = false -%}{%- for block in testimonials -%}{%- if block.settings.quote != blank -%}{%- assign has_reviews = true -%}{%- endif -%}{%- endfor -%}
  {% if has_reviews or show_placeholders %}<section class="ec-reviews"><div class="ec-shell"><div class="ec-section-heading"><h2>From fellow collectors.</h2></div><div class="ec-review-grid">
    {% for block in testimonials %}{% if block.settings.quote != blank %}<figure {{ block.shopify_attributes }}><blockquote>{{ block.settings.quote | escape }}</blockquote>{% if block.settings.attribution != blank %}<figcaption>{{ block.settings.attribution | escape }}</figcaption>{% endif %}</figure>{% elsif show_placeholders %}<figure class="mc-review-placeholder" {{ block.shopify_attributes }}><p>Testimonial {{ forloop.index }}</p><figcaption>Reserved for a real customer quote</figcaption></figure>{% endif %}{% endfor %}
  </div></div></section>{% endif %}

  <section class="ec-faq ec-shell" aria-labelledby="mc-faq-{{ section.id }}"><h2 id="mc-faq-{{ section.id }}">Before you make them yours.</h2>
    <details><summary>Does this include all nine plushes?</summary><p>Yes. This is one complete set of nine separate plushes: warm tan, aqua, bright yellow, orange, lavender, charcoal, leaf-eared cream, icy blue and pink ribbon. You receive one of every pictured design. Display props and gift wrapping are not included.</p></details>
    <details><summary>Can I choose individual colors?</summary><p>This offer is for the full collection. One of every pictured design is included, so there is no color selection to make.</p></details>
    <details><summary>How big are they?</summary><p>Approximately 8 inches (20 cm) tall.</p></details>
    <details><summary>When will my set arrive?</summary><p>{{ section.settings.delivery_text | escape }}</p></details>
    <details><summary>How should I care for them?</summary><p>Gently spot clean and allow to air dry. Keep away from heat and open flames. Follow any care instructions supplied with the product.</p></details>
    <details><summary>What if something is wrong with my order?</summary><p>Contact us with your order number and any relevant photos. <a href="/pages/policy">Read the store’s delivery and returns policy.</a></p></details>
  </section>

  <section class="ec-final"><div class="ec-shell ec-final-grid"><figure>{% render 'mimikyu-image', photo: section.settings.collection_image, fallback: 'mimikyu-source-lineup', alt: 'All nine Little Impostors plush designs included in the complete set' %}</figure><div><p class="ec-eyebrow">Your complete collection</p><h2>Bring all nine home.</h2><p>Every disguise. Every color. One whole little gang to call yours.</p>{% render 'mimikyu-cta', ready: ready, launch_ready: section.settings.purchase_ready, variant: v, form_id: form_id, show_price: true %}<p class="ec-offer-policy">9 separate plushes · One of every design</p></div></div></section>
  {% if ready %}<aside class="ec-sticky" data-ec-sticky aria-label="Quick add complete collection" hidden><div><strong>{{ v.price | money }}</strong><small>all 9 plushes</small></div>{% render 'mimikyu-cta', ready: ready, launch_ready: section.settings.purchase_ready, variant: v, form_id: form_id %}</aside>{% endif %}
  <dialog class="ec-lightbox" data-ec-lightbox aria-label="Enlarged product photo"><div class="ec-lightbox-toolbar"><button type="button" data-ec-zoom-toggle aria-pressed="false">Zoom in</button><span>Swipe or scroll to explore</span><button type="button" data-ec-close aria-label="Close photo" autofocus>×</button></div><div class="ec-lightbox-viewport" tabindex="0"><img width="960" height="960" alt="Enlarged collection photo"></div></dialog>
</div>
{% schema %}
{
  "name": "Little Impostors set",
  "settings": [
    {"type":"text","id":"hero_title","label":"Headline","default":"You’ll want every little impostor."},
    {"type":"checkbox","id":"purchase_ready","label":"Enable purchase buttons","default":false,"info":"Enable after price, fulfillment and delivery are confirmed."},
    {"type":"checkbox","id":"show_placeholders","label":"Show unfilled image and review slots","default":false,"info":"Empty slots always appear in the theme editor. Keep off on the public page."},
    {"type":"text","id":"shipping_heading","label":"Shipping heading","default":"Free U.S. shipping"},
    {"type":"text","id":"shipping_summary","label":"Shipping summary","default":"Arrives in 7-10 business days"},
    {"type":"textarea","id":"delivery_text","label":"Delivery details","default":"Arrives in 7-10 business days. U.S. shipping is free for this set. This collection may arrive separately from other items in your order."},
    {"type":"header","content":"Generated product imagery"},
    {"type":"image_picker","id":"hero_image","label":"Hero — little-impostors-hero.png"},
    {"type":"image_picker","id":"collection_image","label":"Collection — little-impostors-collection.png"},
    {"type":"image_picker","id":"shelf_image","label":"Shelf — little-impostors-shelf.png"},
    {"type":"image_picker","id":"eevee_image","label":"Warm tan portrait"},
    {"type":"image_picker","id":"vaporeon_image","label":"Aqua portrait"},
    {"type":"image_picker","id":"jolteon_image","label":"Bright yellow portrait"},
    {"type":"image_picker","id":"flareon_image","label":"Orange portrait"},
    {"type":"image_picker","id":"espeon_image","label":"Lavender portrait"},
    {"type":"image_picker","id":"umbreon_image","label":"Charcoal portrait"},
    {"type":"image_picker","id":"leafeon_image","label":"Leaf-eared cream portrait"},
    {"type":"image_picker","id":"glaceon_image","label":"Icy blue portrait"},
    {"type":"image_picker","id":"sylveon_image","label":"Pink ribbon portrait"},
    {"type":"image_picker","id":"detail_image","label":"Face and stitching detail"},
    {"type":"header","content":"Size guide"},
    {"type":"image_picker","id":"size_image","label":"Size guide image"},
    {"type":"header","content":"Manually supplied in-hand photos"},
    {"type":"image_picker","id":"handheld_espeon_image","label":"Lavender in-hand image"},
    {"type":"image_picker","id":"handheld_sylveon_image","label":"Pink ribbon in-hand image"}
  ],
  "blocks": [
    {"type":"customer_photo","name":"Customer photo","limit":6,"settings":[{"type":"image_picker","id":"image","label":"Real customer photo"},{"type":"text","id":"caption","label":"Image description (alt text)"}]},
    {"type":"testimonial","name":"Customer testimonial","limit":6,"settings":[{"type":"textarea","id":"quote","label":"Exact customer quote"},{"type":"text","id":"attribution","label":"Customer attribution"}]}
  ],
  "presets": [{"name":"Little Impostors set"}]
}
{% endschema %}
