    {%- assign gb_offer_quote = gb_quote_quality_gift -%}
    {%- assign gb_offer_quote_meta = 'Customer review' -%}
    {%- assign gb_inhand_quote = gb_quote_full_set -%}
    {%- assign gb_inhand_quote_meta = 'Verified buyer' -%}
    {%- assign gb_detail_quote = gb_quote_pretty_gift -%}
    {%- assign gb_detail_quote_meta = 'Customer review' -%}
    {%- assign gb_collector_quote = gb_quote_nostalgia -%}
    {%- assign gb_collector_quote_meta = 'S.P. · Verified buyer' -%}
    {%- assign gb_lifestyle_quote = blank -%}
  {%- when 'gift' -%}
    {%- assign gb_offer_quote = gb_quote_pretty_gift -%}
    {%- assign gb_offer_quote_meta = 'Customer review' -%}
    {%- assign gb_inhand_quote = gb_quote_quality_gift -%}
    {%- assign gb_inhand_quote_meta = 'Customer review' -%}
    {%- assign gb_detail_quote = blank -%}
    {%- assign gb_collector_quote = gb_quote_full_set -%}
    {%- assign gb_collector_quote_meta = 'Verified buyer' -%}
    {%- assign gb_lifestyle_quote = gb_quote_delivery_gift -%}
    {%- assign gb_lifestyle_quote_meta = 'Oliver S. · Verified buyer' -%}
  {%- when 'completion', 'collection', 'og-four' -%}
    {%- assign gb_offer_quote = gb_quote_full_set -%}
    {%- assign gb_offer_quote_meta = 'Verified buyer' -%}
    {%- assign gb_inhand_quote = gb_quote_quality_gift -%}
    {%- assign gb_inhand_quote_meta = 'Customer review' -%}
    {%- assign gb_detail_quote = blank -%}
    {%- assign gb_collector_quote = gb_quote_nostalgia -%}
    {%- assign gb_collector_quote_meta = 'S.P. · Verified buyer' -%}
    {%- assign gb_lifestyle_quote = blank -%}
{%- endcase -%}

{%- if section.settings.hero_eyebrow != blank -%}{%- assign hero_eyebrow = section.settings.hero_eyebrow -%}{%- endif -%}
{%- if section.settings.hero_heading_line_1 != blank -%}{%- assign hero_heading_line_1 = section.settings.hero_heading_line_1 -%}{%- endif -%}
{%- if section.settings.hero_heading_line_2 != blank -%}{%- assign hero_heading_line_2 = section.settings.hero_heading_line_2 -%}{%- endif -%}
{%- if section.settings.hero_lede != blank -%}{%- assign hero_lede = section.settings.hero_lede -%}{%- endif -%}
{%- assign hero_asset = section.settings.hero_asset | strip -%}
{%- assign hero_alt = section.settings.hero_alt | default: 'All 32 glossy hard-enamel badges arranged in chronological order from Kanto through Sinnoh' -%}

{{ 'gym-badge-color.css' | asset_url | stylesheet_tag }}

<div
  id="ProductSection-{{ product.id }}"
  class="gb-color-page"
  data-gb-color-page
  data-section-id="{{ section.id }}"
  data-section-type="product-template"
  data-enable-history-state="false"
  data-variant-type="button"
  data-product-category="pin"
  data-collector-variant-id="{{ collector_variant.id }}"
  data-gb-landing-variant="{{ landing_variant | escape }}"
  data-gb-theme="{{ page_theme | escape }}"
  data-gb-force-collector="{% if section.settings.force_collector %}true{% else %}false{% endif %}"
  data-gb-direct-checkout="{% if section.settings.direct_checkout %}true{% else %}false{% endif %}">

  <div class="gb-color-page__orb gb-color-page__orb--one" aria-hidden="true"></div>
  <div class="gb-color-page__orb gb-color-page__orb--two" aria-hidden="true"></div>

  <div class="gb-color-shell">
    {%- unless section.settings.direct_checkout -%}
      <nav class="gb-color-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">/</span>
        <a href="{{ routes.all_products_collection_url }}">All products</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">32-Badge Collector Pack</span>
      </nav>
    {%- endunless -%}

    <section class="gb-color-hero" aria-labelledby="gb-color-title-{{ section.id }}">
      <div class="gb-color-gallery" data-gb-color-gallery>
        <div class="gb-color-gallery__stage{% if hero_asset != blank %} gb-color-gallery__stage--portrait{% endif %}">
          {%- if hero_asset != blank -%}
            <img
              class="gb-color-gallery__main"
              src="{{ hero_asset | asset_img_url: '1400x' }}"
              srcset="{{ hero_asset | asset_img_url: '720x' }} 720w, {{ hero_asset | asset_img_url: '1100x' }} 1100w, {{ hero_asset | asset_img_url: '1400x' }} 1400w, {{ hero_asset | asset_url }} 2000w"
              sizes="(min-width: 990px) 56vw, 100vw"
              width="2000"
              height="2500"
              alt="{{ hero_alt | escape }}"
              loading="eager"
              fetchpriority="high"
              data-gb-color-main-image
              data-gb-color-custom-hero>
          {%- elsif current_media != blank -%}
            <img
              class="gb-color-gallery__main"
              src="{{ current_media.preview_image | image_url: width: 1600 }}"
              srcset="{{ current_media.preview_image | image_url: width: 720 }} 720w, {{ current_media.preview_image | image_url: width: 1100 }} 1100w, {{ current_media.preview_image | image_url: width: 1600 }} 1600w"
              sizes="(min-width: 990px) 56vw, 100vw"
              width="{{ current_media.preview_image.width }}"
              height="{{ current_media.preview_image.height }}"
              alt="{{ current_media.alt | default: product.title | escape }}"
              loading="eager"
              fetchpriority="high"
              data-gb-color-main-image>
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'gb-color-gallery__placeholder' }}
          {%- endif -%}

          <div class="gb-color-gallery__count" aria-label="Collector Pack includes 32 badges in four boxes">
            <strong>32</strong>
            <span>badges</span>
            <small>4 fitted boxes</small>
          </div>
        </div>

        {%- if section.settings.show_gallery_thumbs and product.media.size > 1 -%}
          <div class="gb-color-gallery__thumbs" aria-label="Product gallery">
            {%- if collector_media != blank -%}
              <button
                class="gb-color-gallery__thumb{% if current_media.id == collector_media.id %} is-active{% endif %}"
                type="button"
                aria-label="Show the complete four-region collector pack"
                aria-current="{% if current_media.id == collector_media.id %}true{% else %}false{% endif %}"
                data-gb-color-thumb
                data-media-id="{{ collector_media.id }}"
                data-full-src="{{ collector_media.preview_image | image_url: width: 1600 }}"
                data-full-srcset="{{ collector_media.preview_image | image_url: width: 720 }} 720w, {{ collector_media.preview_image | image_url: width: 1100 }} 1100w, {{ collector_media.preview_image | image_url: width: 1600 }} 1600w"
                data-alt="{{ collector_media.alt | default: 'All four regional gym badge sets' | escape }}">
                <img
                  src="{{ collector_media.preview_image | image_url: width: 260 }}"
                  width="{{ collector_media.preview_image.width }}"
                  height="{{ collector_media.preview_image.height }}"
                  alt=""
                  loading="lazy">
                <span>All 4</span>
              </button>
            {%- endif -%}

            {%- for media in product.media limit: 4 -%}
              {%- if media.media_type == 'image' -%}
                <button
                  class="gb-color-gallery__thumb{% if current_media.id == media.id %} is-active{% endif %}"
                  type="button"
                  aria-label="Show regional set image {{ forloop.index }}"
                  aria-current="{% if current_media.id == media.id %}true{% else %}false{% endif %}"
                  data-gb-color-thumb
                  data-media-id="{{ media.id }}"
                  data-full-src="{{ media.preview_image | image_url: width: 1600 }}"
                  data-full-srcset="{{ media.preview_image | image_url: width: 720 }} 720w, {{ media.preview_image | image_url: width: 1100 }} 1100w, {{ media.preview_image | image_url: width: 1600 }} 1600w"
                  data-alt="{{ media.alt | default: product.title | escape }}">
                  <img
                    src="{{ media.preview_image | image_url: width: 260 }}"
                    width="{{ media.preview_image.width }}"
                    height="{{ media.preview_image.height }}"
                    alt=""
                    loading="lazy">
                  <span>{{ product.variants[forloop.index0].title | split: ' ' | first }}</span>
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="gb-color-offer">
        <p class="gb-color-eyebrow">{{ hero_eyebrow | escape }}</p>
        <h1 id="gb-color-title-{{ section.id }}">{{ hero_heading_line_1 | escape }}<br>{{ hero_heading_line_2 | escape }}</h1>
        <p class="gb-color-offer__lede">{{ hero_lede | escape }}</p>

        <div class="gb-color-primary-purchase">
          <div class="gb-color-price" data-gb-color-price-wrap data-price-wrapper>
            <s data-gb-color-compare data-product-price-compare{% unless current_is_collector and collector_has_savings %} hidden{% endunless %}>{{ separate_total | money }}</s>
            <span data-gb-color-price data-product-price>{{ current_variant.price | money }}</span>
            <em class="medium-up--hide" data-gb-color-saving data-gb-has-savings="{% if collector_has_savings %}true{% else %}false{% endif %}"{% unless current_is_collector and collector_has_savings %} hidden{% endunless %}>{% if collector_has_savings %}Save {{ collector_savings_money }}{% endif %}</em>
            <small data-gb-color-price-note>
              {%- if current_is_collector -%}Collector Pack · 32 badges · 4 fitted boxes{%- else -%}8-badge regional set{%- endif -%}
            </small>
          </div>

          {%- assign form_id = 'GymBadgeColorForm-' | append: section.id -%}
          {%- form 'product', product, id: form_id, class: 'product-single__form gb-color-form' -%}
            <select name="id" class="no-js" data-gb-color-select data-product-select aria-label="Product variant">
              {%- for variant in product.variants -%}
                <option value="{{ variant.id }}"{% if variant.id == current_variant.id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title }} - {{ variant.price | money }}</option>
              {%- endfor -%}
            </select>

            <button
              class="btn btn--full gb-color-form__submit add-to-cart zenkai-primary-cta"
              type="submit"
              name="add"
              data-add-to-cart
              data-gb-color-submit
              aria-live="polite"
              {% unless current_variant.available %}disabled{% endunless %}>
              <span data-add-to-cart-text data-gb-color-submit-text>
                {%- if current_variant.available -%}
                  {%- if current_is_collector -%}Get All 32 — {{ current_variant.price | money }}{%- else -%}Get {{ current_variant.title }} — {{ current_variant.price | money }}{%- endif -%}
                {%- else -%}
                  Sold out
                {%- endif -%}
              </span>
            </button>

            <p class="gb-color-form__confidence">Free U.S. shipping · Secure checkout · Typical U.S. delivery: 1 business week</p>

            {%- unless section.settings.force_collector -%}
            <div class="gb-color-choice" aria-label="Collector Pack selection">
              <div class="gb-color-choice__heading">
                <div>
                  <span>Best value</span>
                  <strong>All 4 Regions</strong>
                </div>
                <em>{% if collector_has_savings %}Save {{ collector_savings_money }}{% else %}All four{% endif %}</em>
              </div>

              <button
                class="gb-color-collector-option{% if current_is_collector %} is-selected{% endif %}"
                type="button"
                aria-pressed="{% if current_is_collector %}true{% else %}false{% endif %}"
                data-gb-color-variant
                data-variant-id="{{ collector_variant.id }}"
                data-variant-title="{{ collector_variant.title | escape }}"
                data-price="{{ collector_variant.price | money | escape }}"
                data-price-note="Collector Pack · 32 badges · 4 fitted boxes"
                data-compare="{% if collector_has_savings %}{{ separate_total | money | escape }}{% endif %}"
                data-is-collector="true"
                data-media-id="{{ collector_media.id }}"
                data-image-src="{{ collector_media.preview_image | image_url: width: 1600 }}"
                data-image-srcset="{{ collector_media.preview_image | image_url: width: 720 }} 720w, {{ collector_media.preview_image | image_url: width: 1100 }} 1100w, {{ collector_media.preview_image | image_url: width: 1600 }} 1600w"
                data-image-alt="{{ collector_media.alt | default: 'All four regional gym badge sets' | escape }}"
                {% unless collector_variant.available %}disabled{% endunless %}>
                <span class="gb-color-collector-option__check" aria-hidden="true">✓</span>
                <span class="gb-color-collector-option__copy">
                  <strong>Collector Pack</strong>
                  <small>32 badges · 4 fitted boxes</small>
                </span>
                <span class="gb-color-collector-option__price">
                  <s>{{ separate_total | money }}</s>
                  <strong>{{ collector_variant.price | money }}</strong>
                </span>
              </button>
            </div>
            {%- endunless -%}

            <div class="hide" aria-hidden="true" data-variant-json>{{ product.variants | json }}</div>
          {%- endform -%}
        </div>

        <div class="gb-color-trust" aria-label="Order highlights">
          <span><b aria-hidden="true">✓</b> 32 badges · 4 fitted boxes</span>
          <span><b aria-hidden="true">✓</b> Free U.S. shipping</span>
          <span><b aria-hidden="true">✓</b> Secure checkout</span>
        </div>

        {%- if gb_offer_quote != blank -%}
          <figure class="gb-color-buyer-quote">
            <blockquote>“{{ gb_offer_quote | escape }}”</blockquote>
            <figcaption>{{ gb_offer_quote_meta | escape }}</figcaption>
          </figure>
        {%- endif -%}

        <p class="gb-color-gift-note"><strong>{{ gift_note_heading | escape }}</strong> {{ gift_note_body | escape }}</p>

        <p class="gb-color-policy-note">Damaged, missing, incorrect, or not as described? We’ll make it right. <a href="/pages/policy">Full collector policy</a>.</p>
      </div>
    </section>
  </div>

  <p class="gb-color-checkout-status" data-gb-color-checkout-status role="status" aria-live="polite" hidden></p>

  <section class="gb-color-inhand" aria-labelledby="gb-color-inhand-title-{{ section.id }}">
    <div class="gb-color-shell">
      <div class="gb-color-inhand__heading">
        <div><p class="gb-color-pill">Real collector photos</p><h2 id="gb-color-inhand-title-{{ section.id }}">Actually in hand.</h2></div>
        <p>Boxed, displayed, and close enough to see the enamel finish.</p>
      </div>
      <div class="gb-color-inhand__track">
        <figure>
          <img src="{{ framed_display_url }}&amp;width=720" width="677" height="1200" alt="Gym badges arranged in a framed shadow box" loading="lazy">
          <figcaption>Displayed</figcaption>
        </figure>
        <figure>
          <img src="{{ open_box_url }}&amp;width=720" width="675" height="1200" alt="Open gym badge box held in one hand" loading="lazy">
          <figcaption>In hand</figcaption>
        </figure>
        <figure>
          <img src="{{ boxed_arrival_url }}&amp;width=720" width="587" height="1200" alt="Regional gym badge box held just after delivery" loading="lazy">
          <figcaption>Delivered</figcaption>
        </figure>
        <figure>
          <img src="{{ collector_open_box_url }}&amp;width=720" width="1124" height="1500" alt="Open regional gym badge presentation box photographed by a collector" loading="lazy">
          <figcaption>Opened</figcaption>
        </figure>
      </div>
      <figure class="gb-color-inhand__wide">
        <img src="{{ closeup_url }}&amp;width=1400" width="1500" height="726" alt="Close-up view of colorful enamel gym badges" loading="lazy">
        <figcaption>Up close</figcaption>
      </figure>

      {%- if gb_inhand_quote != blank -%}
        <figure class="gb-color-proof-drop gb-color-proof-drop--inhand">
          <blockquote>“{{ gb_inhand_quote | escape }}”</blockquote>
          <figcaption>{{ gb_inhand_quote_meta | escape }}</figcaption>
        </figure>
      {%- endif -%}
    </div>
  </section>

  <section class="gb-color-angle" aria-labelledby="gb-color-angle-title-{{ section.id }}">
    <div class="gb-color-shell">
      <div class="gb-color-angle__intro">
        <p class="gb-color-pill">{{ angle_eyebrow | escape }}</p>
        <h2 id="gb-color-angle-title-{{ section.id }}">{{ angle_heading | escape }}</h2>
        <p>{{ angle_body | escape }}</p>
      </div>
      <div class="gb-color-angle__grid{% if angle_card_4_title != blank %} gb-color-angle__grid--four{% endif %}">
        <article>
          <span>01</span>
          <h3>{{ angle_card_1_title | escape }}</h3>
          <p>{{ angle_card_1_body | escape }}</p>
        </article>
        <article>
          <span>02</span>
          <h3>{{ angle_card_2_title | escape }}</h3>
          <p>{{ angle_card_2_body | escape }}</p>
        </article>
        <article>
          <span>03</span>
          <h3>{{ angle_card_3_title | escape }}</h3>
          <p>{{ angle_card_3_body | escape }}</p>
        </article>
        {%- if angle_card_4_title != blank -%}
          <article>
            <span>04</span>
            <h3>{{ angle_card_4_title | escape }}</h3>
            <p>{{ angle_card_4_body | escape }}</p>
          </article>
        {%- endif -%}
      </div>
    </div>
  </section>

  <section class="gb-color-regions" aria-labelledby="gb-color-regions-title-{{ section.id }}">
    <div class="gb-color-shell">
      <div class="gb-color-section-intro">
        <div>
          <p class="gb-color-pill">{{ regions_eyebrow | escape }}</p>
          <h2 id="gb-color-regions-title-{{ section.id }}">{{ regions_heading_line_1 | escape }}<br>{{ regions_heading_line_2 | escape }}</h2>
        </div>
        <p>{{ regions_body | escape }}</p>
      </div>

      <div class="gb-color-region-grid">
        {%- for variant in product.variants -%}
          {%- unless variant.id == collector_variant.id -%}
            {%- assign variant_media = product.media[forloop.index0] | default: product.featured_media -%}
            <article class="gb-color-region-card">
              <div class="gb-color-region-card__media">
                <img
                  src="{{ variant_media.preview_image | image_url: width: 900 }}"
                  srcset="{{ variant_media.preview_image | image_url: width: 480 }} 480w, {{ variant_media.preview_image | image_url: width: 700 }} 700w, {{ variant_media.preview_image | image_url: width: 900 }} 900w"
                  sizes="(min-width: 990px) 25vw, (min-width: 600px) 50vw, 100vw"
                  width="{{ variant_media.preview_image.width }}"
                  height="{{ variant_media.preview_image.height }}"
                  alt="{{ variant_media.alt | default: variant.title | escape }}"
                  loading="lazy">
              </div>
              <div class="gb-color-region-card__copy">
                <span>0{{ forloop.index }}</span>
                <div><h3>{{ variant.title }}</h3><p>Eight glossy hard-enamel badges in one fitted presentation box.</p></div>
              </div>
            </article>
          {%- endunless -%}
        {%- endfor -%}
      </div>

      <details class="gb-color-single-region-shop">
        <summary>
          <span><strong>Only want one region?</strong> Shop an individual 8-badge box.</span>
          <small>From {{ single_region_price | money }}</small>
          <b aria-hidden="true">+</b>
        </summary>
        <div class="gb-color-single-region-shop__inner">
          <p>Choose a regional box and add it right here—each one includes eight badges in its own fitted white presentation box.</p>
          <div class="gb-color-region-options">
            {%- for variant in product.variants -%}
              {%- unless variant.id == collector_variant.id -%}
                {%- assign variant_media = product.media[forloop.index0] | default: product.featured_media -%}
                <article
                  class="gb-color-region-purchase{% if variant.id == current_variant.id %} is-selected{% endif %}"
                  data-gb-color-region-purchase
                  data-variant-id="{{ variant.id }}">
                  <div class="gb-color-region-purchase__media">
                    <img
                      src="{{ variant_media.preview_image | image_url: width: 600 }}"
                      srcset="{{ variant_media.preview_image | image_url: width: 360 }} 360w, {{ variant_media.preview_image | image_url: width: 600 }} 600w"
                      sizes="(min-width: 990px) 220px, (min-width: 600px) 40vw, 44vw"
                      width="{{ variant_media.preview_image.width }}"
                      height="{{ variant_media.preview_image.height }}"
                      alt="{{ variant_media.alt | default: variant.title | escape }}"
                      loading="lazy">
                  </div>
                  <div class="gb-color-region-purchase__body">
                    <div class="gb-color-region-purchase__heading">
                      <div>
                        <strong>{{ variant.title }}</strong>
                        <span>8 badges · 1 fitted box</span>
                      </div>
                      <small>{{ variant.price | money }}</small>
                    </div>
                    <button
                      class="gb-color-region-purchase__add{% if variant.id == current_variant.id %} is-selected{% endif %}"
                      type="button"
                      aria-pressed="{% if variant.id == current_variant.id %}true{% else %}false{% endif %}"
                      aria-label="{% if variant.available %}Add {{ variant.title | escape }} regional badge box for {{ variant.price | money | escape }}{% else %}{{ variant.title | escape }} regional badge box is sold out{% endif %}"
                      data-gb-color-variant
                      data-gb-color-region-add
                      data-variant-id="{{ variant.id }}"
                      data-variant-title="{{ variant.title | escape }}"
                      data-price="{{ variant.price | money | escape }}"
                      data-price-note="8-badge regional set"
                      data-compare=""
                      data-is-collector="false"
                      data-media-id="{{ variant_media.id }}"
                      data-image-src="{{ variant_media.preview_image | image_url: width: 1600 }}"
                      data-image-srcset="{{ variant_media.preview_image | image_url: width: 720 }} 720w, {{ variant_media.preview_image | image_url: width: 1100 }} 1100w, {{ variant_media.preview_image | image_url: width: 1600 }} 1600w"
                      data-image-alt="{{ variant_media.alt | default: variant.title | escape }}"
                      {% unless variant.available %}disabled{% endunless %}>
                      {%- if variant.available -%}Get {{ variant.title }} — {{ variant.price | money }}{%- else -%}Sold out{%- endif -%}
                    </button>
                  </div>
                </article>
              {%- endunless -%}
            {%- endfor -%}
          </div>
        </div>
      </details>
    </div>
  </section>

  <section class="gb-color-detail" aria-labelledby="gb-color-detail-title-{{ section.id }}">
    <div class="gb-color-shell gb-color-detail__grid">
      <div class="gb-color-detail__image">
        <img
          src="{{ sunlight_url }}&amp;width=1400"
          srcset="{{ sunlight_url }}&amp;width=720 720w, {{ sunlight_url }}&amp;width=1050 1050w, {{ sunlight_url }}&amp;width=1400 1400w"
          sizes="(min-width: 900px) 55vw, 100vw"
          width="1500"
          height="1199"
          alt="Loose enamel gym badges catching bright sunlight"
          loading="lazy">
      </div>
      <div class="gb-color-detail__copy">
        <p class="gb-color-eyebrow">Color worth getting close to</p>
        <h2 id="gb-color-detail-title-{{ section.id }}">The badges do the talking.</h2>
        <p>Black display foam gives every color a clean stage. Up close, polished edges and glossy enamel keep every familiar shape crisp.</p>
        <ul>
          <li>Glossy hard-enamel color</li>
          <li>Raised polished-metal edges</li>
          <li>Secure clutch-style backs</li>
        </ul>
        {%- if gb_detail_quote != blank -%}
          <figure class="gb-color-proof-drop gb-color-proof-drop--compact gb-color-proof-drop--gift">
            <blockquote>“{{ gb_detail_quote | escape }}”</blockquote>
            <figcaption>{{ gb_detail_quote_meta | escape }}</figcaption>
          </figure>
        {%- endif -%}
      </div>
    </div>
  </section>

  <section class="gb-color-collector" aria-labelledby="gb-color-collector-title-{{ section.id }}">
    <div class="gb-color-shell gb-color-collector__grid">
      <div class="gb-color-collector__copy">
        <p class="gb-color-pill">{{ collector_eyebrow | escape }}</p>
        <h2 id="gb-color-collector-title-{{ section.id }}">{{ collector_heading_line_1 | escape }}<br>{{ collector_heading_line_2 | escape }}<br>{{ collector_heading_line_3 | escape }}</h2>
        <p>{{ collector_body | escape }} Get all four for {{ collector_variant.price | money }}{% if collector_has_savings %}—{{ collector_savings_money }} less than buying the boxes separately{% endif %}.</p>
        {%- if gb_collector_quote != blank -%}
          <figure class="gb-color-proof-drop gb-color-proof-drop--compact gb-color-proof-drop--nostalgia">
            <blockquote>“{{ gb_collector_quote | escape }}”</blockquote>
            <figcaption>{{ gb_collector_quote_meta | escape }}</figcaption>
          </figure>
        {%- endif -%}
        <div class="gb-color-collector__stats">
          <div><strong>32</strong><span>badges total</span></div>
          <div><strong>4</strong><span>fitted boxes</span></div>
          <div>{% if collector_has_savings %}<strong>{{ collector_savings_money }}</strong><span>collector savings</span>{% else %}<strong>1</strong><span>complete set</span>{% endif %}</div>
        </div>
        <button class="gb-color-collector__choose" type="button" data-gb-color-choose-collector>Get All 32 — {{ collector_variant.price | money }}</button>
      </div>
      <div class="gb-color-collector__image">
        {%- if hero_asset != blank -%}
          <img
            src="{{ hero_asset | asset_img_url: '1400x' }}"
            srcset="{{ hero_asset | asset_img_url: '720x' }} 720w, {{ hero_asset | asset_img_url: '1100x' }} 1100w, {{ hero_asset | asset_img_url: '1400x' }} 1400w, {{ hero_asset | asset_url }} 2000w"
            sizes="(min-width: 900px) 52vw, 100vw"
            width="2000"
            height="2500"
            alt="{{ hero_alt | escape }}"
            loading="lazy">
        {%- elsif collector_media != blank -%}
          <img
            src="{{ collector_media.preview_image | image_url: width: 1500 }}"
            srcset="{{ collector_media.preview_image | image_url: width: 720 }} 720w, {{ collector_media.preview_image | image_url: width: 1100 }} 1100w, {{ collector_media.preview_image | image_url: width: 1500 }} 1500w"
            sizes="(min-width: 900px) 52vw, 100vw"
            width="{{ collector_media.preview_image.width }}"
            height="{{ collector_media.preview_image.height }}"
            alt="{{ collector_media.alt | default: 'The complete four-region gym badge collection' | escape }}"
            loading="lazy">
        {%- endif -%}
        <span>All 32 shown · All 32 included</span>
      </div>
    </div>
  </section>

  <section class="gb-color-story" aria-label="Ways to collect, display, gift, and wear the gym badge pins">
    <div class="gb-color-shell">
      <article class="gb-color-story-card gb-color-story-card--featured">
        <div class="gb-color-story-card__media">
          <img
            src="{{ collector_story_url }}&amp;width=1400"
            srcset="{{ collector_story_url }}&amp;width=720 720w, {{ collector_story_url }}&amp;width=1050 1050w, {{ collector_story_url }}&amp;width=1400 1400w, {{ collector_story_url }}&amp;width=1800 1800w"
            sizes="(min-width: 990px) 62vw, 100vw"
            width="1800"
            height="1005"
            alt="The complete four-box gym badge Collector Pack"
            loading="lazy">
        </div>
        <div class="gb-color-story-card__copy">
          <p class="gb-color-eyebrow">{{ featured_eyebrow | escape }}</p>
          <h2>{{ featured_heading_line_1 | escape }}<br>{{ featured_heading_line_2 | escape }}<br>{{ featured_heading_line_3 | escape }}</h2>
          <p>{{ featured_body | escape }}</p>
        </div>
      </article>

      <div class="gb-color-story__grid">
        <article class="gb-color-story-card gb-color-story-card--quality">
          <div class="gb-color-story-card__media">
            <img
              src="{{ quality_story_url }}&amp;width=900"
              srcset="{{ quality_story_url }}&amp;width=600 600w, {{ quality_story_url }}&amp;width=900 900w, {{ quality_story_url }}&amp;width=1200 1200w"
              sizes="(min-width: 990px) 50vw, 100vw"
              width="1200"
              height="896"
              alt="Close-up proof of the glossy hard-enamel badges and raised metal trim"
              loading="lazy">
          </div>
          <div class="gb-color-story-card__copy">
            <p class="gb-color-eyebrow">Quality proof</p>
            <h3>Glossy hard enamel.<br>Raised metal trim.</h3>
            <p>Polished color, raised metal edges, and secure clutch backs.</p>
          </div>
        </article>

        <article class="gb-color-story-card gb-color-story-card--lifestyle">
          <div class="gb-color-story-card__media">
            <img
              src="{{ lifestyle_story_url }}&amp;width=900"
              srcset="{{ lifestyle_story_url }}&amp;width=600 600w, {{ lifestyle_story_url }}&amp;width=900 900w, {{ lifestyle_story_url }}&amp;width=1200 1200w"
              sizes="(min-width: 990px) 50vw, 100vw"
              width="1200"
              height="896"
              alt="Gym badge pins styled for display, gifting, and wearing"
              loading="lazy">
          </div>
          <div class="gb-color-story-card__copy">
            <p class="gb-color-eyebrow">Made to show</p>
            <h3>Display it.<br>Gift it. Wear it.</h3>
            <p>Small enough to wear. Clean enough to display.</p>
            {%- if gb_lifestyle_quote != blank -%}
              <figure class="gb-color-proof-drop gb-color-proof-drop--micro gb-color-proof-drop--delight">
                <blockquote>“{{ gb_lifestyle_quote | escape }}”</blockquote>
                <figcaption>{{ gb_lifestyle_quote_meta | escape }}</figcaption>
              </figure>
            {%- endif -%}
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="gb-color-details" aria-labelledby="gb-color-details-title-{{ section.id }}">
    <div class="gb-color-shell gb-color-details__grid">
      <div>
        <p class="gb-color-pill">The short version</p>
        <h2 id="gb-color-details-title-{{ section.id }}">Everything you need to know.</h2>
        <p>The Collector Pack brings all four regions together at the best per-badge price. Individual regional boxes remain available beneath the four-region lineup.</p>
      </div>
      <div class="gb-color-accordions">
        <details open>
          <summary>What arrives <span aria-hidden="true">+</span></summary>
          <div><p>Each regional option includes eight hard-enamel badges in one fitted presentation box. The Collector Pack includes all four regional boxes—32 badges total.</p></div>
        </details>
        <details>
          <summary>Why choose the Collector Pack <span aria-hidden="true">+</span></summary>
          <div><p>You get Kanto, Johto, Hoenn, and Sinnoh together for {{ collector_variant.price | money }}{% if collector_has_savings %}, saving {{ collector_savings_money }} compared with purchasing the four regional sets separately{% endif %}.</p></div>
        </details>
        <details>
          <summary>Where to use them <span aria-hidden="true">+</span></summary>
          <div><p>Keep the badges organized in their boxes, frame a favorite region, or move individual badges to jackets, bags, hats, cork boards, and pin displays.</p></div>
        </details>
        <details>
          <summary>Shipping and care <span aria-hidden="true">+</span></summary>
          <div><p>Most orders ship within 1–2 business days, with typical U.S. delivery in about one business week. Wipe the enamel with a soft dry cloth and remove badges before washing fabric.</p></div>
        </details>
      </div>
    </div>
  </section>

  <div class="gb-color-sticky" data-gb-color-sticky aria-hidden="true">
    <div class="gb-color-sticky__inner">
      <div class="gb-color-sticky__meta">
        <strong data-gb-color-sticky-price>{{ current_variant.price | money }}</strong>
        <span data-gb-color-sticky-label>{% if current_is_collector %}Collector Pack · 32 badges{% else %}{{ current_variant.title }} · 8 badges{% endif %}</span>
      </div>
      <button class="gb-color-sticky__button" type="button" data-gb-color-sticky-add tabindex="-1" {% unless current_variant.available %}disabled{% endunless %}>
        {% if current_is_collector %}Get All 32{% else %}Get {{ current_variant.title }}{% endif %}
      </button>
    </div>
  </div>
</div>

<script src="{{ 'gym-badge-color.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Gym badge color view",
  "settings": [
    {
      "type": "select",
      "id": "landing_variant",
      "label": "Landing-page journey",
      "default": "standard",
      "options": [
        { "value": "standard", "label": "Standard color" },
        { "value": "women", "label": "Women collectors" },
        { "value": "gift-daughter", "label": "Gift for daughter" },
        { "value": "gift-son", "label": "Gift for son" },
        { "value": "gift-girlfriend", "label": "Gift for girlfriend" },
        { "value": "gift-boyfriend", "label": "Gift for boyfriend" },
        { "value": "gift", "label": "Universal gift" },
        { "value": "completion", "label": "32 of 32 completion" },
        { "value": "collection", "label": "Souvenir to collection" },
        { "value": "og-four", "label": "OG four nostalgia" }
      ]
    },
    {
      "type": "checkbox",
      "id": "force_collector",
      "label": "Preselect the Collector Pack",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "direct_checkout",
      "label": "Send primary CTAs directly to checkout",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_gallery_thumbs",
      "label": "Show hero gallery thumbnails",
      "default": true
    },
    {
      "type": "text",
      "id": "hero_asset",
      "label": "Optional theme asset filename"
    },
    {
      "type": "text",
      "id": "hero_alt",
      "label": "Optional hero alt text"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Optional hero eyebrow override"
    },
    {
      "type": "text",
      "id": "hero_heading_line_1",
      "label": "Optional hero heading line 1 override"
    },
    {
      "type": "text",
      "id": "hero_heading_line_2",
      "label": "Optional hero heading line 2 override"
    },
    {
      "type": "textarea",
      "id": "hero_lede",
      "label": "Optional hero lead override"
    }
  ]
}
{% endschema %}
