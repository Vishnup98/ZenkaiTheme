{%- assign collector_variant = blank -%}
{%- assign collector_variant_index = 0 -%}
{%- assign single_region_price = 0 -%}
{%- assign separate_total = 0 -%}

{%- for variant in product.variants -%}
  {%- assign variant_title_downcase = variant.title | downcase -%}
  {%- if variant_title_downcase contains 'collector' or variant_title_downcase contains '4 regions' or variant_title_downcase contains '4 region' -%}
    {%- assign collector_variant = variant -%}
    {%- assign collector_variant_index = forloop.index0 -%}
  {%- else -%}
    {%- assign separate_total = separate_total | plus: variant.price -%}
    {%- if single_region_price == 0 -%}
      {%- assign single_region_price = variant.price -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{%- if collector_variant == blank -%}
  {%- assign collector_variant = product.selected_or_first_available_variant -%}
{%- endif -%}

{%- assign current_variant = collector_variant -%}
{%- unless section.settings.force_collector -%}
  {%- if product.selected_variant != blank -%}
    {%- assign current_variant = product.selected_variant -%}
  {%- endif -%}
{%- endunless -%}
{%- unless current_variant.available -%}
  {%- assign current_variant = product.selected_or_first_available_variant -%}
{%- endunless -%}

{%- assign collector_media = product.media[collector_variant_index] | default: product.media.last | default: product.featured_media -%}
{%- assign current_media = collector_media -%}
{%- for variant in product.variants -%}
  {%- if variant.id == current_variant.id -%}
    {%- assign current_media = product.media[forloop.index0] | default: collector_media -%}
  {%- endif -%}
{%- endfor -%}

{%- assign collector_savings = separate_total | minus: collector_variant.price -%}
{%- assign collector_has_savings = false -%}
{%- if collector_savings > 0 -%}
  {%- assign collector_has_savings = true -%}
{%- endif -%}
{%- assign collector_savings_money = collector_savings | money -%}
{%- assign current_is_collector = false -%}
{%- if current_variant.id == collector_variant.id -%}
  {%- assign current_is_collector = true -%}
{%- endif -%}

