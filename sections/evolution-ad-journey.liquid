{%- assign v = product.selected_or_first_available_variant -%}
{%- assign form_id = 'EvolutionRainbowPawsForm-' | append: section.id -%}
{%- assign per_plush = v.price | divided_by: 8.0 -%}
{%- assign portrait_names = 'espeon,jolteon,flareon,glaceon,sylveon,vaporeon,leafeon,umbreon' | split: ',' -%}
{%- assign portrait_moods = 'Daydream,Electric,Toasty,Snow day,Sweetheart,Splashy,Fresh air,Midnight' | split: ',' -%}
{%- assign portrait_descriptions = 'plush with a lavender hood and tall ears|plush with a yellow hood and white collar|plush with an orange hood and fluffy yellow collar|plush with a pale blue hood and long side flaps|plush with a pink and white hood and ribbons|plush with a bright blue hood and fin-shaped ears|plush with a pale yellow hood and green leaf details|plush with a charcoal hood and yellow ear bands' | split: '|' -%}
{%- assign hero_lede_lead = 'Eight colors. Eight moods.' -%}

<div class="fg-page" data-ec-page data-journey="{{ section.settings.journey_id | escape }}">
  <section class="fg-hero fg-shell" aria-labelledby="fg-title-{{ section.id }}">
    <figure class="fg-hero-media">
      <span class="fg-hero-splash fg-hero-splash--one" aria-hidden="true"></span>
      <span class="fg-hero-splash fg-hero-splash--two" aria-hidden="true"></span>
      <div class="fg-hero-image">
        <img src="{{ 'evo-portrait-group-480.webp' | asset_url }}" srcset="{{ 'evo-portrait-group-480.webp' | asset_url }} 480w, {{ 'evo-portrait-group-1024.webp' | asset_url }} 1024w" sizes="(max-width: 599px) calc(100vw - 54px), (max-width: 899px) min(592px, calc(100vw - 68px)), (max-width: 1239px) 46vw, 566px" width="1024" height="687" alt="All eight colorful Evolution Companions plushes together" loading="eager" fetchpriority="high">
      </div>
      <span class="fg-all-eight-stamp"><strong>8</strong><span>companions,<br>one happy set.</span>{% render 'evolution-paw-mark', class: 'fg-stamp-paw' %}</span>
      <span class="fg-hero-paw-trail" aria-hidden="true">{% render 'evolution-paw-mark', class: 'fg-trail-paw fg-trail-paw--one' %}{% render 'evolution-paw-mark', class: 'fg-trail-paw fg-trail-paw--two' %}{% render 'evolution-paw-mark', class: 'fg-trail-paw fg-trail-paw--three' %}</span>
    </figure>

    <div class="fg-hero-copy">
      <p class="fg-identity"><span aria-label="Evolution" class="fg-rainbow-letters"><i>E</i><i>V</i><i>O</i><i>L</i><i>U</i><i>T</i><i>I</i><i>O</i><i>N</i></span> <span>Companions</span>{% render 'evolution-paw-mark', class: 'fg-identity-paw' %}</p>
      <h1 id="fg-title-{{ section.id }}">{{ section.settings.hero_prefix | escape }} <span class="fg-rainbow-word">{{ section.settings.hero_accent | escape }}</span><br>{{ section.settings.hero_suffix | escape }}</h1>
      <p class="fg-lede">{% if section.settings.hero_body contains hero_lede_lead %}<strong>{{ hero_lede_lead }}</strong>{{ section.settings.hero_body | remove_first: hero_lede_lead | escape }}{% else %}{{ section.settings.hero_body | escape }}{% endif %}</p>

      <div class="evo-purchase-proof evo-purchase-proof--hero" role="group" aria-label="Rated 4.8 out of 5 from 98 Zenkai Shop reviews, more than 3,100 shop orders, and ships free">
        <div class="evo-proof-rating"><span class="evo-proof-rating-line"><span class="evo-proof-stars" aria-hidden="true">★</span><strong>4.8/5</strong></span><small>98 Zenkai shop reviews</small></div>
        <div class="evo-proof-orders"><strong>3,100+</strong><small>Shop orders</small></div>
        <div class="evo-proof-shipping"><span class="evo-proof-paw-badge" aria-hidden="true">{% render 'evolution-paw-mark', class: 'evo-proof-shipping-paw' %}</span><strong>Ships Free</strong></div>
      </div>

      <div class="fg-offer">
        <div class="fg-price">{% render 'collector-compare-price', variant: v, compact: true %}<strong>{{ v.price | money_without_trailing_zeros }}</strong>{% render 'collector-compare-price', variant: v, compact: true, part: 'savings' %}<span>Complete 8-plush set<small>{{ per_plush | money_without_trailing_zeros }} each · every color included</small></span></div>
        {%- form 'product', product, id: form_id, class: 'ec-product-form fg-product-form' -%}
          <input type="hidden" name="id" value="{{ v.id }}">
          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="return_to" value="/checkout">
          <input type="hidden" name="properties[_zk_landing_view]" value="{{ section.settings.journey_id | escape }}">
          <button class="ec-cta fg-cta" type="submit" name="add" data-ec-main-cta {% unless v.available %}disabled{% endunless %}>{% if v.available %}<span class="fg-cta-label">{{ section.settings.cta_label | escape }}</span>{% else %}Sold out{% endif %}</button>
          <p class="fg-shipping" aria-label="Free shipping. {{ section.settings.shipping_summary | escape }}"><strong>Free shipping</strong><span class="fg-shipping-divider" aria-hidden="true">·</span><span>{{ section.settings.shipping_summary | escape }}</span></p>
          {{ form | payment_button }}
        {%- endform -%}
      </div>
    </div>
  </section>

  <section class="fg-paw-promise" aria-label="Complete set highlights">
    <div class="fg-shell">
      <div><span class="fg-mini-paw fg-paw--pink">{% render 'evolution-paw-mark', class: 'fg-paw-icon' %}</span><p><strong>All 8 included</strong></p></div>
      <div><span class="fg-mini-paw fg-paw--blue">{% render 'evolution-paw-mark', class: 'fg-paw-icon' %}</span><p><strong>Free shipping</strong></p></div>
    </div>
  </section>

{% capture journey_moods %}
  <section class="fg-moods" aria-labelledby="fg-moods-title-{{ section.id }}">
    {% render 'evolution-paw-mark', class: 'fg-bg-paw fg-bg-paw--moods' %}
    <div class="fg-rainbow-rule" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
    <div class="fg-shell">
      <header class="fg-section-heading">
        <p class="fg-eyebrow">The whole colorful crew {% render 'evolution-paw-mark', class: 'fg-eyebrow-paw' %}</p>
        <h2 id="fg-moods-title-{{ section.id }}">{{ section.settings.moods_title | escape }}</h2>
        <p>{{ section.settings.moods_body | escape }}</p>
      </header>
      <div class="fg-mood-grid" role="list" aria-label="The eight included plush companions">
        {% for name in portrait_names %}
          {% assign full = 'evo-portrait-' | append: name | append: '-1024.webp' %}
          {% assign small = 'evo-portrait-' | append: name | append: '-480.webp' %}
          {% assign portrait_height = 1024 %}
          {% if name == 'espeon' %}{% assign portrait_height = 918 %}{% endif %}
          <article class="fg-mood-card fg-mood-card--{{ name }}" role="listitem">
            <div class="fg-mood-card-image">
              <img src="{{ small | asset_url }}" srcset="{{ small | asset_url }} 480w, {{ full | asset_url }} 1024w" sizes="(min-width: 1100px) 260px, (min-width: 680px) 44vw, 46vw" width="1024" height="{{ portrait_height }}" loading="lazy" alt="Full view of {{ portrait_descriptions[forloop.index0] }}">
            </div>
            <footer><span>Today’s mood</span><strong>{{ portrait_moods[forloop.index0] }}</strong>{% render 'evolution-paw-mark', class: 'fg-card-paw' %}</footer>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
{% endcapture %}

{% capture journey_personality %}
  <section class="fg-personality fg-shell" aria-labelledby="fg-personality-title-{{ section.id }}">
    <div class="fg-personality-copy">
      <p class="fg-eyebrow">{{ section.settings.personality_eyebrow | escape }}</p>
      <h2 id="fg-personality-title-{{ section.id }}">{{ section.settings.personality_title | escape }}</h2>
      <p>{{ section.settings.personality_body | escape }}</p>
      <p class="fg-hand-note">{{ section.settings.hand_note | escape }}</p>
    </div>
    <figure class="fg-lineup-photo"><button type="button" data-ec-zoom="{{ 'evo-campaign-customer-01.webp' | asset_url }}" aria-label="Enlarge the complete companion lineup"><img src="{{ 'evo-campaign-customer-01.webp' | asset_url }}" width="960" height="285" loading="lazy" alt="All eight plush companions lined up together"></button></figure>
  </section>
{% endcapture %}

{% capture journey_closeup %}
  <section class="fg-closeup">
    <div class="fg-shell fg-closeup-grid">
      <figure><button type="button" data-ec-zoom="{{ 'evo-portrait-detail-1024.webp' | asset_url }}" aria-label="Enlarge the face and hood details"><img src="{{ 'evo-portrait-detail-480.webp' | asset_url }}" srcset="{{ 'evo-portrait-detail-480.webp' | asset_url }} 480w, {{ 'evo-portrait-detail-1024.webp' | asset_url }} 1024w" sizes="(max-width: 599px) calc(100vw - 54px), (max-width: 899px) min(592px, calc(100vw - 68px)), (max-width: 1239px) 46vw, 566px" width="1024" height="687" loading="lazy" alt="Close-up of the plush face, embroidered hood and little brown paws"></button></figure>
      <div><p class="fg-eyebrow">The cute is in the details {% render 'evolution-paw-mark', class: 'fg-eyebrow-paw' %}</p><h2>{{ section.settings.detail_title | escape }}</h2><p>{{ section.settings.detail_body | escape }}</p><div class="fg-face-doodle" aria-hidden="true"><svg viewBox="0 0 140 72" fill="none"><ellipse cx="33" cy="16" rx="6" ry="10" fill="currentColor" transform="rotate(-7 33 16)"/><ellipse cx="107" cy="16" rx="6" ry="10" fill="currentColor" transform="rotate(7 107 16)"/><ellipse cx="70" cy="34" rx="4.5" ry="3" fill="currentColor"/><path d="M18 47c13 12 28 14 42 2 5-4 8-8 10-12 3 4 6 8 11 12 14 12 29 10 42-2" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg></div></div>
    </div>
  </section>
{% endcapture %}

{% capture journey_scale %}
  <section class="fg-scale fg-shell" aria-labelledby="fg-scale-title-{{ section.id }}">
    <div class="fg-scale-copy"><p class="fg-eyebrow">Small crew. Big presence.</p><h2 id="fg-scale-title-{{ section.id }}">Made for desks, shelves<br>and bedside duty.</h2><p>At about eight inches each, they’re easy to keep close—and colorful enough to make the whole shelf feel happier.</p><dl><div><dt>Height</dt><dd>about 8 in</dd></div><div><dt>Each plush</dt><dd>approx. 8 × 7 × 6 in</dd></div></dl></div>
    <div class="fg-scale-photos" aria-label="Customer photos showing two plushes held in a hand">
      <figure><button type="button" data-ec-zoom="{{ 'evo-campaign-handheld-purple-720.webp' | asset_url }}" aria-label="Enlarge the lavender plush held in one hand"><img src="{{ 'evo-campaign-handheld-purple-360.webp' | asset_url }}" srcset="{{ 'evo-campaign-handheld-purple-360.webp' | asset_url }} 360w, {{ 'evo-campaign-handheld-purple-720.webp' | asset_url }} 720w" sizes="(min-width: 900px) 250px, 47vw" width="720" height="960" loading="lazy" alt="Customer holding the lavender hood plush for scale"></button><figcaption>One-hand daydream</figcaption></figure>
      <figure><button type="button" data-ec-zoom="{{ 'evo-campaign-handheld-pink-720.webp' | asset_url }}" aria-label="Enlarge the pink ribbon plush held in one hand"><img src="{{ 'evo-campaign-handheld-pink-360.webp' | asset_url }}" srcset="{{ 'evo-campaign-handheld-pink-360.webp' | asset_url }} 360w, {{ 'evo-campaign-handheld-pink-720.webp' | asset_url }} 720w" sizes="(min-width: 900px) 250px, 47vw" width="720" height="960" loading="lazy" alt="Customer holding the pink ribbon plush for scale"></button><figcaption>Sweetness to go</figcaption></figure>
    </div>
  </section>
{% endcapture %}

{% assign journey_order = section.settings.section_order | split: ',' %}{% for part in journey_order %}{% case part %}{% when 'moods' %}{{ journey_moods }}{% when 'personality' %}{{ journey_personality }}{% when 'closeup' %}{{ journey_closeup }}{% when 'scale' %}{{ journey_scale }}{% endcase %}{% endfor %}
  <section class="fg-community" aria-labelledby="fg-community-title-{{ section.id }}">
    <div class="fg-shell">
      <header class="fg-section-heading fg-section-heading--community"><p class="fg-eyebrow">The rainbow, out in the world</p><h2 id="fg-community-title-{{ section.id }}">Already making<br>themselves at home.</h2><p>Real customer photos. Real little shelf-stealers.</p></header>
      <div class="fg-customer-grid" aria-label="Customer product photos">
        {%- for i in (2..6) -%}
          {%- assign customer_asset = 'evo-campaign-customer-0' | append: i | append: '.webp' -%}
          {%- case i -%}
            {%- when 2 -%}{%- assign customer_alt = 'Pink, lavender and orange companion plushes together' -%}{%- assign customer_width = 720 -%}{%- assign customer_height = 540 -%}
            {%- when 3 -%}{%- assign customer_alt = 'Lavender hood companion plush photographed by a customer' -%}{%- assign customer_width = 720 -%}{%- assign customer_height = 960 -%}
            {%- when 4 -%}{%- assign customer_alt = 'Pink ribbon companion plush photographed by a customer' -%}{%- assign customer_width = 720 -%}{%- assign customer_height = 960 -%}
            {%- when 5 -%}{%- assign customer_alt = 'Two blue companion plushes together' -%}{%- assign customer_width = 360 -%}{%- assign customer_height = 780 -%}
            {%- when 6 -%}{%- assign customer_alt = 'Charcoal hood companion plush photographed by a customer' -%}{%- assign customer_width = 412 -%}{%- assign customer_height = 960 -%}
          {%- endcase -%}
          <figure><button type="button" data-ec-zoom="{{ customer_asset | asset_url }}" aria-label="Enlarge customer photo"><img src="{{ customer_asset | asset_url }}" width="{{ customer_width }}" height="{{ customer_height }}" loading="lazy" alt="{{ customer_alt }}"></button></figure>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="fg-reviews" aria-labelledby="fg-reviews-title-{{ section.id }}">
    {% render 'evolution-paw-mark', class: 'fg-bg-paw fg-bg-paw--reviews' %}
    <div class="fg-shell">
      <div class="fg-review-heading"><div><p class="fg-eyebrow">Loved from ear to paw</p><h2 id="fg-reviews-title-{{ section.id }}">The paw-sitive reviews are in.</h2></div><p class="fg-review-score" aria-label="Rated 4.8 out of 5 from 98 Shop reviews"><span aria-hidden="true">★★★★★</span><strong>4.8/5</strong><small>98 Shop reviews</small></p></div>
      <div class="fg-review-grid">
        <figure><span class="fg-review-paw fg-paw--pink">{% render 'evolution-paw-mark', class: 'fg-paw-icon' %}</span><blockquote>“<strong class="fg-review-highlight">Super adorable!</strong> … had to grab some more for friends.”</blockquote></figure>
        <figure><span class="fg-review-paw fg-paw--yellow">{% render 'evolution-paw-mark', class: 'fg-paw-icon' %}</span><blockquote>“Wife loved them 💪🏾 Kids love them soft, perfect for gifts, <strong class="fg-review-highlight">couldn’t ask for better</strong> 👍”</blockquote></figure>
        <figure><span class="fg-review-paw fg-paw--blue">{% render 'evolution-paw-mark', class: 'fg-paw-icon' %}</span><blockquote>“<strong class="fg-review-highlight">Awesome quality!</strong> i now have collected all 8 from this seller! fast shipping and highly recommend buyer here!”</blockquote></figure>
      </div>
    </div>
  </section>

  <section class="fg-faq fg-shell" aria-labelledby="fg-faq-title-{{ section.id }}">
    <header><p class="fg-eyebrow">Good to know before they arrive</p><h2 id="fg-faq-title-{{ section.id }}">Before the paws hit your doorstep.</h2>{% render 'evolution-paw-mark', class: 'fg-faq-paw' %}</header>
    <div>
      <details><summary>Does the price include all eight?<span aria-hidden="true">+</span></summary><p>Yes. {{ v.price | money_without_trailing_zeros }} buys eight separate plush companions, with one of every design pictured. Each plush comes in its own costume; this is not one plush with spare outfits. Display props and gift wrapping are not included.</p></details>
      <details><summary>Can I choose just one color?<span aria-hidden="true">+</span></summary><p>This page is for the complete collection, so all eight pictured colors are included and there is no color selection to make.</p></details>
      <details><summary>How big is each plush?<span aria-hidden="true">+</span></summary><p>Each is approximately 8 × 7 × 6 inches. Hood and ear shapes vary, so allow a little extra room when planning your display.</p></details>
      <details><summary>Is shipping free, and when will they arrive?<span aria-hidden="true">+</span></summary><p>Shipping is free. Delivery typically takes 7–10 business days, with tracking provided after dispatch. The set may arrive separately from other products in your order.</p></details>
      <details><summary>How should I care for them?<span aria-hidden="true">+</span></summary><p>Spot clean gently and air dry. Keep away from heat and open flames. Not suitable for children under 3 years old.</p></details>
      <details><summary>What if something is wrong with my order?<span aria-hidden="true">+</span></summary><p>If an item is lost in transit, damaged, defective, incorrect, or materially different from its description, contact us with your order number and available photos. <a href="/policies/refund-policy">Read our refund and order-care policy.</a></p></details>
    </div>
  </section>

  <section class="fg-final">
    <span class="fg-final-paw-cloud" aria-hidden="true">{% render 'evolution-paw-mark', class: 'fg-final-paw fg-final-paw--one' %}{% render 'evolution-paw-mark', class: 'fg-final-paw fg-final-paw--two' %}{% render 'evolution-paw-mark', class: 'fg-final-paw fg-final-paw--three' %}</span>
    <div class="fg-shell fg-final-grid">
      <figure><img src="{{ 'evo-portrait-group-480.webp' | asset_url }}" srcset="{{ 'evo-portrait-group-480.webp' | asset_url }} 480w, {{ 'evo-portrait-group-1024.webp' | asset_url }} 1024w" sizes="(min-width: 900px) 50vw, 100vw" width="1024" height="687" loading="lazy" alt="The complete eight-plush Evolution Companions set"></figure>
      <div><p class="fg-eyebrow">All eight. All yours. {% render 'evolution-paw-mark', class: 'fg-eyebrow-paw' %}</p><h2>{{ section.settings.final_title | escape }}</h2><p>{{ section.settings.final_body | escape }}</p><button class="ec-cta fg-cta" type="submit" form="{{ form_id }}" data-ec-inline-cta {% unless v.available %}disabled{% endunless %}>{% if v.available %}<span class="fg-cta-label">{{ section.settings.cta_label | escape }}</span>{% else %}Sold out{% endif %}</button><p class="fg-final-delivery"><strong>Free shipping</strong> · {{ section.settings.shipping_summary | escape }}</p></div>
    </div>
  </section>

  <aside class="ec-sticky fg-sticky" data-ec-sticky aria-label="Quick add complete set"><div>{% render 'collector-compare-price', variant: v, compact: true, context: 'sticky' %}<strong>{{ v.price | money_without_trailing_zeros }}</strong><small><span>Complete Collection</span><span>Ships free</span></small></div><button class="ec-cta fg-cta" type="submit" form="{{ form_id }}" {% unless v.available %}disabled{% endunless %}>{% if v.available %}<span class="fg-cta-label">{{ section.settings.cta_label | escape }}</span>{% else %}Sold out{% endif %}</button></aside>

  <dialog class="ec-lightbox fg-lightbox" data-ec-lightbox aria-label="Enlarged collection photo"><div class="ec-lightbox-toolbar"><button type="button" data-ec-zoom-toggle aria-pressed="false">Zoom in</button><span>Swipe or scroll to explore</span><button type="button" data-ec-close aria-label="Close photo" autofocus>×</button></div><div class="ec-lightbox-viewport" tabindex="0" aria-label="Product photo; scroll to explore when enlarged"><img width="1024" height="1024" alt="Enlarged companion plush photo"></div></dialog>
</div>

{% schema %}
{
  "name": "Evolution ad journey",
  "settings": [
    {
      "type": "text",
      "id": "hero_prefix",
      "label": "Hero headline opening",
      "default": "Every"
    },
    {
      "type": "text",
      "id": "hero_accent",
      "label": "Rainbow headline word",
      "default": "color"
    },
    {
      "type": "text",
      "id": "hero_suffix",
      "label": "Hero headline ending",
      "default": "comes home."
    },
    {
      "type": "textarea",
      "id": "hero_body",
      "label": "Hero introduction",
      "default": "Eight colors. Eight moods. Eight ridiculously cute little companions. The whole rainbow, together in one complete set."
    },
    {
      "type": "text",
      "id": "shipping_summary",
      "label": "Shipping summary",
      "default": "Usually arrives in 7–10 business days"
    },
    {
      "type": "text",
      "id": "detail_title",
      "label": "Detail headline",
      "default": "Tiny hood. Tiny paws. Huge personality."
    },
    {
      "type": "textarea",
      "id": "detail_body",
      "label": "Detail body",
      "default": "Soft ears, embroidered faces, colorful hoods and those unmistakable little brown paws. Every design has its own silhouette, but the whole crew feels like family."
    },
    {
      "type": "text",
      "id": "final_title",
      "label": "Final headline",
      "default": "Bring the whole rainbow home."
    },
    {
      "type": "textarea",
      "id": "final_body",
      "label": "Final body",
      "default": "Every color. Every mood. Eight little companions ready to make your favorite corner theirs."
    },
    {
      "type": "textarea",
      "id": "journey_id",
      "label": "Journey id",
      "default": "evo-rainbow-paws"
    },
    {
      "type": "textarea",
      "id": "cta_label",
      "label": "Cta label",
      "default": "Bring all 8 home"
    },
    {
      "type": "textarea",
      "id": "moods_title",
      "label": "Moods title",
      "default": "Meet the whole crew."
    },
    {
      "type": "textarea",
      "id": "moods_body",
      "label": "Moods body",
      "default": "All eight pictured designs are included."
    },
    {
      "type": "textarea",
      "id": "personality_title",
      "label": "Personality title",
      "default": "A place for every companion."
    },
    {
      "type": "textarea",
      "id": "personality_body",
      "label": "Personality body",
      "default": "Keep the full crew together or arrange them around your favorite room."
    },
    {
      "type": "textarea",
      "id": "hand_note",
      "label": "Hand note",
      "default": "Eight companions. Your own arrangement."
    },
    {
      "type": "textarea",
      "id": "personality_eyebrow",
      "label": "Personality eyebrow",
      "default": "Picture them at home"
    },
    {
      "type": "textarea",
      "id": "section_order",
      "label": "Section order",
      "default": "moods,personality,closeup,scale"
    }
  ],
  "presets": [
    {
      "name": "Evolution ad journey"
    }
  ]
}
{% endschema %}
