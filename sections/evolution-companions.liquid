{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign current_variant_sellable = current_variant.available -%}
{%- if current_variant.inventory_policy == 'continue' -%}
  {%- assign current_variant_sellable = true -%}
{%- endif -%}
{%- assign hero_media = product.media.first -%}
{%- assign lineup_media = hero_media -%}
{%- assign has_customer_lineup = false -%}
{%- assign product_gallery_count = 0 -%}
{%- for media in product.media -%}
  {%- if media.media_type == 'image' and media.alt contains 'Customer' -%}
    {%- unless has_customer_lineup -%}
      {%- assign lineup_media = media -%}
      {%- assign has_customer_lineup = true -%}
    {%- endunless -%}
  {%- elsif media.media_type == 'image' -%}
    {%- assign product_gallery_count = product_gallery_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}
{%- assign lineup_media = lineup_media | default: hero_media -%}
{%- assign savings = current_variant.compare_at_price | minus: current_variant.price -%}

{{ 'evolution-companions.css' | asset_url | stylesheet_tag }}

<div
  id="ProductSection-{{ product.id }}"
  class="evo-plush-page"
  data-evo-plush-page
  data-section-id="{{ product.id }}"
  data-section-type="product-template"
  data-enable-history-state="true">
  <div class="evo-plush-shell">
    <nav class="evo-plush-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Evolution Companions</span>
    </nav>

    <section class="evo-plush-hero" aria-labelledby="evo-plush-title-{{ section.id }}">
      <div class="evo-plush-gallery" data-evo-plush-gallery>
        <div class="evo-plush-gallery__stage">
          {%- if hero_media != blank -%}
            <img
              class="evo-plush-gallery__main"
              src="{{ hero_media.preview_image | image_url: width: 1800 }}"
              srcset="{{ hero_media.preview_image | image_url: width: 720 }} 720w, {{ hero_media.preview_image | image_url: width: 1200 }} 1200w, {{ hero_media.preview_image | image_url: width: 1800 }} 1800w"
              sizes="(min-width: 990px) 58vw, 100vw"
              width="{{ hero_media.preview_image.width }}"
              height="{{ hero_media.preview_image.height }}"
              alt="{{ hero_media.alt | default: product.title | escape }}"
              loading="eager"
              fetchpriority="high"
              data-evo-plush-main-image>
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'evo-plush-gallery__placeholder' }}
          {%- endif -%}
        </div>

        {%- if product_gallery_count > 1 -%}
          <div class="evo-plush-gallery__thumbs" aria-label="Product gallery">
            {%- for media in product.media -%}
              {%- unless media.alt contains 'Customer' -%}
                {%- if media.media_type == 'image' -%}
                  <button
                    class="evo-plush-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                    type="button"
                    aria-label="Show {{ media.alt | default: product.title | escape }}"
                    aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                    data-evo-plush-thumb
                    data-full-src="{{ media.preview_image | image_url: width: 1800 }}"
                    data-full-srcset="{{ media.preview_image | image_url: width: 720 }} 720w, {{ media.preview_image | image_url: width: 1200 }} 1200w, {{ media.preview_image | image_url: width: 1800 }} 1800w"
                    data-alt="{{ media.alt | default: product.title | escape }}">
                    <img
                      src="{{ media.preview_image | image_url: width: 280 }}"
                      width="{{ media.preview_image.width }}"
                      height="{{ media.preview_image.height }}"
                      alt=""
                      loading="lazy">
                  </button>
                {%- endif -%}
              {%- endunless -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="evo-plush-offer">
        <p class="evo-plush-eyebrow">Evolution Companions · Complete collection</p>
        <h1 id="evo-plush-title-{{ section.id }}">Every little face. All eight.</h1>
        <p class="evo-plush-offer__lede">Eight colorful costumes, one complete plush collection. Your first favorite gets the best spot. The others won’t be far away.</p>

        <div class="evo-plush-price" aria-label="Sale price">
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <s>{{ current_variant.compare_at_price | money }}</s>
          {%- endif -%}
          <strong>{{ current_variant.price | money }}</strong>
          {%- if savings > 0 -%}<span>Save {{ savings | money }}</span>{%- endif -%}
        </div>

        <div class="evo-plush-palette" aria-label="Eight costume colors included">
          <span style="--swatch:#f4a9bb" title="Pink"></span>
          <span style="--swatch:#bfa5e8" title="Lavender"></span>
          <span style="--swatch:#b9e6f3" title="Icy blue"></span>
          <span style="--swatch:#4ba9d7" title="Blue"></span>
          <span style="--swatch:#f3792d" title="Orange"></span>
          <span style="--swatch:#f3d64f" title="Yellow"></span>
          <span style="--swatch:#d6bf68" title="Gold"></span>
          <span style="--swatch:#2f3036" title="Black"></span>
          <em>Every color shown is included</em>
        </div>

        {%- form 'product', product, id: 'EvolutionCompanionsForm', class: 'product-single__form evo-plush-form' -%}
          <input type="hidden" name="quantity" value="1">
          <select name="id" class="no-js" data-product-select aria-label="Product variant">
            {%- for variant in product.variants -%}
              <option value="{{ variant.id }}"{% if variant == current_variant %} selected{% endif %}{% unless variant.available or variant.inventory_policy == 'continue' %} disabled{% endunless %}>{{ variant.title }}</option>
            {%- endfor -%}
          </select>
          <button
            class="btn btn--full evo-plush-form__submit add-to-cart zenkai-primary-cta"
            type="submit"
            name="add"
            data-add-to-cart
            aria-live="polite"
            {% unless current_variant_sellable %}disabled{% endunless %}>
            <span data-add-to-cart-text>
              {%- if current_variant_sellable -%}
                Make All 8 Mine — {{ current_variant.price | money }}
              {%- else -%}
                Sold out
              {%- endif -%}
            </span>
          </button>
          <div class="hide" aria-hidden="true" data-variant-json>{{ product.variants | json }}</div>
        {%- endform -%}

        <p class="evo-plush-shipping-note"><strong>Free U.S. shipping</strong><span>Arrives in 5–7 business days</span></p>
        <p class="evo-plush-policy"><a href="/pages/policy">Delivery &amp; returns</a></p>
      </div>
    </section>
  </div>

  <section class="evo-plush-manifesto" aria-labelledby="evo-plush-manifesto-{{ section.id }}">
    <div class="evo-plush-shell evo-plush-manifesto__intro">
      <div>
        <h2 id="evo-plush-manifesto-{{ section.id }}">Picking one was never really the plan.</h2>
      </div>
      <p>Line them up where you’ll see them every day. Straighten an ear, move your favorite to the middle, then step back for another look.</p>
    </div>
  </section>

  <section class="evo-plush-story" aria-labelledby="evo-plush-story-{{ section.id }}">
    <div class="evo-plush-shell evo-plush-story__grid">
      <div class="evo-plush-story__image">
        {%- if lineup_media != blank -%}
          <img
            src="{{ lineup_media.preview_image | image_url: width: 1600 }}"
            srcset="{{ lineup_media.preview_image | image_url: width: 720 }} 720w, {{ lineup_media.preview_image | image_url: width: 1100 }} 1100w, {{ lineup_media.preview_image | image_url: width: 1600 }} 1600w"
            sizes="(min-width: 900px) 55vw, 100vw"
            width="{{ lineup_media.preview_image.width }}"
            height="{{ lineup_media.preview_image.height }}"
            alt="{{ lineup_media.alt | default: 'Customer photo of the complete eight-plush lineup' | escape }}"
            loading="lazy">
        {%- endif -%}
      </div>
      <div class="evo-plush-story__copy">
        <h2 id="evo-plush-story-{{ section.id }}">Meet your eight.</h2>
        <p>Eight separate plushes. One of every pictured design.</p>
        <p class="evo-plush-dimensions"><strong>Approx. 8 × 7 × 6 inches each</strong><span>Small enough for a shelf, a bedside table, or a little company beside your screen.</span></p>
      </div>
    </div>
  </section>

  <section class="evo-plush-ugc" aria-labelledby="evo-plush-ugc-{{ section.id }}">
    <div class="evo-plush-shell">
      <div class="evo-plush-ugc__heading">
        <div>
          <h2 id="evo-plush-ugc-{{ section.id }}">At home with collectors.</h2>
        </div>
        <p>Take a closer look in these customer photos.</p>
      </div>
      <div class="evo-plush-ugc__grid" role="region" aria-label="Customer product photos" tabindex="0">
        {%- assign customer_photo_index = 0 -%}
        {%- for media in product.media -%}
          {%- if media.media_type == 'image' and media.alt contains 'Customer' -%}
            {%- assign customer_photo_index = customer_photo_index | plus: 1 -%}
            {%- if customer_photo_index > 1 -%}
            <figure>
              <button type="button" data-evo-plush-zoom="{{ media.preview_image | image_url: width: 1800 }}" aria-label="Enlarge {{ media.alt | default: 'customer photo' | escape }}">
              <img
                src="{{ media.preview_image | image_url: width: 900 }}"
                srcset="{{ media.preview_image | image_url: width: 420 }} 420w, {{ media.preview_image | image_url: width: 700 }} 700w, {{ media.preview_image | image_url: width: 900 }} 900w"
                sizes="(min-width: 900px) 33vw, 50vw"
                width="{{ media.preview_image.width }}"
                height="{{ media.preview_image.height }}"
                alt="{{ media.alt | default: 'Customer photo of an Evolution Companion plush' | escape }}"
                loading="lazy">
              </button>
            </figure>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="evo-plush-reviews" aria-labelledby="evo-plush-reviews-{{ section.id }}">
    <div class="evo-plush-shell">
      <h2 id="evo-plush-reviews-{{ section.id }}">A little collection. A lot to love.</h2>
      <p class="evo-plush-review-source">Feedback from buyers of the individual designs.</p>
      <div class="evo-plush-reviews__grid">
        <blockquote>
          <p>“Super adorable! … had to grab some more for friends.”</p>
          <cite>Customer review excerpt</cite>
        </blockquote>
        <blockquote>
          <p>“Amazing delivery product excellent condition”</p>
          <cite>Customer review</cite>
        </blockquote>
        <blockquote>
          <p>“Shipping took longer than anticipated but with the holidays it is not too surprising. For the price and quality, i am okay with the longer wait. Would purchase again.”</p>
          <cite>Customer review</cite>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="evo-plush-details" aria-labelledby="evo-plush-details-{{ section.id }}">
    <div class="evo-plush-shell evo-plush-details__grid">
      <div>
        <h2 id="evo-plush-details-{{ section.id }}">Before you make them yours.</h2>
      </div>
      <div class="evo-plush-accordions">
        <details>
          <summary>What arrives <span aria-hidden="true">+</span></summary>
          <div><p>Eight separate plushes, one of every pictured design. Display props and gift wrapping are not included.</p></div>
        </details>
        <details>
          <summary>How big are they? <span aria-hidden="true">+</span></summary>
          <div><p>Approximately 8 × 7 × 6 inches each.</p></div>
        </details>
        <details>
          <summary>How should I care for them? <span aria-hidden="true">+</span></summary>
          <div><p>Spot clean gently with a damp cloth and allow to air dry. Follow any care instructions included with your set.</p></div>
        </details>
        <details>
          <summary>Shipping <span aria-hidden="true">+</span></summary>
          <div><p>U.S. shipping is free. Arrives in 5–7 business days. Your set may arrive separately from other items in your order. Allow extra time around holidays.</p></div>
        </details>
        <details>
          <summary>Age guidance <span aria-hidden="true">+</span></summary>
          <div><p>Not suitable for children under 3 years old. Remove all packing materials before use and inspect seams periodically.</p></div>
        </details>
        <details>
          <summary>Returns <span aria-hidden="true">+</span></summary>
          <div><p>If the set is lost, arrives damaged or defective, contains the wrong item, or is materially different from its description, contact us with your order number and available photos. <a href="/pages/policy">Read the full policy.</a></p></div>
        </details>
      </div>
    </div>
  </section>

  <div class="evo-plush-sticky" data-evo-plush-sticky aria-hidden="true">
    <div class="evo-plush-sticky__inner">
      <div>
        <strong>{{ current_variant.price | money }}</strong>
        <span>Complete 8-Plush Set</span>
      </div>
      <button type="button" data-evo-plush-sticky-add {% unless current_variant_sellable %}disabled{% endunless %}>
        {%- if current_variant_sellable -%}Make All 8 Mine{%- else -%}Sold out{%- endif -%}
      </button>
    </div>
  </div>
  <dialog class="evo-plush-lightbox" data-evo-plush-lightbox aria-label="Enlarged customer photo">
    <div class="evo-plush-lightbox__inner">
      <div class="evo-plush-lightbox__toolbar"><span>Customer photo</span><button type="button" data-evo-plush-close aria-label="Close photo" autofocus>Close <span aria-hidden="true">×</span></button></div>
      <img alt="" data-evo-plush-enlarged>
    </div>
  </dialog>
</div>

<script src="{{ 'evolution-companions.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Evolution companions",
  "settings": []
}
{% endschema %}
