<div class="index-section zenkai-testimonials-section{% if section.settings.alt %} index-section--alt{% endif %}">

  <div
    class="page-width text-{{ section.settings.align_text }}"
    data-section-id="{{ section.id }}"
    data-section-type="testimonials">
    {% if section.settings.title != blank %}
      <header class="section-header zenkai-testimonials-header" data-aos>
        <p class="zenkai-testimonials-kicker">Worn, noticed, repeated</p>
        <h2 class="section-header__title appear-delay">
          {{ section.settings.title | escape }}
        </h2>
        <p class="zenkai-testimonials-subtitle">Designs that get noticed. Blanks that stay in rotation.</p>
      </header>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="testimonials-grid">
        {% for block in section.blocks %}
          <div class="testimonial-card" data-aos {{ block.shopify_attributes }}>
            <span class="testimonial-card__tag">
              {% case forloop.index %}
                {% when 1 %}
                  Wearable nostalgia
                {% when 2 %}
                  Gets asked about
                {% when 3 %}
                  Design details
                {% else %}
                  Fit + compliments
              {% endcase %}
            </span>
            <span class="testimonial-card__quote">
              <svg aria-hidden="true" focusable="false" viewBox="0 0 41 35" width="24" height="24">
                <path d="M10.208 17.711h6.124v16.332H0V21.684C0 8.184 5.444.956 16.332 0v6.125c-4.083 1.14-6.124 4.414-6.124 9.82v1.766zm24.498 0h6.124v16.332H24.498V21.684C24.498 8.184 29.942.956 40.83 0v6.125c-4.083 1.14-6.124 4.414-6.124 9.82v1.766z" fill="currentColor" fill-rule="evenodd"/>
              </svg>
            </span>
            {% if block.settings.testimonial != blank %}
              <div class="testimonial-card__text">{{ block.settings.testimonial }}</div>
            {% endif %}
            {% if block.settings.author != blank %}
              <cite class="testimonial-card__author">{{ block.settings.author | escape }}</cite>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>

</div>

<style>
.zenkai-testimonials-section {
  position: relative;
  overflow: hidden;
}

.zenkai-testimonials-section.index-section--alt {
  padding-top: clamp(2rem, 4.5vw, 3.4rem);
  padding-bottom: clamp(2.25rem, 5vw, 3.8rem);
}

.zenkai-testimonials-section::before {
  content: "";
  position: absolute;
  top: 0;
  left: 50%;
  width: min(760px, 86vw);
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(89, 183, 167, 0.45), transparent);
  transform: translateX(-50%);
}

.zenkai-testimonials-section .page-width {
  position: relative;
}

.zenkai-testimonials-header {
  max-width: 660px;
  margin: 0 auto;
}

.zenkai-testimonials-kicker {
  display: inline-flex;
  margin: 0 0 0.55rem;
  padding: 0.28rem 0.72rem;
  border: 1px solid rgba(89, 183, 167, 0.22);
  border-radius: 999px;
  background: rgba(89, 183, 167, 0.08);
  color: #2b8f7f;
  font-size: 0.76rem;
  font-weight: 800;
  letter-spacing: 0.025em;
  line-height: 1.15;
  text-transform: uppercase;
}

.zenkai-testimonials-section .section-header__title {
  margin-bottom: 0;
  color: #202225;
  font-size: clamp(2.15rem, 5.4vw, 4.45rem);
  line-height: 0.98;
  letter-spacing: 0;
}

.zenkai-testimonials-section .section-header__title::after {
  display: none;
  content: none;
}

.zenkai-testimonials-subtitle {
  max-width: 560px;
  margin: 0.85rem auto 0;
  color: #555872;
  font-size: 1rem;
  line-height: 1.45;
}

.testimonials-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-top: 28px;
}

.testimonial-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, #ffffff 0%, #fbfffd 100%);
  border: 1px solid rgba(89, 183, 167, 0.16);
  border-top: 4px solid #63d6bf;
  padding: 22px;
  border-radius: 10px;
  box-shadow: 0 14px 34px rgba(22, 49, 45, 0.07);
  display: flex;
  flex-direction: column;
  text-align: left;
}

.testimonial-card__tag {
  align-self: flex-start;
  margin-bottom: 16px;
  padding: 0.24rem 0.55rem;
  border-radius: 999px;
  background: #eaf7f3;
  color: #16312d;
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.02em;
  line-height: 1.15;
  text-transform: uppercase;
}

.testimonial-card__quote {
  margin-bottom: 12px;
  color: #59b7a7;
}

.testimonial-card__text {
  flex-grow: 1;
  font-size: 15px;
  line-height: 1.6;
  color: #202225;
  margin-bottom: 15px;
}

.testimonial-card__text p {
  margin: 0;
}

.testimonial-card__author {
  font-style: normal;
  font-weight: 800;
  color: #2b8f7f;
  font-size: 14px;
  letter-spacing: 0;
}

@media screen and (max-width: 990px) {
  .zenkai-testimonials-section.index-section--alt {
    padding-top: 2rem;
    padding-bottom: 2.35rem;
  }

  .zenkai-testimonials-header {
    max-width: 570px;
    margin-bottom: 0;
  }

  .zenkai-testimonials-section .section-header {
    margin-bottom: 0;
  }

  .zenkai-testimonials-section .section-header__title {
    font-size: clamp(2.35rem, 7.1vw, 3.55rem);
    line-height: 1;
  }

  .zenkai-testimonials-subtitle {
    margin-top: 0.72rem;
  }

  .testimonials-grid {
    grid-template-columns: repeat(2, 1fr);
    margin-top: 24px;
  }
}

@media screen and (max-width: 590px) {
  .zenkai-testimonials-section {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .zenkai-testimonials-section.index-section--alt {
    padding-top: 1.55rem;
    padding-bottom: 1.75rem;
  }

  .zenkai-testimonials-header {
    margin-bottom: 0;
  }

  .zenkai-testimonials-section .section-header {
    margin-bottom: 0;
  }

  .zenkai-testimonials-section .section-header__title {
    max-width: 320px;
    margin-right: auto;
    margin-left: auto;
    font-size: clamp(2.15rem, 10vw, 2.85rem);
    line-height: 1;
  }

  .zenkai-testimonials-kicker {
    margin-bottom: 0.45rem;
    font-size: 0.68rem;
  }

  .zenkai-testimonials-subtitle {
    margin-top: 0.65rem;
    font-size: 0.88rem;
    line-height: 1.42;
  }

  .testimonials-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-top: 20px;
  }

  .testimonial-card {
    padding: 12px;
    border-radius: 8px;
    border-top-width: 3px;
    box-shadow: 0 10px 24px rgba(22, 49, 45, 0.07);
  }

  .testimonial-card__tag {
    margin-bottom: 10px;
    padding: 0.2rem 0.45rem;
    font-size: 0.58rem;
    letter-spacing: 0.01em;
  }

  .testimonial-card__quote svg {
    width: 16px;
    height: 16px;
  }

  .testimonial-card__text {
    font-size: 0.88rem;
    line-height: 1.42;
    margin-bottom: 10px;
  }

  .testimonial-card__quote {
    margin-bottom: 8px;
  }

  .testimonial-card__author {
    font-size: 0.78rem;
  }
}
</style>

{% schema %}
  {
    "name": "Testimonials",
    "max_blocks": 10,
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "Testimonials"
      },
      {
        "type": "select",
        "id": "align_text",
        "label": "Text alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Centered"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "round_images",
        "label": "Circular images"
      },
      {
        "type": "checkbox",
        "id": "alt",
        "label": "Use alternate section color"
      }
    ],
    "blocks": [
      {
        "type": "testimonial",
        "name": "Testimonial",
        "settings": [
          {
            "type": "richtext",
            "id": "testimonial",
            "label": "Text",
            "default": "<p>Add customer reviews and testimonials to showcase your store’s happy customers.</p>"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Author's image"
          },
          {
            "type": "text",
            "id": "author",
            "label": "Author",
            "default": "Author's name"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Testimonials",
        "category": "Text",
        "blocks": [
          {
            "type": "testimonial"
          },
          {
            "type": "testimonial"
          }
        ]
      }
    ]
  }
{% endschema %}
