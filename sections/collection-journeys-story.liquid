{%- assign zk_target_handle = section.settings.target_collection_handle | default: 'journeys-collection' -%}
{%- if collection.handle == zk_target_handle -%}
  {%- comment -%}Fallbacks are overwritten by bundle-tiers; they keep static checks and previews stable.{%- endcomment -%}
  {%- assign bundle_tier_2_save = 5 -%}
  {%- assign bundle_tier_3_save = 10 -%}
  {%- assign bundle_tier_4_save = 20 -%}
  {%- include 'bundle-tiers', format: 'noop' -%}

  {%- assign zk_collection_url = collection.url -%}
  {%- if zk_collection_url == blank -%}
    {%- assign zk_collection_url = routes.collections_url | append: '/journeys-collection' -%}
  {%- endif -%}
  {%- assign zk_lead_handle = 'road-to-indigo' -%}
  {%- assign zk_lead_product = all_products[zk_lead_handle] -%}
  {%- assign zk_product_root = routes.root_url | append: 'products/' -%}
  {%- assign zk_lead_url_fallback = zk_product_root | append: zk_lead_handle -%}
  {%- assign zk_lead_url = zk_lead_product.url | default: zk_lead_url_fallback -%}
  {%- assign zk_lead_image = 'indigo_macro.jpg' | file_url -%}

  {%- assign zk_product_handles = 'road-to-indigo||second-journey||the-emerald-journey||platinum-summit' | split: '||' -%}
  {%- assign zk_product_titles = 'Road to Indigo||Second Journey Tee||The Emerald Journey Tee||Platinum Summit Tee' | split: '||' -%}
  {%- assign zk_product_notes = 'The badge-road tee that keeps showing up in carts.||A second stop with the same collected-over-time feel.||Forest-toned artwork on a blank made for repeat wear.||A colder final stop with a standout back print.' | split: '||' -%}
  {%- assign zk_product_ctas = 'Shop Road to Indigo||Shop Second Journey||Shop Emerald Journey||Shop Platinum Summit' | split: '||' -%}
  {%- assign zk_product_images = 'indigo_macro.jpg||secondJourney_macro.png||emerald_macro.png||platinum_macro.png' | split: '||' -%}

  <section
    class="zk-journeys"
    data-section-id="{{ section.id }}"
    data-section-type="collection-journeys-story"
    aria-labelledby="zk-journeys-title-{{ section.id }}">
    <div class="zk-journeys__lead-band">
      <div class="page-width">
        <div class="zk-journeys__lead">
          <div class="zk-journeys__lead-copy" data-aos>
            <span class="bundle-eyebrow bundle-eyebrow--light">
              <span class="bundle-eyebrow__dot"></span>
              <span class="bundle-eyebrow__text">Journeys Collection</span>
            </span>

            <h2 class="zk-journeys__title" id="zk-journeys-title-{{ section.id }}">
              Original reimaginings for every stop in your rotation.
            </h2>

            <p class="zk-journeys__intro">
              Road to Indigo has been the one people keep finding first. The full Journeys set turns that same energy into four wearable pieces: modern linework, soft blanks, clean front graphics, and bold back art made to get noticed in the wild.
            </p>

            <div class="zk-journeys__actions">
              <a class="btn zk-journeys__primary" href="{{ zk_collection_url }}">
                Shop the collection
              </a>
              <a class="zk-journeys__text-link" href="{{ zk_lead_url }}">
                Shop Road to Indigo
                <svg class="zk-journeys__link-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>

          <a class="zk-journeys__lead-media" href="{{ zk_lead_url }}" aria-label="Shop Road to Indigo" data-aos>
            <img
              src="{{ zk_lead_image }}"
              alt="Road to Indigo tee artwork"
              width="1200"
              height="1200"
              loading="eager">
            <span class="zk-journeys__lead-badge">Lead piece</span>
          </a>
        </div>
      </div>
    </div>

    <div class="zk-journeys__lineup-band">
      <div class="page-width">
        <div class="zk-journeys__lineup-head" data-aos>
          <div>
            <span class="zk-journeys__kicker">Build the set</span>
            <h3 class="zk-journeys__lineup-title">The bundle discount unlocks automatically.</h3>
          </div>
          <p class="zk-journeys__lineup-copy">
            Start with the one moving fastest, then add the next stop. Any 2 items saves ${{ bundle_tier_2_save }}, any 3 saves ${{ bundle_tier_3_save }}, and all 4 unlocks ${{ bundle_tier_4_save }} off at checkout.
          </p>
        </div>

        <div class="zk-journeys__products" role="list">
          {%- for zk_handle in zk_product_handles -%}
            {%- assign zk_product = all_products[zk_handle] -%}
            {%- assign zk_index = forloop.index0 -%}
            {%- assign zk_title = zk_product.title | default: zk_product_titles[zk_index] -%}
            {%- assign zk_note = zk_product_notes[zk_index] -%}
            {%- assign zk_cta = zk_product_ctas[zk_index] -%}
            {%- assign zk_image = zk_product_images[zk_index] | file_url -%}
            {%- assign zk_url_fallback = zk_product_root | append: zk_handle -%}
            {%- assign zk_url = zk_product.url | default: zk_url_fallback -%}

            <article class="zk-journeys__product{% if forloop.first %} zk-journeys__product--lead{% endif %}" role="listitem" data-aos>
              <a class="zk-journeys__product-media" href="{{ zk_url }}" aria-label="{{ zk_cta | escape }}">
                <img
                  src="{{ zk_image }}"
                  alt="{{ zk_title | escape }}"
                  width="640"
                  height="640"
                  loading="{% if forloop.index <= 2 %}eager{% else %}lazy{% endif %}">
                {%- if forloop.first -%}
                  <span class="zk-journeys__product-badge">Found first</span>
                {%- endif -%}
              </a>
              <div class="zk-journeys__product-body">
                <h4 class="zk-journeys__product-title">
                  <a href="{{ zk_url }}">{{ zk_title }}</a>
                </h4>
                <p class="zk-journeys__product-note">{{ zk_note }}</p>
                <div class="zk-journeys__product-foot">
                  {%- if zk_product != blank and zk_product.price != blank -%}
                    <span class="zk-journeys__price">
                      {%- if zk_product.price_varies -%}
                        From {{ zk_product.price_min | money_without_trailing_zeros }}
                      {%- else -%}
                        {{ zk_product.price | money_without_trailing_zeros }}
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                  <a class="zk-journeys__product-link" href="{{ zk_url }}">
                    {{ zk_cta }}
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          {%- endfor -%}
        </div>

        <div class="zk-journeys__bundle" role="note" data-aos>
          <div class="zk-journeys__bundle-copy">
            <span class="zk-journeys__kicker">Bundle savings</span>
            <p>Any 2 items saves ${{ bundle_tier_2_save }}. Any 3 saves ${{ bundle_tier_3_save }}. All 4 saves ${{ bundle_tier_4_save }}. No code needed.</p>
          </div>
          <ul class="zk-journeys__tiers" role="list" aria-label="Automatic bundle discount tiers">
            <li>
              <span>Any 2</span>
              <strong>Save ${{ bundle_tier_2_save }}</strong>
            </li>
            <li>
              <span>Any 3</span>
              <strong>Save ${{ bundle_tier_3_save }}</strong>
            </li>
            <li>
              <span>All 4</span>
              <strong>Save ${{ bundle_tier_4_save }}</strong>
            </li>
          </ul>
          <a class="btn btn--secondary zk-journeys__bundle-cta" href="{{ zk_collection_url }}">
            Build your bundle
          </a>
        </div>

        <div class="zk-journeys__craft" data-aos>
          <h3>The pieces you always wished existed.</h3>
          <p>Modern linework. Playful references. Prints that get noticed without feeling like a costume. Each tee is built on soft ringspun cotton with a clean front graphic and bold back art, then printed to order in the USA.</p>
          <p class="zk-journeys__trust">Free U.S. shipping. Ships in 1-2 business days. 30-day first-item guarantee.</p>
        </div>
      </div>
    </div>
  </section>

  {%- style -%}
    #shopify-section-{{ section.id }} {
      background: #f3f9f6;
    }

    #shopify-section-{{ section.id }} .zk-journeys {
      color: #202225;
      background: #f3f9f6;
    }

    #shopify-section-{{ section.id }} .zk-journeys__lead-band {
      background: #16312d;
      color: #ffffff;
      padding: 48px 0 42px;
    }

    #shopify-section-{{ section.id }} .zk-journeys__lead {
      display: grid;
      grid-template-columns: minmax(0, 0.92fr) minmax(320px, 0.78fr);
      gap: 44px;
      align-items: center;
    }

    #shopify-section-{{ section.id }} .zk-journeys__lead-copy {
      max-width: 660px;
    }

    #shopify-section-{{ section.id }} .zk-journeys__title {
      margin: 16px 0 14px;
      color: #ffffff;
      font-size: 42px;
      line-height: 1.08;
      font-weight: 700;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .zk-journeys__intro {
      margin: 0;
      max-width: 620px;
      color: #d9eee9;
      font-size: 16px;
      line-height: 1.7;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .zk-journeys__actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 14px 18px;
      margin-top: 26px;
    }

    #shopify-section-{{ section.id }} .zk-journeys__primary {
      background: #63d6bf;
      color: #102522;
      border-radius: 999px;
      padding: 14px 22px;
      min-width: 0;
    }

    #shopify-section-{{ section.id }} .zk-journeys__primary:hover,
    #shopify-section-{{ section.id }} .zk-journeys__primary:focus {
      background: #77e3ce;
      color: #102522;
    }

    #shopify-section-{{ section.id }} .zk-journeys__text-link,
    #shopify-section-{{ section.id }} .zk-journeys__product-link {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      color: inherit;
      font-size: 14px;
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: 0;
      text-decoration: none;
    }

    #shopify-section-{{ section.id }} .zk-journeys__text-link {
      color: #d9eee9;
    }

    #shopify-section-{{ section.id }} .zk-journeys__text-link:hover,
    #shopify-section-{{ section.id }} .zk-journeys__text-link:focus,
    #shopify-section-{{ section.id }} .zk-journeys__product-link:hover,
    #shopify-section-{{ section.id }} .zk-journeys__product-link:focus {
      color: #63d6bf;
      text-decoration: none;
    }

    #shopify-section-{{ section.id }} .zk-journeys__link-icon,
    #shopify-section-{{ section.id }} .zk-journeys__product-link svg {
      flex: 0 0 auto;
      transition: transform 180ms ease;
    }

    #shopify-section-{{ section.id }} .zk-journeys__text-link:hover .zk-journeys__link-icon,
    #shopify-section-{{ section.id }} .zk-journeys__text-link:focus .zk-journeys__link-icon,
    #shopify-section-{{ section.id }} .zk-journeys__product-link:hover svg,
    #shopify-section-{{ section.id }} .zk-journeys__product-link:focus svg {
      transform: translateX(3px);
    }

    #shopify-section-{{ section.id }} .zk-journeys__lead-media {
      position: relative;
      display: block;
      overflow: hidden;
      border-radius: 8px;
      background: #102522;
      text-decoration: none;
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.24);
    }

    #shopify-section-{{ section.id }} .zk-journeys__lead-media img,
    #shopify-section-{{ section.id }} .zk-journeys__product-media img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 500ms ease;
    }

    #shopify-section-{{ section.id }} .zk-journeys__lead-media img {
      aspect-ratio: 1 / 1;
    }

    #shopify-section-{{ section.id }} .zk-journeys__lead-media:hover img,
    #shopify-section-{{ section.id }} .zk-journeys__lead-media:focus img,
    #shopify-section-{{ section.id }} .zk-journeys__product-media:hover img,
    #shopify-section-{{ section.id }} .zk-journeys__product-media:focus img {
      transform: scale(1.025);
    }

    #shopify-section-{{ section.id }} .zk-journeys__lead-badge,
    #shopify-section-{{ section.id }} .zk-journeys__product-badge {
      position: absolute;
      left: 14px;
      top: 14px;
      display: inline-flex;
      align-items: center;
      min-height: 28px;
      padding: 7px 11px;
      border-radius: 999px;
      background: #63d6bf;
      color: #102522;
      font-size: 11px;
      line-height: 1;
      font-weight: 800;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .zk-journeys__lineup-band {
      padding: 42px 0 48px;
    }

    #shopify-section-{{ section.id }} .zk-journeys__lineup-head {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(320px, 0.75fr);
      gap: 28px;
      align-items: end;
      margin-bottom: 24px;
    }

    #shopify-section-{{ section.id }} .zk-journeys__kicker {
      display: block;
      margin: 0 0 8px;
      color: #2b8f7f;
      font-size: 12px;
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .zk-journeys__lineup-title {
      margin: 0;
      color: #202225;
      font-size: 28px;
      line-height: 1.18;
      font-weight: 700;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .zk-journeys__lineup-copy {
      margin: 0;
      color: #555a6e;
      font-size: 15px;
      line-height: 1.65;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .zk-journeys__products {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 18px;
      margin-bottom: 26px;
    }

    #shopify-section-{{ section.id }} .zk-journeys__product {
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      min-width: 0;
      border: 1px solid #d9eee9;
      border-radius: 8px;
      background: #fbfffd;
      color: #202225;
    }

    #shopify-section-{{ section.id }} .zk-journeys__product--lead {
      border-color: #63d6bf;
      box-shadow: inset 0 0 0 1px rgba(99, 214, 191, 0.35);
    }

    #shopify-section-{{ section.id }} .zk-journeys__product-media {
      position: relative;
      display: block;
      overflow: hidden;
      aspect-ratio: 1 / 1;
      background: #eaf7f3;
      text-decoration: none;
    }

    #shopify-section-{{ section.id }} .zk-journeys__product-body {
      display: flex;
      flex: 1 1 auto;
      flex-direction: column;
      padding: 16px;
    }

    #shopify-section-{{ section.id }} .zk-journeys__product-title {
      margin: 0 0 6px;
      color: #202225;
      font-size: 17px;
      line-height: 1.25;
      font-weight: 700;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .zk-journeys__product-title a {
      color: inherit;
      text-decoration: none;
    }

    #shopify-section-{{ section.id }} .zk-journeys__product-title a:hover,
    #shopify-section-{{ section.id }} .zk-journeys__product-title a:focus {
      color: #2b8f7f;
      text-decoration: none;
    }

    #shopify-section-{{ section.id }} .zk-journeys__product-note {
      margin: 0 0 14px;
      color: #6b6f85;
      font-size: 14px;
      line-height: 1.5;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .zk-journeys__product-foot {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-top: auto;
    }

    #shopify-section-{{ section.id }} .zk-journeys__price {
      color: #202225;
      font-size: 13px;
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .zk-journeys__product-link {
      color: #2b8f7f;
    }

    #shopify-section-{{ section.id }} .zk-journeys__bundle {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(380px, 1fr) auto;
      gap: 20px;
      align-items: center;
      border-top: 1px solid rgba(26, 27, 46, 0.1);
      border-bottom: 1px solid rgba(26, 27, 46, 0.1);
      background: #eaf7f3;
      padding: 22px 24px;
      margin: 0 0 28px;
    }

    #shopify-section-{{ section.id }} .zk-journeys__bundle-copy p {
      margin: 0;
      color: #202225;
      font-size: 15px;
      line-height: 1.55;
      font-weight: 600;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .zk-journeys__tiers {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    #shopify-section-{{ section.id }} .zk-journeys__tiers li {
      min-width: 0;
      padding: 12px 14px;
      border: 1px solid rgba(43, 143, 127, 0.2);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.65);
    }

    #shopify-section-{{ section.id }} .zk-journeys__tiers span,
    #shopify-section-{{ section.id }} .zk-journeys__tiers strong {
      display: block;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .zk-journeys__tiers span {
      margin-bottom: 4px;
      color: #555a6e;
      font-size: 12px;
      line-height: 1.15;
      font-weight: 700;
    }

    #shopify-section-{{ section.id }} .zk-journeys__tiers strong {
      color: #16312d;
      font-size: 18px;
      line-height: 1.1;
      font-weight: 800;
    }

    #shopify-section-{{ section.id }} .zk-journeys__bundle-cta {
      white-space: nowrap;
      border-radius: 999px;
      padding: 12px 18px;
    }

    #shopify-section-{{ section.id }} .zk-journeys__craft {
      max-width: 760px;
      margin: 0 auto;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .zk-journeys__craft h3 {
      margin: 0 0 10px;
      color: #202225;
      font-size: 24px;
      line-height: 1.25;
      font-weight: 700;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .zk-journeys__craft p {
      margin: 0 0 12px;
      color: #555a6e;
      font-size: 15px;
      line-height: 1.7;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .zk-journeys__craft .zk-journeys__trust {
      margin-bottom: 0;
      color: #16312d;
      font-size: 14px;
      font-weight: 800;
    }

    @media (max-width: 1024px) {
      #shopify-section-{{ section.id }} .zk-journeys__lead {
        grid-template-columns: minmax(0, 1fr) minmax(280px, 0.8fr);
        gap: 28px;
      }

      #shopify-section-{{ section.id }} .zk-journeys__title {
        font-size: 36px;
      }

      #shopify-section-{{ section.id }} .zk-journeys__products {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #shopify-section-{{ section.id }} .zk-journeys__bundle {
        grid-template-columns: 1fr;
      }

      #shopify-section-{{ section.id }} .zk-journeys__bundle-cta {
        justify-self: start;
      }
    }

    @media (max-width: 749px) {
      #shopify-section-{{ section.id }} .zk-journeys__lead-band {
        padding: 34px 0 28px;
      }

      #shopify-section-{{ section.id }} .zk-journeys__lead {
        grid-template-columns: 1fr;
        gap: 24px;
      }

      #shopify-section-{{ section.id }} .zk-journeys__title {
        font-size: 30px;
        line-height: 1.12;
      }

      #shopify-section-{{ section.id }} .zk-journeys__intro {
        font-size: 15px;
      }

      #shopify-section-{{ section.id }} .zk-journeys__actions {
        align-items: stretch;
        flex-direction: column;
      }

      #shopify-section-{{ section.id }} .zk-journeys__primary {
        width: 100%;
        text-align: center;
      }

      #shopify-section-{{ section.id }} .zk-journeys__lineup-band {
        padding: 32px 0 36px;
      }

      #shopify-section-{{ section.id }} .zk-journeys__lineup-head {
        grid-template-columns: 1fr;
        gap: 10px;
        margin-bottom: 18px;
      }

      #shopify-section-{{ section.id }} .zk-journeys__lineup-title {
        font-size: 23px;
      }

      #shopify-section-{{ section.id }} .zk-journeys__products {
        grid-template-columns: 1fr;
        gap: 14px;
      }

      #shopify-section-{{ section.id }} .zk-journeys__product {
        display: grid;
        grid-template-columns: 116px minmax(0, 1fr);
      }

      #shopify-section-{{ section.id }} .zk-journeys__product-media {
        min-height: 100%;
      }

      #shopify-section-{{ section.id }} .zk-journeys__product-body {
        padding: 14px;
      }

      #shopify-section-{{ section.id }} .zk-journeys__product-title {
        font-size: 16px;
      }

      #shopify-section-{{ section.id }} .zk-journeys__product-note {
        font-size: 13px;
        margin-bottom: 10px;
      }

      #shopify-section-{{ section.id }} .zk-journeys__bundle {
        padding: 18px 16px;
      }

      #shopify-section-{{ section.id }} .zk-journeys__tiers {
        grid-template-columns: 1fr;
      }

      #shopify-section-{{ section.id }} .zk-journeys__tiers li {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 12px;
      }

      #shopify-section-{{ section.id }} .zk-journeys__tiers span {
        margin-bottom: 0;
      }

      #shopify-section-{{ section.id }} .zk-journeys__tiers strong {
        font-size: 16px;
      }

      #shopify-section-{{ section.id }} .zk-journeys__bundle-cta {
        width: 100%;
        text-align: center;
      }

      #shopify-section-{{ section.id }} .zk-journeys__craft {
        text-align: left;
      }

      #shopify-section-{{ section.id }} .zk-journeys__craft h3 {
        font-size: 21px;
      }
    }

    @media (max-width: 380px) {
      #shopify-section-{{ section.id }} .zk-journeys__product {
        grid-template-columns: 98px minmax(0, 1fr);
      }

      #shopify-section-{{ section.id }} .zk-journeys__product-body {
        padding: 12px;
      }

      #shopify-section-{{ section.id }} .zk-journeys__product-note {
        display: none;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ section.id }} .zk-journeys__lead-media img,
      #shopify-section-{{ section.id }} .zk-journeys__product-media img,
      #shopify-section-{{ section.id }} .zk-journeys__link-icon,
      #shopify-section-{{ section.id }} .zk-journeys__product-link svg {
        transition: none;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{% schema %}
{
  "name": "Journeys collection story",
  "settings": [
    {
      "type": "paragraph",
      "content": "Renders only on the configured collection handle. Default is journeys-collection."
    },
    {
      "type": "text",
      "id": "target_collection_handle",
      "label": "Collection handle",
      "default": "journeys-collection"
    }
  ]
}
{% endschema %}
