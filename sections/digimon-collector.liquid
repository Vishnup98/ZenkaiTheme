<script src="{{ 'digimon-collector.js' | asset_url }}" defer></script>
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign collector_form = 'CrestForm-' | append: section.id
-%}
  {%- assign has_customer_evidence = false -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'testimonial' -%}
      {%- if block.settings.quote != blank or block.settings.image != blank or block.settings.image_asset != blank -%}{%- assign has_customer_evidence = true -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
<div class="dc" data-crest-page>
  <div class="dc-opening">
  <section class="dc-hero dc-wrap" aria-labelledby="CrestTitle-{{ section.id }}">
    <div class="dc-intro">
      <p class="dc-eyebrow">TAG &amp; CREST COLLECTOR SET</p>
      <h1 id="CrestTitle-{{ section.id }}">One tag.<br><em>Your crest.</em></h1>
      <p class="dc-lede"><strong>All 11 interchangeable crests.</strong> One gold-tone metal tag. Yours in a presentation box.</p>
    </div>
    <div class="dc-gallery">
      <div class="dc-main-image" data-crest-main>
        {% render 'digimon-collector-image', name: 'mix', loading: 'eager', alt: 'One tag. Your crest. Mix. Match. Make it yours. Colorful crest inserts arranged around the open gold-tone tag' %}
      </div>
    <div class="dc-gallery-details"><p class="dc-gallery-label" aria-live="polite" data-crest-gallery-label>Mix-and-match collection — select a photo</p>
      <div class="dc-thumbs" role="group" aria-label="Product images">
        {%- assign gallery_names = 'mix,box,single-courage,single-sincerity,single-knowledge,craft' | split: ',' -%}
        {%- assign gallery_labels = 'Mix-and-match collection,Complete boxed collection,Orange Courage crest,Green Sincerity crest,Purple Knowledge crest,Empty tag housing detail' | split: ',' -%}
        {% for image_name in gallery_names %}
          <button type="button" data-crest-thumb="{{ image_name }}" aria-label="Show {{ gallery_labels[forloop.index0] }}" aria-pressed="{% if image_name == 'mix' %}true{% else %}false{% endif %}">{% render 'digimon-collector-image', name: image_name, sizes: '100px', alt: gallery_labels[forloop.index0] %}</button>
        {% endfor %}
      </div>
    </div>
    </div>
    <div class="dc-buy" id="CrestBuy-{{ section.id }}">

      <div class="dc-price-line"><span data-crest-price>{{ current_variant.price | money_with_currency }}</span><span>Complete 11-crest set</span></div>


      {% if section.settings.bonus_title != blank %}<div class="dc-bonus"><strong>{{ section.settings.bonus_title | escape }}</strong>{% if section.settings.bonus_details != blank %}<p>{{ section.settings.bonus_details | escape }}</p>{% endif %}</div>{% endif %}
      {%- form 'product', product, id: collector_form, class: 'dc-form' -%}
        {% if product.variants.size > 1 %}
          <label for="CrestVariant-{{ section.id }}">Collection</label>
          <select id="CrestVariant-{{ section.id }}" name="id" data-crest-variant>{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price | money_with_currency | escape }}" data-available="{{ variant.available }}" {% if variant.id == current_variant.id %}selected{% endif %}>{{ variant.title | escape }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select>
        {% else %}<input type="hidden" name="id" value="{{ current_variant.id }}">{% endif %}
        <input type="hidden" name="quantity" value="1">
        <button class="dc-cta" type="submit" name="add" data-crest-add {% unless current_variant.available %}disabled{% endunless %}><span>{% if current_variant.available %}Add to cart{% else %}Currently unavailable{% endif %}</span><span aria-hidden="true">↗</span></button>
        {{ form.errors | default_errors }}
      {%- endform -%}
      <p class="dc-checkout-note">{{ section.settings.delivery_note | escape }}</p>
      <ul class="dc-inclusions"><li>11 interchangeable crest plates</li><li>1 gold-tone metal tag</li><li>1 black necklace cord</li><li>1 presentation box</li></ul>
      {% for block in section.blocks %}{% if block.type == 'testimonial' and block.settings.feature_in_hero and block.settings.quote != blank %}<a class="dc-hero-proof" href="#CrestReviews-{{ section.id }}"><span>“{{ block.settings.quote | escape }}”</span><small>Product review excerpt · See collector photos ↗</small></a>{% break %}{% endif %}{% endfor %}
      <div class="dc-policy-links">{% if shop.shipping_policy != blank %}<a href="{{ shop.shipping_policy.url }}">Shipping details</a>{% endif %}{% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">Returns policy</a>{% endif %}</div>

    </div>

  </section>
  </div>

  <section class="dc-dark" id="CrestGuide-{{ section.id }}"><div class="dc-wrap">
    <div class="dc-section-head"><div><p class="dc-eyebrow">EXPLORE THE COLLECTION</p><h2>Find <em>your crest.</em></h2></div><p>Eleven ways to make it personal. Tap a crest to see it in the tag.</p></div>
    <div class="dc-crest-explorer" data-selected="courage" data-crest-explorer>
      <figure class="dc-explorer-media" data-crest-explorer-image>{% render 'digimon-collector-image', name: 'single-courage', alt: 'Orange Courage crest in the gold-tone tag', sizes: '(min-width: 750px) 45vw, 90vw' %}</figure>
      <div class="dc-explorer-copy">
        <p class="dc-eyebrow">IN THE COLLECTION</p>
        <div aria-live="polite" aria-atomic="true"><h3 data-crest-explorer-name>Courage</h3><p data-crest-explorer-line>For taking the first step.</p></div>
        {%- assign crest_keys = 'courage,friendship,love,sincerity,knowledge,reliability,hope,light,kindness,miracles,destiny' | split: ',' -%}
        {%- assign crest_names = 'Courage,Friendship,Love,Sincerity,Knowledge,Reliability,Hope,Light,Kindness,Miracles,Destiny' | split: ',' -%}
        {%- assign crest_lines = 'For taking the first step.|For the people beside you.|For what matters most.|For staying true to yourself.|For always asking why.|For showing up.|For looking ahead.|For finding your way.|For the care you give.|For believing in possibility.|For the path you make.' | split: '|' -%}
        <div class="dc-explorer-options" role="group" aria-label="Explore all eleven included crests">
          {% for crest_key in crest_keys %}
            {%- assign crest_photo = 'single-' | append: crest_key -%}
            {%- assign crest_alt = crest_names[forloop.index0] | append: ' crest in the gold-tone tag' -%}
            <button type="button" aria-label="View {{ crest_names[forloop.index0] }}" data-crest-explore="{{ crest_key }}" data-crest-name="{{ crest_names[forloop.index0] }}" data-crest-line="{{ crest_lines[forloop.index0] }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{% render 'digimon-collector-image', name: crest_photo, sizes: '(max-width: 480px) 28vw, 110px', alt: crest_alt %}<span>{{ crest_names[forloop.index0] }}</span></button>
          {% endfor %}
        </div>
        <p class="dc-explorer-note">Start with the one that feels like you. Keep all eleven.</p>
        <a class="dc-text-link" href="#CrestBuy-{{ section.id }}">View the complete set <span aria-hidden="true">↗</span></a>
      </div>
    </div>

  </div></section>
  <section class="dc-feature dc-wrap" id="CrestDetails-{{ section.id }}"><figure>{% render 'digimon-collector-image', name: 'craft', alt: 'Gold-tone tag housing showing the channel for interchangeable crest inserts' %}</figure><div><p class="dc-eyebrow">MADE TO SWITCH.</p><h2>One tag.<br><em>Eleven ways to wear it.</em></h2><p>Choose a crest. Change it whenever you like. All eleven fit the same gold-tone tag.</p><ul class="dc-fitting-notes"><li>Fit and remove each insert using the included instructions.</li><li>Keep the other crests in their individual display slots.</li></ul></div></section>
  {% if section.settings.show_exploded_image %}<section class="dc-exploded dc-wrap"><figure>{% render 'digimon-collector-image', name: 'mix', alt: 'Illustrative exploded view with a partially inserted crest and alternate colored inserts' %}<figcaption>Illustrative arrangement of the interchangeable collection.</figcaption></figure></section>{% endif %}
  {% if has_customer_evidence %}
    <section class="dc-testimonials dc-wrap" id="CrestReviews-{{ section.id }}" aria-labelledby="CrestCustomers-{{ section.id }}">
      <div class="dc-section-head"><div><p class="dc-eyebrow">COLLECTOR PHOTOS</p><h2 id="CrestCustomers-{{ section.id }}">In collectors’ hands.</h2></div></div>
      <div class="dc-review-controls"><span>Customer photos &amp; review excerpts</span><div><button type="button" data-review-prev aria-label="Previous customer photo">←</button><button type="button" data-review-next aria-label="Next customer photo">→</button></div></div><div class="dc-testimonial-grid" tabindex="0" role="region" aria-label="Customer photos and reviews; scroll to see more">
        {% for block in section.blocks %}
          {% if block.type == 'testimonial' %}
            {% if block.settings.quote != blank or block.settings.image != blank or block.settings.image_asset != blank %}
              <figure class="dc-testimonial" {{ block.shopify_attributes }}>
                {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '320, 480, 720, 1000', sizes: '(min-width: 900px) 33vw, 90vw' }}{% elsif block.settings.image_asset != blank %}<img src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.image_alt | escape }}" width="{{ block.settings.image_width }}" height="{{ block.settings.image_height }}" loading="lazy">{% endif %}
                {% if block.settings.quote != blank %}<blockquote><p>{{ block.settings.quote | escape | newline_to_br }}</p></blockquote>{% endif %}
                {% if block.settings.attribution != blank or block.settings.source_url != blank %}<figcaption>{% if block.settings.attribution != blank %}<span>{{ block.settings.attribution | escape }}</span>{% endif %}{% if block.settings.source_url != blank %}<a href="{{ block.settings.source_url | escape }}">View original source</a>{% endif %}</figcaption>{% endif %}
              </figure>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    </section>
  {% endif %}
  <section class="dc-box" id="CrestContents-{{ section.id }}"><div class="dc-wrap dc-feature"><figure>{% render 'digimon-collector-image', name: 'box', alt: 'All eleven crest plates, gold-tone tag and necklace cord in the presentation box' %}</figure><div><p class="dc-eyebrow">INCLUDED IN YOUR SET</p><h2>All eleven.<br><em>Together.</em></h2><p>Every crest is included. Choose which one goes in the tag.</p><ul class="dc-contents-crests" aria-label="The eleven included crests">{% for crest_key in crest_keys %}<li data-crest-explore-color="{{ crest_key }}">{{ crest_names[forloop.index0] }}</li>{% endfor %}</ul><p class="dc-accessories"><span>Gold-tone metal tag</span><span>Black necklace cord</span><span>Presentation box</span></p></div></div></section>
  <section class="dc-faq dc-wrap"><div><h2>Good to know.</h2></div><div class="dc-questions"><details><summary>Does the set include every crest?</summary><p>Yes. Every set includes all eleven crest plates, one gold-tone metal tag, a black necklace cord and the presentation box shown. You do not need to choose a crest when ordering.</p></details><details><summary>Can I change the crest in the tag?</summary><p>Yes. The inserts are interchangeable. Follow the included instructions when fitting or removing a crest.</p></details><details><summary>How should I look after it?</summary><p>Keep the inserts in their slots when not in use. Use a soft, dry cloth and avoid abrasive cleaners, moisture, and contact with hard surfaces.</p></details>{% if section.settings.bonus_title != blank %}<details><summary>What bonus is included?</summary><p><strong>{{ section.settings.bonus_title | escape }}</strong>{% if section.settings.bonus_details != blank %}<br>{{ section.settings.bonus_details | escape }}{% endif %}</p></details>{% endif %}<details><summary>What about delivery and returns?</summary><p>{{ section.settings.delivery_note | escape }} {% if shop.shipping_policy != blank %}<a href="{{ shop.shipping_policy.url }}">Read our shipping policy.</a>{% endif %} {% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">Read our returns policy.</a>{% endif %}</p></details></div></section>
  <section class="dc-finale" id="CrestFinal-{{ section.id }}"><div class="dc-wrap dc-final-grid"><div><h2>All eleven.<br><em>One complete set.</em></h2><p class="dc-finale-copy">11 interchangeable crests. One gold-tone metal tag.<br>Black necklace cord and presentation box included.</p><p class="dc-finale-price"><span data-crest-price>{{ current_variant.price | money_with_currency }}</span> · Complete boxed set</p>{% if section.settings.bonus_title != blank %}<div class="dc-bonus"><strong>{{ section.settings.bonus_title | escape }}</strong>{% if section.settings.bonus_details != blank %}<p>{{ section.settings.bonus_details | escape }}</p>{% endif %}</div>{% endif %}<button class="dc-cta" type="submit" name="add" form="{{ collector_form }}" data-crest-add {% unless current_variant.available %}disabled{% endunless %}><span>{% if current_variant.available %}Add to cart{% else %}Currently unavailable{% endif %}</span><span aria-hidden="true">↗</span></button><p class="dc-checkout-note">{{ section.settings.delivery_note | escape }}</p></div></div></section>
  <div class="dc-sticky" data-crest-sticky hidden><div><strong>Complete set · All 11 crests</strong><span data-crest-price>{{ current_variant.price | money_with_currency }}</span></div><button type="submit" form="{{ collector_form }}" data-crest-add {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}Add to cart{% else %}Unavailable{% endif %}</button></div>
</div>
<script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{
  "name": "Digimon collector",
  "settings": [
    {
      "type": "text",
      "id": "delivery_note",
      "label": "Delivery note",
      "default": "Free U.S. shipping. Any applicable taxes are calculated at checkout."
    },
    {
      "type": "text",
      "id": "bonus_title",
      "label": "Confirmed bonus title",
      "info": "Leave blank to hide the bonus. Publish only a verified offer that will be fulfilled."
    },
    {
      "type": "textarea",
      "id": "bonus_details",
      "label": "Bonus contents and terms",
      "info": "Explain the exact item, quantity, eligibility and how the customer receives it."
    },
    {
      "type": "checkbox",
      "id": "show_exploded_image",
      "label": "Show exploded illustration after verifying the opening mechanism",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Customer evidence",
      "settings": [
        {"type":"checkbox","id":"feature_in_hero","label":"Feature this quote beneath the main purchase button","default":false},
        {
          "type": "image_picker",
          "id": "image",
          "label": "Actual customer photo"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Customer photo theme asset"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Customer photo description"
        },
        {
          "type": "number",
          "id": "image_width",
          "label": "Photo width",
          "default": 720
        },
        {
          "type": "number",
          "id": "image_height",
          "label": "Photo height",
          "default": 960
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Original customer quotation",
          "info": "Use authentic supplied words. Do not invent reviews, ratings or purchase verification."
        },
        {
          "type": "text",
          "id": "attribution",
          "label": "Accurate attribution",
          "info": "Identify the source accurately, including a supplier review origin when applicable."
        },
        {
          "type": "url",
          "id": "source_url",
          "label": "Original source URL"
        }
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}
