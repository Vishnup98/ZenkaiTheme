{{ 'digimon-collector.css' | asset_url | stylesheet_tag }}
<script src="{{ 'digimon-collector.js' | asset_url }}" defer></script>
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign collector_form = 'CrestForm-' | append: section.id
-%}
<div class="dc" data-crest-page>
  <nav class="dc-nav dc-wrap" aria-label="Collection navigation"><span>ZENKAI <i>/</i> THE COLLECTOR SERIES</span><a href="#CrestContents-{{ section.id }}">What’s included <span aria-hidden="true">↗</span></a></nav>
  <section class="dc-hero dc-wrap" aria-labelledby="CrestTitle-{{ section.id }}">
    <div class="dc-intro">
      <p class="dc-eyebrow">THE COMPLETE COLLECTOR SET</p>
      <h1 id="CrestTitle-{{ section.id }}">Digimon Tag &amp; <em>Crest Collector Set</em></h1>
      <p class="dc-lede">One tag. All eleven crests. A collection that takes you back.</p>
      <div class="dc-mobile-offer"><div><span data-crest-price>{{ current_variant.price | money_with_currency }}</span><small>Complete boxed set</small></div><a href="#CrestBuy-{{ section.id }}">View the set ↗</a></div>
    </div>
    <div class="dc-gallery">
      <div class="dc-main-image" data-crest-main>
        {% render 'digimon-collector-image', name: 'box', loading: 'eager', alt: 'The complete Digimon crest collection: eleven crest plates, gold-tone tag, cord and presentation box' %}
        <span class="dc-image-note">THE COMPLETE COLLECTION · 11 CRESTS</span>
      </div>
      <div class="dc-thumbs" role="group" aria-label="Product images">
        {%- assign gallery_names = 'box,courage,green,knowledge,craft' | split: ',' -%}
        {%- assign gallery_labels = 'Complete boxed collection,Orange Courage crest,Green Sincerity crest,Purple Knowledge crest,Empty tag housing detail' | split: ',' -%}
        {% for image_name in gallery_names %}
          <button type="button" data-crest-thumb="{{ image_name }}" aria-label="Show {{ gallery_labels[forloop.index0] }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{% render 'digimon-collector-image', name: image_name, sizes: '100px', alt: gallery_labels[forloop.index0] %}</button>
        {% endfor %}
      </div>
      <p class="dc-caption">All 11 crests pictured are included. Tap a thumbnail to see another view.</p>
    </div>
    <div class="dc-buy" id="CrestBuy-{{ section.id }}">
      <div class="dc-price-line"><span data-crest-price>{{ current_variant.price | money_with_currency }}</span><span>The complete boxed set</span></div>
      <p class="dc-choice-note"><strong>All 11 crests included.</strong> No color selection needed.</p>
      <ul class="dc-inclusions"><li>11 interchangeable crest plates</li><li>1 gold-tone metal tag</li><li>1 black necklace cord</li><li>1 presentation box with individual crest slots</li></ul>
      {% if section.settings.bonus_title != blank %}<div class="dc-bonus"><strong>{{ section.settings.bonus_title | escape }}</strong>{% if section.settings.bonus_details != blank %}<p>{{ section.settings.bonus_details | escape }}</p>{% endif %}</div>{% endif %}
      {%- form 'product', product, id: collector_form, class: 'dc-form' -%}
        {% if product.variants.size > 1 %}
          <label for="CrestVariant-{{ section.id }}">Collection</label>
          <select id="CrestVariant-{{ section.id }}" name="id" data-crest-variant>{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price | money_with_currency | escape }}" data-available="{{ variant.available }}" {% if variant.id == current_variant.id %}selected{% endif %}>{{ variant.title | escape }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select>
        {% else %}<input type="hidden" name="id" value="{{ current_variant.id }}">{% endif %}
        <input type="hidden" name="quantity" value="1">
        <button class="dc-cta" type="submit" name="add" data-crest-add {% unless current_variant.available %}disabled{% endunless %}><span>{% if current_variant.available %}Add the complete set to cart{% else %}Currently unavailable{% endif %}</span><span aria-hidden="true">↗</span></button>
        {{ form.errors | default_errors }}
      {%- endform -%}
      <p class="dc-checkout-note">{{ section.settings.delivery_note | escape }}</p>
      <div class="dc-policy-links">{% if shop.shipping_policy != blank %}<a href="{{ shop.shipping_policy.url }}">Shipping details</a>{% endif %}{% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">Returns policy</a>{% endif %}</div>
      <div class="dc-buy-foot"><p>Display the full collection. Change the crest in your tag whenever you choose.</p></div>
    </div>
  </section>
  <div class="dc-statbar"><div class="dc-wrap"><p><b>11</b><span>Iconic crests</span></p><p><b>1</b><span>Interchangeable tag</span></p><p><b>1</b><span>Presentation box</span></p></div></div>
  <section class="dc-feature dc-wrap" id="CrestDetails-{{ section.id }}"><figure>{% render 'digimon-collector-image', name: 'craft', alt: 'Gold-tone tag housing showing the channel for interchangeable crest inserts' %}</figure><div><p class="dc-eyebrow">ONE TAG. YOUR CREST.</p><h2>Eleven crests.<br><em>One interchangeable tag.</em></h2><p>Choose the crest you want in your tag, then keep the others together in the box. Every design is included, so you can change your choice without buying another set.</p><ol class="dc-steps"><li><span>01</span>Choose from eleven crest designs.</li><li><span>02</span>Fit your chosen crest using the included instructions.</li><li><span>03</span>Return the others to their individual display slots.</li></ol></div></section>
  {% if section.settings.show_exploded_image %}<section class="dc-exploded dc-wrap"><figure>{% render 'digimon-collector-image', name: 'mix', alt: 'Illustrative exploded view with a partially inserted crest and alternate colored inserts' %}<figcaption>Illustrative arrangement of the interchangeable collection.</figcaption></figure></section>{% endif %}
  <section class="dc-box" id="CrestContents-{{ section.id }}"><div class="dc-wrap dc-feature"><div><p class="dc-eyebrow">WHAT ARRIVES IN THE BOX</p><h2>The complete collection.<br><em>All in one box.</em></h2><p>The tag sits at the center, with a place for each crest. Keep the set together for display, or give the complete collection to someone who remembers every adventure.</p><dl><div><dt>11</dt><dd>Interchangeable crest plates</dd></div><div><dt>1</dt><dd>Gold-tone metal tag</dd></div><div><dt>1</dt><dd>Black necklace cord</dd></div><div><dt>1</dt><dd>Presentation box</dd></div></dl>{% if section.settings.bonus_title != blank %}<div class="dc-bonus"><strong>{{ section.settings.bonus_title | escape }}</strong>{% if section.settings.bonus_details != blank %}<p>{{ section.settings.bonus_details | escape }}</p>{% endif %}</div>{% endif %}</div><figure>{% render 'digimon-collector-image', name: 'box', alt: 'Open presentation box containing the complete eleven-crest collection and tag' %}</figure></div></section>
  {%- assign has_customer_evidence = false -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'testimonial' -%}
      {%- if block.settings.quote != blank or block.settings.image != blank -%}{%- assign has_customer_evidence = true -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {% if has_customer_evidence %}
    <section class="dc-testimonials dc-wrap" aria-labelledby="CrestCustomers-{{ section.id }}">
      <div class="dc-section-head"><div><p class="dc-eyebrow">FROM THE COLLECTOR COMMUNITY</p><h2 id="CrestCustomers-{{ section.id }}">In their<br><em>own words.</em></h2></div></div>
      <div class="dc-testimonial-grid">
        {% for block in section.blocks %}
          {% if block.type == 'testimonial' %}
            {% if block.settings.quote != blank or block.settings.image != blank %}
              <figure class="dc-testimonial" {{ block.shopify_attributes }}>
                {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '320, 480, 720, 1000', sizes: '(min-width: 900px) 33vw, 90vw' }}{% endif %}
                {% if block.settings.quote != blank %}<blockquote><p>{{ block.settings.quote | escape | newline_to_br }}</p></blockquote>{% endif %}
                {% if block.settings.attribution != blank or block.settings.source_url != blank %}<figcaption>{% if block.settings.attribution != blank %}<span>{{ block.settings.attribution | escape }}</span>{% endif %}{% if block.settings.source_url != blank %}<a href="{{ block.settings.source_url | escape }}">View original source</a>{% endif %}</figcaption>{% endif %}
              </figure>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    </section>
  {% endif %}
  <section class="dc-story dc-wrap">
    <div class="dc-story-copy"><p class="dc-eyebrow">A LITTLE NOSTALGIA. A LOT OF MEANING.</p><h2>You remember<br>what they<br><em>stood for.</em></h2><p>Courage when you needed it. Friendship that stayed with you. These were never just symbols.</p><p>Choose Courage for the first step, Friendship for the people beside you, or simply the color you keep coming back to. The whole collection is yours to make personal.</p><a class="dc-text-link" href="#CrestGuide-{{ section.id }}">Find your crest <span aria-hidden="true">↗</span></a></div>
    <figure>{% render 'digimon-collector-image', name: 'courage', alt: 'Orange Courage crest engraved in the gold-tone collectible tag' %}<figcaption>COURAGE / A FAMILIAR SPARK</figcaption></figure>
  </section>
  <section class="dc-dark" id="CrestGuide-{{ section.id }}"><div class="dc-wrap">
    <div class="dc-section-head"><div><p class="dc-eyebrow">EVERY CREST HAS A STORY</p><h2>Which one<br>feels like <em>you?</em></h2></div><p>All eleven designs below come with your set.<br>These are included crests, not purchase options.</p></div>
    <div class="dc-crest-cards"><figure>{% render 'digimon-collector-image', name: 'courage', alt: 'Courage crest in orange' %}<figcaption><span>01 / COURAGE</span><p>For the first step.</p></figcaption></figure><figure>{% render 'digimon-collector-image', name: 'green', alt: 'Sincerity crest in green' %}<figcaption><span>02 / SINCERITY</span><p>For staying true.</p></figcaption></figure><figure>{% render 'digimon-collector-image', name: 'knowledge', alt: 'Knowledge crest in purple' %}<figcaption><span>03 / KNOWLEDGE</span><p>For the curious.</p></figcaption></figure></div>
    <div class="dc-crest-names"><span>Courage</span><span>Friendship</span><span>Love</span><span>Sincerity</span><span>Knowledge</span><span>Reliability</span><span>Hope</span><span>Light</span><span>Kindness</span><span>Miracles</span><span>Destiny</span></div>
  </div></section>
  <section class="dc-faq dc-wrap"><div><p class="dc-eyebrow">THE FINER DETAILS</p><h2>Before it joins<br><em>your collection.</em></h2></div><div class="dc-questions"><details open><summary>Does the set include every crest?</summary><p>Yes. Every set includes all eleven crest plates, one gold-tone metal tag, a black necklace cord and the presentation box shown. You do not need to choose a crest when ordering.</p></details><details><summary>Can I change the crest in the tag?</summary><p>Yes. The inserts are interchangeable. Follow the included instructions when fitting or removing a crest.</p></details><details><summary>Are the colored photos different sets?</summary><p>No. They show individual crests from the same complete set. Every set includes all eleven designs.</p></details><details><summary>How should I look after it?</summary><p>Keep the inserts in their slots when not in use. Use a soft, dry cloth and avoid abrasive cleaners, moisture, and contact with hard surfaces.</p></details>{% if section.settings.bonus_title != blank %}<details><summary>What bonus is included?</summary><p><strong>{{ section.settings.bonus_title | escape }}</strong>{% if section.settings.bonus_details != blank %}<br>{{ section.settings.bonus_details | escape }}{% endif %}</p></details>{% endif %}<details><summary>What about delivery and returns?</summary><p>{{ section.settings.delivery_note | escape }} {% if shop.shipping_policy != blank %}<a href="{{ shop.shipping_policy.url }}">Read our shipping policy.</a>{% endif %} {% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">Read our returns policy.</a>{% endif %}</p></details></div></section>
  <section class="dc-finale"><div class="dc-wrap"><p class="dc-eyebrow">THE COMPLETE TAG &amp; CREST SET</p><h2>Bring all<br><em>eleven home.</em></h2><p class="dc-finale-copy">11 interchangeable crests. One gold-tone metal tag.<br>Black necklace cord and presentation box included.</p><p class="dc-finale-price"><span data-crest-price>{{ current_variant.price | money_with_currency }}</span> · Complete boxed set</p>{% if section.settings.bonus_title != blank %}<div class="dc-bonus"><strong>{{ section.settings.bonus_title | escape }}</strong>{% if section.settings.bonus_details != blank %}<p>{{ section.settings.bonus_details | escape }}</p>{% endif %}</div>{% endif %}<button class="dc-cta" type="submit" name="add" form="{{ collector_form }}" data-crest-add {% unless current_variant.available %}disabled{% endunless %}><span>{% if current_variant.available %}Add the complete set to cart{% else %}Currently unavailable{% endif %}</span><span aria-hidden="true">↗</span></button><p class="dc-checkout-note">{{ section.settings.delivery_note | escape }}</p></div></section>
  <div class="dc-sticky" data-crest-sticky hidden><div><strong>Complete set · All 11 crests</strong><span data-crest-price>{{ current_variant.price | money_with_currency }}</span></div><button type="submit" form="{{ collector_form }}" data-crest-add {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}Add to cart{% else %}Unavailable{% endif %}</button></div>
</div>
<script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{
  "name": "Digimon collector",
  "settings": [
    {
      "type": "text",
      "id": "delivery_note",
      "label": "Delivery note",
      "default": "Free U.S. shipping. Any applicable taxes are calculated at checkout."
    },
    {
      "type": "text",
      "id": "bonus_title",
      "label": "Confirmed bonus title",
      "info": "Leave blank to hide the bonus. Publish only a verified offer that will be fulfilled."
    },
    {
      "type": "textarea",
      "id": "bonus_details",
      "label": "Bonus contents and terms",
      "info": "Explain the exact item, quantity, eligibility and how the customer receives it."
    },
    {
      "type": "checkbox",
      "id": "show_exploded_image",
      "label": "Show exploded illustration after verifying the opening mechanism",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Customer evidence",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Actual customer photo"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Original customer quotation",
          "info": "Use authentic supplied words. Do not invent reviews, ratings or purchase verification."
        },
        {
          "type": "text",
          "id": "attribution",
          "label": "Accurate attribution",
          "info": "Identify the source accurately, including a supplier review origin when applicable."
        },
        {
          "type": "url",
          "id": "source_url",
          "label": "Original source URL"
        }
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}
