<script src="{{ 'digimon-collector.js' | asset_url }}" defer></script>
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign collector_form = 'CrestForm-' | append: section.id
-%}
  {%- assign has_customer_evidence = false -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'testimonial' -%}
      {%- if block.settings.quote != blank or block.settings.image != blank or block.settings.image_asset != blank -%}{%- assign has_customer_evidence = true -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
<div class="dc" data-crest-page>
  <div class="dc-opening">
  <section class="dc-hero dc-wrap" aria-labelledby="CrestTitle-{{ section.id }}">
    <div class="dc-intro">
      <p class="dc-eyebrow">TAG &amp; CREST COLLECTOR SET</p>
      <h1 id="CrestTitle-{{ section.id }}">One tag.<br><em>Your crest.</em></h1>
      <p class="dc-lede"><strong>Eleven familiar symbols. Every one is yours.</strong> A gold-tone metal tag, interchangeable crests, and a presentation box to keep them together.</p>
    </div>
    <div class="dc-gallery">
      <div class="dc-main-image" data-crest-main>
        {% render 'digimon-collector-image', name: 'box', loading: 'eager', alt: 'The complete crest collection: eleven crest plates, gold-tone tag, cord and presentation box' %}
        <span class="dc-display-seal"><b>11</b><span>CRESTS INCLUDED</span></span>
        <span class="dc-image-note">THE COMPLETE COLLECTION · 11 CRESTS</span>
      </div>
      <div class="dc-thumbs" role="group" aria-label="Product images">
        {%- assign gallery_names = 'box,courage,green,knowledge,craft' | split: ',' -%}
        {%- assign gallery_labels = 'Complete boxed collection,Orange Courage crest,Green Sincerity crest,Purple Knowledge crest,Empty tag housing detail' | split: ',' -%}
        {% for image_name in gallery_names %}
          <button type="button" data-crest-thumb="{{ image_name }}" aria-label="Show {{ gallery_labels[forloop.index0] }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{% render 'digimon-collector-image', name: image_name, sizes: '100px', alt: gallery_labels[forloop.index0] %}</button>
        {% endfor %}
      </div>
      <p class="dc-caption">One complete set. Every crest shown is yours.</p>
      {% if has_customer_evidence %}<p class="dc-caption"><a href="#CrestReviews-{{ section.id }}">See it in collectors’ hands ↗</a></p>{% endif %}
    </div>
    <div class="dc-buy" id="CrestBuy-{{ section.id }}">
      {% if has_customer_evidence %}{% for block in section.blocks %}{% if block.type == 'testimonial' and block.settings.quote != blank %}<a class="dc-hero-proof" href="#CrestReviews-{{ section.id }}"><span>“{{ block.settings.quote | escape }}”</span><small>From the collector community ↗</small></a>{% break %}{% endif %}{% endfor %}{% endif %}
      <div class="dc-price-line"><span data-crest-price>{{ current_variant.price | money_with_currency }}</span><span>The complete 11-crest collection</span></div>
      <p class="dc-choice-note"><strong>All eleven are yours.</strong> Choose your favorite when it arrives.</p>
      <ul class="dc-inclusions"><li>11 interchangeable crest plates</li><li>1 gold-tone metal tag</li><li>1 black necklace cord</li><li>1 presentation box</li></ul>
      {% if section.settings.bonus_title != blank %}<div class="dc-bonus"><strong>{{ section.settings.bonus_title | escape }}</strong>{% if section.settings.bonus_details != blank %}<p>{{ section.settings.bonus_details | escape }}</p>{% endif %}</div>{% endif %}
      {%- form 'product', product, id: collector_form, class: 'dc-form' -%}
        {% if product.variants.size > 1 %}
          <label for="CrestVariant-{{ section.id }}">Collection</label>
          <select id="CrestVariant-{{ section.id }}" name="id" data-crest-variant>{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price | money_with_currency | escape }}" data-available="{{ variant.available }}" {% if variant.id == current_variant.id %}selected{% endif %}>{{ variant.title | escape }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select>
        {% else %}<input type="hidden" name="id" value="{{ current_variant.id }}">{% endif %}
        <input type="hidden" name="quantity" value="1">
        <button class="dc-cta" type="submit" name="add" data-crest-add {% unless current_variant.available %}disabled{% endunless %}><span>{% if current_variant.available %}Add the complete set{% else %}Currently unavailable{% endif %}</span><span aria-hidden="true">↗</span></button>
        {{ form.errors | default_errors }}
      {%- endform -%}
      <p class="dc-checkout-note">{{ section.settings.delivery_note | escape }}</p>
      <div class="dc-policy-links">{% if shop.shipping_policy != blank %}<a href="{{ shop.shipping_policy.url }}">Shipping details</a>{% endif %}{% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">Returns policy</a>{% endif %}</div>

    </div>
  </section>
  </div>
  <div class="dc-statbar"><div class="dc-wrap"><p><b>11</b><span>Iconic crests</span></p><p><b>1</b><span>Interchangeable tag</span></p><p><b>1</b><span>Presentation box</span></p></div></div>
  <section class="dc-dark" id="CrestGuide-{{ section.id }}"><div class="dc-wrap">
    <div class="dc-section-head"><div><p class="dc-eyebrow">THE CREST ARCHIVE</p><h2>Choose what<br><em>stays with you.</em></h2></div><p>Explore every crest.<br>All eleven are included in your set.</p></div>
    <div class="dc-crest-explorer" data-crest-explorer>
      <figure class="dc-explorer-media" data-crest-explorer-image>{% render 'digimon-collector-image', name: 'single-courage', alt: 'Orange Courage crest in the gold-tone tag', sizes: '(min-width: 750px) 45vw, 90vw' %}</figure>
      <div class="dc-explorer-copy">
        <p class="dc-eyebrow">IN THE COLLECTION</p>
        <div aria-live="polite" aria-atomic="true"><h3 data-crest-explorer-name>Courage</h3><p data-crest-explorer-line>For taking the first step.</p></div>
        {%- assign crest_keys = 'courage,friendship,love,sincerity,knowledge,reliability,hope,light,kindness,miracles,destiny' | split: ',' -%}
        {%- assign crest_names = 'Courage,Friendship,Love,Sincerity,Knowledge,Reliability,Hope,Light,Kindness,Miracles,Destiny' | split: ',' -%}
        {%- assign crest_lines = 'For taking the first step.|For the people beside you.|For what matters most.|For staying true to yourself.|For always asking why.|For showing up.|For looking ahead.|For finding your way.|For the care you give.|For believing in possibility.|For the path you make.' | split: '|' -%}
        <div class="dc-explorer-options" role="group" aria-label="Explore all eleven included crests">
          {% for crest_key in crest_keys %}
            {%- assign crest_photo = 'single-' | append: crest_key -%}
            {%- assign crest_alt = crest_names[forloop.index0] | append: ' crest in the gold-tone tag' -%}
            <button type="button" aria-label="View {{ crest_names[forloop.index0] }}" data-crest-explore="{{ crest_key }}" data-crest-name="{{ crest_names[forloop.index0] }}" data-crest-line="{{ crest_lines[forloop.index0] }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{% render 'digimon-collector-image', name: crest_photo, sizes: '(max-width: 480px) 28vw, 110px', alt: crest_alt %}<span>{{ crest_names[forloop.index0] }}</span></button>
          {% endfor %}
        </div>
        <p class="dc-explorer-note">You don’t have to pick just one. All 11 are included.</p>
        <a class="dc-text-link" href="#CrestBuy-{{ section.id }}">View the complete set <span aria-hidden="true">↗</span></a>
      </div>
    </div>

  </div></section>
  <section class="dc-box" id="CrestContents-{{ section.id }}"><div class="dc-wrap dc-feature"><div><p class="dc-eyebrow">THE WHOLE COLLECTION, TOGETHER</p><h2>Eleven crests.<br><em>One place to keep them.</em></h2><p>Open the box and see the full collection at once. The tag has its place at the center. Every crest has its own slot.</p><dl><div><dt>11</dt><dd>Interchangeable crest plates</dd></div><div><dt>1</dt><dd>Gold-tone metal tag</dd></div><div><dt>1</dt><dd>Black necklace cord</dd></div><div><dt>1</dt><dd>Presentation box</dd></div></dl>{% if section.settings.bonus_title != blank %}<div class="dc-bonus"><strong>{{ section.settings.bonus_title | escape }}</strong>{% if section.settings.bonus_details != blank %}<p>{{ section.settings.bonus_details | escape }}</p>{% endif %}</div>{% endif %}</div><figure>{% render 'digimon-collector-image', name: 'box', alt: 'Open presentation box containing the complete eleven-crest collection and tag' %}</figure></div></section>
  <section class="dc-feature dc-wrap" id="CrestDetails-{{ section.id }}"><figure>{% render 'digimon-collector-image', name: 'craft', alt: 'Gold-tone tag housing showing the channel for interchangeable crest inserts' %}</figure><div><p class="dc-eyebrow">A DIFFERENT DAY. A DIFFERENT CREST.</p><h2>Your favorite<br><em>can change.</em></h2><p>Courage today. Knowledge tomorrow. Pick the crest that feels like you, fit it into the tag, and keep the rest in their display slots.</p><ol class="dc-steps"><li><span>01</span>Choose from eleven crest designs.</li><li><span>02</span>Fit your chosen crest using the included instructions.</li><li><span>03</span>Return the others to their individual display slots.</li></ol></div></section>
  {% if section.settings.show_exploded_image %}<section class="dc-exploded dc-wrap"><figure>{% render 'digimon-collector-image', name: 'mix', alt: 'Illustrative exploded view with a partially inserted crest and alternate colored inserts' %}<figcaption>Illustrative arrangement of the interchangeable collection.</figcaption></figure></section>{% endif %}
  {% if has_customer_evidence %}
    <section class="dc-testimonials dc-wrap" id="CrestReviews-{{ section.id }}" aria-labelledby="CrestCustomers-{{ section.id }}">
      <div class="dc-section-head"><div><p class="dc-eyebrow">OUT OF THE BOX. INTO THEIR COLLECTIONS.</p><h2 id="CrestCustomers-{{ section.id }}">A closer look.<br><em>From collectors.</em></h2></div></div>
      <div class="dc-testimonial-grid">
        {% for block in section.blocks %}
          {% if block.type == 'testimonial' %}
            {% if block.settings.quote != blank or block.settings.image != blank or block.settings.image_asset != blank %}
              <figure class="dc-testimonial" {{ block.shopify_attributes }}>
                {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '320, 480, 720, 1000', sizes: '(min-width: 900px) 33vw, 90vw' }}{% elsif block.settings.image_asset != blank %}<img src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.image_alt | escape }}" width="{{ block.settings.image_width }}" height="{{ block.settings.image_height }}" loading="lazy">{% endif %}
                {% if block.settings.quote != blank %}<blockquote><p>{{ block.settings.quote | escape | newline_to_br }}</p></blockquote>{% endif %}
                {% if block.settings.attribution != blank or block.settings.source_url != blank %}<figcaption>{% if block.settings.attribution != blank %}<span>{{ block.settings.attribution | escape }}</span>{% endif %}{% if block.settings.source_url != blank %}<a href="{{ block.settings.source_url | escape }}">View original source</a>{% endif %}</figcaption>{% endif %}
              </figure>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    </section>
  {% endif %}
  <section class="dc-faq dc-wrap"><div><p class="dc-eyebrow">A FEW DETAILS BEFORE IT’S YOURS</p><h2>Know<br><em>your set.</em></h2></div><div class="dc-questions"><details open><summary>Does the set include every crest?</summary><p>Yes. Every set includes all eleven crest plates, one gold-tone metal tag, a black necklace cord and the presentation box shown. You do not need to choose a crest when ordering.</p></details><details><summary>Can I change the crest in the tag?</summary><p>Yes. The inserts are interchangeable. Follow the included instructions when fitting or removing a crest.</p></details><details><summary>Are the colored photos different sets?</summary><p>No. They show individual crests from the same complete set. Every set includes all eleven designs.</p></details><details><summary>How should I look after it?</summary><p>Keep the inserts in their slots when not in use. Use a soft, dry cloth and avoid abrasive cleaners, moisture, and contact with hard surfaces.</p></details>{% if section.settings.bonus_title != blank %}<details><summary>What bonus is included?</summary><p><strong>{{ section.settings.bonus_title | escape }}</strong>{% if section.settings.bonus_details != blank %}<br>{{ section.settings.bonus_details | escape }}{% endif %}</p></details>{% endif %}<details><summary>What about delivery and returns?</summary><p>{{ section.settings.delivery_note | escape }} {% if shop.shipping_policy != blank %}<a href="{{ shop.shipping_policy.url }}">Read our shipping policy.</a>{% endif %} {% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">Read our returns policy.</a>{% endif %}</p></details></div></section>
  <section class="dc-finale" id="CrestFinal-{{ section.id }}"><div class="dc-wrap dc-final-grid"><figure>{% render 'digimon-collector-image', name: 'box', alt: 'The complete eleven-crest collection in its presentation box' %}</figure><div><p class="dc-eyebrow">ALL ELEVEN. ALL YOURS.</p><h2>One complete set.<br><em>Make it yours.</em></h2><p class="dc-finale-copy">11 interchangeable crests. One gold-tone metal tag.<br>Black necklace cord and presentation box included.</p><p class="dc-finale-price"><span data-crest-price>{{ current_variant.price | money_with_currency }}</span> · Complete boxed set</p>{% if section.settings.bonus_title != blank %}<div class="dc-bonus"><strong>{{ section.settings.bonus_title | escape }}</strong>{% if section.settings.bonus_details != blank %}<p>{{ section.settings.bonus_details | escape }}</p>{% endif %}</div>{% endif %}<button class="dc-cta" type="submit" name="add" form="{{ collector_form }}" data-crest-add {% unless current_variant.available %}disabled{% endunless %}><span>{% if current_variant.available %}Add the complete set{% else %}Currently unavailable{% endif %}</span><span aria-hidden="true">↗</span></button><p class="dc-checkout-note">{{ section.settings.delivery_note | escape }}</p></div></div></section>
  <div class="dc-sticky" data-crest-sticky hidden><div><strong>Complete set · All 11 crests</strong><span data-crest-price>{{ current_variant.price | money_with_currency }}</span></div><button type="submit" form="{{ collector_form }}" data-crest-add {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}Add to cart{% else %}Unavailable{% endif %}</button></div>
</div>
<script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{
  "name": "Digimon collector",
  "settings": [
    {
      "type": "text",
      "id": "delivery_note",
      "label": "Delivery note",
      "default": "Free U.S. shipping. Any applicable taxes are calculated at checkout."
    },
    {
      "type": "text",
      "id": "bonus_title",
      "label": "Confirmed bonus title",
      "info": "Leave blank to hide the bonus. Publish only a verified offer that will be fulfilled."
    },
    {
      "type": "textarea",
      "id": "bonus_details",
      "label": "Bonus contents and terms",
      "info": "Explain the exact item, quantity, eligibility and how the customer receives it."
    },
    {
      "type": "checkbox",
      "id": "show_exploded_image",
      "label": "Show exploded illustration after verifying the opening mechanism",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Customer evidence",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Actual customer photo"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Customer photo theme asset"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Customer photo description"
        },
        {
          "type": "number",
          "id": "image_width",
          "label": "Photo width",
          "default": 720
        },
        {
          "type": "number",
          "id": "image_height",
          "label": "Photo height",
          "default": 960
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Original customer quotation",
          "info": "Use authentic supplied words. Do not invent reviews, ratings or purchase verification."
        },
        {
          "type": "text",
          "id": "attribution",
          "label": "Accurate attribution",
          "info": "Identify the source accurately, including a supplier review origin when applicable."
        },
        {
          "type": "url",
          "id": "source_url",
          "label": "Original source URL"
        }
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}
