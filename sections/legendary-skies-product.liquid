{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'LegendarySkiesForm-' | append: section.id
  assign show_placeholders = section.settings.show_placeholders
  if request.design_mode
    assign show_placeholders = true
  endif
  assign hero_zoom_url = 'legendary-skies-trio-hero.webp' | asset_url
  if section.settings.hero_image != blank
    assign hero_zoom_url = section.settings.hero_image | image_url: width: 2200
  endif
-%}

<div
  class="ls-page"
  data-ls-page
  data-preview="{% if request.design_mode %}true{% else %}false{% endif %}"
>
  <section class="ls-hero ls-shell" aria-labelledby="ls-title-{{ section.id }}">
    <div class="ls-hero__media">
      <span class="ls-hero__orbit ls-hero__orbit--storm" aria-hidden="true"></span>
      <span class="ls-hero__orbit ls-hero__orbit--frost" aria-hidden="true"></span>
      <span class="ls-hero__orbit ls-hero__orbit--flame" aria-hidden="true"></span>
      <button
        class="ls-image-button"
        type="button"
        data-ls-zoom="{{ hero_zoom_url }}"
        aria-label="Enlarge the complete three-plush collection"
      >
        <picture>
          <source media="(max-width: 699px)" srcset="{% if section.settings.lineup_image != blank %}{{ section.settings.lineup_image | image_url: width: 960 }}{% else %}{{ 'legendary-skies-trio-lineup.webp' | asset_url }}{% endif %}">
        {% render 'legendary-skies-image',
          photo: section.settings.hero_image,
          fallback: 'legendary-skies-trio-hero.webp',
          width: 2048,
          height: 2048,
          loading: 'eager',
          sizes: '(max-width: 899px) 100vw, 54vw',
          alt: 'The complete three-plush Legendary Skies collector set'
        %}
        </picture>
      </button>
    </div>

    <div class="ls-hero__copy">
      <div class="ls-identity" aria-label="{{ section.settings.collection_name | escape }}">
        {% render 'legendary-skies-wing-mark', class: 'ls-identity__mark' %}
        <p><span>Legendary</span> <strong>Skies</strong></p>
        <small>The complete three-plush collection</small>
      </div>
      <h1 id="ls-title-{{ section.id }}">
        {{ section.settings.hero_title | escape }}
        <span>{{ section.settings.hero_title_accent | escape }}</span>
      </h1>
      <p class="ls-lede">{{ section.settings.hero_body | escape }}</p>

      <div class="ls-offer">
        {% render 'legendary-skies-price', variant: current_variant %}
        {%- form 'product', product, id: form_id, class: 'ls-product-form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="properties[_zk_landing_view]" value="legendary-skies">
          {% render 'legendary-skies-cta', main: true %}
          <p class="ls-offer__note">{{ section.settings.shipping_heading | escape }} · {{ section.settings.shipping_summary | escape }}</p>
        {%- endform -%}
      </div>
      <div class="ls-facts" role="list" aria-label="Collection details">
        <div role="listitem"><strong>All 3 included</strong><span>One of every design</span></div>
        <div role="listitem"><strong>Approx. 12 inches</strong><span>Each plush</span></div>
        <div role="listitem"><strong>Soft plush fabric</strong><span>Embroidered details</span></div>
      </div>
    </div>
  </section>

  <section class="ls-promise" aria-label="What is included">
    <div class="ls-shell">
      <p><i class="ls-seal ls-seal--yellow">01</i><strong>Storm</strong><span>High voltage</span></p>
      <p><i class="ls-seal ls-seal--blue">02</i><strong>Frost</strong><span>Cold front</span></p>
      <p><i class="ls-seal ls-seal--orange">03</i><strong>Flame</strong><span>Golden hour</span></p>
      <p class="ls-promise__complete">{% render 'legendary-skies-wing-mark', class: 'ls-promise__mark' %}<strong>Full forecast</strong><span>All three included</span></p>
    </div>
  </section>

  <section class="ls-included ls-shell" aria-labelledby="ls-included-{{ section.id }}" data-chapter="01 / THE FORECAST">
    <header class="ls-section-heading">
      <p class="ls-eyebrow">Every force is included {% render 'legendary-skies-wing-mark', class: 'ls-eyebrow__mark' %}</p>
      <h2 id="ls-included-{{ section.id }}">Pick your weather.</h2>
      <p>Three unmistakable silhouettes. Three completely different energies. Your set lands with every one.</p>
    </header>
    <div class="ls-portraits">
      <article>
        <button type="button" class="ls-image-button" data-ls-zoom="{{ 'legendary-skies-yellow-portrait.webp' | asset_url }}" aria-label="Enlarge the yellow plush">
          {% render 'legendary-skies-image', photo: section.settings.yellow_image, fallback: 'legendary-skies-yellow-portrait.webp', width: 2048, height: 2048, sizes: '(max-width: 699px) 82vw, 32vw', alt: 'Yellow spiky-winged plush included in the set' %}
        </button>
        <div>{% render 'legendary-skies-wing-mark', class: 'ls-card__feather', color: 'yellow' %}<small>Forecast 01</small><strong>Storm</strong><span>Electric yellow · black accents</span><em>High voltage</em></div>
      </article>
      <article>
        <button type="button" class="ls-image-button" data-ls-zoom="{{ 'legendary-skies-blue-portrait.webp' | asset_url }}" aria-label="Enlarge the blue plush">
          {% render 'legendary-skies-image', photo: section.settings.blue_image, fallback: 'legendary-skies-blue-portrait.webp', width: 2048, height: 2048, sizes: '(max-width: 699px) 82vw, 32vw', alt: 'Blue broad-winged plush included in the set' %}
        </button>
        <div>{% render 'legendary-skies-wing-mark', class: 'ls-card__feather', color: 'blue' %}<small>Forecast 02</small><strong>Frost</strong><span>Sky blue · soft white chest</span><em>Cold front</em></div>
      </article>
      <article>
        <button type="button" class="ls-image-button" data-ls-zoom="{{ 'legendary-skies-orange-portrait.webp' | asset_url }}" aria-label="Enlarge the orange plush">
          {% render 'legendary-skies-image', photo: section.settings.orange_image, fallback: 'legendary-skies-orange-portrait.webp', width: 2048, height: 2048, sizes: '(max-width: 699px) 82vw, 32vw', alt: 'Orange and yellow flame-winged plush included in the set' %}
        </button>
        <div>{% render 'legendary-skies-wing-mark', class: 'ls-card__feather', color: 'red' %}<small>Forecast 03</small><strong>Flame</strong><span>Golden yellow · red wing details</span><em>Golden hour</em></div>
      </article>
    </div>

  </section>

  <section class="ls-story">
    <div class="ls-shell ls-story__grid">
      <div class="ls-story__copy">
        <p class="ls-eyebrow">Grounded, for now {% render 'legendary-skies-wing-mark', class: 'ls-eyebrow__mark' %}</p>
        <h2>A front-row seat to the forecast.</h2>
        <p>Keep the trio together, or give each one its own corner. Bright colors and unmistakable wings bring a little character to your shelf.</p>
        <ul>
          <li>{% render 'legendary-skies-wing-mark', class: 'ls-list__feather', color: 'red' %}<span>Soft-touch plush fabric</span></li>
          <li>{% render 'legendary-skies-wing-mark', class: 'ls-list__feather', color: 'blue' %}<span>Embroidered and appliquéd details</span></li>
          <li>{% render 'legendary-skies-wing-mark', class: 'ls-list__feather', color: 'yellow' %}<span>One of every pictured design</span></li>
        </ul>
      </div>
      <figure data-note="SHELF CONDITIONS · EXCELLENT">
        {% render 'legendary-skies-image',
          photo: section.settings.lifestyle_image,
          fallback: 'legendary-skies-trio-lifestyle.webp',
          width: 2400,
          height: 1792,
          sizes: '(max-width: 899px) 100vw, 58vw',
          alt: 'The complete plush trio displayed together on a pale wood collector shelf'
        %}
      </figure>
    </div>
  </section>

  <section class="ls-elements" aria-labelledby="ls-elements-{{ section.id }}">
    <div class="ls-shell">
      <header>
        <div><p class="ls-eyebrow">The elemental field guide {% render 'legendary-skies-wing-mark', class: 'ls-eyebrow__mark' %}</p><h2 id="ls-elements-{{ section.id }}">Storm. Frost. Flame.</h2></div>
        <div class="ls-element-key" aria-label="The three elemental personalities"><span><i></i>Storm</span><span><i></i>Frost</span><span><i></i>Flame</span></div>
      </header>
      <figure>
        {% render 'legendary-skies-image',
          photo: section.settings.story_image,
          fallback: 'legendary-skies-trio-story.webp',
          width: 2752,
          height: 1536,
          sizes: '100vw',
          alt: 'The three plushes in golden, blue and warm orange studio light'
        %}
      </figure>
    </div>
  </section>

  <section class="ls-material ls-shell" aria-labelledby="ls-material-{{ section.id }}">
    <figure data-note="THREE MATERIAL STORIES · ONE FLOCK">
      {% render 'legendary-skies-image',
        photo: section.settings.detail_image,
        fallback: 'legendary-skies-trio-details.webp',
        width: 2528,
        height: 1696,
        sizes: '(max-width: 899px) 100vw, 62vw',
        alt: 'Close views of the plush fabric, embroidery, seams and wing details'
      %}
    </figure>
    <div>
      <p class="ls-eyebrow">Field notes · up close {% render 'legendary-skies-wing-mark', class: 'ls-eyebrow__mark' %}</p>
      <h2 id="ls-material-{{ section.id }}">Made soft.<br>Drawn sharp.</h2>
      <p>From angular wing edges to the soft white chest and layered flame appliqué, each design has its own construction and expression.</p>
      <div class="ls-material__facts">
        <p><strong>Soft feel</strong><span>Velvety plush surfaces</span></p>
        <p><strong>Characterful</strong><span>Distinct faces and silhouettes</span></p>
        <p><strong>Display ready</strong><span>Made to stand out together</span></p>
      </div>
    </div>
  </section>

  <section class="ls-size">
    <div class="ls-shell ls-size__grid">
      <div class="ls-size__copy">
        <p class="ls-eyebrow">Altitude, measured {% render 'legendary-skies-wing-mark', class: 'ls-eyebrow__mark' %}</p>
        <h2>Big enough to<br>own the room.</h2>
        <p>All three are sized as a matching set. They are compact enough for a desk or nightstand and large enough to anchor a collector display.</p>
        <div class="ls-size__measure" aria-label="Approximately 12 inches tall each">
          <span aria-hidden="true"></span><strong>≈ 12 IN</strong><span aria-hidden="true"></span>
        </div>
        <p class="ls-size__caption">Approx. 12 inches from shelf to crest</p>
        <small>Plush items are soft and measurements may vary slightly depending on how they are positioned.</small>
      </div>
      <figure>
        {% render 'legendary-skies-image',
          photo: section.settings.scale_image,
          fallback: 'legendary-skies-trio-scale.webp',
          width: 1856,
          height: 2304,
          sizes: '(max-width: 899px) 100vw, 52vw',
          alt: 'The three approximately 12-inch plushes beside a standard hardcover book and table lamp for scale'
        %}
      </figure>
    </div>
  </section>

  {%- assign customer_photos = section.blocks | where: 'type', 'customer_photo' -%}
  {%- assign has_customer_photos = false -%}
  {%- for block in customer_photos -%}
    {%- if block.settings.image != blank -%}{%- assign has_customer_photos = true -%}{%- endif -%}
  {%- endfor -%}
  {% if has_customer_photos or show_placeholders %}
    <section class="ls-community ls-shell" aria-labelledby="ls-community-{{ section.id }}">
      <header class="ls-section-heading">
        <p class="ls-eyebrow">At home with collectors {% render 'legendary-skies-wing-mark', class: 'ls-eyebrow__mark' %}</p>
        <h2 id="ls-community-{{ section.id }}">Seen in the wild.</h2>
        <p>Real customer photos of the trio after it lands.</p>
      </header>
      <div class="ls-community__rail">
        {% for block in customer_photos %}
          {% if block.settings.image != blank %}
            <figure {{ block.shopify_attributes }}>
              <button type="button" class="ls-image-button" data-ls-zoom="{{ block.settings.image | image_url: width: 2000 }}" aria-label="Enlarge {{ block.settings.caption | escape }}">
                {{ block.settings.image | image_url: width: 1000 | image_tag: widths: '420, 640, 800, 1000', sizes: '(max-width: 699px) 76vw, 31vw', loading: 'lazy', alt: block.settings.caption }}
              </button>
              {% if block.settings.caption != blank %}<figcaption>{{ block.settings.caption | escape }}</figcaption>{% endif %}
            </figure>
          {% elsif show_placeholders %}
            <div class="ls-placeholder" {{ block.shopify_attributes }}><strong>Customer photo</strong><span>Add a real buyer image here</span></div>
          {% endif %}
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {%- assign testimonials = section.blocks | where: 'type', 'testimonial' -%}
  {%- assign has_testimonials = false -%}
  {%- for block in testimonials -%}
    {%- if block.settings.quote != blank -%}{%- assign has_testimonials = true -%}{%- endif -%}
  {%- endfor -%}
  {% if has_testimonials or show_placeholders %}
    <section class="ls-reviews" aria-labelledby="ls-reviews-{{ section.id }}">
      <div class="ls-shell">
        <header><p class="ls-eyebrow">From real orders {% render 'legendary-skies-wing-mark', class: 'ls-eyebrow__mark' %}</p><h2 id="ls-reviews-{{ section.id }}">Collector notes.</h2></header>
        <div class="ls-reviews__grid">
          {% for block in testimonials %}
            {% if block.settings.quote != blank %}
              <figure {{ block.shopify_attributes }}><blockquote>“{{ block.settings.quote | escape }}”</blockquote>{% if block.settings.attribution != blank %}<figcaption>{{ block.settings.attribution | escape }}</figcaption>{% endif %}</figure>
            {% elsif show_placeholders %}
              <div class="ls-placeholder" {{ block.shopify_attributes }}><strong>Customer review</strong><span>Add a verified quote here</span></div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  <section class="ls-faq ls-shell" aria-labelledby="ls-faq-{{ section.id }}">
    <header><p class="ls-eyebrow">Arrival briefing</p><h2 id="ls-faq-{{ section.id }}">Before the flock lands.</h2>{% render 'legendary-skies-wing-mark', class: 'ls-faq__mark' %}</header>
    <div>
      <details><summary>Does this include all three plushes?</summary><p>Yes. You receive three separate plushes, one of every design pictured. Display props are not included.</p></details>
      <details><summary>Can I choose just one design?</summary><p>This offer is for the complete three-piece collection, so there is no design selection to make.</p></details>
      <details><summary>How large are they?</summary><p>Each plush is approximately 12 inches tall. Because the toys are soft, the exact measurement can vary slightly depending on how each one is positioned.</p></details>
      <details><summary>When will my set arrive?</summary><p>{{ section.settings.delivery_text | escape }}</p></details>
      <details><summary>How should I care for them?</summary><p>Gently spot clean and allow to air dry. Keep away from heat and open flames. Follow any care instructions supplied with your order.</p></details>
      <details><summary>What if something is wrong with my order?</summary><p>Contact us with your order number and any helpful photos. <a href="/pages/policy">Read the store’s delivery and returns policy.</a></p></details>
    </div>
  </section>

  <section class="ls-final">
    <span class="ls-final__constellation" aria-hidden="true"></span>
    <div class="ls-shell ls-final__grid">
      <figure>
        {% render 'legendary-skies-image', photo: section.settings.lineup_image, fallback: 'legendary-skies-trio-lineup.webp', width: 2528, height: 1696, sizes: '(max-width: 899px) 100vw, 52vw', alt: 'The complete three-piece Legendary Skies plush set' %}
      </figure>
      <div>
        <p class="ls-eyebrow">All three · all yours {% render 'legendary-skies-wing-mark', class: 'ls-eyebrow__mark' %}</p>
        <h2>{{ section.settings.final_title | escape }}</h2>
        <p>{{ section.settings.final_body | escape }}</p>
        {% render 'legendary-skies-price', variant: current_variant %}
        {% render 'legendary-skies-cta', form_id: form_id %}
        <small>{{ section.settings.shipping_heading | escape }} · {{ section.settings.shipping_summary | escape }}</small>
      </div>
    </div>
  </section>

    <aside class="ls-sticky" data-ls-sticky aria-label="Quick add complete trio" hidden>
      <div><strong>{{ current_variant.price | money }}</strong><span>all 3 plushes</span></div>
      {% render 'legendary-skies-cta', form_id: form_id, compact: true %}
    </aside>

  {% render 'legendary-skies-upsell' %}
  <p class="ls-cart-error" data-ls-cart-error role="alert" hidden></p>
  <dialog class="ls-lightbox" data-ls-lightbox aria-label="Enlarged product photograph">
    <button type="button" data-ls-close aria-label="Close enlarged image">×</button>
    <img src="{{ 'legendary-skies-trio-hero.webp' | asset_url }}" width="1600" height="1600" alt="" loading="lazy">
  </dialog>
</div>

{% schema %}
{
  "name": "Legendary Skies product",
  "settings": [
    { "type": "text", "id": "collection_name", "label": "Collection name", "default": "Legendary Skies" },
    { "type": "text", "id": "hero_title", "label": "Headline", "default": "Three icons." },
    { "type": "text", "id": "hero_title_accent", "label": "Headline accent", "default": "One legendary set." },
    { "type": "textarea", "id": "hero_body", "label": "Hero body", "default": "Storm, frost, and flame land together in one display-ready collection. Three separate plushes. One of every design pictured." },
    { "type": "checkbox", "id": "show_placeholders", "label": "Show empty customer proof slots", "default": false, "info": "Empty slots are automatically visible in the theme editor and hidden from shoppers." },
    { "type": "text", "id": "shipping_heading", "label": "Shipping heading", "default": "Free shipping" },
    { "type": "text", "id": "shipping_summary", "label": "Shipping summary", "default": "Arrives in 7–10 business days" },
    { "type": "textarea", "id": "delivery_text", "label": "Delivery details", "default": "Arrives in 7–10 business days. Shipping is free for this set. This collection may arrive separately from other items in your order." },
    { "type": "text", "id": "final_title", "label": "Final headline", "default": "Bring the whole trio home." },
    { "type": "textarea", "id": "final_body", "label": "Final body", "default": "Three separate plushes. Every pictured design. One complete collector set." },
    { "type": "header", "content": "Generated product imagery" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "image_picker", "id": "lineup_image", "label": "Complete lineup image" },
    { "type": "image_picker", "id": "yellow_image", "label": "Yellow plush portrait" },
    { "type": "image_picker", "id": "blue_image", "label": "Blue plush portrait" },
    { "type": "image_picker", "id": "orange_image", "label": "Orange plush portrait" },
    { "type": "image_picker", "id": "lifestyle_image", "label": "Lifestyle image" },
    { "type": "image_picker", "id": "story_image", "label": "Elemental story image" },
    { "type": "image_picker", "id": "detail_image", "label": "Construction detail image" },
    { "type": "image_picker", "id": "scale_image", "label": "Scale image" }
  ],
  "blocks": [
    {
      "type": "customer_photo",
      "name": "Customer photo",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Real customer photo" },
        { "type": "text", "id": "caption", "label": "Image description (alt text)" }
      ]
    },
    {
      "type": "testimonial",
      "name": "Customer testimonial",
      "limit": 6,
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Exact customer quote" },
        { "type": "text", "id": "attribution", "label": "Attribution" }
      ]
    }
  ],
  "presets": [{ "name": "Legendary Skies product" }]
}
{% endschema %}
