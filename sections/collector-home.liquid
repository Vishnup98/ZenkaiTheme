{%- liquid
  assign impostors = all_products['little-impostors-complete-9-plush-collector-set']
  assign companions = all_products['evolution-companions-complete-8-plush-collector-set']
  assign pins = all_products['evolution-pin-set']
  assign badges = all_products['8pcs-anime-gym-badge-enamel-pins-set-colorful-hard-enamel-lapel-brooches-trainer-badges-collectible-gift-box-for-backpack']
  assign impostors_url = section.settings.impostors_url | default: impostors.url | default: '/products/little-impostors-complete-9-plush-collector-set'
  assign companions_url = section.settings.companions_url | default: '/products/evolution-companions-complete-8-plush-collector-set?view=evo-all-eight'
  assign pins_url = section.settings.pins_url | default: pins.url | default: '/products/evolution-pin-set'
  assign badges_url = section.settings.badges_url | default: badges.url | default: '/products/8pcs-anime-gym-badge-enamel-pins-set-colorful-hard-enamel-lapel-brooches-trainer-badges-collectible-gift-box-for-backpack'
  assign hero_image = section.settings.hero_image
  assign apparel_url = section.settings.apparel_url | default: '#zenkai-apparel'
  assign product_image_sizes = '(min-width: 1360px) 302px, (min-width: 1101px) calc((100vw - 152px) / 4), (min-width: 750px) calc((100vw - 104px) / 2), calc((100vw - 56px) / 2)'
  assign hero_image_sizes = '(min-width: 1400px) 784px, (min-width: 750px) 56vw, 100vw'
-%}
{{ 'collector-home.css' | asset_url | stylesheet_tag }}

<div class="zch" data-collector-home>
  <div class="zch-hero-band"><section class="zch-hero" aria-labelledby="zch-title-{{ section.id }}">
    <div class="zch-hero__copy">
      <div class="zch-hero__intro">
        <p class="zch-eyebrow">THE PLUSH COLLECTIONS</p>
        <span class="zch-hero__face" aria-hidden="true"><svg viewBox="0 0 76 30" fill="none" focusable="false"><ellipse cx="15" cy="10" rx="3" ry="6" fill="currentColor"/><ellipse cx="61" cy="8" rx="3" ry="6" fill="currentColor"/><path d="m5 23 9 3 11-7 12 8 12-9 12 7 10-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      </div>
      <h1 id="zch-title-{{ section.id }}">Make room <br>for <span class="zch-hero__accent">mischief.<svg aria-hidden="true" focusable="false" viewBox="0 0 300 16" preserveAspectRatio="none"><path d="M5 10 C60 1 87 17 145 9 S232 5 295 10" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></svg></span></h1>
      <p class="zch-hero__lede">Two complete collections. Plenty of personality.</p>
      <div class="zch-actions"><a class="js-no-transition zch-button" href="#collector-plush">Shop plush sets <span aria-hidden="true">→</span></a></div>
    </div>
    <a class="js-no-transition zch-hero__visual" href="#collector-plush" aria-label="Explore both plush collections">
      {%- if hero_image != blank -%}
        <img src="{{ hero_image | image_url: width: 1200 }}" srcset="{{ hero_image | image_url: width: 550 }} 550w, {{ hero_image | image_url: width: 900 }} 900w, {{ hero_image | image_url: width: 1200 }} 1200w, {{ hero_image | image_url: width: 1600 }} 1600w" sizes="{{ hero_image_sizes }}" width="{{ hero_image.width }}" height="{{ hero_image.height }}" alt="{{ hero_image.alt | default: 'Explore our plush collections' | escape }}" loading="eager" fetchpriority="high">
      {%- else -%}
        <img src="{{ 'collector-home-sky-v2-1536.webp' | asset_url }}" srcset="{{ 'collector-home-sky-v2-640.webp' | asset_url }} 640w, {{ 'collector-home-sky-v2-960.webp' | asset_url }} 960w, {{ 'collector-home-sky-v2-1536.webp' | asset_url }} 1536w" sizes="{{ hero_image_sizes }}" width="1536" height="1024" alt="Colorful plush characters floating through an aqua sky with small enamel badge accents" loading="eager" fetchpriority="high">
      {%- endif -%}
    </a>
  </section></div>
  <section class="zch-trust" aria-label="Shipping and customer trust">
    <div class="zch-trust__inner zch-shell">
      <p class="zch-trust__shipping"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8h16v16H9m10-11h5l5 6v5h-4M3 13h9M1 17h9M3 21h3"/><circle cx="9" cy="24" r="3"/><circle cx="23" cy="24" r="3"/></svg><span><strong>Free US</strong><span>shipping</span></span></p>
      <p class="zch-trust__rating"><svg class="zch-rating-stars" viewBox="0 0 100 20" width="90" height="18" aria-hidden="true" focusable="false"><defs><linearGradient id="zch-stars-{{ section.id }}" x1="0" x2="100" y1="0" y2="0" gradientUnits="userSpaceOnUse"><stop offset="94.8%" stop-color="#8be2cf"/><stop offset="94.8%" stop-color="#46665b"/></linearGradient><clipPath id="zch-stars-clip-{{ section.id }}">{% for star in (0..4) %}<path d="m10 0 3 6.5 7 1-5 5 1.2 7.5L10 16.5 3.8 20 5 12.5 0 7.5l7-1Z" transform="translate({{ star | times: 20 | plus: 2 }} 2) scale(.8)"/>{% endfor %}</clipPath></defs><rect width="100" height="20" fill="url(#zch-stars-{{ section.id }})" clip-path="url(#zch-stars-clip-{{ section.id }})"/></svg><strong>4.8/5</strong><span>from 98 Shop reviews</span></p>
      <p class="zch-trust__orders"><strong>2,900+ orders</strong><span>shipped and counting</span></p>
    </div>
  </section>
  <nav class="zch-category-bar" aria-label="Shop by category">
    <a class="js-no-transition" href="#collector-plush">Plush sets</a>
    <a class="js-no-transition" href="#collector-pins">Pins & badges</a>
    <a class="js-no-transition" href="{{ apparel_url }}">Apparel</a>
  </nav>

  <div id="collector-sets" class="zch-shop zch-shell">
    <span id="collector-favorites" class="zch-anchor" aria-hidden="true"></span>
    <div class="zch-merch-groups">
    {%- for group in (1..2) -%}
      {%- liquid
        if group == 1
          assign group_id = 'collector-plush'
          assign group_title = 'Plush sets'
          assign group_start = 1
          assign group_end = 2
        else
          assign group_id = 'collector-pins'
          assign group_title = 'Pins & badges'
          assign group_start = 3
          assign group_end = 4
        endif
      -%}
    <section id="{{ group_id }}" class="zch-merch-group" aria-labelledby="{{ group_id }}-title-{{ section.id }}">
      <div class="zch-section-heading"><h2 id="{{ group_id }}-title-{{ section.id }}">{{ group_title }}</h2></div>
    <div class="zch-products zch-products--collectibles">
      {%- for index in (group_start..group_end) -%}
        {%- liquid
          case index
            when 1
              assign card_product = impostors
              assign card_url = impostors_url
              assign card_name = 'Little Impostors'
              assign card_category = '9-piece plush set'
              assign card_id = impostors.handle
            when 2
              assign card_product = companions
              assign card_url = companions_url
              assign card_name = 'Evolution Companions'
              assign card_category = '8-piece plush set'
              assign card_id = companions.handle
            when 3
              assign card_product = pins
              assign card_url = pins_url
              assign card_name = 'Evolution Pin Set'
              assign card_category = '8 enamel pins'
              assign card_id = pins.handle
            when 4
              assign card_product = badges
              assign card_url = badges_url
              assign card_name = 'Gym Badge Collection'
              assign card_category = '8 badges per box'
              assign card_id = badges.handle
          endcase
          assign card_image = card_product.featured_image
          if index == 1
            assign card_image = impostors.images[1] | default: impostors.featured_image
          endif
        -%}
        <article class="zch-card zch-card--{{ index }}">
          <a class="zch-card__link js-no-transition" href="{{ card_url }}" data-zch-product="{{ card_id }}" data-zch-placement="card">
            <div class="zch-card__media">
              {%- if card_image != blank -%}
                <img src="{{ card_image | image_url: width: 650 }}" srcset="{{ card_image | image_url: width: 280 }} 280w, {{ card_image | image_url: width: 420 }} 420w, {{ card_image | image_url: width: 650 }} 650w, {{ card_image | image_url: width: 900 }} 900w" sizes="{{ product_image_sizes }}" width="{{ card_image.width }}" height="{{ card_image.height }}" alt="{{ card_name | escape }} — {{ card_category | escape }}" loading="lazy" decoding="async">
              {%- else -%}<div class="zch-image-fallback">{{ card_name }}</div>{%- endif -%}
            </div>
            <div class="zch-card__body">
              <h3{% if index == 1 %} class="zch-card__title--impostors zch-card__title--marked"{% elsif index == 2 %} class="zch-card__title--companions zch-card__title--marked"{% endif %}>{% if index == 1 %}<span>{{ card_name }}</span><svg class="zch-title-mark zch-title-mark--smile" viewBox="0 0 76 30" fill="none" aria-hidden="true" focusable="false"><ellipse cx="15" cy="10" rx="3" ry="6" fill="currentColor"/><ellipse cx="61" cy="8" rx="3" ry="6" fill="currentColor"/><path d="m5 23 9 3 11-7 12 8 12-9 12 7 10-5" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>{% elsif index == 2 %}<span class="zch-evolution-letters" aria-label="EVOLUTION"><span aria-hidden="true"><span style="--evolution-letter: #986838">E</span><span style="--evolution-letter: #2582b6">V</span><span style="--evolution-letter: #a78216">O</span><span style="--evolution-letter: #c65b29">L</span><span style="--evolution-letter: #8860aa">U</span><span style="--evolution-letter: #34343d">T</span><span style="--evolution-letter: #558440">I</span><span style="--evolution-letter: #398d9e">O</span><span style="--evolution-letter: #bf5286">N</span></span></span><svg class="zch-title-mark zch-title-mark--eevee" viewBox="0 0 48 44" fill="none" aria-hidden="true" focusable="false"><path d="M17 24C9 20 4 10 4 3c8 3 14 9 16 19M31 24C39 20 44 10 44 3c-8 3-14 9-16 19" fill="#c29765" stroke="#765233" stroke-width="1.8" stroke-linejoin="round"/><path d="M15 18C11 14 9 10 8 7c5 3 8 7 10 12M33 18c4-4 6-8 7-11-5 3-8 7-10 12" fill="#49372e"/><ellipse cx="16" cy="29" rx="2.2" ry="3.3" fill="#49372e"/><ellipse cx="32" cy="29" rx="2.2" ry="3.3" fill="#49372e"/><path d="m21 34 3 2 3-2" fill="#49372e" stroke="#49372e" stroke-linejoin="round"/><path d="M24 36v2m0 0c-2 2-4 2-6 0m6 0c2 2 4 2 6 0" stroke="#765233" stroke-width="1.5" stroke-linecap="round"/></svg>{% else %}{{ card_name }}{% endif %}</h3>
              <p class="zch-card__category">{{ card_category }}</p>
              <div class="zch-card__details">
                {%- if index == 2 -%}
                  <span class="zch-card__signature zch-card__signature--companions" aria-hidden="true"><span style="--companion-color: #f5a7be"></span><span style="--companion-color: #bea0e7"></span><span style="--companion-color: #b0e5ef"></span><span style="--companion-color: #48a7d3"></span><span style="--companion-color: #fa742d"></span><span style="--companion-color: #f2d449"></span><span style="--companion-color: #d5b969"></span><span style="--companion-color: #303039"></span></span>
                {%- endif -%}
                <span class="zch-card__set-note">{% if index == 1 %}All 9 included{% elsif index == 2 or index == 3 %}All 8 included{% else %}Choose your region{% endif %}</span>
              </div>
              <div class="zch-card__bottom"><span class="zch-card__price">{%- if card_product != blank -%}{% if card_product.price_varies %}<small>From </small>{% endif %}{{ card_product.price | money }}{%- else -%}Explore the set{%- endif -%}</span>{%- if card_product != blank and card_product.available == false -%}<span class="zch-card__stock">Currently sold out</span>{%- endif -%}</div>
            </div>
          </a>
        </article>
      {%- endfor -%}
    </div>
    </section>
    {%- endfor -%}
    </div>
  </div>

  <section id="zenkai-apparel" class="zch-apparel" aria-labelledby="zch-apparel-title-{{ section.id }}">
    <div class="zch-shell">
      <div class="zch-section-heading zch-apparel-heading"><h2 id="zch-apparel-title-{{ section.id }}">In your rotation</h2><div class="zch-rail-controls" data-zch-rail-controls hidden><button type="button" data-zch-rail-step="-1" aria-label="Previous apparel" aria-controls="zch-apparel-rail-{{ section.id }}">‹</button><button type="button" data-zch-rail-step="1" aria-label="Next apparel" aria-controls="zch-apparel-rail-{{ section.id }}">›</button></div><p>Graphic tees and comfortable layers, with a story to tell.</p></div>
      <div class="zch-products zch-products--apparel" id="zch-apparel-rail-{{ section.id }}" data-zch-rail tabindex="0" role="region" aria-label="Browse apparel">
        {%- assign product_image_sizes = '(min-width: 1360px) 285px, (min-width: 1101px) 22vw, (min-width: 750px) 40vw, 78vw' -%}
        {%- assign apparel_handles = 'road-to-indigo|champions-00251|road-to-indigo-sweatshirt|058-059-the-royal-family-tee|054-sad-duck-tee' | split: '|' -%}
        {%- for apparel_handle in apparel_handles -%}
          {%- liquid
            assign apparel_product = all_products[apparel_handle]
            assign apparel_image = apparel_product.featured_image
            case forloop.index
              when 1
                assign apparel_name = 'Road to Indigo Tee'
              when 2
                assign apparel_name = 'Champions Tee'
              when 3
                assign apparel_name = 'Road to Indigo Sweatshirt'
              when 4
                assign apparel_name = 'The Royal Family Tee'
              when 5
                assign apparel_name = 'Sad Duck Tee'
            endcase
            assign apparel_category = 'Graphic tee'
            if forloop.index == 3
              assign apparel_category = 'Sweatshirt'

            endif
          -%}
          {%- if apparel_product != blank -%}
            <article class="zch-card zch-apparel-card">
              <a class="js-no-transition zch-card__link" href="{{ apparel_product.url }}" data-zch-product="{{ apparel_product.handle }}" data-zch-placement="apparel-card">
                <div class="zch-card__media">{%- if apparel_image != blank -%}<img src="{{ apparel_image | image_url: width: 650 }}" srcset="{{ apparel_image | image_url: width: 280 }} 280w, {{ apparel_image | image_url: width: 420 }} 420w, {{ apparel_image | image_url: width: 650 }} 650w, {{ apparel_image | image_url: width: 900 }} 900w" sizes="{{ product_image_sizes }}" width="{{ apparel_image.width }}" height="{{ apparel_image.height }}" alt="{{ apparel_name | escape }} from the Zenkai apparel collection" loading="lazy" decoding="async">{%- endif -%}</div>
                <div class="zch-card__body"><h3>{{ apparel_name }}</h3><p class="zch-card__category">{{ apparel_category }}</p><div class="zch-card__bottom"><span class="zch-card__price">{% if apparel_product.price_varies %}<small>From </small>{% endif %}{{ apparel_product.price | money }}</span>{% unless apparel_product.available %}<span class="zch-card__stock">Currently sold out</span>{% endunless %}</div></div>
              </a>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <p class="zch-shipping-note">Your next rotation ships free in the US.</p>
      <nav class="zch-apparel-categories" aria-label="Explore apparel categories"><a class="js-no-transition" href="/collections/tees">Tees</a><a class="js-no-transition" href="/collections/all-hoodies">Hoodies</a><a class="js-no-transition" href="/collections/sweatshirts">Sweatshirts</a><a class="js-no-transition" href="/collections/all-hats">Hats</a></nav>
    </div>
  </section>

  <section class="zch-customer zch-shell" aria-labelledby="zch-customer-title-{{ section.id }}">
    <div class="zch-section-heading"><div><h2 id="zch-customer-title-{{ section.id }}">At home with you.</h2><p>A closer look at a few favorites, photographed by customers.</p></div></div>
    <div class="zch-customer__photos" role="region" aria-label="Customer photos" tabindex="0">
      <a class="zch-customer__card js-no-transition" href="{{ impostors_url }}">
        <img src="{{ 'little-impostors-customer-leaf-eared-cream-732757905b60.webp' | file_url }}?width=480" srcset="{{ 'little-impostors-customer-leaf-eared-cream-732757905b60.webp' | file_url }}?width=360 360w, {{ 'little-impostors-customer-leaf-eared-cream-732757905b60.webp' | file_url }}?width=720 720w" sizes="(min-width: 750px) 300px, 72vw" width="720" height="960" alt="Customer holding a cream Little Impostors plush with leaf-shaped ears" loading="lazy" decoding="async">
        <span class="zch-customer__name">Little Impostors <span aria-hidden="true">↗</span></span><span class="zch-customer__caption">One of nine plush designs</span>
      </a>
      <a class="zch-customer__card js-no-transition" href="{{ companions_url }}">
        <img src="{{ 'evo-campaign-handheld-purple-720.webp' | asset_url }}" srcset="{{ 'evo-campaign-handheld-purple-360.webp' | asset_url }} 360w, {{ 'evo-campaign-handheld-purple-720.webp' | asset_url }} 720w" sizes="(min-width: 750px) 300px, 72vw" width="720" height="960" alt="Customer holding a purple costume plush from Evolution Companions" loading="lazy" decoding="async">
        <span class="zch-customer__name">Evolution Companions <span aria-hidden="true">↗</span></span><span class="zch-customer__caption">One of eight costume plushes</span>
      </a>
      <a class="zch-customer__card js-no-transition" href="{{ badges_url }}">
        <img src="{{ 'gym-badge-collector-open-box.jpg' | file_url }}?width=480" srcset="{{ 'gym-badge-collector-open-box.jpg' | file_url }}?width=360 360w, {{ 'gym-badge-collector-open-box.jpg' | file_url }}?width=720 720w" sizes="(min-width: 750px) 300px, 72vw" width="1124" height="1500" alt="Customer photo of an open regional box containing eight enamel gym badges" loading="lazy" decoding="async">
        <span class="zch-customer__name">Gym Badge Collection <span aria-hidden="true">↗</span></span><span class="zch-customer__caption">Eight badges in a regional box</span>
      </a>
    </div>
  </section>

  <section class="zch-faq zch-shell" aria-labelledby="zch-faq-title-{{ section.id }}">
    <div><h2 id="zch-faq-title-{{ section.id }}">A little help</h2><p>Questions before you choose?<br><a class="js-no-transition" href="mailto:{{ shop.email | escape }}">Get in touch</a></p></div>
    <div class="zch-faq__items">
      <details><summary>Are the plush collections complete sets?<span aria-hidden="true">+</span></summary><div><p>Yes. Little Impostors includes all nine plush companions, and Evolution Companions includes all eight costume plushies. Each product page shows the complete lineup and product details.</p></div></details>
      <details><summary>What’s included with the pins and badges?<span aria-hidden="true">+</span></summary><div><p>The Evolution Pin Set includes all eight pins. Gym Badge boxes include eight badges each; choose an individual regional box or the complete collection on the product page.</p></div></details>
      <details><summary>How do I choose my apparel size?<span aria-hidden="true">+</span></summary><div><p>Fit varies by style. On each product page, compare the size-chart measurements with a tee, sweatshirt, or hoodie you already like.</p></div></details>
      <details><summary>Where can I check shipping and returns?<span aria-hidden="true">+</span></summary><div><p>Shipping is free on US orders. For international orders, available shipping options and rates are shown at checkout. Check the product page for delivery information specific to your item, or read our <a class="js-no-transition" href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}">shipping policy</a> for more details. We do not accept change-of-mind refunds, returns, or exchanges. If your item arrives damaged, defective, or incorrect, <a class="js-no-transition" href="mailto:{{ shop.email | escape }}">contact our team</a> with your order number and photos so we can review the issue and arrange an appropriate resolution. Read our <a class="js-no-transition" href="/policies/refund-policy">returns and order support policy</a>.</p></div></details>
    </div>
  </section>

</div>

{% schema %}
{
  "name": "Zenkai homepage",
  "settings": [
    {"type": "paragraph", "content": "Apparel and collectibles, together. Images, prices, and availability come from live products. Optional destination links can point to a specific landing-page view."},
    {"type": "image_picker", "id": "hero_image", "label": "Campaign image", "info": "Use a landscape campaign photograph. Defaults to the plush sky campaign artwork."},
    {"type": "url", "id": "impostors_url", "label": "Little Impostors destination"},
    {"type": "url", "id": "companions_url", "label": "Evolution Companions destination"},
    {"type": "url", "id": "pins_url", "label": "Evolution Pin Set destination"},
    {"type": "url", "id": "badges_url", "label": "Gym Badge Collection destination"},
    {"type": "url", "id": "apparel_url", "label": "Apparel destination"}
  ],
  "presets": [{"name": "Zenkai homepage", "category": "Zenkai"}]
}
{% endschema %}
