{%- liquid
  assign impostors = all_products['little-impostors-complete-9-plush-collector-set']
  assign companions = all_products['evolution-companions-complete-8-plush-collector-set']
  assign pins = all_products['evolution-pin-set']
  assign badges = all_products['8pcs-anime-gym-badge-enamel-pins-set-colorful-hard-enamel-lapel-brooches-trainer-badges-collectible-gift-box-for-backpack']
  assign impostors_url = section.settings.impostors_url | default: impostors.url | default: '/products/little-impostors-complete-9-plush-collector-set'
  assign companions_url = section.settings.companions_url | default: '/products/evolution-companions-complete-8-plush-collector-set?view=evo-all-eight'
  assign pins_url = section.settings.pins_url | default: pins.url | default: '/products/evolution-pin-set'
  assign badges_url = section.settings.badges_url | default: badges.url | default: '/products/8pcs-anime-gym-badge-enamel-pins-set-colorful-hard-enamel-lapel-brooches-trainer-badges-collectible-gift-box-for-backpack'
  assign hero_image = section.settings.hero_image | default: impostors.featured_image
  assign apparel_hero_product = all_products['road-to-indigo']
  assign apparel_hero_image = section.settings.apparel_hero_image | default: apparel_hero_product.featured_image
  assign apparel_url = section.settings.apparel_url | default: '/collections/tees'
-%}
{{ 'collector-home.css' | asset_url | stylesheet_tag }}

<div class="zch" data-collector-home>
  <section class="zch-hero zch-shell" aria-labelledby="zch-title-{{ section.id }}">
    <div class="zch-hero__copy">
      <p class="zch-eyebrow">Everyday wear. Personal collections.</p>
      <h1 id="zch-title-{{ section.id }}">For what you wear.<br>And what you love.</h1>
      <p class="zch-hero__lede">Playful apparel, plush companions, and collectible details. Nostalgia and self-expression, made part of your everyday.</p>
      <div class="zch-actions"><a class="js-no-transition zch-button" href="#collector-favorites">Explore collectibles <span aria-hidden="true">↗</span></a><a class="js-no-transition zch-button zch-button--outline" href="#zenkai-apparel">Shop apparel <span aria-hidden="true">↗</span></a></div>
    </div>
    <div class="zch-hero__panels">
    <a class="js-no-transition zch-hero__visual zch-hero__visual--apparel" href="{{ apparel_url }}" aria-label="Explore graphic tees">
      {%- if apparel_hero_image != blank -%}<img src="{{ apparel_hero_image | image_url: width: 750 }}" srcset="{{ apparel_hero_image | image_url: width: 360 }} 360w, {{ apparel_hero_image | image_url: width: 550 }} 550w, {{ apparel_hero_image | image_url: width: 750 }} 750w" sizes="(min-width: 1200px) 320px, (min-width: 750px) 27vw, calc((100vw - 44px) / 2)" width="{{ apparel_hero_image.width }}" height="{{ apparel_hero_image.height }}" alt="Graphic tee from the Zenkai apparel collection" loading="eager" fetchpriority="high">{%- endif -%}
      <span class="zch-hero__caption"><span>Wear it your way <small>Graphic apparel</small></span><span aria-hidden="true">↗</span></span>
    </a>
    <a class="js-no-transition zch-hero__visual" href="{{ impostors_url }}" data-zch-product="{{ impostors.handle }}" data-zch-placement="hero-image" aria-label="Explore Little Impostors, the complete nine-plush set">
      {%- if hero_image != blank -%}
        <img src="{{ hero_image | image_url: width: 750 }}" srcset="{{ hero_image | image_url: width: 360 }} 360w, {{ hero_image | image_url: width: 550 }} 550w, {{ hero_image | image_url: width: 750 }} 750w" sizes="(min-width: 1200px) 320px, (min-width: 750px) 27vw, calc((100vw - 44px) / 2)" width="{{ hero_image.width }}" height="{{ hero_image.height }}" alt="The colorful Little Impostors plush collection, together as a complete set" loading="eager">
      {%- else -%}
        <div class="zch-image-fallback">Explore plush collections</div>
      {%- endif -%}
      <span class="zch-hero__caption"><span>Keep your favorites close <small>Plush & collectibles</small></span><span aria-hidden="true">↗</span></span>
    </a>
    </div>
  </section>

  <nav class="zch-discover" aria-label="Shop by category">
    <div class="zch-shell zch-discover__inner"><span>Find your next favorite</span><a class="js-no-transition" href="#collector-plush">Plush <span aria-hidden="true">↗</span></a><a class="js-no-transition" href="#collector-pins">Pins & badges <span aria-hidden="true">↗</span></a><a class="js-no-transition" href="/collections/tees">Tees <span aria-hidden="true">↗</span></a><a class="js-no-transition" href="/collections/all-hoodies">Hoodies <span aria-hidden="true">↗</span></a><a class="js-no-transition" href="/collections/sweatshirts">Sweatshirts <span aria-hidden="true">↗</span></a><a class="js-no-transition" href="/collections/all-hats">Hats <span aria-hidden="true">↗</span></a></div>
  </nav>

  <section id="collector-sets" class="zch-shop zch-shell" aria-labelledby="zch-shop-title-{{ section.id }}">
    <span id="collector-favorites" class="zch-anchor" aria-hidden="true"></span>
    <div class="zch-section-heading"><div><p class="zch-eyebrow">Discover the collections</p><h2 id="zch-shop-title-{{ section.id }}">Meet your collector favorites.</h2></div><p>Complete plush lineups, colorful pins, <br>and boxed badge sets.</p></div>
    <div class="zch-products">
      {%- for index in (1..4) -%}
        {%- liquid
          case index
            when 1
              assign card_product = impostors
              assign card_url = impostors_url
              assign card_name = 'Little Impostors'
              assign card_category = '9-piece plush collection'
              assign card_description = 'Nine distinct plush companions, together in one complete collection.'
              assign card_count = 'All 9 included'
              assign card_id = impostors.handle
            when 2
              assign card_product = companions
              assign card_url = companions_url
              assign card_name = 'Evolution Companions'
              assign card_category = '8-piece plush collection'
              assign card_description = 'Eight colorful costume plushies. The full lineup for your shelf or desk.'
              assign card_count = 'All 8 included'
              assign card_id = companions.handle
            when 3
              assign card_product = pins
              assign card_url = pins_url
              assign card_name = 'Evolution Pin Set'
              assign card_category = '8-piece enamel pin collection'
              assign card_description = 'A little color for your bag, jacket, or favorite display board.'
              assign card_count = 'All 8 included'
              assign card_id = pins.handle
            when 4
              assign card_product = badges
              assign card_url = badges_url
              assign card_name = 'Gym Badge Collection'
              assign card_category = 'Boxed enamel badge sets'
              assign card_description = 'Choose an eight-badge box, or bring the whole collection home.'
              assign card_count = '8 per box'
              assign card_id = badges.handle
          endcase
          assign card_image = card_product.featured_image
        -%}
        <article class="zch-card zch-card--{{ index }}"{% if index == 1 %} id="collector-plush"{% elsif index == 3 %} id="collector-pins"{% endif %}>
          <a class="zch-card__link js-no-transition" href="{{ card_url }}" data-zch-product="{{ card_id }}" data-zch-placement="card">
            <div class="zch-card__media">
              <span class="zch-card__tag">{{ card_count }}</span>
              {%- if card_image != blank -%}
                <img src="{{ card_image | image_url: width: 650 }}" srcset="{{ card_image | image_url: width: 280 }} 280w, {{ card_image | image_url: width: 420 }} 420w, {{ card_image | image_url: width: 650 }} 650w, {{ card_image | image_url: width: 900 }} 900w" sizes="(min-width: 1280px) 292px, (min-width: 990px) 23vw, calc((100vw - 44px) / 2)" width="{{ card_image.width }}" height="{{ card_image.height }}" alt="{{ card_name | escape }} — {{ card_category | escape }}" loading="lazy" decoding="async">
              {%- else -%}<div class="zch-image-fallback">{{ card_name }}</div>{%- endif -%}
            </div>
            <div class="zch-card__body"><p class="zch-card__category">{{ card_category }}</p><h3>{{ card_name }}</h3><p class="zch-card__description">{{ card_description }}</p>
              <div class="zch-card__bottom"><span class="zch-card__price">{%- if card_product != blank -%}{% if card_product.price_varies %}<small>From </small>{% endif %}{{ card_product.price | money }}{%- else -%}Explore the set{%- endif -%}</span><span class="zch-circle-arrow" aria-hidden="true">↗</span></div>
              <span class="zch-card__cta">{%- if card_product != blank and card_product.available == false -%}Currently sold out · View collection{%- else -%}Shop the collection{%- endif -%}</span>
            </div>
          </a>
        </article>
      {%- endfor -%}
    </div>
  </section>

  <section id="zenkai-apparel" class="zch-apparel" aria-labelledby="zch-apparel-title-{{ section.id }}">
    <div class="zch-shell">
      <div class="zch-section-heading"><div><p class="zch-eyebrow">Wear your favorites</p><h2 id="zch-apparel-title-{{ section.id }}">Made for your everyday rotation.</h2></div><a class="js-no-transition zch-text-link" href="{{ apparel_url }}">Explore apparel <span aria-hidden="true">↗</span></a></div>
      <div class="zch-products zch-products--apparel">
        {%- assign apparel_handles = 'road-to-indigo|champions-00251|058-059-the-royal-family-tee|054-sad-duck-tee|road-to-indigo-sweatshirt|144-146-legends-begin-here-hoodie' | split: '|' -%}
        {%- for apparel_handle in apparel_handles -%}
          {%- liquid
            assign apparel_product = all_products[apparel_handle]
            assign apparel_image = apparel_product.featured_image
            case forloop.index
              when 1
                assign apparel_name = 'Road to Indigo Tee'
              when 2
                assign apparel_name = 'Champions Tee'
              when 3
                assign apparel_name = 'The Royal Family Tee'
              when 4
                assign apparel_name = 'Sad Duck Tee'
              when 5
                assign apparel_name = 'Road to Indigo Sweatshirt'
              when 6
                assign apparel_name = 'Legends Begin Here Hoodie'
            endcase
            assign apparel_category = 'Graphic tee'
            if forloop.index == 5
              assign apparel_category = 'Sweatshirt'
            elsif forloop.index == 6
              assign apparel_category = 'Hoodie'
            endif
          -%}
          {%- if apparel_product != blank -%}
            <article class="zch-card zch-apparel-card">
              <a class="js-no-transition zch-card__link" href="{{ apparel_product.url }}" data-zch-product="{{ apparel_product.handle }}" data-zch-placement="apparel-card">
                <div class="zch-card__media">{%- if apparel_image != blank -%}<img src="{{ apparel_image | image_url: width: 650 }}" srcset="{{ apparel_image | image_url: width: 280 }} 280w, {{ apparel_image | image_url: width: 420 }} 420w, {{ apparel_image | image_url: width: 650 }} 650w" sizes="(min-width: 1280px) 196px, (min-width: 990px) 15vw, (min-width: 750px) 30vw, calc((100vw - 44px) / 2)" width="{{ apparel_image.width }}" height="{{ apparel_image.height }}" alt="{{ apparel_name | escape }} from the Zenkai apparel collection" loading="lazy" decoding="async">{%- endif -%}</div>
                <div class="zch-card__body"><p class="zch-card__category">{{ apparel_category }}</p><h3>{{ apparel_name }}</h3><div class="zch-card__bottom"><span class="zch-card__price">{% if apparel_product.price_varies %}<small>From </small>{% endif %}{{ apparel_product.price | money }}</span><span class="zch-circle-arrow" aria-hidden="true">↗</span></div><span class="zch-card__cta">{% if apparel_product.available %}Choose your size{% else %}Currently sold out{% endif %}</span></div>
              </a>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <nav class="zch-apparel-categories" aria-label="Explore apparel categories"><a class="js-no-transition" href="/collections/tees">Graphic tees <span aria-hidden="true">↗</span></a><a class="js-no-transition" href="/collections/all-hoodies">Hoodies <span aria-hidden="true">↗</span></a><a class="js-no-transition" href="/collections/sweatshirts">Sweatshirts <span aria-hidden="true">↗</span></a><a class="js-no-transition" href="/collections/all-hats">Hats <span aria-hidden="true">↗</span></a></nav>
    </div>
  </section>

  <section class="zch-story zch-shell" aria-labelledby="zch-story-title-{{ section.id }}">
    <div class="zch-story__copy"><p class="zch-eyebrow">The things you connect with</p><h2 id="zch-story-title-{{ section.id }}">A little nostalgia.<br>A lot of you.</h2><p>The graphic you keep in rotation. The pin on your everyday bag. The collection that gets a permanent spot on your desk.</p><p>Zenkai brings those favorites into your everyday, from what you wear to the space you make your own.</p><div class="zch-actions"><a class="js-no-transition zch-text-link" href="{{ apparel_url }}">Find your next graphic <span aria-hidden="true">↗</span></a><a class="js-no-transition zch-text-link" href="#collector-sets">Explore the collections <span aria-hidden="true">↗</span></a></div></div>
    <div class="zch-story__visual"><img src="{{ 'collector-home-shelf-v1.webp' | asset_url }}" srcset="{{ 'collector-home-shelf-v1-640.webp' | asset_url }} 640w, {{ 'collector-home-shelf-v1.webp' | asset_url }} 1200w" sizes="(min-width: 1200px) 410px, (min-width: 750px) 38vw, calc(100vw - 32px)" width="1200" height="1200" alt="Nine colorful plush companions arranged on pale wood display shelves" loading="lazy" decoding="async"></div>
  </section>

  <section class="zch-faq zch-shell" aria-labelledby="zch-faq-title-{{ section.id }}">
    <div><p class="zch-eyebrow">Good to know</p><h2 id="zch-faq-title-{{ section.id }}">Before you choose.</h2><p>Need a hand?<br><a class="js-no-transition" href="mailto:{{ shop.email | escape }}">Get in touch <span aria-hidden="true">↗</span></a></p></div>
    <div class="zch-faq__items">
      <details><summary>Are the plush collections complete sets?<span aria-hidden="true">+</span></summary><div><p>Yes. Little Impostors includes all nine plush companions, and Evolution Companions includes all eight costume plushies. Each product page shows the complete lineup and product details.</p></div></details>
      <details><summary>What’s included with the pins and badges?<span aria-hidden="true">+</span></summary><div><p>The Evolution Pin Set includes eight pins. Gym Badge boxes each include eight badges, with individual box options and a complete collection option on the product page. Check your selected option before adding it to your cart.</p></div></details>
      <details><summary>How do I choose my apparel size?<span aria-hidden="true">+</span></summary><div><p>Open the product page to see its available sizes and sizing information. Check the measurements for the specific tee, sweatshirt, or hoodie you choose, as fit can vary between styles.</p></div></details>
      <details><summary>Where can I check shipping and returns?<span aria-hidden="true">+</span></summary><div><p>See the product page for collection-specific delivery information. Shipping options and any charges are shown at checkout. You can also read our <a class="js-no-transition" href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}">shipping policy</a> and <a class="js-no-transition" href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">return policy</a> before ordering.</p></div></details>
    </div>
  </section>

  <section class="zch-finale" aria-labelledby="zch-finale-title-{{ section.id }}"><p class="zch-eyebrow">Make it part of your everyday</p><h2 id="zch-finale-title-{{ section.id }}">Find what feels like you.</h2><div class="zch-actions"><a class="js-no-transition zch-button" href="#collector-favorites">Explore collectibles <span aria-hidden="true">↗</span></a><a class="js-no-transition zch-button zch-button--outline" href="{{ apparel_url }}">Shop apparel <span aria-hidden="true">↗</span></a></div></section>
</div>

{% schema %}
{
  "name": "Zenkai homepage",
  "settings": [
    {"type": "paragraph", "content": "Apparel and collectibles, together. Images, prices, and availability come from live products. Optional destination links can point to a specific landing-page view."},
    {"type": "image_picker", "id": "hero_image", "label": "Hero image", "info": "Defaults to the Little Impostors product image."},
    {"type": "image_picker", "id": "apparel_hero_image", "label": "Apparel hero image", "info": "Defaults to the Road to Indigo tee product image."},
    {"type": "url", "id": "impostors_url", "label": "Little Impostors destination"},
    {"type": "url", "id": "companions_url", "label": "Evolution Companions destination"},
    {"type": "url", "id": "pins_url", "label": "Evolution Pin Set destination"},
    {"type": "url", "id": "badges_url", "label": "Gym Badge Collection destination"},
    {"type": "url", "id": "apparel_url", "label": "Apparel destination"}
  ],
  "presets": [{"name": "Zenkai homepage", "category": "Zenkai"}]
}
{% endschema %}
