      },
      {
        "type": "text",
        "id": "product_manual_review_name_1",
        "label": "Review name 1"
      },
      {
        "type": "text",
        "id": "product_manual_review_meta_1",
        "label": "Review meta 1",
        "info": "Example: Verified buyer"
      },
      {
        "type": "textarea",
        "id": "product_manual_review_quote_2",
        "label": "Review quote 2"
      },
      {
        "type": "text",
        "id": "product_manual_review_name_2",
        "label": "Review name 2"
      },
      {
        "type": "text",
        "id": "product_manual_review_meta_2",
        "label": "Review meta 2",
        "info": "Example: Verified buyer"
      },
      {
        "type": "textarea",
        "id": "product_manual_review_quote_3",
