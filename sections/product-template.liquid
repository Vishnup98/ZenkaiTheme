      },
      {
        "type": "text",
        "id": "product_pin_lifestyle_heading",
        "label": "Lifestyle image heading",
        "default": "Display it, gift it, wear it."
      },
      {
        "type": "textarea",
        "id": "product_pin_lifestyle_body",
        "label": "Lifestyle image body",
        "default": "Small enough to wear. Clean enough to display."
      },
      {
        "type": "header",
        "content": "Manual reviews"
      },
      {
        "type": "text",
        "id": "product_manual_reviews_heading",
