{{ 'summoning-glow-reviews.css' | asset_url | stylesheet_tag }}

{%- if product.handle == 'summoning-glow-16cm-led-dragon-display' -%}
  <section
    id="SummoningGlowReviews-{{ section.id }}"
    class="sg-reviews"
    data-sg-reviews
    aria-labelledby="SummoningGlowReviewsHeading-{{ section.id }}">
    <div class="page-width">
      <header class="sg-reviews__header">
        <div class="sg-reviews__intro">
          <p class="sg-reviews__eyebrow">Real collector setups</p>
          <h2 id="SummoningGlowReviewsHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.subheading != blank -%}
            <p class="sg-reviews__subheading">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>

        <div class="sg-reviews__summary" aria-label="12 featured customer-photo reviews with a 5 out of 5 average">
          <strong class="sg-reviews__score">12</strong>
          <div class="sg-reviews__summary-copy">
            <p class="sg-reviews__summary-label">Customer-photo reviews</p>
            <div class="sg-reviews__summary-rating">
              {% render 'summoning-glow-review-stars' %}
              <span>5.0 average among featured reviews</span>
            </div>
          </div>
        </div>
      </header>

      <div class="sg-reviews__toolbar" aria-label="Review overview">
        <p class="sg-reviews__signature">Nostalgia, drawn properly <span>— seen on real shelves</span></p>
        <p class="sg-reviews__shown" data-sg-visible-count>6 of 12 shown</p>
      </div>

      <div class="sg-reviews__grid" data-sg-review-grid data-sg-review-total="12">
        {% render 'summoning-glow-review-card', review_id: '3730', reviewer: 'Maria', date_iso: '2024-05-01', date_label: 'May 1, 2024', body: 'It arrived earlier than expected, well packed, with all pieces intact. Everything works. ❤️', lead: 'It arrived earlier than expected, well packed, with all pieces intact.', detail: 'Everything works. ❤️', image_name: 'summoning-glow-review-87093560.jpg', image_width: 750, image_height: 1000, photo_position: '50% 48%' %}
        {% render 'summoning-glow-review-card', review_id: '3728', reviewer: 'Jenna', date_iso: '2024-04-20', date_label: 'Apr 20, 2024', body: 'Happy with the shipment—it arrived early and matched the description. Super pleased.', lead: 'Happy with the shipment—it arrived early and matched the description.', detail: 'Super pleased.', image_name: 'summoning-glow-review-87093558.jpg', image_width: 562, image_height: 1000, photo_position: '50% 44%' %}
        {% render 'summoning-glow-review-card', review_id: '3889', reviewer: 'Oscar', date_iso: '2024-04-03', date_label: 'Apr 3, 2024', body: 'Always fast and good quality.', lead: 'Always fast and good quality.', image_name: 'summoning-glow-review-87093565.jpg', image_width: 1000, image_height: 750, photo_position: '50% 48%' %}
        {% render 'summoning-glow-review-card', review_id: '3727', reviewer: 'Jazmin', date_iso: '2024-03-27', date_label: 'Mar 27, 2024', body: 'Great quality for the price. My only issue is that the ring for the seven balls feels a little large—or the balls feel a little small—so there is some extra space. Otherwise, everything is great.', lead: 'Great quality for the price.', detail: 'My only issue is that the ring for the seven balls feels a little large—or the balls feel a little small—so there is some extra space. Otherwise, everything is great.', image_name: 'summoning-glow-review-87093557.jpg', image_width: 750, image_height: 1000, photo_position: '50% 43%' %}
        {% render 'summoning-glow-review-card', review_id: '3734', reviewer: 'Jada', date_iso: '2024-03-12', date_label: 'Mar 12, 2024', body: 'It arrived very well packed and looks very cool.', lead: 'It arrived very well packed and looks very cool.', image_name: 'summoning-glow-review-87093564.jpg', image_width: 750, image_height: 1000, photo_position: '50% 46%' %}
        {% render 'summoning-glow-review-card', review_id: '3726', reviewer: 'Pablo', date_iso: '2024-02-23', date_label: 'Feb 23, 2024', body: 'Excellent service and faster than I expected. The details are amazing, and the lights really elevate the product. My husband loves it!', lead: 'Excellent service and faster than I expected.', detail: 'The details are amazing, and the lights really elevate the product. My husband loves it!', image_name: 'summoning-glow-review-87093556.jpg', image_width: 450, image_height: 1000, photo_position: '50% 38%' %}
      </div>

      <template data-sg-review-batch="2">
          {% render 'summoning-glow-review-card', review_id: '3723', reviewer: 'Diaz', date_iso: '2024-06-22', date_label: 'Jun 22, 2024', body: 'Not cheap, but not very expensive either. Worth it. It includes a remote to change the colors, plus the Dragon Balls.', lead: 'Not cheap, but not very expensive either.', detail: 'Worth it. It includes a remote to change the colors, plus the Dragon Balls.', image_name: 'summoning-glow-review-87093553.jpg', image_width: 750, image_height: 1000, photo_position: '50% 48%', defer_image: true %}
          {% render 'summoning-glow-review-card', review_id: '3737', reviewer: 'Carlos', date_iso: '2024-06-18', date_label: 'Jun 18, 2024', body: 'Loving it. Thanks, seller.', lead: 'Loving it.', detail: 'Thanks, seller.', image_name: 'summoning-glow-review-87093566.jpg', image_width: 750, image_height: 1000, photo_position: '50% 40%', defer_image: true %}
          {% render 'summoning-glow-review-card', review_id: '3733', reviewer: 'Anna', date_iso: '2024-06-16', date_label: 'Jun 16, 2024', body: 'Good product—excellent for the price!', lead: 'Good product—excellent for the price!', image_name: 'summoning-glow-review-87093563.jpg', image_width: 750, image_height: 1000, photo_position: '50% 48%', defer_image: true %}
          {% render 'summoning-glow-review-card', review_id: '3725', reviewer: 'Gomez', date_iso: '2024-06-14', date_label: 'Jun 14, 2024', body: 'Very nice. It arrived well protected and earlier than expected. 100% recommended.', lead: 'Very nice.', detail: 'It arrived well protected and earlier than expected. 100% recommended.', image_name: 'summoning-glow-review-87093555.jpg', image_width: 450, image_height: 1000, photo_position: '50% 38%', defer_image: true %}
          {% render 'summoning-glow-review-card', review_id: '3729', reviewer: 'Elisa', date_iso: '2024-06-07', date_label: 'Jun 7, 2024', body: 'Photo-only review.', image_name: 'summoning-glow-review-87093559.jpg', image_width: 450, image_height: 1000, photo_position: '50% 43%', defer_image: true %}
          {% render 'summoning-glow-review-card', review_id: '3724', reviewer: 'Jimenez', date_iso: '2024-06-07', date_label: 'Jun 7, 2024', body: "This thing is amazing—I'm delighted. I put it in a glass display case, and it looks even better when turned on. The detail is excellent. I recommend it.", lead: "This thing is amazing—I'm delighted.", detail: 'I put it in a glass display case, and it looks even better when turned on. The detail is excellent. I recommend it.', image_name: 'summoning-glow-review-87093554.jpg', image_width: 500, image_height: 1000, photo_position: '50% 30%', defer_image: true %}
      </template>

      <div class="sg-reviews__reveal">
        <button type="button" class="sg-reviews__reveal-button" data-sg-review-more aria-expanded="false">
          <span data-sg-review-more-label>Show 6 more collector setups</span>
          <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m5 8 5 5 5-5"></path>
          </svg>
        </button>
        <p class="sg-reviews__reveal-status" data-sg-review-status aria-live="polite"></p>
      </div>

      {% render 'summoning-glow-review-lightbox' %}
    </div>
  </section>

  <script src="{{ 'summoning-glow-reviews.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Summoning Glow reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by collectors"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real shelves, close-up details, and first impressions from customers."
    }
  ],
  "presets": [
    {
      "name": "Summoning Glow reviews"
    }
  ]
}
{% endschema %}
