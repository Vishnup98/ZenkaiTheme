{%- assign collector_compare_price = separate_total -%}
{%- assign collector_savings = 0 -%}
{%- assign collector_price_money = blank -%}
{%- if collector_variant != blank -%}
  {%- if collector_variant.compare_at_price > collector_variant.price -%}
    {%- assign collector_compare_price = collector_variant.compare_at_price -%}
  {%- endif -%}
  {%- if collector_compare_price > collector_variant.price -%}
    {%- assign collector_savings = collector_compare_price | minus: collector_variant.price -%}
  {%- else -%}
    {%- assign collector_compare_price = collector_variant.price -%}
  {%- endif -%}
  {%- assign collector_price_money = collector_variant.price | money -%}
{%- endif -%}
{%- assign collector_savings_money = collector_savings | money -%}
{%- assign collector_compare_money = collector_compare_price | money -%}

{%- if product.handle == gym_badge_product_handle and collector_variant != blank -%}
  <div
    class="gb-use gb-use--{{ journey }}"
    data-gb-use-state
    data-collector-variant-id="{{ collector_variant.id }}"
    data-product-id="{{ product.id }}"
    data-landing-variant="use-{{ journey }}"
  >
    <section class="gb-use-hero" aria-labelledby="gb-use-title-{{ section.id }}">
      <div class="gb-use-shell gb-use-hero__grid">
        <figure class="gb-use-hero__visual">
          <picture>
            <source media="(max-width: 749px)" srcset="{{ hero_mobile | asset_url }}">
            <img src="{{ hero_desktop | asset_url }}" width="1200" height="800" alt="{{ hero_alt | escape }}" loading="eager" fetchpriority="high" decoding="async">
          </picture>
          <figcaption>{{ props_text }}</figcaption>
        </figure>

        <div class="gb-use-hero__content">
          <div class="gb-use-trust gb-use-trust--hero" aria-label="Store rating and fulfilled-order count">
            <span class="gb-use-trust__group"><span class="gb-use-stars" aria-hidden="true">★★★★★</span><strong>4.8/5</strong><span>95 reviews</span></span>
            <i aria-hidden="true"></i>
            <span class="gb-use-trust__group"><strong>2,800+</strong><span>orders shipped</span></span>
          </div>
          <p class="gb-use-eyebrow">The complete Collector Pack</p>
          <h1 id="gb-use-title-{{ section.id }}">{{ hero_title }}</h1>
          <p class="gb-use-hero__lede">{{ hero_body }}</p>

          <div class="gb-use-offer gb-use-offer--hero" data-gb-use-inline-offer>
            <div class="gb-use-offer__price">
              <div><span>Collector Pack · 32 badges</span><p>{%- if collector_savings > 0 -%}<s>{{ collector_compare_money }}</s>{%- endif -%}<strong>{{ collector_price_money }}</strong></p></div>
              {%- if collector_savings > 0 -%}<span class="gb-use-save">Save {{ collector_savings_money }}</span>{%- endif -%}
            </div>
            <button class="gb-use-button" type="button" data-gb-use-checkout data-placement="hero" {% unless collector_variant.available %}disabled{% endunless %}>
              <span>{% if collector_variant.available %}Get All 32 — {{ collector_price_money }}{% else %}Collector Pack sold out{% endif %}</span>
            </button>
            <div class="gb-use-offer__signals"><span>Free U.S. shipping</span><span>Typically arrives in 5–7 business days</span></div>
            <div class="gb-use-offer__proof"><strong>4.8/5</strong><span>from 95 reviews</span><i></i><strong>2,800+</strong><span>orders shipped</span></div>
            <p class="gb-use-policy">Damaged, missing, incorrect, or not as described? We’ll make it right. <a href="/pages/policy">Full collector policy</a>.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="gb-use-facts" aria-label="Collector Pack at a glance">
      <div class="gb-use-shell gb-use-facts__grid">
        <article><strong>32</strong><span>glossy hard-enamel badges</span></article>
        <article><strong>4</strong><span>original regions</span></article>
        <article><strong>4</strong><span>fitted collector boxes</span></article>
        {%- if collector_savings > 0 -%}<article><strong>{{ collector_savings_money }}</strong><span>saved on the complete pack</span></article>{%- else -%}<article><strong>1</strong><span>complete Collector Pack</span></article>{%- endif -%}
      </div>
    </section>

    <section class="gb-use-ownership" aria-labelledby="gb-use-ownership-title-{{ section.id }}">
      <div class="gb-use-shell">
        <div class="gb-use-heading gb-use-heading--wide">
          <p class="gb-use-eyebrow">{{ ownership_eyebrow }}</p>
          <h2 id="gb-use-ownership-title-{{ section.id }}">{{ ownership_title }}</h2>
          <p>{{ ownership_body }}</p>
        </div>
        <div class="gb-use-ownership__grid">
          <article><span>01</span><h3>{{ point_one_title }}</h3><p>{{ point_one_body }}</p></article>
          <article><span>02</span><h3>{{ point_two_title }}</h3><p>{{ point_two_body }}</p></article>
          <article><span>03</span><h3>{{ point_three_title }}</h3><p>{{ point_three_body }}</p></article>
        </div>
      </div>
    </section>

    <section class="gb-use-regions" aria-labelledby="gb-use-regions-title-{{ section.id }}">
      <div class="gb-use-shell">
        <div class="gb-use-heading gb-use-heading--center">
