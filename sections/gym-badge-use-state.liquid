{%- assign separate_total = 0 -%}
{%- assign kanto_media = blank -%}
{%- assign johto_media = blank -%}
{%- assign hoenn_media = blank -%}
{%- assign sinnoh_media = blank -%}

{%- for variant in product.variants -%}
  {%- assign variant_title = variant.title | downcase -%}
  {%- assign variant_media = variant.featured_media | default: product.media[forloop.index0] | default: product.featured_media -%}
  {%- assign is_collector_candidate = false -%}
  {%- if variant_title contains 'collector' or variant_title contains '4 regions' or variant_title contains '4 region' or variant_title contains '4-region' or variant_title contains 'all four' -%}
    {%- assign is_collector_candidate = true -%}
    {%- if collector_variant == blank or variant.available -%}
      {%- assign collector_variant = variant -%}
    {%- endif -%}
  {%- endif -%}
  {%- unless is_collector_candidate -%}
    {%- if variant_title contains 'kanto' -%}
      {%- assign kanto_media = variant_media -%}
      {%- assign separate_total = separate_total | plus: variant.price -%}
    {%- elsif variant_title contains 'johto' -%}
      {%- assign johto_media = variant_media -%}
      {%- assign separate_total = separate_total | plus: variant.price -%}
    {%- elsif variant_title contains 'hoenn' -%}
      {%- assign hoenn_media = variant_media -%}
      {%- assign separate_total = separate_total | plus: variant.price -%}
    {%- elsif variant_title contains 'sinnoh' -%}
      {%- assign sinnoh_media = variant_media -%}
      {%- assign separate_total = separate_total | plus: variant.price -%}
    {%- endif -%}
  {%- endunless -%}
{%- endfor -%}

{%- assign kanto_media = kanto_media | default: product.media[0] | default: product.featured_media -%}
